# STORYBLOK_TOKEN=
# STORYBLOK_IS_PREVIEW=yes
# STORYBLOK_ENVIRONMENT=development or production
# STORYBLOK_DEFAULT_LANG=en
# PUBLIC_POSTHOG_TOKEN=

# ---- Admin CMS ----
# Local dev uses a SQLite file by default (file:./data/cms.db).
# For production (Vercel) point these to a libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-token
# Session signing secret (set a long random value in production):
# AUTH_SECRET=
# Bootstrap del primer administrador: solo se usa si la tabla `users` está vacía.
# Después de la migración, los usuarios se gestionan desde la pestaña Usuarios del panel.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# ---- Avisos por email (Resend) ----
# Si falta cualquiera de las tres, el envío es un no-op: la solicitud se guarda
# igual y el panel sigue siendo la fuente de verdad (ver src/lib/email.ts).
# La inyecta la integración de Resend del Marketplace de Vercel:
# RESEND_API_KEY=
# Remitente: debe estar en un dominio verificado en Resend.
# NOTIFY_FROM=Ekosolv <notificaciones@tu-dominio-verificado.com>
# Destinatarios internos, separados por coma:
# NOTIFY_EMAIL=operaciones@ekosolv.com,gerencia@ekosolv.com
