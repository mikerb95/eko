---
/**
 * Tablero XP del propio sitio: iteraciones, historias y Definition of Done.
 *
 * Los datos vienen de src/data/iteraciones.ts y se serializan a un <script
 * type="application/json"> que el script del cliente lee. Se hace así, y no con
 * define:vars, para no depender de que el JSON sobreviva a la interpolación en
 * un atributo y para que los datos sean inspeccionables desde el navegador.
 *
 * Toda la interacción es progresiva: sin JavaScript se ve el resumen y el aviso
 * de la etiqueta <noscript>, no una página en blanco.
 */
import {
  PARES,
  COLUMNAS,
  ITERACIONES,
  COMMITS_POR_MES,
  COMMITS_TOTAL,
  REPO,
} from '../data/iteraciones'

const payload = JSON.stringify({ PARES, COLUMNAS, ITERACIONES, COMMITS_POR_MES, REPO })
const conCommits = ITERACIONES.filter((i) => i.commits != null)
---

<section class="board" aria-label="Tablero de iteraciones">
  <script is:inline type="application/json" id="iterData" set:html={payload} />

  <header class="board-head">
    <p class="board-sub">
      Tablero XP de este sitio, reconstruido del historial real de Git: {COMMITS_TOTAL} commits
      en {conCommits.length} iteraciones. Cada historia lleva su Definition of Done, y un criterio
      solo está en verde si hoy se puede verificar en el repositorio.
    </p>
    <div class="view-toggle" id="viewToggle" role="group" aria-label="Vista del tablero">
      <button type="button" class="view-btn view-btn--on" data-view="board">Tablero</button>
      <button type="button" class="view-btn" data-view="charts">Gráficos</button>
    </div>
  </header>

  <div class="tabs-wrap" id="tabsWrap">
    <button type="button" class="tabs-arrow tabs-arrow--left" id="tabsPrev" aria-label="Iteraciones anteriores" hidden>
      <span aria-hidden="true">‹</span>
    </button>
    <div class="tabs" id="iterTabs" role="tablist" aria-label="Iteraciones"></div>
    <button type="button" class="tabs-arrow tabs-arrow--right" id="tabsNext" aria-label="Iteraciones siguientes" hidden>
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <noscript>
    <p class="noscript">
      El tablero es interactivo y necesita JavaScript. El detalle de cada iteración también está en
      <code>src/data/iteraciones.ts</code>.
    </p>
  </noscript>

  <div class="kpis" id="iterSummary"></div>

  <article class="progress-card" id="iterProgressCard">
    <div class="progress-top">
      <div>
        <h3 class="progress-title" id="iterProgressTitle"></h3>
        <p class="progress-meta" id="iterProgressMeta"></p>
      </div>
      <span class="progress-pct" id="iterProgressPct"></span>
    </div>
    <p class="progress-resumen" id="iterProgressResumen"></p>
    <div class="bar" id="iterBar" role="img" aria-label="Avance de los criterios de DoD"></div>
    <div class="bar-legend" id="iterBarLegend"></div>
    <a class="gh-link" id="iterProgressGh" href={REPO} target="_blank" rel="noopener noreferrer" hidden>
      <span id="iterProgressGhText"></span>
      <span aria-hidden="true">→</span>
    </a>
  </article>

  <div class="board-cols" id="iterBoard"></div>

  <div class="charts" id="iterCharts" hidden>
    <article class="chart">
      <div class="chart-head">
        <div>
          <h3 class="chart-title">Actividad de commits</h3>
          <p class="chart-sub">Commits por mes en el historial del repositorio.</p>
        </div>
      </div>
      <div class="chart-canvas" id="chartMes"></div>
    </article>
    <article class="chart">
      <div class="chart-head">
        <div>
          <h3 class="chart-title">Commits por iteración</h3>
          <p class="chart-sub">Volumen de cada iteración cerrada. El backlog no tiene commits.</p>
        </div>
      </div>
      <div class="chart-canvas" id="chartIter"></div>
    </article>
  </div>

  <div class="modal" id="historiaModal" role="dialog" aria-modal="true" aria-labelledby="hModalTitle" hidden>
    <div class="modal-card">
      <header class="modal-head">
        <span class="modal-id" id="hModalId"></span>
        <h3 class="modal-title" id="hModalTitle"></h3>
        <button type="button" class="modal-close" id="hModalClose" aria-label="Cerrar">
          <span aria-hidden="true">×</span>
        </button>
      </header>
      <div class="modal-body">
        <div class="modal-meta" id="hModalMeta"></div>
        <h4 class="modal-label">Definition of Done</h4>
        <ul class="modal-tests" id="hModalTests"></ul>
        <div id="hModalArchivosBox" hidden>
          <h4 class="modal-label">Dónde vive en el repositorio</h4>
          <ul class="modal-files" id="hModalArchivos"></ul>
        </div>
        <p class="modal-nota" id="hModalNota" hidden></p>
      </div>
    </div>
  </div>
</section>

<script>
  interface Criterio { texto: string; estado: 'pass' | 'fail' | 'pend' }
  interface Historia {
    id: string
    titulo: string
    tipo: string
    valor: string
    col: string
    par: string
    agente?: string
    fecha?: string
    tags: string[]
    dod: Criterio[]
    archivos?: string[]
    nota?: string
  }
  interface Iteracion {
    id: string
    fase: string
    nombre: string
    rango: string
    ghSince: string
    ghUntil: string
    commits: number | null
    resumen: string
    historias: Historia[]
  }

  function initBoard() {
    const dataEl = document.getElementById('iterData')
    if (!dataEl || dataEl.dataset.ready === '1') return
    dataEl.dataset.ready = '1'

    const DATA = JSON.parse(dataEl.textContent || '{}')
    const PARES: Record<string, { nombre: string; rol: string; color: string }> = DATA.PARES
    const COLUMNAS: Array<{ id: string; nombre: string; color: string }> = DATA.COLUMNAS
    const ITERACIONES: Iteracion[] = DATA.ITERACIONES
    const COMMITS_POR_MES: Array<{ mes: string; commits: number }> = DATA.COMMITS_POR_MES
    const REPO: string = DATA.REPO

    const $ = (id: string) => document.getElementById(id)!
    const ghUrl = (since: string, until: string) =>
      `${REPO}/commits/main/?since=${since}&until=${until}`

    const NS = 'http://www.w3.org/2000/svg'
    const SVG = new Set(['svg', 'g', 'path', 'line', 'rect', 'text'])
    function el(tag: string, attrs: Record<string, string> = {}, ...kids: Array<string | Node>) {
      const node = SVG.has(tag)
        ? document.createElementNS(NS, tag)
        : document.createElement(tag)
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v)
      for (const k of kids) node.appendChild(typeof k === 'string' ? document.createTextNode(k) : k)
      return node as HTMLElement
    }

    // La iteración abierta al entrar es la última cerrada, no el backlog: es lo
    // que alguien quiere ver primero al abrir el tablero.
    const cerradas = ITERACIONES.filter((i) => i.commits != null)
    let actual = cerradas[cerradas.length - 1] || ITERACIONES[0]

    /* ---------- Pestañas de iteración ---------- */

    const tabsBox = $('iterTabs')
    const tabEls = ITERACIONES.map((it) => {
      const tab = el('button', {
        type: 'button',
        class: 'tab' + (it.id === actual.id ? ' tab--on' : ''),
        role: 'tab',
        'aria-selected': it.id === actual.id ? 'true' : 'false',
        title: it.nombre,
      })
      tab.dataset.id = it.id
      tab.appendChild(el('span', { class: 'tab-fase' }, it.fase))
      tab.appendChild(el('span', { class: 'tab-name' }, it.nombre))
      const range = el('span', { class: 'tab-range' }, it.rango)
      if (it.commits != null) range.appendChild(el('span', { class: 'tab-commits' }, `${it.commits}`))
      tab.appendChild(range)
      tab.addEventListener('click', () => select(it.id))
      tabsBox.appendChild(tab)
      return tab
    })

    function select(id: string) {
      actual = ITERACIONES.find((i) => i.id === id) || ITERACIONES[0]
      tabEls.forEach((t) => {
        const on = t.dataset.id === actual.id
        t.classList.toggle('tab--on', on)
        t.setAttribute('aria-selected', on ? 'true' : 'false')
      })
      render()
    }

    const wrap = $('tabsWrap')
    const prev = $('tabsPrev')
    const next = $('tabsNext')

    function updateArrows() {
      const max = tabsBox.scrollWidth - tabsBox.clientWidth
      const hasPrev = tabsBox.scrollLeft > 2
      const hasNext = tabsBox.scrollLeft < max - 2
      prev.hidden = !hasPrev
      next.hidden = !hasNext
      wrap.classList.toggle('has-prev', hasPrev)
      wrap.classList.toggle('has-next', hasNext)
    }
    const scrollTabs = (dir: number) =>
      tabsBox.scrollBy({ left: dir * Math.max(tabsBox.clientWidth * 0.8, 220), behavior: 'smooth' })
    prev.addEventListener('click', () => scrollTabs(-1))
    next.addEventListener('click', () => scrollTabs(1))
    tabsBox.addEventListener('scroll', updateArrows, { passive: true })
    // ResizeObserver en vez de un listener de resize en window: initBoard vuelve
    // a correr en cada navegación del ClientRouter, y los listeners colgados de
    // window se acumularían navegación tras navegación.
    new ResizeObserver(updateArrows).observe(tabsBox)

    // Deja visible la pestaña activa, que no es la primera.
    const activo = tabEls.find((t) => t.classList.contains('tab--on'))
    if (activo) activo.scrollIntoView({ block: 'nearest', inline: 'center' })
    updateArrows()

    /* ---------- Conmutador tablero / gráficos ---------- */

    $('viewToggle').addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.view-btn') as HTMLElement | null
      if (!btn) return
      document
        .querySelectorAll<HTMLElement>('.board .view-btn')
        .forEach((b) => b.classList.toggle('view-btn--on', b === btn))
      const charts = btn.dataset.view === 'charts'
      $('iterBoard').hidden = charts
      $('iterProgressCard').hidden = charts
      $('iterCharts').hidden = !charts
      if (charts) renderCharts()
    })

    /* ---------- Cálculo de avance ---------- */

    function dodStats(historias: Historia[]) {
      const dod = historias.flatMap((h) => h.dod || [])
      const total = dod.length
      const pass = dod.filter((d) => d.estado === 'pass').length
      const fail = dod.filter((d) => d.estado === 'fail').length
      return { total, pass, fail, pend: total - pass - fail, pct: total ? Math.round((pass / total) * 100) : 0 }
    }

    /* ---------- Render principal ---------- */

    function render() {
      const h = actual.historias
      const aceptadas = h.filter((s) => s.col === 'aceptada').length
      const enCurso = h.filter((s) => s.col === 'desarrollo' || s.col === 'aceptacion').length
      const d = dodStats(h)

      const summary = $('iterSummary')
      summary.replaceChildren()
      const tiles = [
        { label: 'Historias', value: String(h.length), sub: `${aceptadas} aceptadas`, tone: 'deep' },
        { label: 'DoD', value: `${d.pass}/${d.total}`, sub: `${d.pend} pendientes`, tone: 'aqua' },
        { label: 'Completado', value: `${d.pct}%`, sub: `${enCurso} en curso`, tone: 'forest' },
        {
          label: 'Commits',
          value: actual.commits != null ? String(actual.commits) : '—',
          sub: actual.rango,
          tone: 'clay',
        },
      ]
      for (const t of tiles) {
        const tile = el('div', { class: 'kpi' })
        const label = el('div', { class: 'kpi-label' })
        label.appendChild(el('i', { class: `kpi-dot kpi-dot--${t.tone}` }))
        label.appendChild(document.createTextNode(t.label))
        tile.appendChild(label)
        tile.appendChild(el('div', { class: 'kpi-value' }, t.value))
        tile.appendChild(el('div', { class: 'kpi-sub' }, t.sub))
        summary.appendChild(tile)
      }

      $('iterProgressTitle').textContent = actual.nombre
      $('iterProgressMeta').textContent =
        `${actual.fase} · ${actual.rango} · ${d.pass} de ${d.total} criterios de DoD cumplidos`
      $('iterProgressResumen').textContent = actual.resumen || ''
      $('iterProgressPct').textContent = `${d.pct}%`

      const gh = $('iterProgressGh') as HTMLAnchorElement
      if (actual.commits != null) {
        gh.href = ghUrl(actual.ghSince, actual.ghUntil)
        $('iterProgressGhText').textContent = `Ver los ${actual.commits} commits de este periodo en GitHub`
        gh.hidden = false
      } else {
        gh.hidden = true
      }

      const bar = $('iterBar')
      bar.replaceChildren()
      const segs = [
        { color: 'var(--forest)', v: d.pass },
        { color: 'var(--clay-2)', v: d.fail },
        { color: 'var(--line-2)', v: d.pend },
      ]
      for (const s of segs) {
        if (s.v <= 0 || !d.total) continue
        const seg = el('div', { class: 'bar-seg' })
        seg.style.background = s.color
        seg.style.width = `${(s.v / d.total) * 100}%`
        bar.appendChild(seg)
      }

      const legend = $('iterBarLegend')
      legend.replaceChildren()
      const keys: Array<[string, string, number]> = [
        ['var(--forest)', 'Cumplidos', d.pass],
        ['var(--line-2)', 'Pendientes', d.pend],
      ]
      if (d.fail) keys.push(['var(--clay-2)', 'Retirados o rotos', d.fail])
      for (const [color, texto, n] of keys) {
        const span = el('span', {}, `${texto} ${n}`)
        const dot = el('i', {})
        dot.style.background = color
        span.prepend(dot)
        legend.appendChild(span)
      }

      const board = $('iterBoard')
      board.replaceChildren()
      for (const col of COLUMNAS) {
        const items = h.filter((s) => s.col === col.id)
        const colEl = el('div', { class: 'col' })
        const head = el('div', { class: 'col-head' })
        const dot = el('span', { class: 'col-dot' })
        dot.style.background = col.color
        head.appendChild(dot)
        head.appendChild(el('span', { class: 'col-name' }, col.nombre))
        head.appendChild(el('span', { class: 'col-count' }, String(items.length)))
        colEl.appendChild(head)
        const body = el('div', { class: 'col-body' })
        if (!items.length) body.appendChild(el('div', { class: 'col-empty' }, 'Sin historias'))
        else for (const s of items) body.appendChild(historiaCard(s))
        colEl.appendChild(body)
        board.appendChild(colEl)
      }
    }

    /* ---------- Tarjeta de historia ---------- */

    const TIPO: Record<string, string> = { historia: 'Historia', bug: 'Bug', tarea: 'Tarea', spike: 'Spike' }
    const VALOR: Record<string, string> = { alto: 'Valor alto', medio: 'Valor medio', bajo: 'Valor bajo' }
    const ICONO: Record<string, string> = { pass: '✓', fail: '✕', pend: '' }

    function criterioLi(c: Criterio, cls: string) {
      const li = el('li', { class: cls })
      const icon = el('span', { class: `test-icon test-icon--${c.estado}` }, ICONO[c.estado] ?? '')
      icon.setAttribute('aria-hidden', 'true')
      li.appendChild(icon)
      li.appendChild(document.createTextNode(c.texto))
      return li
    }

    function historiaCard(s: Historia) {
      const par = PARES[s.par] || { nombre: s.par, rol: '', color: '#6B7580' }
      const dod = s.dod || []
      const pass = dod.filter((c) => c.estado === 'pass').length

      const card = el('button', { type: 'button', class: 'card' })

      const top = el('div', { class: 'card-top' })
      top.appendChild(el('span', { class: 'card-id' }, s.id))
      top.appendChild(el('span', { class: `card-type card-type--${s.tipo}` }, TIPO[s.tipo] || s.tipo))
      if (dod.length) top.appendChild(el('span', { class: 'card-pts' }, `${pass}/${dod.length} DoD`))
      card.appendChild(top)

      card.appendChild(el('p', { class: 'card-title' }, s.titulo))

      if (s.tags?.length) {
        const tags = el('div', { class: 'card-tags' })
        for (const t of s.tags) tags.appendChild(el('span', { class: 'tag' }, `#${t}`))
        card.appendChild(tags)
      }

      if (dod.length) {
        const tests = el('ul', { class: 'card-tests' })
        for (const c of dod) tests.appendChild(criterioLi(c, 'card-test'))
        card.appendChild(tests)
      }

      const foot = el('div', { class: 'card-foot' })
      const valor = el('span', { class: `card-valor card-valor--${s.valor}` })
      valor.appendChild(el('i', {}))
      valor.appendChild(document.createTextNode(VALOR[s.valor] || s.valor))
      foot.appendChild(valor)
      if (s.agente) foot.appendChild(el('span', { class: 'card-agente' }, s.agente))
      const avatar = el('span', { class: 'avatar', title: `${par.nombre} — ${par.rol}` }, s.par)
      avatar.style.background = par.color
      foot.appendChild(avatar)
      card.appendChild(foot)

      card.addEventListener('click', () => openModal(s))
      return card
    }

    /* ---------- Detalle de historia ---------- */

    const modal = $('historiaModal')
    let lastFocus: HTMLElement | null = null

    function openModal(s: Historia) {
      const par = PARES[s.par] || { nombre: s.par, rol: '' }
      const colNombre = COLUMNAS.find((c) => c.id === s.col)?.nombre || s.col

      $('hModalId').textContent = s.id
      $('hModalTitle').textContent = s.titulo

      const fecha = s.fecha
        ? new Date(`${s.fecha}T00:00:00`).toLocaleDateString('es-CO', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        : actual.rango

      const meta = $('hModalMeta')
      meta.replaceChildren()
      const filas: Array<[string, string]> = [
        ['Estado', colNombre],
        ['Tipo', TIPO[s.tipo] || s.tipo],
        ['Valor', VALOR[s.valor] || s.valor],
        ['Fecha', fecha],
        ['Pareja', `${par.nombre}${par.rol ? ` — ${par.rol}` : ''}`],
      ]
      for (const [k, v] of filas) {
        const row = el('span', {})
        row.appendChild(el('span', { class: 'modal-meta-label' }, `${k}:`))
        row.appendChild(document.createTextNode(` ${v}`))
        meta.appendChild(row)
      }

      const tests = $('hModalTests')
      tests.replaceChildren()
      for (const c of s.dod || []) tests.appendChild(criterioLi(c, `modal-test modal-test--${c.estado}`))

      const archivosBox = $('hModalArchivosBox')
      const archivos = $('hModalArchivos')
      archivos.replaceChildren()
      if (s.archivos?.length) {
        for (const f of s.archivos) archivos.appendChild(el('li', {}, f))
        archivosBox.hidden = false
      } else {
        archivosBox.hidden = true
      }

      const nota = $('hModalNota')
      if (s.nota) {
        nota.textContent = s.nota
        nota.hidden = false
      } else {
        nota.hidden = true
      }

      lastFocus = document.activeElement as HTMLElement
      modal.hidden = false
      document.body.style.overflow = 'hidden'
      ;($('hModalClose') as HTMLButtonElement).focus()
    }

    function closeModal() {
      modal.hidden = true
      document.body.style.overflow = ''
      lastFocus?.focus()
    }

    $('hModalClose').addEventListener('click', closeModal)
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal()
    })
    // El listener va en el modal, no en document, por la misma razón: al abrirlo
    // el foco queda en su botón de cierre, así que la tecla llega igual.
    modal.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal()
    })

    /* ---------- Gráficos ---------- */

    let chartsDone = false

    function barChart(
      host: HTMLElement,
      datos: Array<{ etiqueta: string; valor: number; titulo?: string }>,
      color: string,
    ) {
      host.replaceChildren()
      const W = 640
      const H = 220
      const padL = 34
      const padB = 42
      const padT = 12
      const max = Math.max(1, ...datos.map((d) => d.valor))
      const innerW = W - padL - 10
      const innerH = H - padB - padT
      const step = innerW / datos.length
      const barW = Math.min(46, step * 0.6)

      const svg = el('svg', {
        viewBox: `0 0 ${W} ${H}`,
        role: 'img',
        'aria-label': datos.map((d) => `${d.etiqueta}: ${d.valor}`).join('; '),
      })

      // Rejilla horizontal y escala.
      for (let i = 0; i <= 3; i++) {
        const v = Math.round((max / 3) * i)
        const y = padT + innerH - (v / max) * innerH
        svg.appendChild(
          el('line', {
            x1: String(padL),
            x2: String(W - 10),
            y1: y.toFixed(1),
            y2: y.toFixed(1),
            stroke: 'var(--line)',
            'stroke-width': '1',
          }),
        )
        svg.appendChild(
          el('text', { x: String(padL - 8), y: (y + 4).toFixed(1), class: 'ax', 'text-anchor': 'end' }, String(v)),
        )
      }

      datos.forEach((d, i) => {
        const h = (d.valor / max) * innerH
        const x = padL + step * i + (step - barW) / 2
        const y = padT + innerH - h
        const rect = el('rect', {
          x: x.toFixed(1),
          y: y.toFixed(1),
          width: barW.toFixed(1),
          height: Math.max(d.valor > 0 ? 2 : 0, h).toFixed(1),
          rx: '3',
          fill: color,
        })
        rect.appendChild(el('title', {}, `${d.titulo || d.etiqueta}: ${d.valor} commits`))
        svg.appendChild(rect)
        if (d.valor > 0) {
          svg.appendChild(
            el(
              'text',
              { x: (x + barW / 2).toFixed(1), y: (y - 5).toFixed(1), class: 'val', 'text-anchor': 'middle' },
              String(d.valor),
            ),
          )
        }
        svg.appendChild(
          el(
            'text',
            { x: (x + barW / 2).toFixed(1), y: String(H - padB + 18), class: 'ax', 'text-anchor': 'middle' },
            d.etiqueta,
          ),
        )
      })

      host.appendChild(svg)
    }

    function renderCharts() {
      if (chartsDone) return
      chartsDone = true

      const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic']
      barChart(
        $('chartMes'),
        COMMITS_POR_MES.map((m) => {
          const [y, mm] = m.mes.split('-')
          return { etiqueta: `${MESES[Number(mm) - 1]} ${y.slice(2)}`, valor: m.commits, titulo: m.mes }
        }),
        'var(--deep)',
      )

      barChart(
        $('chartIter'),
        ITERACIONES.filter((i) => i.commits != null).map((i, idx) => ({
          etiqueta: `it-${idx}`,
          valor: i.commits as number,
          titulo: i.nombre,
        })),
        'var(--forest)',
      )
    }

    render()
  }

  document.addEventListener('astro:page-load', initBoard)
  initBoard()
</script>

<style>
  .board {
    --ok: var(--forest);
    color: var(--ink);
    font-family: var(--font-sans);
  }

  /* ===== Cabecera ===== */
  .board-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 22px;
  }
  .board-sub {
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--mute);
  }
