---
/**
 * Footer único del sitio.
 *
 * Antes estaba copiado a mano en 28 páginas, con 11 variantes distintas por
 * deriva accidental: dos descripciones de empresa, columnas que aparecían o
 * desaparecían y páginas de servicio sin columna Legal. Aquí hay una sola
 * versión; las páginas solo pueden cambiar el titular.
 *
 * Uso:  <SiteFooter />                          → español
 *       <SiteFooter lang="en" />                → inglés
 *       <SiteFooter headline="..." />           → titular a medida
 */

interface Props {
  lang?: 'es' | 'en'
  /** HTML del titular. Por defecto, el de cada idioma. */
  headline?: string
}

const { lang = 'es', headline }: Props = Astro.props
const es = lang === 'es'

const t = es
  ? {
      headline: '¿Un nuevo <em>expediente</em><br>en el radar?',
      cta: 'Escríbenos',
      contactHref: '/contacto',
      desc: 'Consultoría ambiental especializada en cumplimiento ANLA, ESG y economía circular.',
      services: 'Servicios',
      site: 'Sitio',
      contact: 'Contacto',
      legal: 'Legal',
      links: [
        { label: 'Inicio', href: '/' },
        { label: 'Nosotros', href: '/quienes-somos' },
        { label: 'Normativas', href: '/normativas' },
        { label: 'Casos', href: '/casos' },
        { label: 'Diario', href: '/blog' },
      ],
      legalLinks: [
        { label: 'Licencias y autorizaciones', href: '/licencias' },
        { label: 'Política de tratamiento', href: null },
        { label: 'Términos de servicio', href: null },
        { label: 'Código de ética', href: null },
      ],
      servicesLinks: [
        { label: 'EKONSULTING', href: '/ekonsulting' },
        { label: 'EKORAEE', href: '/ekoraee' },
        { label: 'EKOPARTNER', href: '/ekopartner' },
        { label: 'EKOTRADING', href: '/ekotrading' },
      ],
      logoAlt: 'EKOSOLV — Consultores en Sostenibilidad',
    }
  : {
      headline: 'A new <em>case</em><br>on the radar?',
      cta: 'Write to us',
      contactHref: '/en/contact',
      desc: 'Environmental consulting specialized in ANLA compliance, ESG, and circular economy.',
      services: 'Services',
      site: 'Site',
      contact: 'Contact',
      legal: 'Legal',
      links: [
        { label: 'Home', href: '/en' },
        { label: 'About', href: '/en/about' },
        { label: 'Regulations', href: '/en/regulations' },
        { label: 'Cases', href: '/en/cases' },
        { label: 'Journal', href: '/en/blog' },
      ],
      legalLinks: [
        { label: 'Licences and authorisations', href: '/en/licenses' },
        { label: 'Data processing policy', href: null },
        { label: 'Terms of service', href: null },
        { label: 'Code of ethics', href: null },
      ],
      servicesLinks: [
        { label: 'EKONSULTING', href: '/en/ekonsulting' },
        { label: 'EKORAEE', href: '/en/ekoraee' },
        { label: 'EKOPARTNER', href: '/en/ekopartner' },
        { label: 'EKOTRADING', href: '/en/ekotrading' },
      ],
      logoAlt: 'EKOSOLV — Sustainability Consultants',
    }

const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-head reveal">
      <div class="display" set:html={headline ?? t.headline} />
      <a href={t.contactHref} class="foot-cta">
        {t.cta}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <div class="foot-cols">
      <div>
        <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt={t.logoAlt} />
        <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">{t.desc}</p>
      </div>

      <div>
        <h5>{t.services}</h5>
        <ul>{t.servicesLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div>
        <h5>{t.site}</h5>
        <ul>{t.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div>
        <h5>{t.contact}</h5>
        <ul>
          <li><a href="mailto:info@ekosolv.com">info@ekosolv.com</a></li>
          <li><a href="tel:+573212712773">+57 321 271 2773</a></li>
          <li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li>
        </ul>
      </div>

      <div>
        <h5>{t.legal}</h5>
        {/*
          Los enlaces con href === null aún no tienen documento redactado
          (pregunta abierta 3.c). Se muestran atenuados y sin <a>: un enlace
          legal roto es peor que un texto sin enlace — la Política de
          Tratamiento es obligación de la Ley 1581 de 2012.
        */}
        <ul>
          {t.legalLinks.map((l) =>
            l.href
              ? <li><a href={l.href}>{l.label}</a></li>
              : <li data-pending>{l.label}</li>
          )}
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <div>© {year} Ekosolv S.A.S. · NIT 900.659.506-9</div>
      <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
        <span>@mikerb95</span>
      </a>
    </div>
  </div>
</footer>
