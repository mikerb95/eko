---
/**
 * Footer único del sitio.
 *
 * Antes estaba copiado a mano en 28 páginas, con 11 variantes distintas por
 * deriva accidental: dos descripciones de empresa, columnas que aparecían o
 * desaparecían y páginas de servicio sin columna Legal. Aquí hay una sola
 * versión; las páginas solo pueden cambiar el titular.
 *
 * Uso:  <SiteFooter />                          → español
 *       <SiteFooter lang="en" />                → inglés
 *       <SiteFooter headline="..." />           → titular a medida
 */

import { perfilesFooter } from '../lib/redes'
import { LEGAL_PATHS } from '../lib/legal'

interface Props {
  lang?: 'es' | 'en'
  /** HTML del titular. Por defecto, el de cada idioma. */
  headline?: string
}

const { lang = 'es', headline }: Props = Astro.props
const es = lang === 'es'

const t = es
  ? {
      headline: '¿Un nuevo <em>expediente</em><br>en el radar?',
      cta: 'Escríbenos',
      contactHref: '/contacto',
      desc: 'Consultoría ambiental especializada en cumplimiento ANLA, ESG y economía circular.',
      services: 'Servicios',
      site: 'Sitio',
      contact: 'Contacto',
      legal: 'Legal',
      links: [
        { label: 'Inicio', href: '/' },
        { label: 'Nosotros', href: '/quienes-somos' },
        { label: 'Normativas', href: '/normativas' },
        { label: 'Casos', href: '/casos' },
        { label: 'Diario', href: '/blog' },
      ],
      legalLinks: [
        { label: 'Licencias y autorizaciones', href: '/licencias' },
        { label: 'Política de tratamiento de datos', href: LEGAL_PATHS.es.politica },
        { label: 'Términos de servicio', href: LEGAL_PATHS.es.terminos },
        { label: 'Política de cookies', href: LEGAL_PATHS.es.cookies },
        { label: 'Código de ética', href: LEGAL_PATHS.es.etica },
      ],
      servicesLinks: [
        { label: 'EKONSULTING', href: '/ekonsulting' },
        { label: 'EKORAEE', href: '/ekoraee' },
        { label: 'EKOPARTNER', href: '/ekopartner' },
        { label: 'EKOTRADING', href: '/ekotrading' },
      ],
      docsLabel: 'Proyecto',
      docsHint: 'Acceso restringido: requiere sesión de administrador',
      docsLinks: [
        { label: 'Documentación de ingeniería', href: '/docs' },
        { label: 'Radar regulatorio', href: '/docs/radar' },
        { label: 'Kanban', href: '/docs/kanban' },
        { label: 'Oportunidades 2026–2030', href: '/oportunidades2630' },
      ],
      social: 'Síguenos',
      socialPending: 'perfil pendiente de confirmar',
      logoAlt: 'EKOSOLV — Consultores en Sostenibilidad',
      rights: 'Sitio, diseño y código fuente © {year} Mike Rodríguez. Todos los derechos reservados. Prohibida su reproducción, adaptación o reutilización, total o parcial, por cualquier medio.',
    }
  : {
      headline: 'A new <em>case</em><br>on the radar?',
      cta: 'Write to us',
      contactHref: '/en/contact',
      desc: 'Environmental consulting specialized in ANLA compliance, ESG, and circular economy.',
      services: 'Services',
      site: 'Site',
      contact: 'Contact',
      legal: 'Legal',
      links: [
        { label: 'Home', href: '/en' },
        { label: 'About', href: '/en/about' },
        { label: 'Regulations', href: '/en/regulations' },
        { label: 'Cases', href: '/en/cases' },
        { label: 'Journal', href: '/en/blog' },
      ],
      legalLinks: [
        { label: 'Licences and authorisations', href: '/en/licenses' },
        { label: 'Data processing policy', href: LEGAL_PATHS.en.politica },
        { label: 'Terms of service', href: LEGAL_PATHS.en.terminos },
        { label: 'Cookie policy', href: LEGAL_PATHS.en.cookies },
        { label: 'Code of ethics', href: LEGAL_PATHS.en.etica },
      ],
      servicesLinks: [
        { label: 'EKONSULTING', href: '/en/ekonsulting' },
        { label: 'EKORAEE', href: '/en/ekoraee' },
        { label: 'EKOPARTNER', href: '/en/ekopartner' },
        { label: 'EKOTRADING', href: '/en/ekotrading' },
      ],
      docsLabel: 'Project',
      docsHint: 'Restricted access: requires an administrator session',
      docsLinks: [
        { label: 'Engineering documentation', href: '/docs' },
        { label: 'Regulatory radar', href: '/docs/radar' },
        { label: 'Kanban', href: '/docs/kanban' },
        { label: 'Opportunities 2026–2030', href: '/oportunidades2630' },
      ],
      social: 'Follow us',
      socialPending: 'profile pending confirmation',
      logoAlt: 'EKOSOLV — Sustainability Consultants',
      rights: 'Site, design and source code © {year} Mike Rodríguez. All rights reserved. Reproduction, adaptation or reuse, in whole or in part, by any means, is prohibited.',
    }

const year = new Date().getFullYear()

/*
 * Los perfiles sociales van en esta primera columna, bajo el logo, y no en una
 * sexta columna: `.foot-cols` es un grid de `2fr repeat(4, 1fr)`, así que una
 * columna más rompería la retícula en los tres breakpoints.
 *
 * `perfilesFooter()` devuelve solo los perfiles verificados; en local añade los
 * pendientes, atenuados y sin enlace, con el mismo tratamiento que los enlaces
 * legales sin documento (ver `src/lib/redes.ts`).
 */
const redes = perfilesFooter()

const iconos: Record<string, string> = {
  linkedin: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.65h.05c.53-.95 1.83-1.95 3.75-1.95 4 0 4.4 2.5 4.4 5.75V21h-4v-5.6c0-1.35-.03-3.1-1.9-3.1-1.9 0-2.2 1.48-2.2 3v5.7h-4V9Z',
  instagram: 'M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.89 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-10.4a1.44 1.44 0 1 0 0-2.88 1.44 1.44 0 0 0 0 2.88Z',
  facebook: 'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z',
}
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-head reveal">
      <div class="display" set:html={headline ?? t.headline} />
      <a href={t.contactHref} class="foot-cta">
        {t.cta}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <div class="foot-cols">
      <div>
        <img class="foot-logo" src="/brand/ekosolv-horizontal-white.png" alt={t.logoAlt} width="249" height="72" />
        <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">{t.desc}</p>

        {redes.length > 0 && (
          <div class="foot-social">
            <h5>{t.social}</h5>
            <ul>
              {redes.map((p) =>
                p.activo && p.url ? (
                  <li>
                    <a href={p.url} target="_blank" rel="noopener noreferrer me" aria-label={`${p.label} — Ekosolv`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d={iconos[p.red]} />
                      </svg>
                    </a>
                  </li>
                ) : (
                  <li data-pending title={`${p.label} — ${t.socialPending}`}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={iconos[p.red]} />
                    </svg>
                    <span class="sr-only">{p.label} — {t.socialPending}</span>
                  </li>
                )
              )}
            </ul>
          </div>
        )}
      </div>

      <div>
        <h5>{t.services}</h5>
        <ul>{t.servicesLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div>
        <h5>{t.site}</h5>
        <ul>{t.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div>
        <h5>{t.contact}</h5>
        <ul>
          <li><a href="mailto:info@ekosolv.com">info@ekosolv.com</a></li>
          <li><a href="tel:+573212712773">+57 321 271 2773</a></li>
          <li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li>
        </ul>
      </div>

      <div>
        <h5>{t.legal}</h5>
        {/*
          Los enlaces con href === null aún no tienen documento redactado: se
          muestran atenuados y sin <a>, porque un enlace legal roto es peor que
          un texto sin enlace. Las rutas salen de `LEGAL_PATHS` en
          src/lib/legal.ts; hoy el único pendiente es el Código de ética, que es
          un documento de la compañía y no podemos redactarlo por ella.
        */}
        <ul>
          {t.legalLinks.map((l) =>
            l.href
              ? <li><a href={l.href}>{l.label}</a></li>
              : <li data-pending>{l.label}</li>
          )}
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      {/*
        Dos titularidades distintas, a propósito. La primera es de la empresa:
        cubre marca, razón social y contenido corporativo. La segunda es la
        autoría del sitio como obra —código, arquitectura y diseño—, que no se
        transfiere por el solo hecho de publicarlo. Ver LICENSE en la raíz del
        repositorio; sin este aviso no hay a quién atribuir la obra si aparece
        copiada.
      */}
      <div class="foot-copy">
        <div>© {year} Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <div class="foot-rights">{t.rights.replace('{year}', String(year))}</div>
      </div>

      {/* Documentación del proyecto. Son páginas internas: van con noindex y el
          middleware exige sesión de administrador, así que quien no la tenga
          acaba en el login. Se dejan a la vista —con candado— porque el enlace
          es la forma de llegar a ellas; lo que protege no es esconderlo. */}
      <nav class="foot-docs" aria-label={t.docsLabel} title={t.docsHint}>
        <span class="foot-docs-label">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="2"/>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
          </svg>
          {t.docsLabel}
          <span class="sr-only"> — {t.docsHint}</span>
        </span>
        {t.docsLinks.map((l) => <a href={l.href} rel="nofollow">{l.label}</a>)}
      </nav>

      <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
        <span>@mikerb95</span>
      </a>
    </div>
  </div>
</footer>
