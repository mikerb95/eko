---
// Escenas animadas de las guías de Claude (/academia/recursos/guias, textos en
// src/lib/talleres/guiasClaude.ts). Son motion graphics hechos con CSS
// (src/styles/guias.css sobre la base de src/styles/maquetas.css): arrancan
// cuando la escena aparece (el reproductor la pasa de hidden a visible) y con
// movimiento reducido quedan quietas en su estado final.
//
// Ilustraciones, no capturas: los menús y botones copian los nombres reales de
// Claude (en inglés, como salen hoy) y los datos son de ejemplo. Las escenas
// de Zoho reutilizan las maquetas de la capacitación 1, que salen de la
// conexión real del 2026-11-19.
interface Props {
  id: string
}
import Maqueta from '../taller/Maqueta.astro'
import Ventana from './Ventana.astro'
import Ruta from './Ruta.astro'
import { chispa } from '../../lib/talleres/chispa'
const { id } = Astro.props

const pensar = (d: number, fin: number) => `--d:${d}s;--fin:${fin}s`
const PENSANDO = `${chispa()}<span>Pensando</span>`
const LOGO = chispa(false, 'gm-logo-claude')
const ZOHO_MAQUETA: Record<string, string> = { 'zh-region': 'conector', 'zh-oauth': 'oauth', 'zh-permisos': 'permisos', 'zh-probar': 'prueba' }
---

<div class:list={['mq gm', `gm-${id}`]} data-escena={id} aria-hidden="true">
  {ZOHO_MAQUETA[id] && <Maqueta id={ZOHO_MAQUETA[id]!} />}

  {/* ───────────── Siigo ───────────── */}
  {id === 'sg-activar' && (
    <Ventana url="siigonube.siigo.com · Configuración">
      <div class="gm-dos-col">
        <ul class="gm-menu">
          <li>Inicio</li><li>Ventas</li><li>Compras</li>
          <li class="gm-sel" style="--d:.5s">Configuración</li>
          <li class="gm-sub gm-sel" style="--d:1.1s">Alianzas e integraciones</li>
        </ul>
        <div class="gm-col">
          <b class="gm-titulo mq-ap" style="--d:1.4s">Credenciales de integración (Siigo API)</b>
          <span class="gm-fila mq-ap" style="--d:1.7s"><span>Tipo API</span><span class="gm-switch" /></span>
          <span class="gm-fila gm-fila-clave mq-ap" style="--d:1.9s"><span>Tipo MCP <small>para Claude</small></span><span class="gm-switch gm-prende" style="--d:2.6s" /></span>
          <span class="mq-sello mq-ap" style="--d:3.2s">Credencial MCP activa</span>
        </div>
      </div>
    </Ventana>
  )}

  {id === 'sg-agregar' && (
    <Ventana url="Claude · Customize · Connectors">
      <Ruta tramos={['Customize', 'Connectors', '+', 'Add custom connector']} />
      <div class="mq-modal gm-modal mq-ap" style="--d:2s">
        <b>Add custom connector</b>
        <span class="gm-et-claro">Name</span>
        <span class="gm-campo-osc"><span class="mq-tipeo" style="--n:5;--t:.6s;animation-delay:2.4s,0s">Siigo</span></span>
        <span class="gm-et-claro">Remote MCP server URL</span>
        <span class="gm-campo-osc"><span class="mq-tipeo" style="--n:33;--t:1.8s;animation-delay:3.1s,0s">https://mcp.siigo.com/mcp-adapter</span></span>
        <span class="mq-boton mq-pulso" style="--d:5.1s">Add</span>
      </div>
    </Ventana>
  )}

  {id === 'sg-login' && (
    <Ventana url="siigonube.siigo.com · Autorizar">
      <div class="gm-centro">
        <b class="gm-marca-siigo">siigo</b>
        <span class="mq-campo"><span class="mq-tipeo" style="--n:22;--t:1.2s">contabilidad@ekosolv.co</span></span>
        <span class="mq-campo mq-clave mq-ap" style="--d:1.6s">••••••••••</span>
        <span class="mq-boton mq-pulso" style="--d:2s">Ingresar</span>
        <div class="gm-permiso mq-ap" style="--d:3s">
          <span class="gm-pareja"><span class="gm-chip-siigo">S</span><span class="gm-enlace" /><Fragment set:html={LOGO} /></span>
          <b>Claude quiere acceder a su empresa en Siigo</b>
          <span class="mq-boton mq-pulso" style="--d:3.6s">Autorizar</span>
        </div>
      </div>
    </Ventana>
  )}

  {id === 'sg-probar' && (
    <Ventana url="Claude">
      <div class="mq-chat gm-chat">
        <span class="mq-burbuja mq-yo"><span class="mq-tipeo" style="--n:44;--t:1.6s">¿Qué facturas de venta se emitieron esta semana?</span></span>
        <span class="mq-pensar chispa-fila" style={pensar(2, 2.9)} set:html={PENSANDO} />
        <span class="mq-aprobar mq-ap" style="--d:3s"><span>Claude wants to use a tool from <b>Siigo</b></span><span class="mq-botones"><span class="mq-boton mq-sec">Decline</span><span class="mq-boton mq-pulso" style="--d:3.3s">Allow once</span></span></span>
        <span class="mq-herramienta mq-ap" style="--d:4.3s"><span class="mq-giro" style="animation-delay:0s,4.9s" />Used Siigo</span>
        <span class="mq-burbuja mq-ia mq-tabla gm-tabla3 mq-ap" style="--d:5.2s">
          <span><b>Factura</b><b>Cliente</b><b>Fecha</b></span>
          <span><i>FV-1042</i><i>Cliente de ejemplo A</i><i>24 nov</i></span>
          <span><i>FV-1043</i><i>Cliente de ejemplo B</i><i>25 nov</i></span>
          <span><i>FV-1044</i><i>Cliente de ejemplo C</i><i>26 nov</i></span>
        </span>
      </div>
    </Ventana>
  )}

  {/* ───────────── Zoho ───────────── */}
  {id === 'zh-buscar' && (
    <Ventana url="Claude · Customize · Connectors">
      <Ruta tramos={['Customize', 'Connectors', 'Browse']} />
      <span class="mq-campo gm-buscar mq-ap" style="--d:1.2s"><span class="gm-lupa" /><span class="mq-tipeo" style="--n:8;--t:.8s;animation-delay:1.5s,0s">Zoho CRM</span></span>
      <div class="mq-conector mq-ap" style="--d:2.6s">
        <span class="mq-logo mq-zoho">Z</span>
        <div><b>Zoho CRM</b><span class="mq-sub">By Zoho <span class="mq-verif">Verified</span></span></div>
        <span class="mq-boton mq-pulso" style="--d:3.4s">Connect</span>
      </div>
      <div class="gm-gris mq-ap" style="--d:2.9s"><span class="gm-cuadro" /><span class="gm-renglon" /></div>
    </Ventana>
  )}

  {/* ───────────── Microsoft 365 ───────────── */}
  {id === 'of-admin' && (
    <Ventana url="Claude · Organization settings · Connectors">
      <Ruta tramos={['Organization settings', 'Connectors']} />
      <div class="mq-conector mq-ap" style="--d:1s">
        <span class="gm-logo-ms"><i /><i /><i /><i /></span>
        <div><b>Microsoft 365</b><span class="mq-sub">SharePoint · OneDrive · Outlook · Teams</span></div>
        <span class="mq-boton mq-pulso" style="--d:1.6s">Add to your team</span>
      </div>
      <div class="gm-ms-consent mq-ap" style="--d:3s">
        <span class="mq-et">Microsoft Entra · Administrador global</span>
        <b>Permisos solicitados para toda la organización</b>
        <span class="mq-sub">Una sola vez. Después cada persona conecta su cuenta.</span>
        <span class="mq-botones"><span class="mq-boton mq-sec">Cancel</span><span class="mq-boton gm-ms-btn mq-pulso" style="--d:3.6s">Accept</span></span>
      </div>
    </Ventana>
  )}

  {id === 'of-conectar' && (
    <Ventana url="Claude · Customize · Connectors">
      <Ruta tramos={['Customize', 'Connectors', 'Microsoft 365']} />
      <div class="gm-dos-pantallas">
        <div class="mq-pantalla mq-ap" style="--d:1.3s">
          <b>¿Qué cuenta va a conectar?</b>
          <span class="mq-opcion gm-op-claro gm-op-sel" style="--d:2s"><i />Work or school account</span>
          <span class="mq-opcion gm-op-claro"><i />Personal account</span>
          <span class="mq-boton mq-pulso" style="--d:2.3s">Continue</span>
        </div>
        <div class="mq-pantalla gm-ms-login mq-ap" style="--d:3.1s">
          <span class="gm-logo-ms gm-ms-chico"><i /><i /><i /><i /></span>
          <b>Iniciar sesión</b>
          <span class="mq-campo"><span class="mq-tipeo" style="--n:21;--t:1.2s;animation-delay:3.5s,0s">su.nombre@ekosolv.co</span></span>
          <span class="mq-boton gm-ms-btn mq-pulso" style="--d:4.9s">Siguiente</span>
        </div>
      </div>
    </Ventana>
  )}

  {id === 'of-apps' && (
    <div class="gm-radial">
      <svg class="gm-lineas" viewBox="0 0 400 240" preserveAspectRatio="none">
        <path d="M200 120 L70 50" style="--d:.6s" /><path d="M200 120 L330 50" style="--d:.8s" />
        <path d="M200 120 L70 190" style="--d:1s" /><path d="M200 120 L330 190" style="--d:1.2s" />
      </svg>
      <span class="gm-nucleo mq-ap" style="--d:.1s"><Fragment set:html={chispa(true, 'gm-chispa-xl')} /></span>
      {[
        ['Outlook', 'Correo y calendario', '#0A64C9', 'gm-a1', '.9s'],
        ['SharePoint', 'Sitios y documentos', '#038387', 'gm-a2', '1.1s'],
        ['OneDrive', 'Sus archivos', '#0F78D4', 'gm-a3', '1.3s'],
        ['Teams', 'Chats y canales', '#5B5FC7', 'gm-a4', '1.5s'],
      ].map(([n, t, c, cls, d]) => (
        <span class:list={['gm-app mq-ap', cls]} style={`--d:${d};--c:${c}`}><span class="gm-app-ico">{n![0]}</span><b>{n}</b><small>{t}</small></span>
      ))}
      <span class="gm-pie-chips mq-ap" style="--d:2.3s"><span class="gm-chip-ok">Lee con sus permisos</span><span class="gm-chip-ojo">Escribe solo si el admin lo activa</span></span>
    </div>
  )}

  {id === 'of-probar' && (
    <Ventana url="Claude">
      <div class="mq-chat gm-chat">
        <span class="mq-burbuja mq-yo mq-ap" style="--d:.1s">Busca en mi Outlook los correos de esta semana sobre el informe de cumplimiento y resume qué falta.</span>
        <span class="mq-herramienta mq-ap" style="--d:.9s"><span class="mq-giro" style="animation-delay:0s,1.9s" />Buscando en Outlook</span>
        <span class="mq-herramienta mq-ap" style="--d:2s"><span class="mq-giro" style="animation-delay:0s,3s" />Buscando en SharePoint</span>
        <span class="mq-pensar chispa-fila" style={pensar(3.1, 4)} set:html={PENSANDO} />
        <span class="mq-burbuja mq-ia gm-lista mq-ap" style="--d:4.1s">
          <b>Falta por cerrar</b>
          <span class="mq-ap" style="--d:4.4s">· Anexo de residuos (lo pidió el cliente el martes)</span>
          <span class="mq-ap" style="--d:4.7s">· Firma del representante legal</span>
          <span class="gm-archivo mq-ap" style="--d:5s"><span class="gm-doc" />Informe_cumplimiento.docx · SharePoint</span>
        </span>
      </div>
    </Ventana>
  )}

  {id === 'of-excel' && (
    <div class="gm-excel-escena">
      <span class="gm-toast mq-ap" style="--d:.2s"><span class="gm-logo-ms gm-ms-chico"><i /><i /><i /><i /></span>Claude for Microsoft 365 · Get it now</span>
      <div class="mq-ventana gm-excel mq-ap" style="--d:.9s">
        <div class="gm-excel-cinta"><span>Inicio</span><span>Insertar</span><span>Datos</span><span class="gm-cinta-claude gm-sel" style="--d:1.6s"><Fragment set:html={chispa(false)} />Claude</span></div>
        <div class="gm-excel-cuerpo">
          <div class="gm-hoja">
            {Array.from({ length: 6 }, (_, f) => (
              <span class:list={['gm-hoja-fila', { 'gm-hoja-alerta': f === 2 || f === 4 }]} style={`--d:${4 + f * 0.15}s`}>
                <i>{f === 0 ? 'Cliente' : `Cliente ${f}`}</i><i>{f === 0 ? 'Fecha' : f === 2 || f === 4 ? '' : `${10 + f} nov`}</i><i>{f === 0 ? 'Estado' : 'Abierto'}</i>
              </span>
            ))}
          </div>
          <div class="gm-panel mq-ap" style="--d:2s">
            <b class="gm-panel-t"><Fragment set:html={chispa(false)} />Claude</b>
            <span class="mq-burbuja mq-yo mq-ap" style="--d:2.4s">Marca las filas sin fecha</span>
            <span class="mq-pensar chispa-fila" style={pensar(2.9, 3.8)} set:html={PENSANDO} />
            <span class="mq-burbuja mq-ia mq-ap" style="--d:3.9s">Listo: marqué 2 filas en amarillo.</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {/* ───────────── Skills ───────────── */}
  {id === 'sk-activar' && (
    <Ventana url="Claude · Settings · Capabilities">
      <Ruta tramos={['Settings', 'Capabilities']} />
      <div class="gm-lista-ajustes">
        <span class="gm-fila mq-ap" style="--d:1s"><span>Memory</span><span class="gm-switch gm-on" /></span>
        <span class="gm-fila gm-fila-clave mq-ap" style="--d:1.2s"><span>Code execution and file creation<small>Las skills lo necesitan</small></span><span class="gm-switch gm-prende" style="--d:2.2s" /></span>
        <span class="gm-fila mq-ap" style="--d:1.4s"><span>Web search</span><span class="gm-switch gm-on" /></span>
      </div>
      <span class="mq-sello mq-ap" style="--d:2.8s">Listo para usar skills</span>
    </Ventana>
  )}

  {id === 'sk-pedir' && (
    <Ventana url="Claude · Customize · Skills">
      <div class="gm-dos-col">
        <div class="gm-col">
          <Ruta tramos={['Customize', 'Skills']} />
          <span class="gm-fila gm-fila-clave mq-ap" style="--d:1s"><span>skill-creator<small>Anthropic</small></span><span class="gm-switch gm-prende" style="--d:1.6s" /></span>
          <span class="gm-fila mq-ap" style="--d:1.2s"><span>docx<small>Anthropic</small></span><span class="gm-switch gm-on" /></span>
        </div>
        <div class="mq-chat gm-chat gm-chat-mini">
          <span class="mq-burbuja mq-yo mq-ap" style="--d:2.3s">Ayúdame a crear una skill para las propuestas comerciales. Pregúntame una cosa a la vez.</span>
          <span class="mq-pensar chispa-fila" style={pensar(3.2, 4.1)} set:html={PENSANDO} />
          <span class="mq-burbuja mq-ia mq-ap" style="--d:4.2s"><b>Pregunta 1 de 5.</b> ¿Qué secciones lleva siempre una propuesta de Ekosolv?</span>
        </div>
      </div>
    </Ventana>
  )}

  {id === 'sk-archivo' && (
    <div class="mq-ventana gm-editor">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">propuesta-ekosolv / SKILL.md</span></div>
      <div class="gm-editor-cuerpo">
        <ul class="gm-arbol">
          <li class="gm-carpeta">propuesta-ekosolv</li>
          <li class="gm-activo">SKILL.md</li>
          <li class="mq-ap" style="--d:4.6s">plantilla.docx</li>
        </ul>
        <pre class="gm-codigo"><span class="mq-ap" style="--d:.2s">---</span><span class="mq-ap" style="--d:.5s"><b>name:</b> propuesta-ekosolv</span><span class="gm-brilla mq-ap" style="--d:.9s"><b>description:</b> Arma propuestas comerciales de Ekosolv. Úsala cuando pidan una propuesta, cotización u oferta.</span><span class="mq-ap" style="--d:1.4s">---</span><span class="mq-ap" style="--d:2s"># Pasos</span><span class="mq-ap" style="--d:2.4s">1. Pide el cliente, el servicio y el alcance.</span><span class="mq-ap" style="--d:2.8s">2. Usa la plantilla y el trato de usted.</span><span class="mq-ap" style="--d:3.2s"># Nunca</span><span class="mq-ap" style="--d:3.6s">- Inventar precios: déjalos entre corchetes.</span></pre>
        <span class="gm-nota-flecha mq-ap" style="--d:1.6s">Claude lee esto para decidir cuándo abrirla</span>
      </div>
    </div>
  )}

  {id === 'sk-subir' && (
    <Ventana url="Claude · Customize · Skills">
      <Ruta tramos={['Customize', 'Skills', '+', 'Upload a skill']} />
      <div class="gm-drop mq-ap" style="--d:1.9s">
        <span class="gm-zip" style="--d:2.4s"><span class="gm-zip-ico">ZIP</span>propuesta-ekosolv.zip</span>
        <span class="gm-barra-prog" style="--d:3.3s"><i /></span>
      </div>
      <span class="gm-fila gm-fila-clave mq-ap" style="--d:4.6s"><span>propuesta-ekosolv<small>Arma propuestas comerciales de Ekosolv…</small></span><span class="gm-switch gm-prende" style="--d:5s" /></span>
    </Ventana>
  )}

  {id === 'sk-usar' && (
    <Ventana url="Claude">
      <div class="mq-chat gm-chat">
        <span class="mq-burbuja mq-yo"><span class="mq-tipeo" style="--n:47;--t:1.6s">Arma la propuesta para el cliente de la planta.</span></span>
        <span class="gm-skill-usada mq-ap" style="--d:2.1s"><span class="gm-skill-ico" />Using skill: propuesta-ekosolv</span>
        <span class="mq-pensar chispa-fila" style={pensar(2.6, 3.6)} set:html={PENSANDO} />
        <span class="mq-burbuja mq-ia gm-lista mq-ap" style="--d:3.7s">
          <b>Propuesta comercial · [Cliente]</b>
          <span class="mq-ap" style="--d:4s">1. Contexto y necesidad</span>
          <span class="mq-ap" style="--d:4.3s">2. Alcance del servicio</span>
          <span class="mq-ap" style="--d:4.6s">3. Inversión: [por definir]</span>
        </span>
      </div>
    </Ventana>
  )}

  {/* ───────────── Plugins ───────────── */}
  {id === 'pl-catalogo' && (
    <Ventana url="Claude · Customize · Plugins">
      <Ruta tramos={['Customize', 'Plugins', 'Discover']} />
      <div class="gm-catalogo">
        {[
          ['Finanzas', '#2E8B57'], ['Ventas', '#C96442'], ['Mercadeo', '#7A5AF8'],
          ['Operaciones', '#124E7D'], ['Legal', '#6B7580'], ['Productividad', '#179C91'],
        ].map(([n, c], i) => (
          <span class:list={['gm-plugin mq-ap', { 'gm-plugin-sel': i === 0 }]} style={`--d:${1.3 + i * 0.15}s;--c:${c}`}>
            <span class="gm-plugin-ico" /><b>{n}</b><small>Anthropic</small>
          </span>
        ))}
      </div>
    </Ventana>
  )}

  {id === 'pl-instalar' && (
    <Ventana url="Claude · Plugins · Finanzas">
      <div class="gm-plugin-det">
        <span class="gm-plugin-ico gm-ico-xl mq-ap" style="--d:.1s;--c:#2E8B57" />
        <div><b class="gm-titulo">Finanzas</b><span class="mq-sub">Anthropic · Plugin</span></div>
        <span class="mq-boton mq-pulso" style="--d:3s">Install</span>
      </div>
      <div class="gm-trae">
        <span class="mq-ap" style="--d:.7s"><em>Skills</em><b>Conciliación · Cierre de mes · Reportes</b></span>
        <span class="mq-ap" style="--d:1.2s"><em>Comandos</em><b><code>/conciliar</code> <code>/cierre</code></b></span>
        <span class="mq-ap" style="--d:1.7s"><em>Conectores</em><b>Hoja de cálculo · Correo</b></span>
      </div>
      <span class="mq-aviso mq-ap" style="--d:4s">Plugin instalado</span>
    </Ventana>
  )}

  {id === 'pl-conectores' && (
    <Ventana url="Claude · Plugins · Finanzas · Connectors">
      <span class="gm-pestanas"><i>Overview</i><i class="gm-sel" style="--d:.4s">Connectors</i><i>Skills</i></span>
      {['Correo', 'Hoja de cálculo'].map((c, k) => (
        <span class="gm-fila mq-ap" style={`--d:${0.8 + k * 0.3}s`}>
          <span>{c}</span>
          <span class="gm-estado-cambia" style={`--d:${2 + k * 1.3}s`}><i class="antes">Not connected</i><i class="despues">Connected</i></span>
          <span class="mq-boton mq-sec mq-pulso" style={`--d:${1.4 + k * 1.3}s`}>Connect</span>
        </span>
      ))}
      <span class="gm-nota-flecha mq-ap" style="--d:4.4s">Instalar no conecta: cada uno se conecta con su usuario</span>
    </Ventana>
  )}

  {id === 'pl-usar' && (
    <Ventana url="Claude">
      <div class="mq-chat gm-chat">
        <div class="gm-comandos mq-ap" style="--d:.9s">
          <span class="gm-cmd gm-sel" style="--d:1.8s"><code>/conciliar</code><small>Cruza el extracto con los registros</small></span>
          <span class="gm-cmd"><code>/cierre</code><small>Lista de cierre de mes</small></span>
          <span class="gm-cmd"><code>/reporte</code><small>Resumen para gerencia</small></span>
        </div>
        <span class="mq-entrada gm-entrada"><span class="mq-tipeo" style="--n:10;--t:.5s;animation-delay:.4s,0s">/conciliar</span></span>
        <span class="mq-burbuja mq-ia mq-ap" style="--d:2.8s">Adjunte el extracto del banco y el mes que quiere conciliar.</span>
      </div>
    </Ventana>
  )}

  {id === 'pl-ajustar' && (
    <Ventana url="Claude · Plugins · Finanzas">
      <div class="gm-plugin-det">
        <span class="gm-plugin-ico" style="--c:#2E8B57" />
        <div><b class="gm-titulo">Finanzas</b><span class="mq-sub">Instalado</span></div>
        <span class="gm-menu-pop mq-ap" style="--d:.4s"><i>Disable</i><i class="gm-sel" style="--d:.9s">Customize</i><i>Uninstall</i></span>
      </div>
      <div class="mq-chat gm-chat gm-chat-mini">
