        <path class="gm-trazo" d="M20 50 L110 110 L150 150 L152 40 L250 100 L290 150 L292 40 L380 90" />
        <circle cx="152" cy="40" r="6" class="gm-punto" style="--d:2.2s" />
        <circle cx="292" cy="40" r="6" class="gm-punto" style="--d:3.6s" />
      </svg>
      <span class="gm-et-graf gm-et-umbral mq-ap" style="--d:.4s">Mínimo: cuando baja de aquí, recarga</span>
      <span class="gm-et-graf gm-et-objetivo mq-ap" style="--d:.6s">Vuelve a este saldo</span>
      <span class="mq-aviso gm-aviso-graf mq-ap" style="--d:2.4s">Recarga automática</span>
