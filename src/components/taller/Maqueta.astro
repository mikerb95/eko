---
// Maqueta animada de un paso de la práctica guiada (escena `conectar`). La
// usan el proyector (Conectar.astro) y el celular (sala.astro la deja en un
// <template> y src/scripts/taller/sala.ts la clona en cada paso). Las
// animaciones son solo CSS (src/styles/maquetas.css): arrancan al aparecer y
// con movimiento reducido quedan quietas en su estado final.
//
// Son ilustraciones, no capturas, pero copian las pantallas reales vistas el
// 2026-11-19 al conectar un CRM de prueba (docs/capturas/zoho/): el conector
// con la región, las dos autorizaciones de Zoho y los permisos por
// herramienta y el aviso con el que Claude pide aprobación antes de leer, con
// sus etiquetas en inglés tal como salen (los tratos son datos de ejemplo de Zoho).
// Mientras Claude piensa se ve su logo animado (.mq-pensar, src/lib/talleres/chispa.ts),
// que se recoge cuando llega la respuesta (--fin).
interface Props {
  id: string
}
import { chispa } from '../../lib/talleres/chispa'
const { id } = Astro.props
---

<div class:list={['mq', `mq-${id}`]} data-maqueta={id} aria-hidden="true">
  {id === 'objetivo' && (
    <div class="mq-objetivo-fila">
      <div class="mq-ficha mq-ap" style="--d:.1s">
        <span class="mq-et">Objetivo</span>
        <b>Conectar mi Zoho CRM</b>
      </div>
      <div class="mq-ficha mq-limite mq-ap" style="--d:.6s">
        <span class="mq-et">Límite</span>
        <b><span class="mq-candado" />Solo leer</b>
      </div>
      <div class="mq-flecha mq-ap" style="--d:1.1s" />
      <div class="mq-ficha mq-claude mq-ap" style="--d:1.4s">
        <span class="mq-et">Claude</span>
        <b>Resuelve el cómo</b>
        <Fragment set:html={chispa(true, 'mq-chispa-grande')} />
      </div>
    </div>
  )}

  {id === 'cuenta' && (
    <div class="mq-ventana">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">claude.ai/login</span></div>
      <div class="mq-cuerpo mq-centro">
        <b class="mq-marca">Claude</b>
        <span class="mq-campo"><span class="mq-tipeo" style="--n:20;--t:1.6s">su.nombre@ekosolv.com</span></span>
        <span class="mq-boton mq-pulso" style="--d:1.9s">Continuar</span>
        <span class="mq-sello mq-ap" style="--d:2.6s">Espacio: Ekosolv · Team</span>
      </div>
    </div>
  )}

  {id === 'extension' && (
    <div class="mq-ventana">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">chromewebstore.google.com</span><span class="mq-pieza" /><span class="mq-fijada mq-ap" style="--d:2.4s">C</span></div>
      <div class="mq-cuerpo">
        <div class="mq-tienda">
          <span class="mq-logo">C</span>
          <div>
            <b>Claude</b>
            <span class="mq-sub">Anthropic · Extensión</span>
          </div>
          <span class="mq-boton mq-pulso" style="--d:.8s">Agregar a Chrome</span>
        </div>
        <span class="mq-aviso mq-ap" style="--d:1.6s">Claude se agregó a Chrome</span>
        <span class="mq-nota-chica mq-ap" style="--d:2.4s">Fíjela con la pieza de rompecabezas</span>
      </div>
    </div>
  )}

  {(id === 'desktop' || id === 'pedir' || id === 'prueba') && (
    <div class="mq-ventana mq-app">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">Claude</span><span class="mq-cuenta">Ekosolv</span></div>
      <div class="mq-cuerpo mq-app-cuerpo">
        <div class="mq-lado"><i /><i /><i /><i /></div>
        <div class="mq-chat">
          {id === 'desktop' && (
            <>
              <b class="mq-saludo mq-ap" style="--d:.2s">¿En qué le ayudo hoy?</b>
              <span class="mq-entrada mq-ap" style="--d:.6s"><span class="mq-cursor-texto" /></span>
            </>
          )}
          {id === 'pedir' && (
            <>
              <span class="mq-burbuja mq-yo"><span class="mq-tipeo" style="--n:44;--t:2.2s">Quiero conectar mi Zoho CRM. Solo para leer.</span></span>
              <span class="mq-pensar chispa-fila" style="--d:2.4s;--fin:3.6s" set:html={`${chispa()}<span>Pensando</span>`} />
              <span class="mq-burbuja mq-ia mq-ap" style="--d:3.7s">Para eso sirve el conector oficial de Zoho CRM. Lo dejamos en solo lectura:</span>
              <span class="mq-tarjeta mq-ap" style="--d:4.3s"><span class="mq-logo mq-zoho">Z</span><b>Zoho CRM</b><span class="mq-boton mq-pulso" style="--d:4.8s">Conectar</span></span>
            </>
          )}
          {id === 'prueba' && (
            <>
              <span class="mq-burbuja mq-yo mq-ap" style="--d:.1s">¿Cuáles son mis cinco tratos abiertos más recientes en Zoho?</span>
              <span class="mq-pensar chispa-fila" style="--d:.5s;--fin:1.5s" set:html={`${chispa()}<span>Pensando</span>`} />
              <span class="mq-aprobar mq-ap" style="--d:1.6s"><span>Claude wants to use <code>ZohoCRM_executeCOQLQuery</code> from Zoho CRM</span><span class="mq-botones"><span class="mq-boton mq-sec">Decline</span><span class="mq-boton mq-pulso" style="--d:2s">Allow once</span><span class="mq-boton mq-sec">Always allow</span></span></span>
              <span class="mq-herramienta mq-ap" style="--d:3s"><span class="mq-giro" />Used Zoho CRM: executeCOQLQuery</span>
              <span class="mq-pensar chispa-fila" style="--d:3.4s;--fin:4.4s" set:html={`${chispa()}<span>Pensando</span>`} />
              <span class="mq-burbuja mq-ia mq-tabla mq-ap" style="--d:4.5s">
                <span><b>Trato</b><b>Etapa</b></span>
                <span><i>Benton</i><i>Qualification</i></span>
                <span><i>Chanay</i><i>Needs Analysis</i></span>
                <span><i>Chemel</i><i>Value Proposition</i></span>
              </span>
            </>
          )}
        </div>
      </div>
    </div>
  )}

  {id === 'conector' && (
    <div class="mq-ventana">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">claude.ai · Plugins · Zoho CRM</span></div>
      <div class="mq-cuerpo">
        <div class="mq-conector">
          <span class="mq-logo mq-zoho">Z</span>
          <div>
            <b>Zoho CRM</b>
            <span class="mq-sub">By Zoho · MCP Server for Zoho CRM Workflows</span>
          </div>
          <span class="mq-boton mq-pulso" style="--d:1.6s">Connect</span>
        </div>
        <div class="mq-datos">
          <span class="mq-ap" style="--d:.3s"><em>Developer</em>Zoho <span class="mq-verif">Verified</span></span>
          <span class="mq-ap" style="--d:.6s"><em>Herramientas</em>41</span>
          <span class="mq-ap" style="--d:.9s"><em>Envía datos a</em>claude-zohocrm.zohomcp.com</span>
        </div>
        <div class="mq-modal mq-ap" style="--d:2.8s">
          <b>Connect Zoho CRM</b>
          <span class="mq-sub">Choose the region where your account is hosted.</span>
          <span class="mq-opcion mq-elegida"><i />United States</span>
          <span class="mq-opcion"><i />Europe</span>
          <span class="mq-opcion"><i />India</span>
          <span class="mq-boton mq-pulso" style="--d:3.4s">Connect</span>
        </div>
      </div>
    </div>
  )}

  {id === 'oauth' && (
    <div class="mq-ventana">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">mcp.zoho.com · accounts.zoho.com</span></div>
      <div class="mq-cuerpo mq-dos">
        <div class="mq-pantalla mq-primera">
          <span class="mq-et">Pantalla 1 · Zoho MCP</span>
          <b>This application wants to access your Zoho MCP Account</b>
          <span class="mq-sub">Access your Zoho MCP account associated with Tools</span>
          <span class="mq-botones"><span class="mq-boton mq-sec">Deny</span><span class="mq-boton mq-pulso" style="--d:.8s">Allow</span></span>
        </div>
        <div class="mq-pantalla mq-segunda mq-ap" style="--d:2.4s">
          <span class="mq-et">Pantalla 2 · Zoho Accounts</span>
          <b>MCP would like to access the following information.</b>
          <ul class="mq-scopes">
            <li>get deals data</li>
            <li>get contacts data</li>
            <li class="mq-ojo">Update resources in a module</li>
            <li class="mq-ojo">Delete resources from a module</li>
          </ul>
          <span class="mq-botones"><span class="mq-boton mq-sec">Reject</span><span class="mq-boton mq-pulso" style="--d:3.2s">Accept</span></span>
        </div>
      </div>
    </div>
  )}

  {id === 'permisos' && (
    <div class="mq-ventana">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">Zoho CRM · Permissions</span></div>
      <div class="mq-cuerpo">
        <span class="mq-grupo"><span>Read-only tools · 21</span><span class="mq-estado mq-aprob">Needs approval</span></span>
        {['ZohoCRM_searchRecords', 'ZohoCRM_getRecord'].map((h) => (
          <span class="mq-fila"><code>{h}</code><span class="mq-estado mq-aprob">Needs approval</span></span>
        ))}
        <span class="mq-grupo mq-grupo-esc"><span>Write/delete tools · 19</span><span class="mq-estado mq-cambia" style="--d:1s"><i class="antes">Needs approval</i><i class="despues">Blocked</i></span></span>
        {['ZohoCRM_createRecords', 'ZohoCRM_updateRecord', 'ZohoCRM_deleteRecord'].map((h, k) => (
          <span class="mq-fila mq-fila-esc"><code>{h}</code><span class="mq-estado mq-cambia" style={`--d:${1.4 + k * 0.25}s`}><i class="antes">Needs approval</i><i class="despues">Blocked</i></span></span>
        ))}
        <span class="mq-menu mq-ap" style="--d:.3s"><i>Always allow</i><i>Needs approval</i><i>Always ask</i><i class="mq-menu-sel">Blocked</i></span>
      </div>
    </div>
  )}

  {id === 'navegador' && (
    <div class="mq-ventana mq-controlada">
      <div class="mq-barra"><i /><i /><i /><span class="mq-url">crm.zoho.com · Tratos</span></div>
      <span class="mq-control"><span><Fragment set:html={chispa()} />Claude está usando esta pestaña</span> <span class="mq-detener">Detener</span></span>
      <div class="mq-cuerpo mq-nav">
        <div class="mq-crm">
          <span class="mq-pestanas"><i>Clientes</i><i class="mq-objetivo-clic">Tratos</i><i>Contactos</i></span>
          <span class="mq-renglon" /><span class="mq-renglon" /><span class="mq-renglon" /><span class="mq-renglon" />
          <span class="mq-puntero" />
        </div>
        <ol class="mq-bitacora">
          <li class="mq-ap" style="--d:.3s">Abro crm.zoho.com</li>
          <li class="mq-ap" style="--d:1.3s">Entro a Tratos</li>
          <li class="mq-ap" style="--d:2.3s">Filtro: abiertos</li>
          <li class="mq-ap" style="--d:3.3s">Cuento los tratos</li>
          <li class="mq-ap mq-limite-li" style="--d:4.1s">No toco Guardar ni Borrar</li>
        </ol>
      </div>
    </div>
  )}
</div>
