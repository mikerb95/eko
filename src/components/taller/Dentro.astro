---
// Escenas explicativas: reglas contra ejemplos, perillas, etapas del
// entrenamiento, ventana de contexto, ecosistema, áreas y hábitos de revisión.
// El marcado es el estado final; el motor anima hacia él.
import type { Escena } from '../../lib/talleres/tipos'
import { colorDe } from '../../lib/academia/ui'

interface Props {
  e: Escena
}
const { e } = Astro.props
const d = e.datos ?? {}
const COLOR_GRUPO: Record<string, string> = { raee: '#124E7D', respel: '#B8926F', aprov: '#179C91' }

// Perillas: ángulos finales (las "ya entrenadas").
// Ordenadas en una onda suave: se nota que el ajuste pasó del azar al orden.
const angulo = (i: number) => Math.round(50 * Math.sin((i % 12) / 2.2) + 35 * Math.cos(Math.floor(i / 12) / 1.6) - 10)
const perillas = Array.from({ length: 72 }, (_, i) => angulo(i))
// Curva de error que baja con las rondas.
const curva = Array.from({ length: 41 }, (_, i) => {
  const x = 40 + i * 11
  const y = 40 + 250 * (1 - Math.exp(-i / 7)) + Math.sin(i * 1.7) * 9 * Math.exp(-i / 12)
  return `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`
}).join(' ')

const docs = (d.docs ?? []) as { nombre: string; paginas: number; tono: string }[]
const cap = (d.capacidad as number) ?? 400
let usado = 0
const anchos = docs.map((doc) => {
  const libre = Math.max(0, cap - usado)
  const w = Math.min(doc.paginas, libre) / cap
  usado += doc.paginas
  return w
})
const fmt = (n: number) => n.toLocaleString('es-CO')
---

{e.tipo === 'reglas' && (
  <>
    <div class="panel" data-paso="1">
      <h3><span class="pt" style="--c:#124E7D" />Programa con reglas</h3>
      {(d.reglas as { si: string; entonces: string }[]).map((r) => (
        <p class="regla"><span class="si">SI</span>{r.si}<span class="ent">→ {r.entonces}</span></p>
      ))}
      <div class="caso" data-paso="2" data-caso-reglas>
        <span class="tk t2">{d.caso}</span>
        <span class="sello">Ninguna regla aplica</span>
      </div>
    </div>
    <div class="panel" data-paso="3">
      <h3><span class="pt" style="--c:#179C91" />Modelo que aprendió de ejemplos</h3>
      <div class="grupos">
        {(d.grupos as { id: string; nombre: string; ejemplos: string[] }[]).map((g) => (
          <div class="grupo" style={`--c:${COLOR_GRUPO[g.id]}`} data-grupo={g.id}>
            <b>{g.nombre}</b>
            {g.ejemplos.map((x) => <span class="tk">{x}</span>)}
          </div>
        ))}
      </div>
      <div class="acierto" data-caso-modelo>
        <span class="tk t2">{d.caso}</span>
        <span class="sello ok">RAEE con componente peligroso</span>
      </div>
    </div>
  </>
)}

{e.tipo === 'perillas' && (
  <>
    <div class="perillas" aria-hidden="true" data-paso="1">
      {perillas.map((a) => (
        <span class="perilla">
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" /><g style={`--a:${a}`} data-angulo={a}><line x1="20" y1="20" x2="20" y2="8" /></g></svg>
        </span>
      ))}
    </div>
    <div class="error">
      <div data-paso="2">
        <svg viewBox="0 0 520 345" role="img" aria-label="El error baja a medida que avanza el entrenamiento">
          <line class="eje" x1="40" y1="20" x2="40" y2="310" />
          <line class="eje" x1="40" y1="310" x2="500" y2="310" />
          <text class="lbl" x="48" y="30">error</text>
          <text class="lbl" x="360" y="335">entrenamiento →</text>
          <path class="curva" d={curva} pathLength="1" data-curva />
        </svg>
        <p class="ronda">Ronda de entrenamiento <b data-ronda>40.000.000</b></p>
      </div>
      <p class="frase-grande" data-paso="3">Los modelos grandes tienen <span class="acento">miles de millones</span> de perillas.</p>
      <p class="tl-nota" data-paso="3">El número exacto de Claude no es público.</p>
    </div>
  </>
)}

{e.tipo === 'etapas' && (
  <div class="etapas">
    {(d.etapas as { titulo: string; texto: string }[]).map((x, k) => (
      <div class="etapa" data-paso={k + 1}>
        <div class="ilus" aria-hidden="true">
          {k === 0 && (
            <svg viewBox="0 0 400 330" data-ilus="lee">
              {Array.from({ length: 5 }, (_, i) => (
                <g transform={`translate(${24 + i * 14} ${40 + i * 18})`} data-hoja>
                  <rect width="110" height="140" rx="8" fill="#fff" stroke="#C7C2BA" stroke-width="2" />
                  {Array.from({ length: 6 }, (_, j) => <rect x="14" y={20 + j * 18} width={70 - (j % 3) * 12} height="6" rx="3" fill="#D9D5CF" />)}
                </g>
              ))}
              <g data-flujo>
                {Array.from({ length: 6 }, (_, i) => <rect x={190 + i * 12} y={150 + (i % 3) * 14} width="22" height="10" rx="4" fill={['#124E7D', '#179C91', '#B8926F'][i % 3]} opacity=".8" />)}
              </g>
              <rect x="280" y="110" width="96" height="110" rx="22" fill="#124E7D" />
              {Array.from({ length: 9 }, (_, i) => <circle cx={304 + (i % 3) * 24} cy={140 + Math.floor(i / 3) * 24} r="5" fill="#6fd2c9" data-neurona />)}
            </svg>
          )}
          {k === 1 && (
            <svg viewBox="0 0 400 330" data-ilus="ajuste">
              {[0, 1, 2].map((i) => (
                <g transform={`translate(40 ${36 + i * 92})`} data-respuesta>
                  <rect width="240" height="70" rx="14" fill="#F6F4F0" />
                  <rect x="18" y="20" width={170 - i * 30} height="8" rx="4" fill="#C7C2BA" />
                  <rect x="18" y="40" width={120 + i * 20} height="8" rx="4" fill="#C7C2BA" />
                  <circle cx="300" cy="35" r="24" fill={i === 1 ? '#B4442F' : '#2E8B57'} data-marca />
                  {i === 1 ? (
                    <path d="M290 25 L310 45 M310 25 L290 45" stroke="#fff" stroke-width="5" stroke-linecap="round" />
                  ) : (
                    <path d="M288 36 L297 45 L313 27" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  )}
                </g>
              ))}
            </svg>
          )}
          {k === 2 && (
            <svg viewBox="0 0 400 330" data-ilus="corte">
              <line x1="30" y1="190" x2="250" y2="190" stroke="#124E7D" stroke-width="6" stroke-linecap="round" />
              <line x1="250" y1="190" x2="370" y2="190" stroke="#C7C2BA" stroke-width="6" stroke-dasharray="4 12" stroke-linecap="round" />
              {[50, 110, 170, 230].map((x) => <circle cx={x} cy="190" r="9" fill="#124E7D" />)}
              {[300, 350].map((x) => <circle cx={x} cy="190" r="9" fill="none" stroke="#C7C2BA" stroke-width="3" />)}
              <g data-corte>
                <line x1="250" y1="110" x2="250" y2="250" stroke="#B4442F" stroke-width="4" />
                <rect x="170" y="70" width="160" height="34" rx="10" fill="#B4442F" />
                <text x="250" y="93" text-anchor="middle" fill="#fff" font-family="Geist Mono, monospace" font-size="16">fecha de corte</text>
              </g>
              <text x="325" y="150" text-anchor="middle" fill="#6B7580" font-family="Bricolage Grotesque, sans-serif" font-size="48" font-weight="600">?</text>
            </svg>
          )}
        </div>
        <span class="num">0{k + 1}</span>
        <h3>{x.titulo}</h3>
        <p>{x.texto}</p>
      </div>
    ))}
  </div>
)}

{e.tipo === 'contexto' && (
  <div class="mesa">
    <div class="mesa-riel" role="img" aria-label="Capacidad de la ventana de contexto">
      {docs.map((doc, k) => (
        <span class={`doc ${doc.tono}`} style={`width:${(anchos[k]! * 100).toFixed(2)}%`} data-paso={k + 1} data-doc={k}>
          {anchos[k]! > 0.2 ? doc.nombre : ''}
        </span>
      ))}
    </div>
    <div class="mesa-escala"><span>0</span><span>Lo que cabe en una conversación: del orden de unos cientos de páginas</span></div>
    <div class="mesa-leyenda">
      {docs.map((doc, k) => (
        <div data-paso={k + 1}>
          <b>{doc.nombre}</b>
          <span>{fmt(doc.paginas)} páginas</span>
          <span class={doc.paginas + docs.slice(0, k).reduce((a, x) => a + x.paginas, 0) <= cap ? 'si' : 'no'}>
            {doc.paginas + docs.slice(0, k).reduce((a, x) => a + x.paginas, 0) <= cap ? 'Cabe' : 'No cabe: hay que elegir qué darle'}
          </span>
        </div>
      ))}
    </div>
    <p class="llamado" data-paso="3"><span class="pt" />Al abrir una conversación nueva, la mesa queda vacía.</p>
  </div>
)}

{e.tipo === 'ecosistema' && (
  <div class="capas">
    {(d.capas as { titulo: string; items: string[]; texto: string }[]).map((c, k) => (
      <div class="capa" data-paso={k + 1}>
        <div>
          <h3>{c.titulo}</h3>
          <p>{c.texto}</p>
        </div>
        <div class="items">
          {c.items.map((x) => <span class:list={['tk', { nuestro: x === 'Claude' || x === 'claude.ai' }]}>{x}</span>)}
        </div>
      </div>
    ))}
  </div>
)}

{e.tipo === 'areas' && (
  <div class="areas">
    {(d.areas as { id: string; nombre: string; ejemplo: string }[]).map((a, k) => (
      <div class="area" style={`--c:${colorDe(a.id)}`} data-paso={k + 1}>
        <h3>{a.nombre}</h3>
        <p>{a.ejemplo}</p>
      </div>
    ))}
  </div>
)}

{e.tipo === 'verificar' && (
  <div class="habitos">
    {(d.pasos as { titulo: string; texto: string }[]).map((h, k) => (
      <div class="habito" data-paso={k + 1}>
        <span class="n">0{k + 1}</span>
        <h3>{h.titulo}</h3>
        <p>{h.texto}</p>
      </div>
    ))}
  </div>
)}
