---
// Una escena de la presentación: cabecera común (kicker, título, aviso de
// contenido provisional) y el cuerpo según su tipo. Los elementos con
// data-paso="k" aparecen con el clic k del presentador (en modo documento se
// ven todos).
import type { Escena, Taller } from '../../lib/talleres/tipos'
import { COLOR_BLOQUE, TIPOS_OSCUROS, type Contexto } from './tipos'
import Apertura from './Apertura.astro'
import Dentro from './Dentro.astro'
import Interactivos from './Interactivos.astro'
import Votaciones from './Votaciones.astro'
import Pedir from './Pedir.astro'
import Cierre from './Cierre.astro'
import Conectar from './Conectar.astro'
import Clawd from './Clawd.astro'

interface Props {
  e: Escena
  t: Taller
  ctx: Contexto
  indice: number
}
const { e, t, ctx, indice } = Astro.props
const oscura = TIPOS_OSCUROS.has(e.tipo)
const grupo = (() => {
  if (['portada', 'sala', 'diagnostico', 'descanso', 'practica'].includes(e.tipo)) return 'apertura'
  if (['reglas', 'perillas', 'etapas', 'contexto', 'ecosistema', 'areas', 'verificar'].includes(e.tipo)) return 'dentro'
  if (['tokens', 'siguiente', 'inventa', 'mapa', 'anonimizar'].includes(e.tipo)) return 'interactivos'
  if (['evaluacion', 'voto', 'verdad', 'semaforo', 'comparacion', 'repaso'].includes(e.tipo)) return 'votaciones'
  if (['metodo', 'constructor', 'iterar'].includes(e.tipo)) return 'pedir'
  if (e.tipo === 'conectar') return 'conectar'
  return 'cierre'
})()

// Escenas donde Clawd tiene un papel (el motor está en scripts/taller/clawd.ts
// y en los hooks de escenas.ts). En las demás no aparece.
// Map y no objeto: `constructor` es un tipo de escena y en un objeto choca con
// la propiedad heredada del mismo nombre.
type Papel = { accesorio: 'teclado' | 'mesa' | 'nada'; lugar: string }
const PAPELES = new Map<string, Papel>([
  ['portada', { accesorio: 'teclado', lugar: 'portada' }],
  ['siguiente', { accesorio: 'teclado', lugar: 'piensa' }],
  ['inventa', { accesorio: 'teclado', lugar: 'inventa' }],
  ['contexto', { accesorio: 'mesa', lugar: 'mesa' }],
  ['constructor', { accesorio: 'teclado', lugar: 'constructor' }],
  ['evaluacion', { accesorio: 'nada', lugar: 'votos' }],
  ['voto', { accesorio: 'nada', lugar: 'votos' }],
  ['repaso', { accesorio: 'nada', lugar: 'votos' }],
  ['verdad', { accesorio: 'nada', lugar: 'votos' }],
  ['semaforo', { accesorio: 'nada', lugar: 'votos' }],
  ['descanso', { accesorio: 'nada', lugar: 'descanso' }],
  ['practica', { accesorio: 'teclado', lugar: 'practica' }],
])
const papel = PAPELES.get(e.tipo)
---

<section
  class:list={['tl-escena', `esc-${e.tipo}`, { oscura }]}
  id={`escena-${e.id}`}
  data-escena={e.id}
  data-tipo={e.tipo}
  data-pasos={e.pasos}
  data-indice={indice}
  data-bloque={e.bloque}
  data-interaccion={e.interaccion}
  data-demo={e.demo}
  style={`--bloque:${COLOR_BLOQUE[e.bloque] ?? '#179C91'}`}
  aria-label={e.titulo}
>
  <p class="tl-kicker">{e.kicker}</p>
  <h2 class="tl-titulo">{e.titulo}</h2>
  {e.provisional && <span class="tl-provisional">Ejemplo ilustrativo · se reemplaza con material de Ekosolv</span>}
  <div class="tl-cuerpo">
    {grupo === 'apertura' && <Apertura e={e} t={t} ctx={ctx} />}
    {grupo === 'dentro' && <Dentro e={e} />}
    {grupo === 'interactivos' && <Interactivos e={e} />}
    {grupo === 'votaciones' && <Votaciones e={e} t={t} />}
    {grupo === 'pedir' && <Pedir e={e} t={t} ctx={ctx} />}
    {grupo === 'cierre' && <Cierre e={e} t={t} ctx={ctx} />}
    {grupo === 'conectar' && <Conectar e={e} />}
  </div>
  {papel && <Clawd accesorio={papel.accesorio} lugar={papel.lugar} frases={e.datos?.clawd} />}
</section>
