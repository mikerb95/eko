---
// Escenas de cierre: los sábados que faltan (todo el equipo asiste a todos)
// y la despedida con la tarjeta resumen.
import type { Escena, Taller } from '../../lib/talleres/tipos'
import type { Contexto } from './tipos'

interface Props {
  e: Escena
  t: Taller
  ctx: Contexto
}
const { e, ctx } = Astro.props
const d = e.datos ?? {}
---

{e.tipo === 'sigue' && (
  <div class="sabados">
    {(d.sabados as number[]).map((n) => (
      <div class="sabado">
        <span class="n">Capacitación {n} de 4</span>
        <h3>Sábado {n}</h3>
        <p>Todo el equipo · 4 horas, presencial</p>
      </div>
    ))}
  </div>
)}

{e.tipo === 'cierre' && (
  <div style="display:flex;gap:56px;align-items:center;flex-wrap:wrap">
    <div class="qr" set:html={ctx.qrResumen} role="img" aria-label={`Código QR de ${ctx.urlResumen}`} />
    <div style="display:flex;flex-direction:column;gap:18px;max-width:28ch">
      <p class="frase-grande">Rápida y capaz como un practicante nuevo. Su trabajo <span class="acento" style="color:#6fd2c9">siempre se revisa</span>.</p>
      <p class="tl-nota">Escanee el código para guardar la tarjeta resumen.</p>
    </div>
  </div>
)}
