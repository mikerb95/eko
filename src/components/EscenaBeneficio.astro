---
/**
 * Mini escenas de "Por qué Ekosolv" en la portada. Cada una demuestra el
 * beneficio de su carta en vez de repetirlo:
 *
 * - interlocutor: tres frentes (licencia, recolección, certificado) se unen en
 *   un solo proveedor que llega a la empresa.
 * - redaccion: el borrador se escribe solo; la empresa solo aprueba.
 * - trazabilidad: un escáner pasa por los lotes y cada uno queda certificado.
 * - vencimientos: cada vencimiento se atiende antes de llegar al expediente
 *   sancionatorio, que queda vacío.
 * - plazo: plazo de diez días hábiles; la respuesta sale mucho antes del final.
 *
 * El HTML es el estado final (todo resuelto). Los bucles los monta
 * `src/scripts/motion/escenas.ts`. Decorativas (`aria-hidden`): el texto de la
 * carta ya dice lo mismo.
 */

type Tipo = 'interlocutor' | 'redaccion' | 'trazabilidad' | 'vencimientos' | 'plazo'

interface Props {
  tipo: Tipo
  /** Rótulos de la escena, en el idioma de la página. */
  t: Record<string, string>
}

const { tipo, t } = Astro.props
const lotes = ['A', 'B', 'C', 'D']
const dias = Array.from({ length: 10 }, (_, i) => i)
/** Día (índice) en que aterriza la respuesta en la escena del plazo. */
const RESPUESTA = 2
---

<div class={`esc esc-${tipo}`} data-escena={tipo} aria-hidden="true">
  {tipo === 'interlocutor' && (
    <div class="esc-uno">
      <div class="esc-frentes">
        <span class="esc-chip" data-e="frente">{t.licencia}</span>
        <span class="esc-chip" data-e="frente">{t.recoleccion}</span>
        <span class="esc-chip" data-e="frente">{t.certificado}</span>
      </div>
      <svg class="esc-hilos" viewBox="0 0 60 84" preserveAspectRatio="none" data-e="hilos">
        <path d="M0 12 C 30 12, 30 42, 60 42" />
        <path d="M0 42 L 60 42" />
        <path d="M0 72 C 30 72, 30 42, 60 42" />
      </svg>
      <span class="esc-nodo" data-e="nodo">Ekosolv</span>
      <svg class="esc-hilo-final" viewBox="0 0 30 10" preserveAspectRatio="none" data-e="final"><path d="M0 5 L 30 5" /></svg>
      <span class="esc-chip esc-destino" data-e="destino">{t.empresa}</span>
    </div>
  )}

  {tipo === 'redaccion' && (
    <div class="esc-dos">
      <div class="esc-doc">
        <div class="esc-doc-titulo">{t.documento}</div>
        <span class="esc-renglon" style="--w: 92%" data-e="renglon"></span>
        <span class="esc-renglon" style="--w: 78%" data-e="renglon"></span>
        <span class="esc-renglon" style="--w: 86%" data-e="renglon"></span>
        <span class="esc-renglon" style="--w: 54%" data-e="renglon"></span>
      </div>
      <div class="esc-firma">
        <span class="esc-quien">{t.usted}</span>
        <span class="esc-boton" data-e="boton">
          <span class="esc-boton-a">{t.aprobar}</span>
          <span class="esc-boton-b">✓ {t.radicado}</span>
        </span>
      </div>
      <svg class="esc-cursor" viewBox="0 0 16 16" data-e="cursor"><path d="M2 1 L2 13 L5.5 9.8 L8 15 L10 14 L7.6 9 L12 9 Z" /></svg>
    </div>
  )}

  {tipo === 'trazabilidad' && (
    <div class="esc-tres">
      <div class="esc-lotes">
        {lotes.map((l) => (
          <div class="esc-lote" data-e="lote">
            <span class="esc-lote-nombre">{t.lote} {l}</span>
            <span class="esc-lote-cert">✓</span>
          </div>
        ))}
        <span class="esc-escaner" data-e="escaner"></span>
      </div>
      <div class="esc-pie"><span>{t.certificado}</span></div>
    </div>
  )}

  {tipo === 'vencimientos' && (
    <div class="esc-cuatro">
      <div class="esc-pista">
        <span class="esc-via"></span>
        <span class="esc-hoy" data-e="hoy"></span>
        {[16, 38, 60].map((x) => (
          <span class="esc-venc" style={`--x: ${x}%`} data-e="venc"><i>!</i><b>✓</b></span>
        ))}
        <span class="esc-expediente">{t.expediente}</span>
      </div>
      <div class="esc-pie"><span>{t.vencimiento}</span></div>
    </div>
  )}

  {tipo === 'plazo' && (
    <div class="esc-cinco">
      <div class="esc-plazo-rotulo"><span>{t.plazo}</span><span class="esc-respuesta-rotulo" data-e="rotulo">{t.respuesta}</span></div>
      <div class="esc-dias">
        {dias.map((d) => (
          <span class={`esc-dia${d <= RESPUESTA ? ' esc-dia-usado' : ''}`} data-e="dia">
            {d === RESPUESTA && <span class="esc-marca" data-e="marca"></span>}
          </span>
        ))}
      </div>
      <div class="esc-pie"><span>{t.dia1}</span><span>{t.dia10}</span></div>
    </div>
  )}
</div>

<style is:global>
  .esc {
    --esc-tinta: var(--ink);
    --esc-suave: color-mix(in oklab, var(--ink) 9%, transparent);
    --esc-linea: color-mix(in oklab, var(--ink) 22%, transparent);
    --esc-acento: var(--forest);
    margin-top: 22px;
    padding: 14px;
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--ink) 4%, transparent);
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--esc-tinta);
    position: relative; overflow: hidden;
    min-height: 104px;
  }
  .svc.accent-deep .esc {
    --esc-tinta: #fff;
    --esc-suave: color-mix(in oklab, #fff 12%, transparent);
    --esc-linea: color-mix(in oklab, #fff 30%, transparent);
    --esc-acento: var(--aqua);
    background: color-mix(in oklab, #fff 7%, transparent);
  }
  .esc-pie {
    display: flex; justify-content: space-between; gap: 8px;
    margin-top: 10px; font-size: 9.5px; opacity: .55;
  }
  .esc-chip {
    display: inline-block; padding: 5px 9px; border-radius: 999px;
    border: 1px solid var(--esc-linea); white-space: nowrap;
  }

  /* 01 · interlocutor */
  .esc-uno { display: grid; grid-template-columns: auto minmax(24px, 1fr) auto minmax(14px, 34px) auto; align-items: center; }
  .esc-frentes { display: grid; gap: 6px; }
  .esc-hilos, .esc-hilo-final { width: 100%; height: auto; overflow: visible; }
  .esc-hilos { height: 84px; }
  .esc-hilos path, .esc-hilo-final path { fill: none; stroke: var(--esc-acento); stroke-width: 1.3; vector-effect: non-scaling-stroke; }
  .esc-hilo-final { height: 10px; }
  .esc-nodo {
    padding: 7px 10px; border-radius: 999px;
    background: var(--esc-acento); color: var(--paper);
    font-weight: 500;
  }
  .svc.accent-deep .esc-nodo { color: var(--ink); }
  .esc-destino { border-color: var(--esc-acento); color: var(--esc-acento); }

  /* 02 · redacción */
  .esc-dos { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: end; position: relative; }
  .esc-doc {
    display: grid; gap: 7px; padding: 10px 12px;
    border-radius: 8px; background: var(--paper);
    box-shadow: 0 1px 0 var(--esc-suave), 0 8px 18px -12px rgba(10, 20, 30, .35);
  }
  .esc-doc-titulo { font-size: 9.5px; opacity: .6; margin-bottom: 2px; color: var(--ink); }
  .esc-renglon { display: block; height: 5px; width: var(--w); border-radius: 3px; background: color-mix(in oklab, var(--ink) 18%, transparent); transform-origin: left center; }
  .esc-firma { display: grid; gap: 6px; justify-items: end; }
  .esc-quien { font-size: 9.5px; opacity: .6; }
  .esc-boton {
    display: grid; padding: 7px 12px; border-radius: 999px;
    background: var(--esc-acento); color: var(--paper);
    font-weight: 500; white-space: nowrap;
  }
  .esc-boton > span { grid-area: 1 / 1; text-align: center; transition: opacity .25s ease; }
  /* Estado final del servidor: ya radicado. El script alterna con [data-paso="aprobar"]. */
  .esc-boton-a { opacity: 0; }
  .esc-boton[data-paso="aprobar"] { background: transparent; color: var(--esc-acento); box-shadow: inset 0 0 0 1px var(--esc-acento); }
  .esc-boton[data-paso="aprobar"] .esc-boton-a { opacity: 1; }
  .esc-boton[data-paso="aprobar"] .esc-boton-b { opacity: 0; }
  .esc-cursor { position: absolute; width: 15px; height: 15px; right: 18px; bottom: -2px; fill: var(--ink); stroke: #fff; stroke-width: 1; opacity: 0; pointer-events: none; }

  /* 03 · trazabilidad */
  .esc-lotes { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .esc-lote {
    display: grid; gap: 6px; padding: 9px 6px; border-radius: 8px; min-width: 0;
    border: 1px solid var(--esc-linea); text-align: center;
    transition: border-color .3s ease, background .3s ease;
  }
  .esc-lote-cert { color: var(--esc-acento); font-size: 14px; line-height: 1; transition: opacity .3s ease, transform .3s ease; }
  .esc-lote[data-pendiente] { border-style: dashed; }
  .esc-lote[data-pendiente] .esc-lote-cert { opacity: 0; transform: translateY(4px); }
  .esc-lote:not([data-pendiente]) { border-color: color-mix(in oklab, var(--esc-acento) 55%, transparent); background: color-mix(in oklab, var(--esc-acento) 7%, transparent); }
  .esc-escaner {
    position: absolute; top: -6px; bottom: -6px; left: 0; width: 2px; border-radius: 2px;
    background: var(--esc-acento); box-shadow: 0 0 12px var(--esc-acento);
    opacity: 0;
  }

  /* 04 · vencimientos */
  .esc-pista { position: relative; height: 52px; margin-inline: 4px; }
  .esc-via { position: absolute; left: 0; right: 0; top: 26px; height: 1px; background: var(--esc-linea); }
  .esc-hoy { position: absolute; top: 14px; height: 24px; width: 1.5px; left: 84%; background: var(--esc-acento); opacity: 0; }
  .esc-venc {
    position: absolute; left: var(--x); top: 16px; width: 20px; height: 20px; margin-left: -10px;
    display: grid; place-items: center; border-radius: 50%;
    background: var(--esc-acento); color: var(--paper); font-style: normal; font-size: 11px;
    transition: background .3s ease, color .3s ease, box-shadow .3s ease;
  }
  .esc-venc > * { grid-area: 1 / 1; font-style: normal; font-weight: 600; transition: opacity .2s ease; }
  .esc-venc i { opacity: 0; }
  .esc-venc[data-pendiente] { background: var(--paper); color: var(--clay-ink); box-shadow: inset 0 0 0 1.5px var(--clay-2); }
  .esc-venc[data-pendiente] i { opacity: 1; }
  .esc-venc[data-pendiente] b { opacity: 0; }
  .esc-expediente {
    position: absolute; right: 0; top: 14px; padding: 5px 8px; border-radius: 6px;
    border: 1px dashed var(--esc-linea); background: var(--paper-warm);
    text-decoration: line-through; text-decoration-color: var(--esc-acento); opacity: .7;
  }
  .svc.accent-deep .esc-expediente { background: var(--deep); }

  /* 05 · plazo */
  .esc-plazo-rotulo { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
  .esc-respuesta-rotulo { color: var(--esc-acento); }
  .esc-dias { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; }
  .esc-dia { position: relative; height: 22px; border-radius: 4px; background: var(--esc-suave); }
  .esc-dia-usado { background: color-mix(in oklab, var(--esc-acento) 35%, transparent); }
  .esc-marca {
    position: absolute; inset: -5px -2px; border-radius: 6px;
    border: 1.5px solid var(--esc-acento); background: color-mix(in oklab, var(--esc-acento) 20%, transparent);
  }

  @media (max-width: 420px) {
    .esc { font-size: 9.5px; padding: 12px; }
    .esc-chip { padding: 4px 7px; }
    .esc-nodo { padding: 6px 8px; }
  }
</style>
