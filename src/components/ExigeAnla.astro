---
/**
 * "¿Qué le exige la ANLA a su empresa?" Pieza central del hero de la portada.
 * El visitante elige su tipo de empresa y la lista de normas se reordena: las
 * que le aplican suben encendidas y el resto se apaga. El pie cuenta cuántas
 * son y lleva al formulario de contacto con el sector ya elegido.
 *
 * Funciona sin JS: los perfiles son radios y el encendido, la cifra y el
 * enlace los resuelve el CSS con `:has()`. `src/scripts/motion/exige.ts` solo
 * añade el recorrido automático por perfiles y el reordenamiento animado.
 *
 * La relación perfil → norma vive en `src/lib/exigencias.ts` (orientativa).
 */
import { PERFILES, type Perfil, BASE, normasDe, ordenar } from '../lib/exigencias'

interface Norma {
  /** Código visible ("DEC 1076 · Title 5" en inglés). */
  code: string
  /** Código canónico de normativas.json, si el visible está traducido. */
  ref?: string
  title: string
  /** Título corto para la fila (el oficial va dentro de la ficha). Sin él, la fila usa `title`. */
  corto?: string
  body: string
}

interface Props {
  normas: Norma[]
  /** Nombre visible de cada perfil y su valor en el campo "sector" del formulario de contacto. */
  perfiles: Record<Perfil, { label: string; sector: string }>
  /** Ruta del formulario de contacto. */
  href: string
  inicial?: Perfil
  textos: {
    rotulo: string
    aviso: string
    pregunta: string
    /** Sufijo de la cifra: "normas le aplican". */
    aplican: string
    /** Lectura para lectores de pantalla de una norma encendida. */
    aplica: string
    /** Etiqueta de las normas que aplican a todos. */
    todas: string
    /** Línea bajo la lista: cómo se usa y por qué es orientativo. */
    ayuda: string
    cta: string
  }
}

const { normas, perfiles, href, inicial = 'importadora', textos } = Astro.props
// El mapa de exigencias.ts usa los códigos en español; `ref` los trae cuando el visible está traducido.
const lista = ordenar(normas.map((n) => ({ ...n, visible: n.code, code: n.ref ?? n.code })), inicial)
const enlace = (p: Perfil) => `${href}?sector=${encodeURIComponent(perfiles[p].sector)}`
const esBase = (code: string) => (BASE as readonly string[]).includes(code)
// La lista reserva el alto del perfil con más normas: así el panel no cambia de
// tamaño al pasar de un perfil a otro y el hero no salta.
const maxFilas = Math.max(...PERFILES.map((p) => normasDe(p).length))
---

<div class="exige" id="exige" data-exige style={`--ex-filas: ${maxFilas}`}>
  <div class="ex-head">
    <div class="ex-rotulo"><span class="ex-pulso" aria-hidden="true"></span>{textos.rotulo}</div>
    <div class="ex-aviso">{textos.aviso}</div>
  </div>

  <fieldset class="ex-perfiles">
    <legend class="ex-pregunta">{textos.pregunta}</legend>
    <div class="ex-chips">
      {PERFILES.map((p) => (
        <label class="ex-chip" data-exige-chip={p}>
          <input type="radio" name="exige-perfil" value={p} checked={p === inicial} />
          <span>{perfiles[p].label}</span>
          <i class="ex-prog" aria-hidden="true"></i>
        </label>
      ))}
    </div>
  </fieldset>

  <ol class="ex-lista" data-exige-lista>
    {lista.map((n) => (
      <li
        class:list={['ex-norma', ...PERFILES.filter((p) => normasDe(p).includes(n.code)).map((p) => `p-${p}`)]}
        data-code={n.code}
      >
        <details>
          <summary>
            <span class="ex-punto" aria-hidden="true"></span>
            <span class="ex-code">{n.visible}</span>
            <span class="ex-titulo">{n.corto ?? n.title}</span>
            {esBase(n.code) && <span class="ex-todas">{textos.todas}</span>}
            <span class="sr-only ex-sr">{textos.aplica}</span>
            <svg class="ex-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <p>{n.corto && n.corto !== n.title && <strong>{n.title}. </strong>}{n.body}</p>
        </details>
      </li>
    ))}
  </ol>
  <p class="ex-ayuda">{textos.ayuda}</p>

  <div class="ex-pie">
    <div class="ex-cuenta" data-exige-cuenta>
      {PERFILES.map((p) => (
        <span class="ex-n" data-p={p}><b data-exige-n>{normasDe(p).length}</b> {textos.aplican}</span>
      ))}
    </div>
    {PERFILES.map((p) => (
      <a class="ex-cta" data-p={p} href={enlace(p)}>
        {textos.cta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    ))}
  </div>
</div>

<style is:global>
  /* Una hoja de expediente sobre el papel: clara, para no competir con el radar oscuro de abajo.
     Columna flexible: en el hero se estira al alto de la fila y el pie queda abajo. */
  .exige {
    position: relative;
    display: flex; flex-direction: column;
    background: color-mix(in oklab, #fff 72%, var(--paper-warm));
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(18px, 2vw, 26px);
    box-shadow:
      0 1px 0 #fff inset,
      0 30px 60px -36px color-mix(in oklab, var(--ink) 38%, transparent),
      0 8px 20px -14px color-mix(in oklab, var(--ink) 20%, transparent);
  }

  .ex-head {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .ex-rotulo {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2);
  }
  .ex-pulso { width: 8px; height: 8px; border-radius: 50%; background: var(--aqua); animation: pulse 1.8s infinite; }
  .ex-aviso {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--clay-ink); padding: 3px 8px; border-radius: 999px;
    background: color-mix(in oklab, var(--clay) 22%, transparent);
  }

  .ex-perfiles { border: 0; margin-top: 12px; min-width: 0; }
  .ex-pregunta {
    font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(21px, 1.8vw, 24px); letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 10px; padding: 0;
  }
  .ex-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ex-chip {
    position: relative; overflow: hidden; cursor: pointer;
    padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--line-2); background: transparent;
    font-size: 13.5px; line-height: 1.2; color: var(--ink-2); white-space: nowrap;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }
  .ex-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .ex-chip span { position: relative; z-index: 1; }
  .ex-chip:hover { border-color: var(--ink-2); }
  .ex-chip:has(input:checked) { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .ex-chip:has(input:focus-visible) { outline: 2px solid var(--forest); outline-offset: 3px; }
  /* Barra del recorrido automático: el script la llena mientras nadie elige. */
  .ex-prog {
    position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--aqua); transform: scaleX(0); transform-origin: left;
  }

  /* Solo se listan las normas del perfil elegido: nada de filas apagadas de relleno.
     El alto mínimo reserva el perfil más largo (--ex-filas) para que el panel no salte. */
  .ex-lista {
    --ex-fila: 36px;
    list-style: none; margin-top: 14px; border-top: 1px solid var(--line);
    min-height: calc(var(--ex-filas, 8) * var(--ex-fila));
  }
  .ex-norma { display: none; border-bottom: 1px solid var(--line); }
  .ex-norma summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 8px 140px minmax(0, 1fr) auto auto; align-items: center; gap: 12px;
    min-height: calc(var(--ex-fila) - 1px);
    padding: 4px 6px; border-radius: 8px;
    transition: background .25s ease;
  }
  .ex-norma summary::-webkit-details-marker { display: none; }
  .ex-norma summary:hover { background: color-mix(in oklab, var(--aqua) 7%, transparent); }
  .ex-norma summary:focus-visible { outline: 2px solid var(--forest); outline-offset: 1px; }
  .ex-punto {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--aqua);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--aqua) 18%, transparent);
  }
  .ex-code { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--ink-2); white-space: nowrap; }
  .ex-titulo { font-size: 14.5px; line-height: 1.3; color: var(--ink); }
  .ex-todas {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mute); padding: 2px 6px; border: 1px solid var(--line-2); border-radius: 999px;
  }
  .ex-chev { color: var(--mute); transition: transform .25s ease; grid-column: 5; }
  .ex-norma details[open] .ex-chev { transform: rotate(180deg); }
  .ex-norma details p {
    padding: 0 6px 12px calc(8px + 12px + 6px);
    font-size: 14px; line-height: 1.5; color: var(--ink-2); max-width: 62ch;
  }
  .ex-norma details p strong { font-weight: 500; color: var(--ink); }
  .ex-ayuda { margin-top: 10px; font-size: 13px; line-height: 1.45; color: var(--mute); }

  /* Encendido: una regla por perfil, porque el CSS no puede leer el valor del radio. */
  .exige:has(input[value="importadora"]:checked) .p-importadora,
  .exige:has(input[value="productora"]:checked) .p-productora,
  .exige:has(input[value="telco"]:checked) .p-telco,
  .exige:has(input[value="datacenter"]:checked) .p-datacenter,
  .exige:has(input[value="retail"]:checked) .p-retail { display: block; }

  /* Pie: la cifra manda; la salida es un enlace secundario, porque la acción
     principal del hero es el botón de diagnóstico de la columna de texto. */
  .ex-pie {
    margin-top: auto; padding-top: 14px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  }
  .ex-n, .ex-cta { display: none; }
  .ex-n { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); align-items: baseline; gap: 10px; }
  .ex-n b {
    font-family: var(--font-display); font-weight: var(--display-weight); font-size: 40px; line-height: 1;
    letter-spacing: -0.03em; color: var(--ink); text-transform: none; display: inline-block;
  }
  .ex-cta {
    align-items: center; gap: 8px;
    padding: 6px 2px; color: var(--ink); font-size: 15px; font-weight: 500; white-space: nowrap;
    text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--aqua) 70%, transparent);
    text-decoration-thickness: 2px; text-underline-offset: 5px;
    transition: color .2s ease, text-decoration-color .2s ease;
  }
  .ex-cta:hover { color: var(--deep); text-decoration-color: var(--aqua); }
  .ex-cta svg { transition: transform .2s ease; }
  .ex-cta:hover svg { transform: translateX(3px); }
  .ex-cta:focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; border-radius: 4px; }

  .exige:has(input[value="importadora"]:checked) [data-p="importadora"],
  .exige:has(input[value="productora"]:checked) [data-p="productora"],
  .exige:has(input[value="telco"]:checked) [data-p="telco"],
  .exige:has(input[value="datacenter"]:checked) [data-p="datacenter"],
  .exige:has(input[value="retail"]:checked) [data-p="retail"] { display: inline-flex; }

  @media (max-width: 600px) {
    .ex-lista { --ex-fila: 54px; }
    .ex-norma summary { grid-template-columns: 8px minmax(0, 1fr) auto auto; row-gap: 2px; padding-block: 8px; }
    .ex-code { grid-column: 2; }
    .ex-titulo { grid-column: 2 / 4; grid-row: 2; font-size: 14px; }
    .ex-todas { grid-column: 3; grid-row: 1; justify-self: end; }
    .ex-chev { grid-column: 4; grid-row: 1 / 3; }
    .ex-n b { font-size: 38px; }
  }
</style>
