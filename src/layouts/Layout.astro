---
import AsesorChat from '../components/AsesorChat.astro'
import "../styles/global.css"
import "../styles/blog.css"
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/Nav.astro'
import SchemaOrg from '../components/SchemaOrg.astro'
import { SITE_URL, url } from '../lib/site'
import { hreflangFor, rutasEs, seoDe } from '../lib/rutas'
import { migas, organizacion, servicioDeRuta, sitioWeb } from '../lib/schema'

interface Props {
  /**
   * Solo para páginas cuyo título no se puede saber de antemano: hoy, los
   * artículos del blog. El resto lo toma de `seoDe(path)`, que lee el
   * inventario de rutas. Ver la nota en `src/lib/rutas.ts`.
   */
  title?: string
  /** Igual que `title`: la excepción, no la regla. */
  description?: string
  activePath?: string
  /** Ruta canónica de esta página. Por defecto usa activePath. */
  path?: string
  /**
   * Imagen para compartir en redes (ruta absoluta desde /public).
   * La de portada se genera con `node scripts/og/generar.mjs`.
   */
  ogImage?: string
  /**
   * `og:type`. Los artículos del blog son `article`, no `website`, y con eso
   * se desbloquean `article:published_time` y `article:section`, que son lo
   * que las redes muestran como fecha en la tarjeta.
   */
  ogType?: 'website' | 'article'
  /** Fecha ISO de publicación. Solo tiene sentido con `ogType="article"`. */
  publishedTime?: string
  /** Sección del artículo, para `article:section`. */
  section?: string
  /**
   * Excluye la página de los buscadores. Para documentación interna del
   * proyecto, que vive en el sitio pero no es contenido comercial.
   */
  noindex?: boolean
  /**
   * Nodos JSON-LD propios de la página (un `Service`, un `BlogPosting`). Se
   * suman a la organización y al sitio, que van en todas.
   */
  nodosSchema?: unknown[]
}

const {
  title,
  description,
  activePath = "/",
  path = activePath,
  ogImage = "/og/portada.jpg",
  ogType = "website",
  publishedTime,
  section,
  noindex = false,
  nodosSchema = [],
} = Astro.props

// Título y descripción del inventario de rutas. Los textos por defecto solo
// aplican a páginas que no están en él, como las internas del proyecto.
const seo = seoDe(path)
const pageTitle = title ?? seo?.titulo ?? 'Ekosolv — Consultoría ambiental ANLA'
const pageDescription =
  description ??
  seo?.descripcion ??
  'Acompañamos a importadores, productores y operadores de tecnología en Colombia a construir sus planes de gestión ambiental, licencias y reportes.'

/*
 * Un solo meta robots por página. Se combinan las directivas de indexación con
 * la reserva frente a entrenamiento de modelos: si van en dos etiquetas
 * separadas los buscadores las fusionan igual, pero queda una etiqueta
 * duplicada difícil de auditar. `noai` y `noimageai` no son estándar formal;
 * valen como manifestación expresa de voluntad, que es lo que exige la
 * cláusula 3.7 de LICENSE para que la prohibición sea oponible.
 */
const robots = [noindex ? 'noindex, nofollow' : null, 'noai', 'noimageai']
  .filter(Boolean)
  .join(', ')

const canonical = url(path)
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`
const ogImageType = ogImageUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'
const alt = hreflangFor(path)

/*
 * Grafo de datos estructurados. Las páginas internas del proyecto llevan
 * `noindex`, así que no tiene sentido gastarles migas ni describirlas: se
 * quedan con la organización y el sitio, que sirven de contexto igual.
 *
 * Las migas usan el título corto del inventario ("Casos", "Servicios"), no el
 * `<title>` completo, porque en el resultado de búsqueda se muestran como una
 * ruta y "Casos de cumplimiento ambiental empresarial · Ekosolv" no cabe.
 */
const rutaActual = rutasEs.find((r) => r.path === path)
const nodos = [
  organizacion('es'),
  sitioWeb('es'),
  !noindex && rutaActual && path !== '/'
    ? migas([
        { nombre: 'Inicio', path: '/' },
        { nombre: rutaActual.titulo, path: rutaActual.path },
      ])
    : null,
  rutaActual
    ? servicioDeRuta(rutaActual.path, rutaActual.titulo, rutaActual.descripcion, 'es')
    : null,
  ...nodosSchema,
].filter(Boolean)
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alt && <link rel="alternate" hreflang="es" href={url(alt.es)} />}
    {alt && <link rel="alternate" hreflang="en" href={url(alt.en)} />}
    {alt && <link rel="alternate" hreflang="x-default" href={url(alt.es)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && section && <meta property="article:section" content={section} />}
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ekosolv" />
    <meta property="og:image" content={ogImageUrl} />
    {/* WhatsApp solo arma la previsualización grande si conoce el tamaño antes de bajar la imagen. */}
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {/* Faltaba, y sí estaba en LayoutEn: los dos layouts deben ser espejo. */}
    <meta name="twitter:image" content={ogImageUrl} />
    {/* Reserva de derechos. Va en el <head> porque es lo primero que queda en
        una copia hecha con "guardar como" o con un scraper: el aviso viaja con
        el archivo aunque se pierda el footer. Ver LICENSE en la raíz. */}
    <meta name="copyright" content={`© ${new Date().getFullYear()} Mike Rodríguez. Todos los derechos reservados.`} />
    <meta name="author" content="Mike Rodríguez" />
    <meta name="rights" content="All rights reserved. Prohibida la reproducción, adaptación o reutilización total o parcial de este sitio, su código y su diseño." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300..700&family=Geist+Mono:wght@300..500&display=swap" rel="stylesheet" />
    <SchemaOrg nodos={nodos} />
    <ClientRouter />
  </head>
  <body>
    <div id="cursor"></div>
    <div class="blobs" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>

    <Nav lang="es" activePath={activePath} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <AsesorChat lang="es" />

    <script>
      // Cursor trailing dot
      (() => {
        const dot = document.getElementById("cursor");
        if (!dot || window.matchMedia("(pointer: coarse)").matches) {
          if (dot) dot.style.display = "none";
          return;
        }
        let x = 0, y = 0, tx = 0, ty = 0;
        window.addEventListener("pointermove", (e) => { tx = e.clientX; ty = e.clientY; });
        document.addEventListener("pointerover", (e) => {
          const hover = (e.target as Element).closest("a, button, .svc, .case, .norm, [data-link]");
          if (dot) dot.classList.toggle("big", !!hover);
        });
        function tick() {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          dot.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
          requestAnimationFrame(tick);
        }
        tick();
      })();


      // Reveal on scroll
      function initRevealers() {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(en => {
            if (en.isIntersecting) {
              en.target.classList.add("in");
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll(".reveal").forEach(el => io.observe(el));
      }

      // Accordion for normativas
      function initAccordion() {
        document.querySelectorAll(".norm").forEach(n => {
          n.addEventListener("click", () => {
            const open = n.getAttribute("data-open") === "true";
            n.setAttribute("data-open", open ? "false" : "true");
          });
        });
      }

      // Chip toggles for contact form
      function initChips() {
        document.querySelectorAll(".chip").forEach(c => {
          c.addEventListener("click", (e) => {
            e.preventDefault();
            const on = c.classList.toggle("on");
            c.setAttribute("aria-pressed", on ? "true" : "false");
          });
        });
      }

      // Reorganiza los blobs de fondo al azar en cada navegación
      function randomizeBlobs() {
        const zones = [
          { xMin: -18, xMax: 4,  yMin: -22, yMax: 2 },
          { xMin: 48,  xMax: 76, yMin: 6,   yMax: 48 },
          { xMin: 2,   xMax: 34, yMin: 48,  yMax: 78 },
        ];
        document.querySelectorAll<HTMLElement>(".blob").forEach((el, i) => {
          const z = zones[i % zones.length];
          const bx = z.xMin + Math.random() * (z.xMax - z.xMin);
          const by = z.yMin + Math.random() * (z.yMax - z.yMin);
          el.style.setProperty("--bx", `${bx.toFixed(1)}%`);
          el.style.setProperty("--by", `${by.toFixed(1)}%`);
        });
      }

      // Run on load and after each Astro view transition
      function init() {
        initRevealers();
        initAccordion();
        initChips();
        randomizeBlobs();
      }

      document.addEventListener("astro:page-load", init);
      init();
    </script>
  </body>
</html>
