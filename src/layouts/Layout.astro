---
import "../styles/global.css"
import "../styles/blog.css"
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/Nav.astro'
import { SITE_URL, url } from '../lib/site'
import { hreflangFor } from '../lib/rutas'

interface Props {
  title?: string
  description?: string
  activePath?: string
  /** Ruta canónica de esta página. Por defecto usa activePath. */
  path?: string
  /**
   * Imagen para compartir en redes (ruta absoluta desde /public).
   * La de portada se genera con `node scripts/og/generar.mjs`.
   */
  ogImage?: string
  /**
   * Excluye la página de los buscadores. Para documentación interna del
   * proyecto, que vive en el sitio pero no es contenido comercial.
   */
  noindex?: boolean
}

const {
  title = "Eko — Consultoría ambiental ANLA",
  description = "Acompañamos a importadores, productores y operadores de tecnología en Colombia a construir sus planes de gestión ambiental, licencias y reportes.",
  activePath = "/",
  path = activePath,
  ogImage = "/og/portada.jpg",
  noindex = false,
} = Astro.props

/*
 * Un solo meta robots por página. Se combinan las directivas de indexación con
 * la reserva frente a entrenamiento de modelos: si van en dos etiquetas
 * separadas los buscadores las fusionan igual, pero queda una etiqueta
 * duplicada difícil de auditar. `noai` y `noimageai` no son estándar formal;
 * valen como manifestación expresa de voluntad, que es lo que exige la
 * cláusula 3.7 de LICENSE para que la prohibición sea oponible.
 */
const robots = [noindex ? 'noindex, nofollow' : null, 'noai', 'noimageai']
  .filter(Boolean)
  .join(', ')

const canonical = url(path)
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`
const ogImageType = ogImageUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'
const alt = hreflangFor(path)
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alt && <link rel="alternate" hreflang="es" href={url(alt.es)} />}
    {alt && <link rel="alternate" hreflang="en" href={url(alt.en)} />}
    {alt && <link rel="alternate" hreflang="x-default" href={url(alt.es)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ekosolv" />
    <meta property="og:image" content={ogImageUrl} />
    {/* WhatsApp solo arma la previsualización grande si conoce el tamaño antes de bajar la imagen. */}
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {/* Reserva de derechos. Va en el <head> porque es lo primero que queda en
        una copia hecha con "guardar como" o con un scraper: el aviso viaja con
        el archivo aunque se pierda el footer. Ver LICENSE en la raíz. */}
    <meta name="copyright" content={`© ${new Date().getFullYear()} Mike Rodríguez. Todos los derechos reservados.`} />
    <meta name="author" content="Mike Rodríguez" />
    <meta name="rights" content="All rights reserved. Prohibida la reproducción, adaptación o reutilización total o parcial de este sitio, su código y su diseño." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300..700&family=Geist+Mono:wght@300..500&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <div id="cursor"></div>
    <div class="blobs" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>

    <Nav lang="es" activePath={activePath} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <a
      href="https://wa.me/573212712773"
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-fab"
      aria-label="Chatea por WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <script>
      // Cursor trailing dot
      (() => {
        const dot = document.getElementById("cursor");
        if (!dot || window.matchMedia("(pointer: coarse)").matches) {
          if (dot) dot.style.display = "none";
          return;
        }
        let x = 0, y = 0, tx = 0, ty = 0;
        window.addEventListener("pointermove", (e) => { tx = e.clientX; ty = e.clientY; });
        document.addEventListener("pointerover", (e) => {
          const hover = (e.target as Element).closest("a, button, .svc, .case, .norm, [data-link]");
          if (dot) dot.classList.toggle("big", !!hover);
        });
        function tick() {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          dot.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
          requestAnimationFrame(tick);
        }
        tick();
      })();


      // Reveal on scroll
      function initRevealers() {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(en => {
            if (en.isIntersecting) {
              en.target.classList.add("in");
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll(".reveal").forEach(el => io.observe(el));
      }

      // Accordion for normativas
      function initAccordion() {
        document.querySelectorAll(".norm").forEach(n => {
          n.addEventListener("click", () => {
            const open = n.getAttribute("data-open") === "true";
            n.setAttribute("data-open", open ? "false" : "true");
          });
        });
      }

      // Chip toggles for contact form
      function initChips() {
        document.querySelectorAll(".chip").forEach(c => {
          c.addEventListener("click", (e) => {
            e.preventDefault();
            const on = c.classList.toggle("on");
            c.setAttribute("aria-pressed", on ? "true" : "false");
          });
        });
      }

      // Reorganiza los blobs de fondo al azar en cada navegación
      function randomizeBlobs() {
        const zones = [
          { xMin: -18, xMax: 4,  yMin: -22, yMax: 2 },
          { xMin: 48,  xMax: 76, yMin: 6,   yMax: 48 },
          { xMin: 2,   xMax: 34, yMin: 48,  yMax: 78 },
        ];
        document.querySelectorAll<HTMLElement>(".blob").forEach((el, i) => {
          const z = zones[i % zones.length];
          const bx = z.xMin + Math.random() * (z.xMax - z.xMin);
          const by = z.yMin + Math.random() * (z.yMax - z.yMin);
          el.style.setProperty("--bx", `${bx.toFixed(1)}%`);
          el.style.setProperty("--by", `${by.toFixed(1)}%`);
        });
      }

      // Run on load and after each Astro view transition
      function init() {
        initRevealers();
        initAccordion();
        initChips();
        randomizeBlobs();
      }

      document.addEventListener("astro:page-load", init);
      init();
    </script>
  </body>
</html>
