---
import DynamicComponent from './DynamicComponent.astro'

const { blok, language, translate } = Astro.props
---

<main class="has-[>*:nth-child(3)]:space-y-16 has-[>*:nth-child(3)]:md:space-y-32">
  {blok.body?.map((section) => (
    <DynamicComponent language={language} translate={translate} blok={section} />
  ))}
</main>
