---
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
---

<Layout title="Agenda una recolección — Ekosolv" description="Formulario de recolección de residuos electrónicos (RAEE). Programa el retiro de tus equipos obsoletos con transporte certificado y certificado de disposición final." activePath="/agenda-una-recoleccion">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · Recolección</div>
      <div class="l">Cuidando el planeta, paso a paso</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Agenda una <em>recolección</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Formulario de recolección de residuos electrónicos (RAEE). Por favor completa todos los campos requeridos (<span style="color:var(--deep)">*</span>). Incluye transporte certificado y certificado de disposición final.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="contact-grid reveal">
      <div class="contact-info">
        <div class="row"><div class="k">Email</div><div class="v ulink">info@ekosolv.com</div></div>
        <div class="row"><div class="k">Teléfono</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">WhatsApp</div><div class="v">+57 322 226 6729</div></div>
        <div class="row"><div class="k">Oficina</div><div class="v">Edificio RPTV<br>Carrera 15 #31B-33, Bogotá D.C.</div></div>
        <div class="row"><div class="k">Horario</div><div class="v">Lun – Vie · 8:00 – 17:30 COT</div></div>
        <div class="row">
          <div class="k">Atajo</div>
          <div class="v">
            ¿Prefieres WhatsApp?<br>
            <a href="https://wa.me/573212712773" target="_blank" rel="noopener" style="color:var(--deep); font-weight:500">Agenda por WhatsApp →</a>
          </div>
        </div>
      </div>

      <form class="form" id="recoleccion-form">
        <div class="form-row">
          <div class="field">
            <label for="first_name">Nombre *</label>
            <input id="first_name" type="text" name="first_name" placeholder="Tu nombre" required />
          </div>
          <div class="field">
            <label for="last_name">Apellido *</label>
            <input id="last_name" type="text" name="last_name" placeholder="Tu apellido" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email">Email *</label>
            <input id="email" type="email" name="email" placeholder="tu@correo.co" required />
          </div>
          <div class="field">
            <label for="phone">Teléfono *</label>
            <input id="phone" type="tel" name="phone" placeholder="+57" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="company">Empresa</label>
            <input id="company" type="text" name="company" placeholder="Nombre de la compañía" />
          </div>
          <div class="field">
            <label for="country">País / región *</label>
            <input id="country" type="text" name="country" placeholder="Colombia" value="Colombia" required />
          </div>
        </div>
        <div class="field">
          <label for="address">Dirección *</label>
          <input id="address" type="text" name="address" placeholder="Calle / carrera y número" required />
        </div>
        <div class="field">
          <label>Dirección — línea 2</label>
          <input type="text" name="address2" placeholder="Apartamento, oficina, piso (opcional)" />
        </div>
        <div class="form-row">
          <div class="field">
            <label for="city">Ciudad *</label>
            <input id="city" type="text" name="city" placeholder="Bogotá D.C." required />
          </div>
          <div class="field">
            <label for="postal_code">Código postal</label>
            <input id="postal_code" type="text" name="postal_code" placeholder="110111" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="waste_type">Tipo de residuo</label>
            <select id="waste_type" name="waste_type">
              <option value="">Selecciona…</option>
              <option value="raee_computo">RAEE · Cómputo y periféricos</option>
              <option value="raee_telco">RAEE · Telecomunicaciones</option>
              <option value="raee_datacenter">RAEE · Infraestructura de data center</option>
              <option value="baterias">Baterías y pilas</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="field">
            <label for="estimated_quantity">Cantidad estimada</label>
            <input id="estimated_quantity" type="text" name="estimated_quantity" placeholder="Ej. 40 equipos / 300 kg" />
          </div>
        </div>
        <div class="field">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" placeholder="Detalles adicionales y fecha tentativa de recolección…"></textarea>
        </div>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute; left:-9999px; height:0; width:0; opacity:0" />
        <p id="recoleccion-error" style="display:none; color:#b04a2e; margin:0"></p>
        <button type="submit" class="submit">
          <span class="submit-text">Enviar</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </div>
  </section>

  <SiteFooter />

  <script>
    const form = document.getElementById("recoleccion-form") as HTMLFormElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector(".submit") as HTMLButtonElement;
      const text = form.querySelector(".submit-text") as HTMLElement;
      const err = document.getElementById("recoleccion-error") as HTMLElement;
      btn.disabled = true;
      text.textContent = "Enviando…";
      err.style.display = "none";
      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch("/api/recolecciones", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || "No se pudo enviar la solicitud.");
        text.textContent = `¡Solicitud ${j.consecutive} recibida! ✓`;
        btn.style.background = "var(--forest)";
        form.querySelectorAll("input, textarea").forEach((el) => ((el as HTMLInputElement).disabled = true));
      } catch (ex) {
        err.textContent = ex instanceof Error ? ex.message : "Error de red. Intenta de nuevo o escríbenos por WhatsApp.";
        err.style.display = "block";
        btn.disabled = false;
        text.textContent = "Enviar";
      }
    });
  </script>
</Layout>
