---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Agenda una recolección — Ekosolv" description="Formulario de recolección de residuos electrónicos (RAEE). Programa el retiro de tus equipos obsoletos con transporte certificado y certificado de disposición final." activePath="/agenda-una-recoleccion">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · Recolección</div>
      <div class="l">Cuidando el planeta, paso a paso</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Agenda una <em>recolección</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Formulario de recolección de residuos electrónicos (RAEE). Por favor completa todos los campos requeridos (<span style="color:var(--deep)">*</span>). Incluye transporte certificado y certificado de disposición final.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="contact-grid reveal">
      <div class="contact-info">
        <div class="row"><div class="k">Email</div><div class="v ulink">info@ekosolv.com</div></div>
        <div class="row"><div class="k">Teléfono</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">WhatsApp</div><div class="v">+57 322 226 6729</div></div>
        <div class="row"><div class="k">Oficina</div><div class="v">Edificio RPTV<br>Carrera 15 #31B-33, Bogotá D.C.</div></div>
        <div class="row"><div class="k">Horario</div><div class="v">Lun – Vie · 8:00 – 17:30 COT</div></div>
        <div class="row">
          <div class="k">Atajo</div>
          <div class="v">
            ¿Prefieres WhatsApp?<br>
            <a href="https://wa.me/573212712773" target="_blank" rel="noopener" style="color:var(--deep); font-weight:500">Agenda por WhatsApp →</a>
          </div>
        </div>
      </div>

      <form class="form" id="recoleccion-form">
        <div class="form-row">
          <div class="field">
            <label>Nombre *</label>
            <input type="text" name="first_name" placeholder="Tu nombre" required />
          </div>
          <div class="field">
            <label>Apellido *</label>
            <input type="text" name="last_name" placeholder="Tu apellido" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Email *</label>
            <input type="email" name="email" placeholder="tu@correo.co" required />
          </div>
          <div class="field">
            <label>Teléfono *</label>
            <input type="tel" name="phone" placeholder="+57" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Empresa</label>
            <input type="text" name="company" placeholder="Nombre de la compañía" />
          </div>
          <div class="field">
            <label>País / región *</label>
            <input type="text" name="country" placeholder="Colombia" value="Colombia" required />
          </div>
        </div>
        <div class="field">
          <label>Dirección *</label>
          <input type="text" name="address" placeholder="Calle / carrera y número" required />
        </div>
        <div class="field">
          <label>Dirección — línea 2</label>
          <input type="text" name="address2" placeholder="Apartamento, oficina, piso (opcional)" />
        </div>
        <div class="form-row">
          <div class="field">
            <label>Ciudad *</label>
            <input type="text" name="city" placeholder="Bogotá D.C." required />
          </div>
          <div class="field">
            <label>Código postal</label>
            <input type="text" name="postal_code" placeholder="110111" />
          </div>
        </div>
        <div class="field">
          <label>Mensaje</label>
          <textarea name="message" placeholder="Tipo de equipos, cantidad aproximada y fecha tentativa de recolección…"></textarea>
        </div>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute; left:-9999px; height:0; width:0; opacity:0" />
        <p id="recoleccion-error" style="display:none; color:#b04a2e; margin:0"></p>
        <button type="submit" class="submit">
          <span class="submit-text">Enviar</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">¿Un nuevo <em>expediente</em><br>en el radar?</div>
        <a href="/contacto" class="foot-cta">Escríbenos <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Consultores en Sostenibilidad" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Consultoría ambiental especializada en cumplimiento ANLA, ESG y economía circular.</p>
        </div>
        <div><h5>Servicios</h5><ul><li><a href="/ekonsulting">EKONSULTING</a></li><li><a href="/ekoraee">EKORAEE</a></li><li><a href="/ekopartner">EKOPARTNER</a></li><li><a href="/ekotrading">EKOTRADING</a></li></ul></div>
        <div><h5>Sitio</h5><ul><li><a href="/">Inicio</a></li><li><a href="/quienes-somos">Nosotros</a></li><li><a href="/agenda-una-recoleccion">Agenda</a></li><li><a href="/blog">Diario</a></li></ul></div>
        <div><h5>Contacto</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>

  <script>
    const form = document.getElementById("recoleccion-form") as HTMLFormElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector(".submit") as HTMLButtonElement;
      const text = form.querySelector(".submit-text") as HTMLElement;
      const err = document.getElementById("recoleccion-error") as HTMLElement;
      btn.disabled = true;
      text.textContent = "Enviando…";
      err.style.display = "none";
      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch("/api/recolecciones", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || "No se pudo enviar la solicitud.");
        text.textContent = `¡Solicitud ${j.consecutive} recibida! ✓`;
        btn.style.background = "var(--forest)";
        form.querySelectorAll("input, textarea").forEach((el) => ((el as HTMLInputElement).disabled = true));
      } catch (ex) {
        err.textContent = ex instanceof Error ? ex.message : "Error de red. Intenta de nuevo o escríbenos por WhatsApp.";
        err.style.display = "block";
        btn.disabled = false;
        text.textContent = "Enviar";
      }
    });
  </script>
</Layout>
