---
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import TypeformFlow from '../components/TypeformFlow.astro'
import type { TFStep } from '../components/TypeformFlow.astro'
import { CONSENT_HTML, AVISO_PRIVACIDAD } from '../lib/legal'

const steps: TFStep[] = [
  {
    title: '¿Cómo te llamas?',
    subtitle: 'Empecemos por lo básico.',
    row: true,
    fields: [
      { type: 'text', name: 'first_name', label: 'Nombre', placeholder: 'Tu nombre', required: true, autocomplete: 'given-name' },
      { type: 'text', name: 'last_name', label: 'Apellido', placeholder: 'Tu apellido', required: true, autocomplete: 'family-name' },
    ],
  },
  {
    title: '¿Cómo te contactamos?',
    subtitle: 'Coordinamos el retiro por aquí.',
    row: true,
    fields: [
      { type: 'email', name: 'email', label: 'Email', placeholder: 'tu@correo.co', required: true, autocomplete: 'email' },
      { type: 'tel', name: 'phone', label: 'Teléfono', placeholder: '+57', required: true, autocomplete: 'tel' },
    ],
  },
  {
    title: '¿Desde qué organización?',
    row: true,
    fields: [
      { type: 'text', name: 'company', label: 'Empresa', placeholder: 'Nombre de la compañía', autocomplete: 'organization' },
      { type: 'text', name: 'country', label: 'País / región', placeholder: 'Colombia', value: 'Colombia', required: true },
    ],
  },
  {
    title: '¿Dónde recogemos los equipos?',
    subtitle: 'Dirección donde están los residuos a retirar.',
    fields: [
      { type: 'text', name: 'address', label: 'Dirección', placeholder: 'Calle / carrera y número', required: true, autocomplete: 'address-line1' },
      { type: 'text', name: 'address2', label: 'Dirección — línea 2', placeholder: 'Apartamento, oficina, piso (opcional)', autocomplete: 'address-line2' },
    ],
  },
  {
    title: '¿En qué ciudad?',
    row: true,
    fields: [
      { type: 'text', name: 'city', label: 'Ciudad', placeholder: 'Bogotá D.C.', required: true, autocomplete: 'address-level2' },
      { type: 'text', name: 'postal_code', label: 'Código postal', placeholder: '110111', autocomplete: 'postal-code' },
    ],
  },
  {
    title: '¿Qué tipo de residuo es?',
    subtitle: 'Elige la categoría que mejor lo describe.',
    fields: [
      {
        type: 'choice',
        name: 'waste_type',
        label: 'Tipo de residuo',
        options: [
          { value: 'raee_computo', label: 'RAEE · Cómputo y periféricos' },
          { value: 'raee_telco', label: 'RAEE · Telecomunicaciones' },
          { value: 'raee_datacenter', label: 'RAEE · Infraestructura de data center' },
          { value: 'baterias', label: 'Baterías y pilas' },
          { value: 'otro', label: 'Otro' },
        ],
      },
    ],
  },
  {
    title: 'Cantidad y detalles',
    subtitle: 'Un estimado nos ayuda a planear el transporte.',
    fields: [
      { type: 'text', name: 'estimated_quantity', label: 'Cantidad estimada', placeholder: 'Ej. 40 equipos / 300 kg' },
      { type: 'textarea', name: 'message', label: 'Mensaje', placeholder: 'Detalles adicionales y fecha tentativa de recolección…' },
    ],
  },
]
---

<Layout title="Agenda una recolección — Ekosolv" description="Formulario de recolección de residuos electrónicos (RAEE). Programa el retiro de tus equipos obsoletos con transporte certificado y certificado de disposición final." activePath="/agenda-una-recoleccion">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · Recolección</div>
      <div class="l">Cuidando el planeta, paso a paso</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Agenda una <em>recolección</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Residuos electrónicos (RAEE) con transporte certificado y certificado de disposición final. Te tomará menos de un minuto — una pregunta a la vez.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="reveal">
      <TypeformFlow
        formId="recoleccion-form"
        endpoint="/api/recolecciones"
        submitLabel="Enviar solicitud"
        successMode="consecutive"
        successTitle="¡Solicitud recibida!"
        successBody="Recibimos tu solicitud de recolección. Te contactamos para coordinar el retiro."
        whatsapp="https://wa.me/573212712773"
        steps={steps}
      />
    </div>

    <p class="tf-alt reveal">
      ¿Prefieres coordinar rápido?
      <a href="https://wa.me/573212712773" target="_blank" rel="noopener">Agenda por WhatsApp →</a>
    </p>
  </section>

  <SiteFooter />

  <style>
    .tf-alt {
      margin-top: clamp(40px, 6vw, 64px);
      padding-top: 26px;
      border-top: 1px solid var(--line);
      font-size: 15px;
      color: var(--ink-2);
      max-width: 720px;
    }
    .tf-alt a { color: var(--deep); font-weight: 500; margin-left: 6px; }
  </style>
</Layout>
