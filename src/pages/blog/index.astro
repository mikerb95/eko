---
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import { getPosts } from '../../lib/cms'

const posts = await getPosts()
const featured = posts.find(p => p.featured) || posts[0]
const rest = posts.filter(p => p !== featured)
---

<Layout title="Blog — Eko" activePath="/blog">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Blog</div>
      <div class="l">{posts.length} artículos · actualizado semanalmente</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Notas de <em>campo</em><br>regulatorio.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Análisis, guías y alertas sobre el cumplimiento ambiental en el sector tecnológico colombiano. Escrito por el equipo, sin editor de contenidos detrás.
    </p>
  </section>

  <section class="section wrap">
    <a class="blog-featured reveal" href={`/blog/${featured.slug}`} style="view-transition-name: featured-post">
      <div class={`blog-featured-media accent-${featured.accent}`}>
        <div class="bfm-coords">
          <span>ES · {featured.date}</span>
          <span>{featured.readtime} de lectura</span>
        </div>
        <div class="bfm-badge">Destacado</div>
      </div>
      <div class="blog-featured-body">
        <div class="blog-kicker">
          <span class="dot"></span>{featured.category}
        </div>
        <h2 class="blog-featured-title">{featured.title}</h2>
        <p class="lede" style="margin-top:20px">{featured.lede}</p>
        <div class="blog-read">
          Leer artículo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </div>
      </div>
    </a>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Archivo · 2026</div>
        <h2>Lecturas <em>recientes</em>.</h2>
      </div>
      <div class="meta">Publicamos cuando hay algo que realmente aporte — no por calendario editorial. Promedio: dos piezas al mes.</div>
    </div>

    <div class="blog-list reveal">
      {rest.map((p, i) => (
        <a class="blog-row" href={`/blog/${p.slug}`}>
          <div class="br-num">{String(i + 2).padStart(2, "0")}</div>
          <div class="br-cat"><span class={`d accent-${p.accent}`}></span>{p.category}</div>
          <div class="br-title">{p.title}</div>
          <div class="br-date">{p.date}</div>
          <div class="br-time">{p.readtime}</div>
          <div class="br-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M7 17L17 7M9 7h8v8"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.3fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Newsletter</div>
          <h2 style="margin-top:14px; max-width:18ch">Un <em>brief</em> mensual para equipos HSE.</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:52ch; font-size:15px; line-height:1.55">
            Cambios regulatorios del mes, vencimientos próximos, interpretaciones de la autoridad y un caso breve. Sin ruido.
          </p>
        </div>
        <form class="news-form" id="news-form">
          <div class="news-field">
            <label>Correo corporativo</label>
            <div class="news-input-row">
              <input type="email" placeholder="tu@empresa.co" required />
              <button type="submit">
                Suscribirme
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </button>
            </div>
            <div class="news-ok" id="news-ok">Listo — recibirás el próximo brief a fin de mes.</div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">¿Un nuevo <em>expediente</em><br>en el radar?</div>
        <a href="/contacto" class="foot-cta">
          Escríbenos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Consultores en Sostenibilidad" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Consultoría ambiental especializada en cumplimiento ANLA para el sector tecnológico.</p>
        </div>
        <div><h5>Sitio</h5><ul><li><a href="/">Inicio</a></li><li><a href="/servicios">Servicios</a></li><li><a href="/normativas">Normativas</a></li><li><a href="/casos">Casos</a></li><li><a href="/blog">Blog</a></li></ul></div>
        <div><h5>Contacto</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
        <div><h5>Legal</h5><ul><li>Política de tratamiento</li><li>Términos de servicio</li><li>Código de ética</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
      </div>
    </div>
  </footer>

  <script>
    const form = document.getElementById("news-form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector("input") as HTMLInputElement;
      const ok = document.getElementById("news-ok") as HTMLElement;
      if (input) input.value = "";
      if (ok) ok.style.opacity = "1";
    });
  </script>
</Layout>
