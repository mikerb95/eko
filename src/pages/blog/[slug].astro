---
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import { getPosts, getPostBySlug } from '../../lib/cms'
import SiteFooter from '../../components/SiteFooter.astro'
import { enlacesCompartir } from '../../lib/redes'

const { slug } = Astro.params
const post = slug ? await getPostBySlug(slug) : null
if (!post) return Astro.redirect('/blog')

const allPosts = await getPosts()
const related = allPosts.filter(p => p.slug !== post.slug).slice(0, 3)

const compartir = enlacesCompartir(`/blog/${post.slug}`, post.title)
---

<Layout title={`${post.title} — Eko`} description={post.lede} activePath="/blog" path={`/blog/${post.slug}`}>
  <section class="page-head wrap">
    <div class="page-strip">
      <a class="l ulink" href="/blog">← Diario</a>
      <div class="l">{post.category} · {post.readtime}</div>
    </div>
    <div class="blog-kicker reveal" style="margin-top:40px">
      <span class={`dot accent-${post.accent}`}></span>{post.category} · {post.date}
    </div>
    <h1 class="display reveal post-title" style="margin-top:24px; font-size:clamp(44px,7vw,104px)">
      {post.title}
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">{post.lede}</p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class={`post-hero accent-${post.accent} reveal`} style="view-transition-name: post-hero">
      <div class="ph-coords">
        <span>Por Equipo Eko</span>
        <span>{post.date}</span>
      </div>
    </div>

    <div class="post-body reveal">
      {post.sections.map(s => {
        if (s.type === "p") return <p class="post-p">{s.text}</p>
        if (s.type === "h2") return <h2 class="post-h2">{s.text}</h2>
        if (s.type === "pull") return <blockquote class="post-pull">{s.text}</blockquote>
        if (s.type === "list") return (
          <ul class="post-list">
            {s.items?.map(item => <li>{item}</li>)}
          </ul>
        )
        return null
      })}
    </div>

    <div class="post-foot reveal">
      {/*
        Endpoints públicos de compartir: son enlaces normales, sin API ni
        token. Instagram no tiene equivalente web, por eso no está.
        `rel="nofollow"` porque son acciones, no contenido que valga indexar.
      */}
      <div class="pf-share">
        <span class="l">Compartir</span>
        <a href={compartir.linkedin} target="_blank" rel="noopener noreferrer nofollow">LinkedIn</a>
        <a href={compartir.facebook} target="_blank" rel="noopener noreferrer nofollow">Facebook</a>
        <a href={compartir.whatsapp} target="_blank" rel="noopener noreferrer nofollow">WhatsApp</a>
        <a href={compartir.correo} rel="nofollow">Correo</a>
        <button type="button" class="pf-copy" data-copiar={Astro.url.href}>Copiar enlace</button>
      </div>
      <a class="pf-next" href="/contacto">
        <div>
          <div class="l">¿Esto te pasa a ti?</div>
          <div class="t">Pide un diagnóstico →</div>
        </div>
      </a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Seguir leyendo</div>
        <h2>Otras <em>notas</em>.</h2>
      </div>
    </div>
    <div class="blog-list reveal">
      {related.map((p, i) => (
        <a class="blog-row" href={`/blog/${p.slug}`}>
          <div class="br-num">{String(i + 1).padStart(2, "0")}</div>
          <div class="br-cat"><span class={`d accent-${p.accent}`}></span>{p.category}</div>
          <div class="br-title">{p.title}</div>
          <div class="br-date">{p.date}</div>
          <div class="br-time">{p.readtime}</div>
          <div class="br-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M7 17L17 7M9 7h8v8"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <SiteFooter />

  <script>
    // Prevent default on share links (no real share API wired)
    document.querySelectorAll(".pf-share a").forEach(a => {
      a.addEventListener("click", e => e.preventDefault());
    });
  </script>
</Layout>
