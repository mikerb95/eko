---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contacto — Ekosolv" activePath="/contacto">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Contacto</div>
      <div class="l">Respondemos en &lt; 24 h hábiles</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Un <em>diagnóstico</em><br>para empezar.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Cuéntanos brevemente qué obligación necesitas resolver. Te contactamos en 24 horas hábiles para una sesión sin costo de 45 minutos.
    </p>
  </section>

  <section class="section wrap">
    <div class="band reveal" style="margin-bottom: clamp(32px, 4vw, 56px)">
      <div class="band-grid" style="grid-template-columns: 1fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Recolección</div>
          <h2 style="margin-top:14px; max-width:20ch">¿Necesitas retirar equipos <em>obsoletos</em>?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:16px; max-width:44ch; font-size:15px; line-height:1.55">
            Agenda una recolección de residuos electrónicos (RAEE) para tu empresa. Incluye transporte certificado y certificado de disposición final.
          </p>
        </div>
        <div style="display:flex; flex-direction:column; justify-content:center; gap:20px">
          <a href="https://wa.me/573212712773" target="_blank" rel="noopener" class="foot-cta" style="background: color-mix(in oklab, #fff 15%, transparent); border: 1px solid color-mix(in oklab, #fff 25%, transparent);">
            Agendar por WhatsApp
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <div style="font-family: var(--font-mono); font-size:11.5px; color: color-mix(in oklab, #fff 55%, transparent); letter-spacing:0.06em; text-transform:uppercase;">
            +57 321 271 2773 · info@ekosolv.com
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="contact-grid reveal">
      <div class="contact-info">
        <div class="row"><div class="k">Email</div><div class="v ulink">info@ekosolv.com</div></div>
        <div class="row"><div class="k">Teléfono</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">WhatsApp</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">Oficina</div><div class="v">Edificio RPTV<br>Carrera 15 #31B-33, Bogotá D.C.</div></div>
        <div class="row"><div class="k">Horario</div><div class="v">Lun – Vie · 8:00 – 17:30 COT</div></div>
        <div class="row">
          <div class="k">Emergencias</div>
          <div class="v">
            Visitas no programadas de la autoridad ambiental:<br>
            <span style="color:var(--deep); font-weight:500">+57 322 226 6729</span> · 24/7
          </div>
        </div>
      </div>

      <form class="form" id="contact-form">
        <div class="form-row">
          <div class="field">
            <label>Nombre</label>
            <input type="text" placeholder="Tu nombre" />
          </div>
          <div class="field">
            <label>Empresa</label>
            <input type="text" placeholder="Nombre de la compañía" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Email corporativo</label>
            <input type="email" placeholder="tu@empresa.co" />
          </div>
          <div class="field">
            <label>Teléfono</label>
            <input type="tel" placeholder="+57" />
          </div>
        </div>
        <div class="field">
          <label>Sector</label>
          <select>
            <option>Importadora de tecnología</option>
            <option>Ensambladora / productora</option>
            <option>Telecomunicaciones</option>
            <option>Data center / infraestructura</option>
            <option>Retail electrónico</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="field">
          <label>Línea de servicio (selecciona las que apliquen)</label>
          <div class="chips">
            <button type="button" class="chip">EKONSULTING · Asesoría ANLA</button>
            <button type="button" class="chip on">EKORAEE · Residuos electrónicos</button>
            <button type="button" class="chip">EKOPARTNER · Operación residuos</button>
            <button type="button" class="chip">EKOTRADING · Activos IT</button>
            <button type="button" class="chip">Estrategia ESG</button>
          </div>
        </div>
        <div class="field">
          <label>Cuéntanos más</label>
          <textarea placeholder="Contexto de la obligación, tipo de residuos, volúmenes estimados, vencimientos próximos…"></textarea>
        </div>
        <button type="submit" class="submit">
          <span class="submit-text">Enviar solicitud</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </button>
      </form>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">¿Un nuevo <em>expediente</em><br>en el radar?</div>
        <a href="/contacto" class="foot-cta">
          Escríbenos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Consultores en Sostenibilidad" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Consultoría ambiental especializada en cumplimiento ANLA, ESG y economía circular.</p>
        </div>
        <div><h5>Sitio</h5><ul><li><a href="/">Inicio</a></li><li><a href="/servicios">Servicios</a></li><li><a href="/normativas">Normativas</a></li><li><a href="/casos">Casos</a></li><li><a href="/blog">Diario</a></li></ul></div>
        <div><h5>Contacto</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
        <div><h5>Legal</h5><ul><li>Política de tratamiento</li><li>Términos de servicio</li><li>Código de ética</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>

  <script>
    const form = document.getElementById("contact-form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const btn = form.querySelector(".submit") as HTMLButtonElement;
      const text = form.querySelector(".submit-text") as HTMLElement;
      if (text) text.textContent = "Enviado ✓";
      if (btn) btn.style.background = "var(--forest)";
    });
  </script>
</Layout>
