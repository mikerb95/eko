---
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import TypeformFlow from '../components/TypeformFlow.astro'
import type { TFStep } from '../components/TypeformFlow.astro'
import { CONSENT_HTML, MARKETING_HTML, AVISO_PRIVACIDAD } from '../lib/legal'

const steps: TFStep[] = [
  {
    title: '¿Con quién hablamos?',
    subtitle: 'Cuéntanos quién eres y desde dónde escribes.',
    row: true,
    fields: [
      { type: 'text', name: 'name', label: 'Nombre', placeholder: 'Tu nombre', required: true, autocomplete: 'name' },
      { type: 'text', name: 'company', label: 'Empresa', placeholder: 'Nombre de la compañía', autocomplete: 'organization' },
    ],
  },
  {
    title: '¿Cómo te contactamos?',
    subtitle: 'Respondemos en menos de 24 horas hábiles.',
    row: true,
    fields: [
      { type: 'email', name: 'email', label: 'Email corporativo', placeholder: 'tu@empresa.co', required: true, autocomplete: 'email' },
      { type: 'tel', name: 'phone', label: 'Teléfono', placeholder: '+57', autocomplete: 'tel' },
    ],
  },
  {
    title: '¿A qué sector perteneces?',
    subtitle: 'Nos ayuda a preparar la sesión con el contexto correcto.',
    fields: [
      {
        type: 'choice',
        name: 'sector',
        label: 'Sector',
        options: [
          { value: 'Importadora de tecnología', label: 'Importadora de tecnología' },
          { value: 'Ensambladora / productora', label: 'Ensambladora / productora' },
          { value: 'Telecomunicaciones', label: 'Telecomunicaciones' },
          { value: 'Data center / infraestructura', label: 'Data center / infraestructura' },
          { value: 'Retail electrónico', label: 'Retail electrónico' },
          { value: 'Otro', label: 'Otro' },
        ],
      },
    ],
  },
  {
    title: '¿Qué necesitas resolver?',
    subtitle: 'Selecciona las líneas de servicio que apliquen.',
    fields: [
      {
        type: 'choice',
        name: 'service_lines',
        label: 'Línea de servicio',
        multiple: true,
        options: [
          { value: 'EKONSULTING · Asesoría ANLA', label: 'EKONSULTING', hint: 'Asesoría ANLA' },
          { value: 'EKORAEE · Residuos electrónicos', label: 'EKORAEE', hint: 'Residuos electrónicos', selected: true },
          { value: 'EKOPARTNER · Operación residuos', label: 'EKOPARTNER', hint: 'Operación residuos' },
          { value: 'EKOTRADING · Activos IT', label: 'EKOTRADING', hint: 'Activos IT' },
          { value: 'Estrategia ESG', label: 'Estrategia ESG' },
        ],
      },
    ],
  },
  {
    title: 'Cuéntanos el contexto',
    subtitle: 'Entre más detalle, mejor preparamos la sesión.',
    fields: [
      { type: 'textarea', name: 'message', label: 'Cuéntanos más', placeholder: 'Contexto de la obligación, tipo de residuos, volúmenes estimados, vencimientos próximos…' },
      { type: 'consent', name: 'consent', html: CONSENT_HTML.es },
      // Opcional y desmarcada: alimenta la lista de Zoho Campaigns, que es una
      // finalidad distinta de responder la solicitud (ver `MARKETING_HTML`).
      { type: 'consent', name: 'marketing', html: MARKETING_HTML.es, required: false, notice: AVISO_PRIVACIDAD.es },
    ],
  },
]
---

<Layout activePath="/contacto">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Contacto</div>
      <div class="l">Respondemos en &lt; 24 h hábiles</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Un <em>diagnóstico</em><br>para empezar.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Cuéntanos brevemente qué obligación necesitas resolver. Te contactamos en 24 horas hábiles para una sesión sin costo de 45 minutos.
    </p>
  </section>

  <section class="section wrap">
    <div class="band reveal" style="margin-bottom: clamp(32px, 4vw, 56px)">
      <div class="band-grid" style="grid-template-columns: 1fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Recolección</div>
          <h2 style="margin-top:14px; max-width:20ch">¿Necesitas retirar equipos <em>obsoletos</em>?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:16px; max-width:44ch; font-size:15px; line-height:1.55">
            Agenda una recolección de residuos electrónicos (RAEE) para tu empresa. Incluye transporte certificado y certificado de disposición final.
          </p>
        </div>
        <div style="display:flex; flex-direction:column; justify-content:center; gap:20px">
          <a href="https://wa.me/573212712773" target="_blank" rel="noopener" class="foot-cta" style="background: color-mix(in oklab, #fff 15%, transparent); border: 1px solid color-mix(in oklab, #fff 25%, transparent);">
            Agendar por WhatsApp
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <div style="font-family: var(--font-mono); font-size:11.5px; color: color-mix(in oklab, #fff 55%, transparent); letter-spacing:0.06em; text-transform:uppercase;">
            +57 321 271 2773 · info@ekosolv.com
          </div>
        </div>
      </div>
    </div>

    <div class="reveal">
      <TypeformFlow
        formId="contact-form"
        endpoint="/api/contacto"
        submitLabel="Enviar solicitud"
        successMode="simple"
        successTitle="Solicitud enviada"
        successBody="Gracias. Te contactamos en menos de 24 horas hábiles para agendar tu diagnóstico."
        whatsapp="https://wa.me/573212712773"
        steps={steps}
      />
    </div>
  </section>

  <SiteFooter />
</Layout>
