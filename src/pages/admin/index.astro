---
export const prerender = false
import { seedIfEmpty, getPostsAdmin, getNormativasAdmin } from '../../lib/cms'
import { listOrders } from '../../lib/ops'
import { listContacts } from '../../lib/contactos'
import { listUsers, ROLE_LABELS, type Role, type User } from '../../lib/users'
import { asegurarEsquema, cliente } from '../../lib/db'
import { iaDisponible, usuarioDeSesion } from '../../lib/asistente/motor'
import { listarRecientes, obtenerConversacion } from '../../lib/asistente/conversaciones'
import { sinRayas, turnosDe } from '../../lib/asistente/turnos'
import { escriturasDe } from '../../lib/asistente/escrituras/index'
import { listarAlertas } from '../../lib/agente/datos'
import { habilesRestantes, hoyEnBogota } from '../../lib/agente/diasHabiles'
import { ico } from '../../lib/admin/iconos'
import AdminLayout from '../../layouts/AdminLayout.astro'

// Populate DB from JSON on first run, then load everything
let seedError = ''
try {
  await seedIfEmpty()
} catch (e: any) {
  seedError = String(e?.message || e)
}
const posts = await getPostsAdmin()
const normativas = await getNormativasAdmin()
let orders: Awaited<ReturnType<typeof listOrders>> = []
try {
  orders = await listOrders()
} catch (e: any) {
  if (!seedError) seedError = String(e?.message || e)
}
const pendingOrders = orders.filter((o) => o.status === 'solicitada').length
let contacts: Awaited<ReturnType<typeof listContacts>> = []
try {
  contacts = await listContacts()
} catch (e: any) {
  if (!seedError) seedError = String(e?.message || e)
}
const newContacts = contacts.filter((c) => c.status === 'nuevo').length
const user = Astro.locals.user || 'admin'
const role = Astro.locals.role || ''
const isAdmin = role === 'admin'
let users: User[] = []
if (isAdmin) {
  try {
    users = await listUsers()
  } catch (e: any) {
    if (!seedError) seedError = String(e?.message || e)
  }
}

// ── Asistente con IA (docs/plan-asistente.md, fase 8) ─────────────────────
// Fail-soft: si las tablas del asistente fallan, el panel carga igual, sin
// recientes. La caja busca sin IA aunque no haya clave.
const asisUsuario = usuarioDeSesion(Astro.locals)
const nombreCorto = String(user).split(' ')[0]
const proponeAlgo = asisUsuario ? escriturasDe(asisUsuario.rol).length > 0 : false
const ATAJOS: Record<string, string[]> = {
  recolecciones: ['¿Qué recolecciones están pendientes esta semana?'],
  cumplimiento: ['¿Qué alertas de cumplimiento vencen en los próximos 10 días?'],
  contactos: ['¿Qué contactos no se han atendido?'],
}
const atajos = [
  ...ATAJOS.recolecciones,
  ...(['admin', 'consultor', 'lectura', 'finanzas'].includes(role) ? ATAJOS.cumplimiento : []),
  ...(['admin', 'operaciones', 'consultor'].includes(role) ? ATAJOS.contactos : []),
]
let asisRecientes: Awaited<ReturnType<typeof listarRecientes>> = []
let asisInicial: unknown = null
const verTodas = isAdmin && Astro.url.searchParams.get('todas') === '1'
if (asisUsuario) {
  try {
    await asegurarEsquema()
    const db = cliente()
    asisRecientes = await listarRecientes(db, asisUsuario, { limite: 6, todas: verTodas })
    const idConv = Astro.url.searchParams.get('c')
    const c = idConv ? await obtenerConversacion(db, idConv, asisUsuario) : null
    if (c) {
      asisInicial = {
        id: c.id,
        estado: c.estado,
        ajena: c.usuario !== asisUsuario.usuario,
        dueno: c.usuario,
        turnos: turnosDe(c.mensajes as never).map((t) => ({ ...t, respuesta: sinRayas(t.respuesta) })),
        propuesta: c.propuesta ? { origen: c.propuesta.origen, motivo: c.propuesta.motivo, herramienta: c.propuesta.herramienta, vista: c.propuesta.vista } : null,
        error: c.error,
      }
    }
  } catch (e: any) {
    console.error('[admin] asistente', e?.message || e)
  }
}
const asis = {
  ia: iaDisponible(),
  rol: role,
  rolTexto: ROLE_LABELS[role as Role] ?? role,
  proponeAlgo,
  inicial: asisInicial,
  esAdmin: isAdmin,
}

// Alertas de cumplimiento para el número de la barra lateral. Fail-soft: si
// el agente no tiene tablas todavía, la barra sale sin número.
const cuentaAlertas = { alertas: undefined as number | undefined, alertasUrgentes: 0 }
try {
  const hoy = hoyEnBogota()
  const abiertas = (await listarAlertas()).filter((a) => a.estado === 'abierta' || a.estado === 'en_curso')
  cuentaAlertas.alertas = abiertas.length
  cuentaAlertas.alertasUrgentes = abiertas.filter((a) => a.vence_el && habilesRestantes(hoy, a.vence_el) <= 5).length
} catch (e: any) {
  console.error('[admin] alertas', e?.message || e)
}
const cuentas = {
  ordenes: orders.length, ordenesNuevas: pendingOrders,
  contactos: contacts.length, contactosNuevos: newContacts,
  posts: posts.length, normativas: normativas.length, usuarios: users.length,
  ...cuentaAlertas,
}
---

<AdminLayout titulo="EKOSOLV · Panel" activo="inicio" enPanel css={['/admin/asistente.css']} cuentas={cuentas}>
  {seedError && <div slot="avisos" class="banner-error">No se pudo inicializar la base de datos: {seedError}</div>}

    <!-- INICIO -->
    <section id="panel-inicio" class="panel is-active">
      <!-- ASISTENTE -->
      <section class="asis" aria-labelledby="asis-saludo">
        <h1 id="asis-saludo" class="asis-saludo">Hola, {nombreCorto}. ¿En qué le ayudo?</h1>
        <form id="asis-form" class="asis-caja" autocomplete="off">
          <textarea id="asis-q" name="q" rows="1" maxlength="1000" placeholder={asis.ia ? 'Pregunte o busque algo: una orden, una alerta, un contacto…' : 'Busque una orden, un expediente, un contacto…'} aria-label="Pregunte o busque algo"></textarea>
          <button type="submit" class="asis-enviar" aria-label="Enviar">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h12M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div id="asis-resultados" class="asis-resultados" hidden></div>
        </form>
        <p class="asis-nota">
          {asis.ia
            ? (proponeAlgo
                ? 'La IA consulta el panel y prepara cambios; nada se guarda sin que usted lo apruebe.'
                : 'Con su rol, la IA solo consulta: no propone cambios.')
            : 'El asistente con IA aún no está activo; por ahora la caja solo busca.'}
        </p>
        {asis.ia && (
          <div class="asis-atajos" id="asis-atajos">
            {atajos.map((a) => <button type="button" class="asis-atajo" data-atajo={a}>{a}</button>)}
          </div>
        )}
        <div id="asis-hilo" class="asis-hilo" aria-live="polite"></div>
        {asisRecientes.length > 0 && (
          <div class="asis-recientes">
            <div class="asis-recientes-head">
              <span>{verTodas ? 'Conversaciones del equipo' : 'Sus conversaciones recientes'}</span>
              {isAdmin && <a href={verTodas ? '/admin' : '/admin?todas=1'}>{verTodas ? 'Ver solo las mías' : 'Ver las de todos'}</a>}
            </div>
            <ul>
              {asisRecientes.map((r) => (
                <li>
                  <a href={`/admin?c=${r.id}${verTodas ? '&todas=1' : ''}`}>
                    {r.pendiente && <span class="asis-punto" title="Tiene un cambio esperando su aprobación"></span>}
                    <span class="asis-rec-q">{r.pregunta}</span>
                    {verTodas && <span class="asis-rec-u">{r.usuario}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <div id="inicio-kpis" class="kpi-grid"></div>
      <div class="dash-grid">
        <article class="dash-card">
          <header class="dash-head">
            <div><h3>Embudo de recolecciones</h3><p>Órdenes por etapa, de la solicitud al certificado.</p></div>
            <button type="button" class="link-btn" data-ir="recolecciones" data-vista="tablero">Ver tablero</button>
          </header>
          <div id="inicio-embudo"></div>
        </article>
        <article class="dash-card">
          <header class="dash-head">
            <div><h3>Requiere atención</h3><p>Solicitudes sin confirmar y mensajes sin responder.</p></div>
          </header>
          <div id="inicio-atencion"></div>
        </article>
      </div>
      <article class="dash-card">
        <header class="dash-head">
          <div><h3>Actividad reciente</h3><p>Lo último que entró por los formularios del sitio.</p></div>
        </header>
        <div id="inicio-actividad"></div>
      </article>
    </section>

    <!-- RECOLECCIONES -->
    <section id="panel-recolecciones" class="panel">
      <div class="panel-head">
        <div>
          <h2>Órdenes de recolección</h2>
          <p class="panel-sub">Solicitudes del formulario público y su avance hasta el certificado.</p>
        </div>
        <div class="seg" role="group" aria-label="Vista">
          <button type="button" class="is-on" data-vista="tabla">Tabla</button>
          <button type="button" data-vista="tablero">Tablero</button>
        </div>
      </div>
      <div class="toolbar">
        <label class="buscar"><Fragment set:html={ico('buscar')} /><input type="search" id="order-q" placeholder="Buscar por orden, cliente, ciudad o responsable" aria-label="Buscar órdenes" /></label>
        <div class="chips" id="order-chips"></div>
      </div>
      <div id="order-list"></div>
    </section>

    <!-- CONTACTOS -->
    <section id="panel-contactos" class="panel">
      <div class="panel-head">
        <div>
          <h2>Contactos</h2>
          <p class="panel-sub">Mensajes que llegan por el formulario de contacto del sitio.</p>
        </div>
      </div>
      <div class="toolbar">
        <label class="buscar"><Fragment set:html={ico('buscar')} /><input type="search" id="contact-q" placeholder="Buscar por nombre, empresa, correo o sector" aria-label="Buscar contactos" /></label>
        <div class="chips" id="contact-chips"></div>
      </div>
      <div id="contact-list"></div>
    </section>

    <!-- BLOG -->
    <section id="panel-blog" class="panel">
      <div class="panel-head">
        <div>
          <h2>Artículos del blog</h2>
          <p class="panel-sub">Lo que se publica en /blog. Los borradores no salen en el sitio.</p>
        </div>
        <button class="btn-primary" id="new-post">+ Nuevo artículo</button>
      </div>
      <div class="toolbar">
        <label class="buscar"><Fragment set:html={ico('buscar')} /><input type="search" id="post-q" placeholder="Buscar por título, categoría o URL" aria-label="Buscar artículos" /></label>
        <div class="chips" id="post-chips"></div>
      </div>
      <div id="post-list"></div>
    </section>

    <!-- NORMATIVAS -->
    <section id="panel-normativas" class="panel">
      <div class="panel-head">
        <div>
          <h2>Normativas vigentes</h2>
          <p class="panel-sub">Las fichas de la página /normativas, en el orden en que se muestran.</p>
        </div>
        <button class="btn-primary" id="new-norm">+ Nueva normativa</button>
      </div>
      <div class="toolbar">
        <label class="buscar"><Fragment set:html={ico('buscar')} /><input type="search" id="norm-q" placeholder="Buscar por código, título o etiqueta" aria-label="Buscar normativas" /></label>
        <div class="chips" id="norm-chips"></div>
      </div>
      <div id="norm-list"></div>
    </section>

    {isAdmin && (
      <section id="panel-usuarios" class="panel">
        <div class="panel-head">
          <div>
            <h2>Usuarios del panel</h2>
            <p class="panel-sub">Quién entra al panel y qué puede hacer según su rol.</p>
          </div>
          <button class="btn-primary" id="new-user">+ Nuevo usuario</button>
        </div>
        <div class="toolbar">
          <label class="buscar"><Fragment set:html={ico('buscar')} /><input type="search" id="user-q" placeholder="Buscar por nombre o usuario" aria-label="Buscar usuarios" /></label>
          <div class="chips" id="user-chips"></div>
        </div>
        <div id="user-list"></div>
      </section>
    )}

    {isAdmin && (
      <section id="panel-ia" class="panel">
        <div class="panel-head">
          <div>
            <h2>Asistente IA: límites y consumo</h2>
            <p class="panel-sub">Topes de gasto diario y lo que lleva gastado cada persona en el mes.</p>
          </div>
        </div>
        <div class="ia-grid">
          <form id="ia-topes" class="ia-card">
            <h3>Límite de gasto diario</h3>
            <p class="muted">Si se alcanza, la IA se detiene hasta el día siguiente (hora de Colombia). El buscador sigue funcionando.</p>
            <div class="grid2">
              <label>Toda la empresa (US$)<input name="empresaUsd" type="number" min="0" max="100" step="0.5" required /></label>
              <label>Cada persona (US$)<input name="usuarioUsd" type="number" min="0" max="100" step="0.5" required /></label>
            </div>
            <p class="muted" id="ia-hoy"></p>
            <div class="drawer-actions">
              <button type="submit" class="btn-primary"><span class="t">Guardar límites</span></button>
              <p class="form-error" id="ia-err"></p>
            </div>
          </form>
          <div class="ia-card">
            <div class="ia-mes-head">
              <h3>Consumo del mes</h3>
              <input type="month" id="ia-mes" />
            </div>
            <div id="ia-consumo"><p class="muted">Cargando…</p></div>
            <a class="btn-ghost" id="ia-csv" href="#">Descargar CSV</a>
          </div>
        </div>
      </section>
    )}

  <Fragment slot="fuera">
    <!-- CONTACTO -->
    <div class="drawer" id="contact-drawer" hidden>
      <div class="drawer-bg" data-close></div>
      <div class="drawer-panel">
        <div class="drawer-head"><div><p class="drawer-kicker">Contacto</p><h3 id="contact-drawer-title">Contacto</h3></div><button class="x" data-close aria-label="Cerrar">×</button></div>
        <div class="drawer-body" id="contact-body"></div>
      </div>
    </div>

    <!-- USUARIO EDITOR -->
    <div class="drawer" id="user-drawer" hidden>
      <div class="drawer-bg" data-close></div>
      <div class="drawer-panel drawer-angosto">
        <div class="drawer-head"><div><p class="drawer-kicker">Usuarios del panel</p><h3 id="user-drawer-title">Usuario</h3></div><button class="x" data-close aria-label="Cerrar">×</button></div>
        <form id="user-form" class="drawer-body">
          <input type="hidden" name="id" />
          <fieldset class="grupo">
            <legend>Cuenta</legend>
            <label>Nombre<input name="name" placeholder="Nombre completo" required /></label>
            <label>Usuario para entrar<input name="username" placeholder="nombre.apellido o correo" required autocomplete="off" /></label>
            <label>Contraseña<input name="password" type="password" placeholder="Mín. 8 caracteres" autocomplete="new-password" /></label>
          </fieldset>
          <fieldset class="grupo">
            <legend>Acceso</legend>
            <label>Rol
              <select name="role">
                <option value="admin">Administrador</option>
                <option value="operaciones">Operaciones</option>
                <option value="logistica">Logística</option>
                <option value="consultor">Consultor</option>
                <option value="finanzas">Finanzas</option>
                <option value="lectura">Solo lectura</option>
              </select>
              <small>El rol define qué secciones ve la persona y qué puede cambiar el asistente en su nombre.</small>
            </label>
            <label class="switch">
              <input type="checkbox" name="active" checked />
              <span class="switch-ui" aria-hidden="true"></span>
              <span class="switch-txt"><b>Cuenta activa</b><small>Si se apaga, la persona no puede entrar, pero su historial se conserva.</small></span>
            </label>
          </fieldset>
          <div class="drawer-actions">
            <p class="form-error" id="user-err"></p>
            <button type="button" class="btn-ghost" data-close>Cancelar</button>
            <button type="submit" class="btn-primary"><span class="t">Guardar</span></button>
          </div>
        </form>
      </div>
    </div>

    <!-- ORDEN DE RECOLECCIÓN -->
    <div class="drawer" id="order-drawer" hidden>
      <div class="drawer-bg" data-close></div>
      <div class="drawer-panel">
        <div class="drawer-head"><div><p class="drawer-kicker">Orden de recolección</p><h3 id="order-drawer-title">Orden</h3></div><button class="x" data-close aria-label="Cerrar">×</button></div>
        <form id="order-form" class="drawer-body">
          <input type="hidden" name="id" />
          <div id="order-client"></div>
          <fieldset class="grupo">
            <legend>Gestión</legend>
            <div class="grid3">
              <label>Estado
                <select name="status">
                  <option value="solicitada">Solicitada</option>
                  <option value="confirmada">Confirmada</option>
                  <option value="programada">Programada</option>
                  <option value="en_ruta">En ruta</option>
                  <option value="recolectada">Recolectada</option>
                  <option value="certificada">Certificada</option>
                  <option value="cerrada">Cerrada</option>
                  <option value="cancelada">Cancelada</option>
                </select>
              </label>
              <label>Responsable<input name="assigned_to" placeholder="Nombre del responsable" /></label>
              <label>Fecha programada<input name="scheduled_at" type="date" /></label>
            </div>
            <label>Notas internas<textarea name="internal_notes" rows="3" placeholder="Vehículo, transportador, observaciones…"></textarea><small>Solo las ve el equipo; el cliente no las recibe.</small></label>
            <label>Comentario para la bitácora<input name="note" placeholder="Opcional: queda en el historial junto con este cambio" /></label>
          </fieldset>
          <fieldset class="grupo">
            <legend>Historial</legend>
            <div id="order-events"></div>
          </fieldset>
          <div class="drawer-actions">
            <p class="form-error" id="order-err"></p>
            <button type="button" class="btn-ghost" data-close>Cancelar</button>
            <button type="submit" class="btn-primary"><span class="t">Guardar</span></button>
          </div>
        </form>
      </div>
    </div>

    <!-- POST EDITOR -->
    <div class="drawer" id="post-drawer" hidden>
      <div class="drawer-bg" data-close></div>
      <div class="drawer-panel drawer-ancho">
        <div class="drawer-head"><div><p class="drawer-kicker">Blog</p><h3 id="post-drawer-title">Artículo</h3></div><button class="x" data-close aria-label="Cerrar">×</button></div>
        <form id="post-form" class="drawer-body">
          <input type="hidden" name="id" />
          <fieldset class="grupo">
            <legend>Encabezado</legend>
            <label>Título<input name="title" class="input-grande" required /></label>
            <label>Entradilla<textarea name="lede" rows="3"></textarea><small>Párrafo corto que abre el artículo y se usa como descripción en buscadores.</small></label>
          </fieldset>
          <fieldset class="grupo">
            <legend>Datos de publicación</legend>
            <div class="grid2">
              <label>Dirección (URL)<span class="prefijo"><span>/blog/</span><input name="slug" placeholder="se genera del título" /></span></label>
              <label>Categoría<input name="category" placeholder="Economía circular" /></label>
            </div>
            <div class="grid3">
              <label>Fecha<input name="date" placeholder="14 abr 2025" /></label>
              <label>Lectura<input name="readtime" placeholder="3 min" /></label>
              <label>Color de la categoría
                <select name="accent">
                  <option value="deep">Azul petróleo</option>
                  <option value="forest">Verde</option>
                  <option value="clay">Arcilla</option>
                </select>
              </label>
            </div>
            <label>Imagen para compartir
              <input name="image" placeholder="/og/mi-articulo.jpg" />
              <small>1200×630, subida a <code>public/og/</code>. Es lo que se ve al compartir el artículo en LinkedIn, Facebook o WhatsApp. Si se deja vacía se usa la portada genérica del sitio.</small>
            </label>
            <div class="grid2">
              <label class="switch">
                <input type="checkbox" name="featured" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-txt"><b>Destacado</b><small>Aparece arriba en el blog.</small></span>
              </label>
              <label class="switch">
                <input type="checkbox" name="borrador" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-txt"><b>Borrador</b><small>No se publica en el sitio.</small></span>
              </label>
            </div>
          </fieldset>
          <fieldset class="grupo">
            <legend>Contenido</legend>
            <div id="sections"></div>
            <div class="add-sec">
              <button type="button" data-add="p">+ Párrafo</button>
              <button type="button" data-add="h2">+ Subtítulo</button>
              <button type="button" data-add="pull">+ Cita</button>
              <button type="button" data-add="list">+ Lista</button>
            </div>
          </fieldset>
          <div class="drawer-actions">
            <p class="form-error" id="post-err"></p>
            <button type="button" class="btn-ghost" data-close>Cancelar</button>
            <button type="submit" class="btn-primary"><span class="t">Guardar</span></button>
          </div>
        </form>
      </div>
    </div>

    <!-- NORMATIVA EDITOR -->
    <div class="drawer" id="norm-drawer" hidden>
      <div class="drawer-bg" data-close></div>
      <div class="drawer-panel">
        <div class="drawer-head"><div><p class="drawer-kicker">Normativas</p><h3 id="norm-drawer-title">Normativa</h3></div><button class="x" data-close aria-label="Cerrar">×</button></div>
        <form id="norm-form" class="drawer-body">
          <input type="hidden" name="id" />
          <fieldset class="grupo">
            <legend>Ficha</legend>
            <label>Código<input name="code" placeholder="RES 1297 · 2010" required /></label>
            <label>Título<input name="title" required /></label>
            <label>Descripción<textarea name="body" rows="4"></textarea></label>
            <label>Etiquetas<input name="tags" placeholder="RAEE, Posconsumo" /><small>Separadas por coma.</small></label>
          </fieldset>
          <fieldset class="grupo">
            <legend>Ubicación en la página</legend>
            <div class="grid2">
              <label>Columna
                <select name="col"><option value="1">Columna 1</option><option value="2">Columna 2</option></select>
              </label>
              <label>Orden<input name="position" type="number" value="0" /><small>Las de número menor salen primero.</small></label>
            </div>
            <label class="switch">
              <input type="checkbox" name="borrador" />
              <span class="switch-ui" aria-hidden="true"></span>
              <span class="switch-txt"><b>Borrador</b><small>No se publica en el sitio.</small></span>
            </label>
          </fieldset>
          <div class="drawer-actions">
            <p class="form-error" id="norm-err"></p>
            <button type="button" class="btn-ghost" data-close>Cancelar</button>
            <button type="submit" class="btn-primary"><span class="t">Guardar</span></button>
          </div>
        </form>
      </div>
    </div>


    <script is:inline define:vars={{ posts, normativas, orders, contacts, users, role, asis }}>
      window.__ASIS__ = asis
      window.__POSTS__ = posts
      window.__NORMS__ = normativas
      window.__ORDERS__ = orders
      window.__CONTACTS__ = contacts
      window.__USERS__ = users
      window.__ROLE__ = role
    </script>
    <script src="/admin/admin.js" type="module"></script>
    <script src="/admin/asistente.js" type="module"></script>
  </Fragment>
</AdminLayout>
