---
// Certificado laboral de una persona del equipo, listo para imprimir o
// guardar en PDF desde el navegador (hoja carta vertical). Solo admin.
// ?persona=<usuario_id>&salario=1 para incluir el salario.
export const prerender = false
import { hoyEnBogota } from '../../../lib/agente/diasHabiles'
import { asegurarEsquema, cliente } from '../../../lib/db'
import { SITE_ADDRESS, SITE_LEGAL_NAME, SITE_NIT } from '../../../lib/site'
import { armarCertificado, type Certificado } from '../../../lib/talento/certificado'
import { leerEstado } from '../../../lib/talento/datos'

if (Astro.locals.role !== 'admin') return Astro.redirect('/admin')

const hoy = hoyEnBogota()
const id = Number(Astro.url.searchParams.get('persona'))
const conSalario = Astro.url.searchParams.get('salario') === '1'
let cert: Certificado | null = null
let error = ''
let firmaNombre = ''
let firmaCargo = ''
let nombre = ''
try {
  await asegurarEsquema()
  const e = await leerEstado(cliente(), hoy)
  const p = e.personas.find((x) => x.usuario_id === id)
  if (!p) error = 'Esa persona ya no está en el panel.'
  else if (!p.ficha) error = 'La persona todavía no tiene ficha.'
  else {
    nombre = p.nombre
    firmaNombre = e.ajustes.firmaNombre
    firmaCargo = e.ajustes.firmaCargo
    const f = p.ficha
    cert = armarCertificado({
      nombre: p.nombre,
      documento: f.documento,
      cargo: e.cargos.find((c) => c.id === f.cargo_id)?.nombre ?? '',
      tipo_contrato: f.tipo_contrato,
      fecha_ingreso: f.fecha_ingreso,
      fecha_retiro: f.fecha_retiro,
      salario: f.salario,
      conSalario,
      hoy,
      empresa: SITE_LEGAL_NAME,
      nit: SITE_NIT,
      ciudad: SITE_ADDRESS.region,
    })
  }
} catch (e: any) {
  console.error('[admin/talento/certificado]', e?.stack || e)
  error = 'No se pudo cargar el certificado.'
}
const volver = `/admin/talento?persona=${id}&ver=ficha`
const listo = cert && !cert.faltan.length
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Certificado laboral{nombre ? ` · ${nombre}` : ''}</title>
    <style>
      @page { size: letter; margin: 22mm 24mm; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #eef0ee; color: #1d2421; font: 15px/1.7 system-ui, -apple-system, 'Segoe UI', Arial, sans-serif; }
      .barra { font: 14px/1.4 system-ui, sans-serif; display: flex; gap: 12px; align-items: center; justify-content: space-between; max-width: 216mm; margin: 20px auto 0; padding: 0 4px; }
      .barra a { color: #1f6f6f; }
      .barra button { font: 600 14px system-ui, sans-serif; background: #1f6f6f; color: #fff; border: 0; border-radius: 999px; padding: 10px 18px; cursor: pointer; }
      .aviso { font: 14px/1.5 system-ui, sans-serif; background: #fff4d6; color: #7a5300; border-radius: 10px; padding: 10px 14px; max-width: 216mm; margin: 12px auto 0; }
      .hoja { background: #fff; width: 216mm; min-height: 279mm; margin: 16px auto 40px; padding: 22mm 24mm; box-shadow: 0 2px 18px rgb(0 0 0 / .08); display: flex; flex-direction: column; }
      .cab { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #d9dedb; padding-bottom: 14px; }
      .cab img { height: 42px; }
      .cab p { margin: 0; text-align: right; font: 12px/1.5 system-ui, sans-serif; color: #56605b; }
      h1 { font: 700 15px/1.4 system-ui, sans-serif; letter-spacing: .14em; text-align: center; margin: 48px 0 8px; }
      .quien { text-align: center; margin: 0 0 30px; }
      .certifica { font: 700 15px system-ui, sans-serif; letter-spacing: .14em; text-align: center; margin: 0 0 22px; }
      .cuerpo p { text-align: justify; margin: 0 0 18px; }
      .firma { margin-top: 70px; }
      .firma .linea { width: 70mm; border-top: 1px solid #1d2421; margin-bottom: 6px; }
      .firma p { margin: 0; line-height: 1.5; }
      .pie { margin-top: auto; padding-top: 24px; border-top: 1px solid #d9dedb; font: 11.5px/1.5 system-ui, sans-serif; color: #56605b; text-align: center; }
      .error { font: 15px/1.6 system-ui, sans-serif; max-width: 560px; margin: 60px auto; background: #fff; padding: 28px; border-radius: 14px; }
      @media print {
        body { background: #fff; }
        .barra, .aviso { display: none; }
        .hoja { width: auto; min-height: calc(279mm - 44mm); margin: 0; padding: 0; box-shadow: none; }
      }
    </style>
  </head>
  <body>
    {error && (
      <div class="error"><p>{error}</p><p><a href="/admin/talento">Volver a Talento humano</a></p></div>
    )}
    {cert && !listo && (
      <div class="error">
        <p><b>Al certificado le faltan datos.</b> Complete en la ficha {cert.faltan.join(', ').replace(/, ([^,]*)$/, ' y $1')}, y vuelva a generarlo.</p>
        <p><a href={volver}>Ir a la ficha de {nombre}</a></p>
      </div>
    )}
    {cert && listo && (
      <>
        <div class="barra">
          <a href={volver}>Volver a la ficha</a>
          <span>Para el PDF: Imprimir y elegir "Guardar como PDF".</span>
          <button type="button" id="imprimir">Imprimir o guardar en PDF</button>
        </div>
        {!firmaNombre && <p class="aviso">Falta quién firma. Configúrelo en Talento humano, pestaña Ajustes. Mientras tanto, la firma sale en blanco.</p>}
        <main class="hoja">
          <header class="cab">
            <img src="/brand/ekosolv-horizontal.png" alt={SITE_LEGAL_NAME} />
            <p>{SITE_LEGAL_NAME}<br />NIT {SITE_NIT}</p>
          </header>
          <h1>{SITE_LEGAL_NAME.toUpperCase()}</h1>
          <p class="quien">NIT {SITE_NIT}</p>
          <p class="certifica">CERTIFICA:</p>
          <div class="cuerpo">
            {cert.parrafos.map((t) => <p>{t}</p>)}
            <p>{cert.expedicion}</p>
          </div>
          <div class="firma">
            <p>Cordialmente,</p>
            <div style="height: 60px"></div>
            <div class="linea"></div>
            <p><b>{firmaNombre || ' '}</b></p>
            <p>{firmaCargo}</p>
            <p>{SITE_LEGAL_NAME}</p>
          </div>
          <footer class="pie">{SITE_ADDRESS.calle}, {SITE_ADDRESS.edificio} · {SITE_ADDRESS.region} · {SITE_ADDRESS.correo}</footer>
        </main>
      </>
    )}
    <script is:inline>
      document.getElementById('imprimir')?.addEventListener('click', () => window.print())
    </script>
  </body>
</html>
