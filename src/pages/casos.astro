---
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { agregadoCasos, casosVisibles, hayAgregado, mostrarPlaceholders } from '../lib/credenciales'

const cases = casosVisibles()

---

<Layout title="Casos — Eko" activePath="/casos">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Casos</div>
      <div class="l">Selección · 2024 – 2026</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Cómo <em>trabajamos</em>,<br>caso por caso.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Documentamos cada mandato en un formato que podamos sustentar, sin exponer la confidencialidad de nuestros clientes. Aquí solo publicamos cifras verificadas.
    </p>
  </section>

  <section class="section wrap">
    {mostrarPlaceholders && (
      <div class="dev-warning">
        ⚠ PLACEHOLDERS — visibles solo en desarrollo. Los 6 casos anteriores eran
        inventados. Rellena `casos` y `agregadoCasos` en src/lib/credenciales.ts
        con mandatos reales y pon `verificado: true`.
      </div>
    )}

    {cases.length === 0 && (
      <div class="reveal" style="border-top:1px solid var(--line); padding-top:40px">
        <h2 style="max-width:22ch">Preparando esta <em>sección</em>.</h2>
        <p class="lede" style="margin-top:20px; max-width:56ch">
          Estamos documentando nuestros mandatos en un formato que podamos
          sustentar sin comprometer la confidencialidad de los clientes. Si
          quiere referencias para un proceso de contratación, se las damos
          directamente.
        </p>
        <a href="/contacto" class="doc-link" style="margin-top:28px">
          Pedir referencias
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    )}

    <div class="cases reveal">
      {cases.map(c => (
        <article class={`case ${c.cls}`}>
          <div class="cover" data-label={c.label}></div>
          <div class="kicker">
            <span>{c.kicker[0]}</span>
            <span>{c.kicker[1]}</span>
          </div>
          <h3 set:html={c.title.replace(c.titleEm, `<em>${c.titleEm}</em>`)}></h3>
          <div class="metric">
            {c.metrics.map(m => (
              <div>
                <div class="v">{m[0]}</div>
                <div class="l">{m[1]}</div>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  {hayAgregado() && (
    <section class="section wrap">
      <div class="band reveal">
        <div class="band-grid" style="grid-template-columns: 1.3fr 1fr 1fr">
          <div>
            <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Resultados agregados</div>
            <h2 style="margin-top:14px; max-width:18ch">El impacto, <em>sumando</em> todos los mandatos.</h2>
          </div>
          <div class="stat">
            <div class="n">{agregadoCasos.riesgoMitigado}</div>
            <div class="lbl">Riesgo sancionatorio mitigado</div>
          </div>
          <div class="stat">
            <div class="n">{agregadoCasos.sanciones}</div>
            <div class="lbl">Sanciones en firme</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <SiteFooter />
</Layout>
