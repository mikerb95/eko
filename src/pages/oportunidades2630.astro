---
export const prerender = false // página interna: el middleware exige sesión (src/middleware.ts)
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { FOUNDED_YEAR, stats, tonnesManaged, yearsActive } from '../lib/brand'

// Estado de cada eje frente a lo que el gobierno ha hecho desde el 7 de agosto.
// Revisión: 28 de octubre de 2026.
const ESTADOS = {
  vigente: "Vigente",
  tramite: "En trámite",
  propuesta: "Solo propuesta",
  caducado: "Caducado",
  nueva: "Nueva",
  ajustada: "Ajustada",
}

const ejes = [
  {
    code: "ECONOMÍA · EMERGENCIA",
    title: "Emergencia económica, pero por el terremoto",
    body: "La emergencia económica que el programa planteaba para desregular nunca se declaró con ese fin. La que sí llegó fue por el sismo de magnitud 7,4 del 10 de agosto (epicentro en San José del Palmar, Chocó): Decreto 1261 de 2026, firmado el 19 de agosto, en 15 departamentos por 30 días, con 11 decretos más el 9 de septiembre. La meta de crecer entre 6% y 7% sigue en el discurso, ahora atada a la reconstrucción.",
    tags: ["D. 1261/2026", "Reconstrucción", "PIB 6–7% (meta)"],
    estado: "vigente",
    col: 1,
  },
  {
    code: "ESTADO",
    title: "Reducción del Estado: depende del Congreso",
    body: "El 17 de septiembre el Centro Democrático radicó un proyecto que daría al presidente facultades extraordinarias por seis meses para fusionar o suprimir ministerios y entidades. Las corporaciones autónomas regionales quedan excluidas. Un borrador de campaña ponía a la ANLA en la lista de entidades por eliminar, pero el equipo de gobierno negó que exista esa lista. Mientras el proyecto no se apruebe, la fiscalización ambiental sigue como estaba.",
    tags: ["Facultades extraordinarias", "CAR excluidas", "ANLA sin cambios"],
    estado: "tramite",
    col: 1,
  },
  {
    code: "MINERÍA · ENERGÍA",
    title: "Fracking anunciado y licencia en paralelo con la consulta previa",
    body: "En la posesión el presidente anunció que autorizará el fracking \"responsable y sostenible\", sin tocar páramos. En octubre, los ministros del Interior (Rodrigo Lara) y de Ambiente (Fabio Arjona) publicaron un borrador de decreto para tramitar la licencia ambiental en paralelo con la consulta previa: la ANLA o la CAR podrían arrancar la evaluación sin esperar a la Dirección de Consulta Previa. La consulta pública cerró el 14 de octubre; falta la versión final.",
    tags: ["Borrador de decreto", "Sirius · Colectora · eólicos", "Más trámites ANLA"],
    estado: "tramite",
    col: 2,
  },
  {
    code: "PLANEACIÓN · AMBIENTE",
    title: "Plan de desarrollo en construcción y plan ABC",
    body: "El DNP arrancó el Plan Nacional de Desarrollo 2026–2030 el 17 de septiembre: las bases van al Consejo Nacional de Planeación el 15 de noviembre y el proyecto de ley se radica el 7 de febrero de 2027. Prioriza reconstrucción, inversión privada y el sector minero-energético. Las zonas económicas especiales siguen siendo promesa de campaña. El ministro Arjona (biólogo marino, exdirector de Conservación Internacional) enfoca la cartera en ecosistemas y agua: el posconsumo queda en el marco vigente.",
    tags: ["PND al Congreso: feb. 2027", "Zonas especiales: pendiente", "Posconsumo sin cambios"],
    estado: "propuesta",
    col: 2,
  },
]

const oportunidades = [
  {
    n: "01", code: "LICENCIAMIENTO",
    title: "Más proyectos entrando a licenciamiento",
    lede: "No hubo \"licenciamiento exprés\" por decreto, pero la dirección es la misma: si se expide el decreto de trámite paralelo, proyectos de gas, transmisión, eólicos y vías podrían presentar estudios hasta dos años antes. Eso concentra en 2027 la demanda de estudios de impacto, planes de manejo e Informes de Cumplimiento Ambiental (ICA), justo lo que vende EKONSULTING.",
    tags: ["EIA · DAA · PMA", "ICA", "Decreto de trámite paralelo"],
    when: "2027 en adelante",
    estado: "ajustada",
  },
  {
    n: "02", code: "ESG PRIVADO",
    title: "El cumplimiento lo exige el comprador",
    lede: "El argumento se sostiene pero se estrechó. La UE recortó la CSRD con el paquete Omnibus I (en vigor desde el 18 de marzo de 2026): ahora solo reportan grupos con más de 1.000 empleados y más de 450 millones de euros de facturación, y los estándares simplificados aplican desde 2028. El CBAM entró en su fase definitiva el 1 de enero de 2026 (certificados desde febrero de 2027), pero toca acero, aluminio, cemento y fertilizantes, no residuos. El cliente objetivo es la filial de una multinacional grande, no cualquier exportador.",
    tags: ["CSRD · Omnibus I", "CBAM definitivo", "Filiales de multinacionales"],
    when: "Todo el periodo",
    estado: "ajustada",
  },
  {
    n: "03", code: "VOLUMEN RAEE",
    title: "Crecimiento del volumen de RAEE",
    lede: "Colombia ya genera más de 300.000 toneladas de RAEE al año, más de 6 kg por habitante, y apenas se recicla formalmente alrededor del 20%. Desde 2026 los sistemas colectivos de la Resolución 0851 de 2022 deben cubrir las nuevas subcategorías de aparatos de consumo masivo, y las metas de recolección siguen subiendo con sanciones para productores incumplidos. El nuevo gobierno no ha tocado ni esta norma ni el Decreto 670 de 2025 (Basura Cero).",
    tags: ["Res. 0851/2022", "> 300.000 t/año", "Basura Cero vigente"],
    when: "Estructural",
    estado: "vigente",
  },
  {
    n: "04", code: "RECONSTRUCCIÓN",
    title: "Residuos del terremoto",
    lede: "El sismo afectó cerca de 494 municipios en 16 departamentos, con Chocó, Valle, Caldas y Risaralda a la cabeza, y 303 establecimientos de salud dañados. Solo en Cali llegaron más de 232.000 toneladas de escombros al centro de acopio de la calle 5 hasta el 16 de octubre, y la operación de emergencia sigue hasta enero o febrero de 2027. Entre los escombros y en la reposición de equipos de hospitales, oficinas y colegios sale RAEE que hoy nadie está separando ni certificando.",
    tags: ["RAEE en demoliciones", "Reposición de equipos", "Chocó · Valle · Eje Cafetero"],
    when: "Oct. 2026–2027",
    estado: "nueva",
  },
]

const cambios = [
  {
    estado: "nueva",
    titulo: "Nuevo desde julio",
    items: [
      "Terremoto del 10 de agosto y emergencia económica (D. 1261/2026): abre la oportunidad 04.",
      "Borrador de decreto para tramitar licencia y consulta previa en paralelo.",
      "Fracking anunciado en la posesión, sin páramos.",
      "Cronograma del PND: bases el 15 de noviembre, Congreso el 7 de febrero de 2027.",
    ],
  },
  {
    estado: "ajustada",
    titulo: "Se ajustó",
    items: [
      "CSRD: tras Omnibus I solo obliga a grupos de más de 1.000 empleados y 450 M€.",
      "Reducción del Estado: pasó de anuncio a proyecto de facultades en el Congreso.",
      "Volumen RAEE: la cifra de referencia sube a más de 300.000 t/año.",
    ],
  },
  {
    estado: "caducado",
    titulo: "Caducó",
    items: [
      "Emergencia económica para desregular: la única que se declaró fue por el sismo.",
      "\"Licenciamiento exprés\" por decreto inmediato: hoy es un borrador de trámite paralelo.",
      "Estado 40% más pequeño desde el día uno: no hay nada aprobado.",
    ],
  },
]

const lineas = [
  {
    code: "EKORAEE", accent: "forest",
    role: "Gestión de residuos electrónicos",
    body: `Recolección, transporte, almacenamiento y disposición certificada de RAEE, con campañas de recolección y logística inversa. Es la única línea con operación física y por tanto la que fija la capacidad logística real.`,
    cap: `${tonnesManaged('es')} toneladas gestionadas desde ${FOUNDED_YEAR}`,
    atiende: "Oportunidades 03 y 04",
  },
  {
    code: "EKONSULTING", accent: "deep",
    role: "Cumplimiento y licenciamiento",
    body: "Licenciamiento ambiental, estudios, Informes de Cumplimiento Ambiental, operación de sistemas de recolección y acompañamiento ESG. Se presta de forma remota en todo el país, así que crece sin abrir sedes.",
    cap: `${stats.approvalRate}% de radicaciones aprobadas ante la ANLA · sin dependencia geográfica`,
    atiende: "Oportunidades 01 y 02",
  },
  {
    code: "EKOTRADING", accent: "clay",
    role: "Economía circular de activos IT",
    body: "Compra y venta de activos tecnológicos con valorización de equipo aún útil. Es la línea que convierte el residuo en ingreso y la que más se beneficia de la rotación de parque tecnológico empresarial.",
    cap: "Canal de valorización y reventa en operación",
    atiende: "Oportunidades 03 y 04",
  },
  {
    code: "EKOPARTNER", accent: "aqua",
    role: "Sistema colectivo de envases y empaques",
    body: "Sistema Colectivo de Recolección de Envases y Empaques avalado por la Resolución 1407 de 2018 (modificada por la 1342 de 2020), en operación desde 2021. Aporta la experiencia de reportar a la autoridad en nombre de terceros.",
    cap: "52 toneladas de empaques en su primer año",
    atiende: "Oportunidad 02",
  },
]

const capacidades = [
  { v: String(yearsActive), u: "años", l: `Operando desde ${FOUNDED_YEAR}, con presencia en Bogotá` },
  { v: String(stats.serviceLines), u: "", l: "Líneas integradas bajo una misma marca y un mismo cliente" },
  { v: "2014", u: "", l: "Participación en el lanzamiento de la estrategia REP+ de la ANLA" },
  { v: "2024", u: "", l: "COP16 y campaña posconsumo con MinAmbiente en Quibdó e Istmina" },
]

const encaje = [
  {
    op: "01 · LICENCIAMIENTO",
    lineas: ["EKONSULTING"],
    tiene: "Trayectoria de radicación ante la ANLA y equipo de consultoría remoto, que atiende proyectos en cualquier región sin costo logístico.",
    brecha: "La capacidad es humana y no escala sola. Absorber una ola de trámites exige plantillas de estudio e informes generados desde datos, no redactados desde cero.",
    cubre: "Reportería automática · Fase 3",
  },
  {
    op: "02 · ESG PRIVADO",
    lineas: ["EKONSULTING", "EKOPARTNER"],
    tiene: "Experiencia reportando a la autoridad en nombre de terceros a través del sistema colectivo, que es exactamente la mecánica que pedirán inversionistas y casas matrices.",
    brecha: "Hoy la evidencia sale en PDF y Excel. Un auditor externo no puede verificarla por su cuenta, y ese es justamente el requisito que impone CSRD y CBAM.",
    cubre: "Portal ESG · Fase 2",
  },
  {
    op: "03 · VOLUMEN RAEE",
    lineas: ["EKORAEE", "EKOTRADING"],
    tiene: "Operación física en marcha con más de una década de historial y un canal de valorización que ya recupera valor del equipo aprovechable.",
    brecha: "Falta trazabilidad por unidad y borrado certificado de datos. Sin eso, las empresas grandes no entregan sus equipos y el volumen extra se va a la competencia.",
    cubre: "Cadena de custodia · Fase 1 · Módulo ITAD · Fase 2",
  },
  {
    op: "04 · RECONSTRUCCIÓN",
    lineas: ["EKORAEE", "EKOTRADING"],
    tiene: "Campaña posconsumo con MinAmbiente en Quibdó e Istmina en 2024: ya hay relación institucional y experiencia logística en Chocó, el departamento del epicentro.",
    brecha: "Alcaldías, hospitales y aseguradoras van a pedir prueba de qué se recogió, de dónde y cómo se dispuso. Sin certificados por lote ni trazabilidad, el RAEE de la emergencia termina mezclado con los escombros.",
    cubre: "Cadena de custodia · Fase 1",
  },
]

const modulos = [
  {
    n: "01", code: "CUSTODIA",
    title: "Cadena de custodia digital de punta a punta",
    lede: "Desde la solicitud de recolección hasta el certificado de disposición final con QR verificable públicamente: manifiesto de transporte, pesaje y tratamiento registrados como datos, no como PDFs y Excel, que es como opera hoy casi todo el sector.",
    when: "Fase 1 · MVP",
  },
  {
    n: "02", code: "REPORTERÍA",
    title: "Reportería regulatoria automática",
    lede: "Motor que genera los informes anuales de los sistemas de recolección (Res. 0851) y los ICA a partir de los datos operativos. Es el painkiller directo: la parte que todos los obligados odian hacer a mano.",
    when: "Fase 3",
  },
  {
    n: "03", code: "PORTAL ESG",
    title: "Portal ESG para clientes corporativos",
    lede: "Dashboard con kilogramos gestionados, tasa de valorización, CO₂ evitado y certificados descargables: cifras que el cliente pega directamente en su reporte de sostenibilidad. Aquí nace la demanda inmediata: el cliente del cliente (auditor, inversionista, casa matriz) exige esos números.",
    when: "Fase 2",
  },
  {
    n: "04", code: "ITAD",
    title: "Módulo ITAD para EKOTRADING",
    lede: "Inventario de activos, certificado de borrado seguro de datos y valorización de reventa. El borrado certificado es lo que desbloquea que grandes empresas entreguen sus equipos.",
    when: "Fase 2–3",
  },
]

const fuentes = [
  { t: "El Tiempo: Resultados segunda vuelta presidencial 2026", u: "https://www.eltiempo.com/politica/elecciones-colombia-2026/resultados-segunda-vuelta-presidencial-2026-siga-el-minuto-a-minuto-del-preconteo-de-la-registraduria-nacional-3565893" },
  { t: "El Tiempo: Los 10 pilares del plan de gobierno de De la Espriella", u: "https://www.eltiempo.com/politica/elecciones-colombia-2026/abelardo-de-la-espriella-anuncio-los-10-pilares-de-su-gobierno-plan-colombia-ii-reduccion-del-estado-en-40-7-megacarceles-y-otras-medidas-3561778" },
  { t: "La Silla Vacía: Plan ABC de medio ambiente", u: "https://www.lasillavacia.com/en-vivo/este-es-el-plan-abc-para-medio-ambiente-y-comunidades-de-de-la-espriella/" },
  { t: "El Tiempo: Emergencia económica en 15 departamentos tras el terremoto (D. 1261/2026)", u: "https://www.eltiempo.com/politica/abelardo-de-la-espriella/gobierno-de-abelardo-de-la-espriella-firma-decreto-que-declara-la-emergencia-economica-para-hacerle-frente-a-crisis-tras-terremoto-3579549" },
  { t: "Presidencia: 11 decretos al amparo de la emergencia económica (9 sep. 2026)", u: "https://www.presidencia.gov.co/prensa/Paginas/Presidente-De-La-Espriella-y-su-Gabinete-firmaron-11-decretos-al-amparo-260909.aspx" },
  { t: "ACNUR: Terremoto en Colombia, municipios y departamentos afectados", u: "https://data.unhcr.org/en/documents/details/123848" },
  { t: "OPS: Informe de situación 5, terremoto agosto 2026", u: "https://www.paho.org/es/documentos/informe-situacion-5-colombia-terremoto-agosto-2026-19-agosto-2026" },
  { t: "Occidente: Escombros del terremoto convertidos en ecomateriales en Cali (16 oct. 2026)", u: "https://occidente.co/cali/escombros-del-terremoto-en-ecomateriales-reconstruccion-cali-uaesp/" },
  { t: "Infobae: Borrador de decreto de licencia y consulta previa simultáneas (10 oct. 2026)", u: "https://www.infobae.com/colombia/2026/10/10/licencias-ambientales-y-consultas-previas-se-tramitarian-de-forma-simultanea-esto-dice-borrador-de-decreto-del-gobierno-de-la-espriella/" },
