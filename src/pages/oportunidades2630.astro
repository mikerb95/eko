---
export const prerender = false // página interna: el middleware exige sesión (src/middleware.ts)
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { FOUNDED_YEAR, stats, tonnesManaged, yearsActive } from '../lib/brand'

// Estado de cada eje frente a lo que ha pasado en 2026.
// Revisión: 28 de octubre de 2026.
const ESTADOS = {
  vigente: "Vigente",
  tramite: "En trámite",
  mixto: "Vigente y pendiente",
  caducado: "Caducado",
  nueva: "Nueva",
  ajustada: "Ajustada",
}

const ejes = [
  {
    code: "RESPEL · CERTIFICADOS",
    title: "Decreto 766 de 2026: el certificado de gestión pasa a ser digital",
    body: "Expedido el 15 de julio de 2026, reescribe el régimen de residuos peligrosos (Título 6 del Decreto 1076 de 2015), y los RAEE están en su anexo. El gestor debe tener licencia y entregar la certificación de gestión por medios electrónicos con seguridad (QR, firma digital) en máximo 90 días hábiles. Desde 2027 el generador carga esos certificados en el RUA del IDEAM, que cruza lo que uno dice haber entregado con lo que el otro dice haber recibido. El generador los conserva cinco años y los gestores tienen 12 meses para ajustar sus certificados.",
    tags: ["Certificado con QR", "Cruce en el RUA desde 2027", "Ajuste en 12 meses"],
    estado: "vigente",
    col: 1,
  },
  {
    code: "REP · CONTROL",
    title: "La ANLA salió a buscar productores evasores",
    body: "Con la estrategia REP+, la ANLA cruza las importaciones de BACEX con el RUES para encontrar productores de aparatos eléctricos que no tienen sistema de recolección. A mayo de 2026 tenía 516 productores con sistema RAEE aprobado (42 expedientes, 9 colectivos), unas 2.347 empresas en el ámbito de las corrientes priorizadas, 506 oficios enviados y 32 impulsos sancionatorios. El régimen sancionatorio se endureció con la Ley 2387 de 2024.",
    tags: ["Estrategia REP+", "516 productores RAEE", "Ley 2387/2024"],
    estado: "vigente",
    col: 1,
  },
  {
    code: "LICENCIAMIENTO",
    title: "Licencia ambiental en paralelo con la consulta previa",
    body: "El gobierno publicó en octubre un borrador de decreto para que la ANLA o la CAR evalúen la licencia sin esperar a que termine la consulta previa. Apunta a gas, transmisión eléctrica, eólicos, vías y puertos, y podría adelantar hasta dos años la radicación de estudios. La consulta pública cerró el 14 de octubre. La reducción del Estado sigue en un proyecto de facultades extraordinarias en el Congreso: la ANLA y las CAR siguen operando igual.",
    tags: ["Borrador de decreto", "ANLA sin cambios", "Más estudios en 2027"],
    estado: "tramite",
    col: 2,
  },
  {
    code: "NUEVAS CORRIENTES",
    title: "Baterías y paneles solares entran al radar",
    body: "La Resolución 0799 de 2025 rige desde el 1 de enero de 2026 para baterías de plomo-ácido: fabricantes e importadores de más de 300 unidades al año deben tener sistema de recolección, con indicadores de 90% para vehículos y 60% para motos, y gestores licenciados que certifiquen. Las baterías de litio de vehículos eléctricos ya están dentro de la Res. 0851. Y la Resolución 40159 de 2026 de MinMinas (programa Colombia Solar) ordena a MinAmbiente reglamentar los residuos de módulos, inversores y baterías solares, sin plazo todavía.",
    tags: ["Res. 0799/2025", "Litio en Res. 0851", "Paneles: norma pendiente"],
    estado: "mixto",
    col: 2,
  },
]

const oportunidades = [
  {
    n: "01", code: "CERTIFICADOS",
    title: "El gestor con certificado digital primero",
    lede: "El Decreto 766 vuelve obligatorio lo que hoy casi ningún gestor tiene: certificados electrónicos verificables que el cliente pueda subir al RUA y que cuadren con lo que reporta. Desde 2027 el sistema detecta si lo entregado y lo certificado no coinciden. Las empresas medianas y grandes van a preferir al gestor cuyo certificado pase el cruce sin trabajo extra. Es la Fase 1 de la plataforma, ahora con fecha límite.",
    tags: ["D. 766/2026", "RUA · IDEAM", "QR y firma digital"],
    when: "Antes de jul. 2027",
    estado: "nueva",
  },
  {
    n: "02", code: "EVASORES REP",
    title: "Productores que tienen que ponerse al día",
    lede: "Cada importador o fabricante que la ANLA identifica como evasor tiene que presentar un sistema de recolección, individual o colectivo, y desde ahí rendir informe anual de avance. Son cientos de empresas que necesitan formular el sistema, unirse a un colectivo y demostrar recolección con certificados. Es consultoría (EKONSULTING) más operación de colectivo, que es lo que Ekosolv ya hace con envases (EKOPARTNER).",
    tags: ["Res. 0851/2022", "Sistemas colectivos", "Informe anual ANLA"],
    when: "2026–2027",
    estado: "nueva",
  },
  {
    n: "03", code: "VOLUMEN RAEE",
    title: "Crecimiento del volumen de RAEE",
    lede: "Colombia ya genera más de 300.000 toneladas de RAEE al año, más de 6 kg por habitante, y se recicla formalmente alrededor del 20%. La Res. 0851 cubre 297 subpartidas de aparatos de consumo masivo, y desde 2026 los sistemas colectivos deben ampliar cobertura a las nuevas subcategorías. El cambio de gobierno no ha tocado ni esta norma ni el Decreto 670 de 2025 (Basura Cero).",
    tags: ["297 subpartidas", "> 300.000 t/año", "~20% de reciclaje"],
    when: "Estructural",
    estado: "vigente",
  },
  {
    n: "04", code: "LICENCIAMIENTO",
    title: "Más proyectos entrando a licenciamiento",
    lede: "No hubo \"licenciamiento exprés\" inmediato, pero si se expide el decreto de trámite paralelo, proyectos de gas, transmisión, eólicos y vías podrían presentar estudios hasta dos años antes. Eso concentra en 2027 la demanda de estudios de impacto, planes de manejo e Informes de Cumplimiento Ambiental (ICA), justo lo que vende EKONSULTING.",
    tags: ["EIA · DAA · PMA", "ICA", "Decreto de trámite paralelo"],
    when: "2027 en adelante",
    estado: "ajustada",
  },
  {
    n: "05", code: "NUEVAS CORRIENTES",
    title: "Baterías y paneles solares",
    lede: "Las baterías de plomo-ácido ya tienen sistema obligatorio y los gestores licenciados son los únicos que pueden certificar. Las de litio de vehículos eléctricos todavía no llegan en volumen, pero la obligación existe. Los paneles solares son la apuesta de largo plazo: Colombia Solar los instala por miles con vida útil de 25 años, y un módulo viejo conserva cerca del 80% de su capacidad, así que hay negocio de reúso además de reciclaje. Quien llegue con experiencia a la mesa técnica de MinAmbiente ayuda a escribir la norma.",
    tags: ["Res. 0799/2025", "Res. 40159/2026 MinMinas", "Reúso de módulos"],
    when: "2027–2030",
    estado: "nueva",
  },
]

const cambios = [
  {
    estado: "nueva",
    titulo: "Nuevo desde julio",
    items: [
      "Decreto 766 de 2026: certificados de gestión electrónicos y cruce en el RUA desde 2027.",
      "La ANLA persigue evasores con la estrategia REP+ y ya tiene 32 impulsos sancionatorios.",
      "Res. 0799 de 2025 en vigor desde enero: sistema obligatorio para baterías de plomo-ácido.",
      "MinMinas pidió a MinAmbiente reglamentar los residuos de paneles solares.",
    ],
  },
  {
    estado: "ajustada",
    titulo: "Se ajustó",
    items: [
      "Licenciamiento: ya no es un decreto exprés, es un borrador de trámite paralelo con la consulta previa.",
      "ESG: tras Omnibus I, la CSRD europea solo obliga a grupos de más de 1.000 empleados y 450 M€. Pesa menos como argumento de venta.",
      "Volumen RAEE: la cifra de referencia sube a más de 300.000 t/año.",
    ],
  },
  {
    estado: "caducado",
    titulo: "Caducó",
    items: [
      "Que un Estado más pequeño iba a aflojar el control ambiental: la ANLA sigue igual y la REP se está apretando.",
      "\"Licenciamiento exprés\" por decreto inmediato.",
      "El CBAM europeo como motor de demanda: cubre acero, aluminio, cemento y fertilizantes, no residuos.",
    ],
  },
]

const lineas = [
  {
    code: "EKORAEE", accent: "forest",
    role: "Gestión de residuos electrónicos",
    body: `Recolección, transporte, almacenamiento y disposición certificada de RAEE, con campañas de recolección y logística inversa. Es la única línea con operación física y por tanto la que fija la capacidad logística real.`,
    cap: `${tonnesManaged('es')} toneladas gestionadas desde ${FOUNDED_YEAR}`,
    atiende: "Oportunidades 01, 03 y 05",
  },
  {
    code: "EKONSULTING", accent: "deep",
    role: "Cumplimiento y licenciamiento",
    body: "Licenciamiento ambiental, estudios, Informes de Cumplimiento Ambiental, operación de sistemas de recolección y acompañamiento ESG. Se presta de forma remota en todo el país, así que crece sin abrir sedes.",
    cap: `${stats.approvalRate}% de radicaciones aprobadas ante la ANLA · sin dependencia geográfica`,
    atiende: "Oportunidades 02 y 04",
  },
  {
    code: "EKOTRADING", accent: "clay",
    role: "Economía circular de activos IT",
    body: "Compra y venta de activos tecnológicos con valorización de equipo aún útil. Es la línea que convierte el residuo en ingreso y la que más se beneficia de la rotación de parque tecnológico empresarial.",
    cap: "Canal de valorización y reventa en operación",
    atiende: "Oportunidades 03 y 05",
  },
  {
    code: "EKOPARTNER", accent: "aqua",
    role: "Sistema colectivo de envases y empaques",
    body: "Sistema Colectivo de Recolección de Envases y Empaques avalado por la Resolución 1407 de 2018 (modificada por la 1342 de 2020), en operación desde 2021. Aporta la experiencia de reportar a la autoridad en nombre de terceros.",
    cap: "52 toneladas de empaques en su primer año",
    atiende: "Oportunidad 02",
  },
]

const capacidades = [
  { v: String(yearsActive), u: "años", l: `Operando desde ${FOUNDED_YEAR}, con presencia en Bogotá` },
  { v: String(stats.serviceLines), u: "", l: "Líneas integradas bajo una misma marca y un mismo cliente" },
  { v: "2014", u: "", l: "Participación en el lanzamiento de la estrategia REP+ de la ANLA" },
  { v: "2024", u: "", l: "COP16 y campaña posconsumo con MinAmbiente en Quibdó e Istmina" },
]

const encaje = [
  {
    op: "01 · CERTIFICADOS",
    lineas: ["EKORAEE"],
    tiene: "Ya emite certificados de disposición a sus clientes y tiene más de una década de historial operativo que respalda cada uno.",
    brecha: "Los certificados salen en PDF. El Decreto 766 pide medios electrónicos con QR o firma digital, conservación por cinco años y datos que cuadren en el RUA con lo que reporta el cliente.",
    cubre: "Cadena de custodia · Fase 1",
  },
  {
    op: "02 · EVASORES REP",
    lineas: ["EKONSULTING", "EKOPARTNER"],
    tiene: "Experiencia operando un sistema colectivo de envases y reportando a la autoridad en nombre de terceros, que es exactamente lo que necesita un productor que llega tarde.",
    brecha: "No hay una oferta empaquetada de \"sistema RAEE llave en mano\" para el productor que recibe el oficio de la ANLA, ni un informe anual que salga solo de los datos.",
    cubre: "Reportería automática · Fase 3",
  },
  {
    op: "03 · VOLUMEN RAEE",
    lineas: ["EKORAEE", "EKOTRADING"],
    tiene: "Operación física en marcha con más de una década de historial y un canal de valorización que ya recupera valor del equipo aprovechable.",
    brecha: "Falta trazabilidad por unidad y borrado certificado de datos. Sin eso, las empresas grandes no entregan sus equipos y el volumen extra se va a la competencia.",
    cubre: "Cadena de custodia · Fase 1 · Módulo ITAD · Fase 2",
  },
  {
    op: "04 · LICENCIAMIENTO",
    lineas: ["EKONSULTING"],
    tiene: "Trayectoria de radicación ante la ANLA y equipo de consultoría remoto, que atiende proyectos en cualquier región sin costo logístico.",
    brecha: "La capacidad es humana y no escala sola. Absorber una ola de trámites exige plantillas de estudio e informes generados desde datos, no redactados desde cero.",
    cubre: "Reportería automática · Fase 3",
  },
  {
    op: "05 · NUEVAS CORRIENTES",
    lineas: ["EKORAEE", "EKOTRADING"],
    tiene: "Logística de recolección y un canal de reventa que sabe valorar equipo usado, que es la base para reusar módulos solares.",
    brecha: "Hay que confirmar si la licencia actual cubre baterías y paneles, y no existe un protocolo de prueba y clasificación de módulos para reúso.",
    cubre: "Módulo ITAD · Fase 2",
  },
]

const modulos = [
  {
    n: "01", code: "CUSTODIA",
    title: "Cadena de custodia digital de punta a punta",
    lede: "Desde la solicitud de recolección hasta el certificado de disposición final con QR verificable públicamente: manifiesto de transporte, pesaje y tratamiento registrados como datos, no como PDFs y Excel. Es justo el certificado electrónico que el Decreto 766 exige y que el cliente debe poder cargar en el RUA desde 2027.",
    when: "Fase 1 · MVP",
  },
  {
    n: "02", code: "REPORTERÍA",
    title: "Reportería regulatoria automática",
    lede: "Motor que genera los informes anuales de avance de los sistemas de recolección ante la ANLA (Res. 0851) y los ICA a partir de los datos operativos. Es el painkiller directo: la parte que todos los obligados odian hacer a mano.",
    when: "Fase 3",
  },
  {
    n: "03", code: "PORTAL ESG",
    title: "Portal ESG para clientes corporativos",
    lede: "Dashboard con kilogramos gestionados, tasa de valorización, CO₂ evitado y certificados descargables: cifras que el cliente pega directamente en su reporte de sostenibilidad. Aquí nace la demanda inmediata: el cliente del cliente (auditor, inversionista, casa matriz) exige esos números.",
    when: "Fase 2",
  },
  {
    n: "04", code: "ITAD",
    title: "Módulo ITAD para EKOTRADING",
    lede: "Inventario de activos, certificado de borrado seguro de datos y valorización de reventa. El borrado certificado es lo que desbloquea que grandes empresas entreguen sus equipos.",
    when: "Fase 2–3",
  },
]

const fuentes = [
  { t: "Alcaldía de Bogotá: texto del Decreto 766 de 2026 (residuos peligrosos)", u: "https://www.alcaldiabogota.gov.co/sisjur/normas/Norma1.jsp?dt=S&i=193834" },
  { t: "Lloreda Camacho: lo que cambia para generadores con el Decreto 766 de 2026", u: "https://lloredacamacho.com/en/decreto-766-de-2026-lo-que-cambia-para-generadores-de-respel-2/" },
  { t: "ANLA y MinAmbiente: Sistemas de recolección y gestión de RAEE, mayo 2026", u: "https://quimicos.minambiente.gov.co/wp-content/uploads/2026/07/3.-ANLA__Sistemas-de-Recoleccion-y-Gestion-de-RAEE-de-consumo-masivo-1.pdf" },
  { t: "ANLA: Marco normativo RAEE", u: "https://www.anla.gov.co/tramites-y-servicios/permisos-tramites-ambientales/raee-electricos-y-electronicos/raee-marco-normativo" },
  { t: "MinAmbiente: Colombia regula la gestión de baterías usadas (Res. 0799 de 2025)", u: "https://www.minambiente.gov.co/colombia-regula-la-gestion-responsable-de-baterias-usadas/" },
  { t: "ReSolar LATAM: residuos de paneles solares y la Resolución 40159 de 2026", u: "https://resolarlatam.com/resolucion-40159-2026-residuos-paneles-solares/" },
  { t: "CEPAL: segunda vida de baterías de vehículos eléctricos en Colombia", u: "https://www.cepal.org/sites/default/files/news/files/carlos_alvarez_-_colombia.pdf" },
  { t: "Infobae: borrador de decreto de licencia y consulta previa simultáneas (10 oct. 2026)", u: "https://www.infobae.com/colombia/2026/10/10/licencias-ambientales-y-consultas-previas-se-tramitarian-de-forma-simultanea-esto-dice-borrador-de-decreto-del-gobierno-de-la-espriella/" },
  { t: "Infobae: proyecto de facultades extraordinarias para fusionar entidades", u: "https://www.infobae.com/colombia/2026/09/18/abelardo-de-la-espriella-tendria-facultades-extraordinarias-por-seis-meses-para-fusionar-y-eliminar-ministerios-esta-es-la-iniciativa-que-estudiara-el-congreso/" },
  { t: "RTVC: crecen los residuos electrónicos, avance de Colombia (15 oct. 2026)", u: "https://www.rtvcnoticias.com/actualidad/medio-ambiente/residuos-electronicos-crecen-cuanto-avanza-colombia" },
  { t: "El Colombiano: manejo de RAEE en Colombia (~20% de reciclaje)", u: "https://www.elcolombiano.com/medio-ambiente/colombia-avanza-en-manejo-de-residuos-electricos-y-electronicos-raee-MD15165797" },
  { t: "ANLA: Decreto 670 de 2025, programa Basura Cero", u: "https://www.anla.gov.co/wanla/eureka/normativa/decretos/decreto-reglamentario-670-de-2025-programa-basura-cero-servicio-publico-de-aseo-y-tema-ambiental-residuos-solidos-gestion-integral-de-residuos-solidos" },
  { t: "AKD: la directiva Omnibus I entra en vigor el 18 de marzo de 2026 (CSRD)", u: "https://www.akd.eu/insights/provisional-agreement-on-omnibus-i-changes-to-the-scope-and-reporting-obligations-under-the-csrd" },
]
---

<Layout
  title="Oportunidades 2026–2030 | Ekosolv"
  description="Análisis estratégico: oportunidades para el sector de gestión ambiental y RAEE ante el nuevo gobierno de Colombia 2026–2030, y la plataforma de trazabilidad que las captura."
  activePath="/oportunidades2630"
  noindex
>
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Análisis estratégico</div>
      <div class="l">Gobierno 2026–2030 · actualizado 28 oct. 2026</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      El nuevo gobierno<br>como <em>oportunidad</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">
      Abelardo de la Espriella asumió la presidencia el 7 de agosto de 2026 con un programa de desregulación, reactivación minero-energética y reducción del Estado. Tres días después, el terremoto del Pacífico cambió las prioridades. Para el sector de gestión ambiental y RAEE, nada de eso es una amenaza.
    </p>
    <p class="lede-coda reveal">Es un reacomodo de dónde nace la demanda.</p>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Contexto político</div>
          <h2 style="margin-top:14px; max-width:18ch">Segunda vuelta, <em>21 de junio</em> de 2026.</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            De la Espriella (Defensores de la Patria) venció a Iván Cepeda (Pacto Histórico) en un resultado estrecho. Su programa: "La Patria Milagro".
          </p>
        </div>
        <div class="stat">
          <div class="n">49.7<small>%</small></div>
          <div class="lbl">12.9M de votos en segunda vuelta</div>
        </div>
        <div class="stat">
          <div class="n">−40<small>%</small></div>
          <div class="lbl">Reducción propuesta del tamaño del Estado</div>
        </div>
        <div class="stat">
          <div class="n">6–7<small>%</small></div>
          <div class="lbl">Meta de crecimiento anual del PIB</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Revisión del 28 de octubre</div>
        <h2>Qué <em>cambió</em> desde<br>la versión de julio.</h2>
      </div>
      <div class="meta">
        Tras doce semanas de gobierno, parte del programa ya es decreto, parte sigue en el Congreso y parte no pasó. Cada eje y cada oportunidad lleva ahora su estado.
      </div>
    </div>
    <div class="changes reveal">
      {cambios.map(c => (
        <article class="change" data-estado={c.estado}>
          <div class="estado" data-estado={c.estado}>{c.titulo}</div>
          <ul>{c.items.map(i => <li>{i}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Programa de gobierno</div>
        <h2>Cuatro ejes que <em>mueven</em><br>el tablero del sector.</h2>
      </div>
      <div class="meta">
        Lo relevante no es la orientación política sino dónde queda la exigencia ambiental: el foco estatal se va a seguridad, reconstrucción y reactivación, y el posconsumo queda gobernado por el marco vigente y por el mercado. Haz clic para expandir.
      </div>
    </div>
    <div class="norms reveal">
      <div class="norms-col">
        {ejes.filter(e => e.col === 1).map((e, idx) => (
          <div class="norm" data-open={idx === 0 ? 'true' : 'false'}>
            <div>
              <div class="code">{e.code} <span class="estado" data-estado={e.estado}>{ESTADOS[e.estado]}</span></div>
              <h4>{e.title}</h4>
            </div>
            <button class="plus" aria-label="expand">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 1v10M1 6h10"/>
              </svg>
            </button>
            <div class="body">
              <p>{e.body}</p>
              <ul>{e.tags.map(t => <li>{t}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
      <div class="norms-col">
        {ejes.filter(e => e.col === 2).map(e => (
          <div class="norm" data-open="false">
            <div>
              <div class="code">{e.code} <span class="estado" data-estado={e.estado}>{ESTADOS[e.estado]}</span></div>
              <h4>{e.title}</h4>
            </div>
            <button class="plus" aria-label="expand">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 1v10M1 6h10"/>
              </svg>
            </button>
            <div class="body">
              <p>{e.body}</p>
              <ul>{e.tags.map(t => <li>{t}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Oportunidades del sector</div>
        <h2>Cuatro frentes donde la demanda<br>crece <em>sin importar</em> el gobierno.</h2>
      </div>
      <div class="meta">
