<script>
  // Índice fijo: marca la sección visible y llena la barra de progreso.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc [data-toc]')].map(a => [a.dataset.toc, a])
  )
  const marcar = (id: string) => {
    links.forEach((a, k) => a.toggleAttribute('aria-current', k === id))
    const activo = links.get(id)
    activo?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' })
  }
  const obs = new IntersectionObserver(
    entradas => {
      const visible = entradas.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
      if (visible) marcar(visible.target.id)
    },
    { rootMargin: '-30% 0px -60% 0px' }
  )
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) obs.observe(el) })

  const barra = document.querySelector<HTMLElement>('.toc-progress span')
  const avance = () => {
    const max = document.documentElement.scrollHeight - innerHeight
    if (barra) barra.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`
  }
  addEventListener('scroll', avance, { passive: true })
  avance()
</script>

