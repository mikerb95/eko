---
import Layout from '../layouts/Layout.astro'
import { hayLicencias, licenciasVisibles, mostrarPlaceholders } from '../lib/credenciales'
import SiteFooter from '../components/SiteFooter.astro'

const licencias = licenciasVisibles()

function fecha(iso: string): string {
  if (!iso) return '—'
  return new Date(`${iso}T00:00:00`).toLocaleDateString('es-CO', {
    year: 'numeric', month: 'long', day: 'numeric',
  })
}
---

<Layout activePath="/licencias">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Legal</div>
      <div class="l">Documentos verificables</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Licencias y <em>autorizaciones</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:60ch">
      Cada habilitación con su número de resolución, entidad expedidora y vigencia.
      Publicamos los actos administrativos para que el área jurídica o de compras de
      su compañía pueda verificarlos sin pedirlos.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    {mostrarPlaceholders && (
      <div class="dev-warning">
        ⚠ PLACEHOLDERS — visibles solo en desarrollo. Rellena `licencias` en
        src/lib/credenciales.ts, sube el PDF a /public/docs/ y pon `publicada: true`.
      </div>
    )}

    {licencias.length > 0 ? (
      <div class="licencias reveal">
        {licencias.map((l) => (
          <article class="licencia">
            <h3>{l.titulo}</h3>
            <div class="field"><span class="k">Entidad</span>{l.entidad}</div>
            <div class="field"><span class="k">Resolución</span>{l.resolucion}</div>
            {l.pdf
              ? <a class="doc-link" href={l.pdf} target="_blank" rel="noopener">
                  Ver PDF
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              : <span class="field"><span class="k">Documento</span>Disponible a solicitud</span>}
            <div class="field"><span class="k">Expedida</span>{fecha(l.expedida)}</div>
            <div class="field"><span class="k">Vigencia</span>{l.vigencia}</div>
            <p class="alcance">{l.alcance}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="reveal" style="border-top:1px solid var(--line); padding-top:40px">
        <h2 style="max-width:20ch">Estamos actualizando esta <em>sección</em>.</h2>
        <p class="lede" style="margin-top:20px; max-width:56ch">
          Si necesita nuestras licencias y autorizaciones vigentes para un proceso de
          contratación o una auditoría de proveedores, se las enviamos el mismo día.
        </p>
        <a href="/contacto" class="doc-link" style="margin-top:28px; justify-self:start">
          Solicitar documentos
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    )}
  </section>

  {hayLicencias() && (
    <section class="section wrap" style="padding-top:0">
      <div class="band reveal">
        <div class="band-grid" style="grid-template-columns: 1.4fr 1fr">
          <div>
            <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Verificación</div>
            <h2 style="margin-top:14px; max-width:20ch">¿Necesita algún documento <em>adicional</em>?</h2>
            <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
              Certificados de existencia, pólizas, RUT o soportes específicos para su
              proceso de contratación.
            </p>
          </div>
          <div style="display:flex; align-items:center; justify-content:flex-end;">
            <a href="/contacto" class="foot-cta">
              Escríbenos
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <SiteFooter />
</Layout>
