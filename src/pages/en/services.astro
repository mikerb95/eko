---
import LayoutEn from '../../layouts/LayoutEn.astro'
import { LINEAS } from '../../data/servicios'
import SiteFooter from '../../components/SiteFooter.astro'
import VideoFacade from '../../components/VideoFacade.astro'
import { videoServiciosVisible } from '../../lib/credenciales'

const videoServicios = videoServiciosVisible('en')

// Contenido en src/data/servicios.ts (lo lee también el asesor con IA); aquí solo lo visual.
const estilo: Record<string, { accent: string }> = {
  EKONSULTING: { accent: "accent-deep" },
  EKORAEE: { accent: "accent-forest" },
  EKOPARTNER: { accent: "" },
  EKOTRADING: { accent: "accent-clay" },
}
const lines = LINEAS.en.map((l) => ({ ...l, ...estilo[l.code] }))
---

<LayoutEn activePath="/en/services">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Service lines</div>
      <div class="l">04 lines · one ecosystem</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      From compliance<br>to <em>competitive advantage</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:54ch">
      Four integrated lines covering the full environmental lifecycle of a tech company: regulatory obligation, waste operations, circular economy, and ESG strategy.
    </p>
  </section>

  <section class="section wrap">
    <div class="process reveal">
      {lines.map(s => (
        <div class={`process-row ${s.accent ? s.accent + '-row' : ''}`} style="grid-template-columns: 100px 240px 1fr 160px">
          <div class="n">{s.n} · {s.code}</div>
          <div>
            <h3 style="font-size:clamp(20px,2vw,30px)">{s.title}</h3>
          </div>
          <div class="desc">
            {s.lede}
            <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:18px">
              {s.deliverables.map(d => (
                <span style="font-size:13px; line-height:1.4; color:var(--ink-2); padding:8px 14px; background:var(--paper); border:1px solid var(--line); border-radius:999px;">{d}</span>
              ))}
            </div>
            <a href={s.slug} style="display:inline-flex; align-items:center; gap:6px; margin-top:16px; font-family:var(--font-mono); font-size:11.5px; letter-spacing:0.04em; text-transform:uppercase; color:var(--deep);">
              View {s.code} line
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <div class="when">{s.plazo}</div>
        </div>
      ))}
    </div>
  </section>

  {videoServicios && (
    <section class="section wrap">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">Video · Services</div>
          <h2>Our service lines<br>in <em>action</em>.</h2>
        </div>
      </div>
      <div class="reveal" style="max-width:820px">
        <VideoFacade video={videoServicios} lang="en" />
      </div>
    </section>
  )}

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Methodology · EKORUTA</div>
        <h2>A proprietary framework to go<br>beyond the <em>regulatory minimum</em>.</h2>
      </div>
      <div class="meta">
        The EKORUTA is our business sustainability roadmap. It guides each organization step by step — from the first ANLA diagnostic to an ESG strategy aligned with UN SDGs.
      </div>
    </div>

    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr">
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Diagnostic</div>
          <div class="lbl">ANLA obligations + ESG gaps</div>
        </div>
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Roadmap</div>
          <div class="lbl">Regulatory plan + applicable SDGs</div>
        </div>
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Execution</div>
          <div class="lbl">Filings + operations + trading</div>
        </div>
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Improvement</div>
          <div class="lbl">ESG report + new cycle</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.4fr 1fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">How we work</div>
          <h2 style="margin-top:14px; max-width:18ch">Three modalities, one <em>standard</em>.</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            We work per fixed project, as a monthly retainer, or in a hybrid scheme. No fine print.
          </p>
        </div>
        <div class="stat">
          <div class="n">45<small>min</small></div>
          <div class="lbl">Initial diagnostic at no cost</div>
        </div>
        <div class="stat">
          <div class="n">4</div>
          <div class="lbl">Integrated lines available</div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter lang="en" />
</LayoutEn>
