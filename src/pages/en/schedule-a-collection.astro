---
import LayoutEn from '../../layouts/LayoutEn.astro'
---

<LayoutEn title="Schedule a collection — Ekosolv" description="Electronic waste (WEEE) collection request form. Schedule the retrieval of your obsolete equipment with certified transport and final disposal certificate." activePath="/en/schedule-a-collection">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · Collection</div>
      <div class="l">Caring for the planet, step by step</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Schedule a <em>collection</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Electronic waste (WEEE) collection request form. Please fill in all required fields (<span style="color:var(--deep)">*</span>). Includes certified transport and final disposal certificate.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="contact-grid reveal">
      <div class="contact-info">
        <div class="row"><div class="k">Email</div><div class="v ulink">info@ekosolv.com</div></div>
        <div class="row"><div class="k">Phone</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">WhatsApp</div><div class="v">+57 322 226 6729</div></div>
        <div class="row"><div class="k">Office</div><div class="v">Edificio RPTV<br>Carrera 15 #31B-33, Bogotá D.C.</div></div>
        <div class="row"><div class="k">Hours</div><div class="v">Mon – Fri · 8:00 – 17:30 COT</div></div>
        <div class="row">
          <div class="k">Shortcut</div>
          <div class="v">
            Prefer WhatsApp?<br>
            <a href="https://wa.me/573212712773" target="_blank" rel="noopener" style="color:var(--deep); font-weight:500">Schedule via WhatsApp →</a>
          </div>
        </div>
      </div>

      <form class="form" id="recoleccion-form">
        <div class="form-row">
          <div class="field">
            <label>First name *</label>
            <input type="text" name="first_name" placeholder="Your first name" required />
          </div>
          <div class="field">
            <label>Last name *</label>
            <input type="text" name="last_name" placeholder="Your last name" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Email *</label>
            <input type="email" name="email" placeholder="you@email.com" required />
          </div>
          <div class="field">
            <label>Phone *</label>
            <input type="tel" name="phone" placeholder="+1" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Company</label>
            <input type="text" name="company" placeholder="Company name" />
          </div>
          <div class="field">
            <label>Country / region *</label>
            <input type="text" name="country" placeholder="Colombia" value="Colombia" required />
          </div>
        </div>
        <div class="field">
          <label>Address *</label>
          <input type="text" name="address" placeholder="Street and number" required />
        </div>
        <div class="field">
          <label>Address — line 2</label>
          <input type="text" name="address2" placeholder="Apartment, suite, floor (optional)" />
        </div>
        <div class="form-row">
          <div class="field">
            <label>City *</label>
            <input type="text" name="city" placeholder="Bogotá D.C." required />
          </div>
          <div class="field">
            <label>Postal code</label>
            <input type="text" name="postal_code" placeholder="110111" />
          </div>
        </div>
        <div class="field">
          <label>Message</label>
          <textarea name="message" placeholder="Type of equipment, approximate quantity, and tentative collection date…"></textarea>
        </div>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute; left:-9999px; height:0; width:0; opacity:0" />
        <p id="recoleccion-error" style="display:none; color:#b04a2e; margin:0"></p>
        <button type="submit" class="submit">
          <span class="submit-text">Send</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">A new <em>case</em><br>on the radar?</div>
        <a href="/en/contact" class="foot-cta">Write to us <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Sustainability Consultants" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Environmental consulting specialized in ANLA compliance, ESG, and circular economy.</p>
        </div>
        <div><h5>Services</h5><ul><li><a href="/en/ekonsulting">EKONSULTING</a></li><li><a href="/en/ekoraee">EKORAEE</a></li><li><a href="/en/ekopartner">EKOPARTNER</a></li><li><a href="/en/ekotrading">EKOTRADING</a></li></ul></div>
        <div><h5>Site</h5><ul><li><a href="/en">Home</a></li><li><a href="/en/about">About</a></li><li><a href="/en/schedule-a-collection">Schedule</a></li><li><a href="/en/blog">Journal</a></li></ul></div>
        <div><h5>Contact</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <div>Built with care in Bogotá</div>
      </div>
    </div>
  </footer>

  <script>
    const form = document.getElementById("recoleccion-form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const btn = form.querySelector(".submit") as HTMLButtonElement;
      const text = form.querySelector(".submit-text") as HTMLElement;
      if (text) text.textContent = "Thank you! ✓";
      if (btn) btn.style.background = "var(--forest)";
    });
  </script>
</LayoutEn>
