---
import LayoutEn from '../../layouts/LayoutEn.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import TypeformFlow from '../../components/TypeformFlow.astro'
import type { TFStep } from '../../components/TypeformFlow.astro'
import { CONSENT_HTML, AVISO_PRIVACIDAD } from '../../lib/legal'

const steps: TFStep[] = [
  {
    title: 'What’s your name?',
    subtitle: 'Let’s start with the basics.',
    row: true,
    fields: [
      { type: 'text', name: 'first_name', label: 'First name', placeholder: 'Your first name', required: true, autocomplete: 'given-name' },
      { type: 'text', name: 'last_name', label: 'Last name', placeholder: 'Your last name', required: true, autocomplete: 'family-name' },
    ],
  },
  {
    title: 'How can we reach you?',
    subtitle: 'We’ll coordinate the pickup here.',
    row: true,
    fields: [
      { type: 'email', name: 'email', label: 'Email', placeholder: 'you@email.com', required: true, autocomplete: 'email' },
      { type: 'tel', name: 'phone', label: 'Phone', placeholder: '+1', required: true, autocomplete: 'tel' },
    ],
  },
  {
    title: 'Which organization?',
    row: true,
    fields: [
      { type: 'text', name: 'company', label: 'Company', placeholder: 'Company name', autocomplete: 'organization' },
      { type: 'text', name: 'country', label: 'Country / region', placeholder: 'Colombia', value: 'Colombia', required: true },
    ],
  },
  {
    title: 'Where do we pick up the equipment?',
    subtitle: 'Address where the waste to be collected is located.',
    fields: [
      { type: 'text', name: 'address', label: 'Address', placeholder: 'Street and number', required: true, autocomplete: 'address-line1' },
      { type: 'text', name: 'address2', label: 'Address — line 2', placeholder: 'Apartment, suite, floor (optional)', autocomplete: 'address-line2' },
    ],
  },
  {
    title: 'Which city?',
    row: true,
    fields: [
      { type: 'text', name: 'city', label: 'City', placeholder: 'Bogotá D.C.', required: true, autocomplete: 'address-level2' },
      { type: 'text', name: 'postal_code', label: 'Postal code', placeholder: '110111', autocomplete: 'postal-code' },
    ],
  },
  {
    title: 'What type of waste is it?',
    subtitle: 'Pick the category that best describes it.',
    fields: [
      {
        type: 'choice',
        name: 'waste_type',
        label: 'Waste type',
        options: [
          { value: 'raee_computo', label: 'WEEE · Computing & peripherals' },
          { value: 'raee_telco', label: 'WEEE · Telecommunications' },
          { value: 'raee_datacenter', label: 'WEEE · Data center infrastructure' },
          { value: 'baterias', label: 'Batteries' },
          { value: 'otro', label: 'Other' },
        ],
      },
    ],
  },
  {
    title: 'Quantity & details',
    subtitle: 'An estimate helps us plan the transport.',
    fields: [
      { type: 'text', name: 'estimated_quantity', label: 'Estimated quantity', placeholder: 'E.g. 40 devices / 300 kg' },
      { type: 'textarea', name: 'message', label: 'Message', placeholder: 'Additional details and tentative collection date…' },
    ],
  },
]
---

<LayoutEn title="Schedule a collection — Ekosolv" description="Electronic waste (WEEE) collection request form. Schedule the retrieval of your obsolete equipment with certified transport and final disposal certificate." activePath="/en/schedule-a-collection">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · Collection</div>
      <div class="l">Caring for the planet, step by step</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Schedule a <em>collection</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Electronic waste (WEEE) with certified transport and final disposal certificate. It takes under a minute — one question at a time.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="reveal">
      <TypeformFlow
        formId="recoleccion-form"
        endpoint="/api/recolecciones"
        submitLabel="Send request"
        successMode="consecutive"
        successTitle="Request received!"
        successBody="We received your collection request. We’ll reach out to coordinate the pickup."
        whatsapp="https://wa.me/573212712773"
        lang="en"
        steps={steps}
      />
    </div>

    <p class="tf-alt reveal">
      Prefer to coordinate quickly?
      <a href="https://wa.me/573212712773" target="_blank" rel="noopener">Schedule via WhatsApp →</a>
    </p>
  </section>

  <SiteFooter lang="en" />

  <style>
    .tf-alt {
      margin-top: clamp(40px, 6vw, 64px);
      padding-top: 26px;
      border-top: 1px solid var(--line);
      font-size: 15px;
      color: var(--ink-2);
      max-width: 720px;
    }
    .tf-alt a { color: var(--deep); font-weight: 500; margin-left: 6px; }
  </style>
</LayoutEn>
