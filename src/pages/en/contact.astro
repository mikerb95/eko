---
import LayoutEn from '../../layouts/LayoutEn.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import TypeformFlow from '../../components/TypeformFlow.astro'
import type { TFStep } from '../../components/TypeformFlow.astro'
import { CONSENT_HTML, MARKETING_HTML, AVISO_PRIVACIDAD } from '../../lib/legal'

const steps: TFStep[] = [
  {
    title: 'Who are we talking to?',
    subtitle: 'Tell us who you are and where you’re writing from.',
    row: true,
    fields: [
      { type: 'text', name: 'name', label: 'Name', placeholder: 'Your name', required: true, autocomplete: 'name' },
      { type: 'text', name: 'company', label: 'Company', placeholder: 'Company name', autocomplete: 'organization' },
    ],
  },
  {
    title: 'How can we reach you?',
    subtitle: 'We respond within 24 business hours.',
    row: true,
    fields: [
      { type: 'email', name: 'email', label: 'Corporate email', placeholder: 'you@company.com', required: true, autocomplete: 'email' },
      { type: 'tel', name: 'phone', label: 'Phone', placeholder: '+1', autocomplete: 'tel' },
    ],
  },
  {
    title: 'Which sector are you in?',
    subtitle: 'It helps us prepare the session with the right context.',
    fields: [
      {
        type: 'choice',
        name: 'sector',
        label: 'Sector',
        options: [
          { value: 'Technology importer', label: 'Technology importer' },
          { value: 'Assembler / producer', label: 'Assembler / producer' },
          { value: 'Telecommunications', label: 'Telecommunications' },
          { value: 'Data center / infrastructure', label: 'Data center / infrastructure' },
          { value: 'Electronics retail', label: 'Electronics retail' },
          { value: 'Other', label: 'Other' },
        ],
      },
    ],
  },
  {
    title: 'What do you need to resolve?',
    subtitle: 'Select all the service lines that apply.',
    fields: [
      {
        type: 'choice',
        name: 'service_lines',
        label: 'Service line',
        multiple: true,
        options: [
          { value: 'EKONSULTING · ANLA Advisory', label: 'EKONSULTING', hint: 'ANLA Advisory' },
          { value: 'EKORAEE · Electronic waste', label: 'EKORAEE', hint: 'Electronic waste', selected: true },
          { value: 'EKOPARTNER · Waste operations', label: 'EKOPARTNER', hint: 'Waste operations' },
          { value: 'EKOTRADING · IT assets', label: 'EKOTRADING', hint: 'IT assets' },
          { value: 'ESG Strategy', label: 'ESG Strategy' },
        ],
      },
    ],
  },
  {
    title: 'Tell us the context',
    subtitle: 'The more detail, the better we prepare the session.',
    fields: [
      { type: 'textarea', name: 'message', label: 'Tell us more', placeholder: 'Context of the obligation, type of waste, estimated volumes, upcoming deadlines…' },
      { type: 'consent', name: 'consent', html: CONSENT_HTML.en },
      // Opcional y desmarcada: alimenta la lista de Zoho Campaigns, que es una
      // finalidad distinta de responder la solicitud (ver `MARKETING_HTML`).
      { type: 'consent', name: 'marketing', html: MARKETING_HTML.en, required: false, notice: AVISO_PRIVACIDAD.en },
    ],
  },
]
---

<LayoutEn activePath="/en/contact">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Contact</div>
      <div class="l">We respond within &lt; 24 business hours</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      A <em>diagnostic</em><br>to get started.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Briefly tell us what obligation you need to resolve. We'll reach out within 24 business hours for a free 45-minute session.
    </p>
  </section>

  <section class="section wrap">
    <div class="band reveal" style="margin-bottom: clamp(32px, 4vw, 56px)">
      <div class="band-grid" style="grid-template-columns: 1fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Collection</div>
          <h2 style="margin-top:14px; max-width:20ch">Need to remove <em>obsolete</em> equipment?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:16px; max-width:44ch; font-size:15px; line-height:1.55">
            Schedule an electronic waste (WEEE) collection for your company. Includes certified transport and final disposal certificate.
          </p>
        </div>
        <div style="display:flex; flex-direction:column; justify-content:center; gap:20px">
          <a href="https://wa.me/573212712773" target="_blank" rel="noopener" class="foot-cta" style="background: color-mix(in oklab, #fff 15%, transparent); border: 1px solid color-mix(in oklab, #fff 25%, transparent);">
            Schedule via WhatsApp
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <div style="font-family: var(--font-mono); font-size:11.5px; color: color-mix(in oklab, #fff 55%, transparent); letter-spacing:0.06em; text-transform:uppercase;">
            +57 321 271 2773 · info@ekosolv.com
          </div>
        </div>
      </div>
    </div>

    <div class="reveal">
      <TypeformFlow
        formId="contact-form"
        endpoint="/api/contacto"
        submitLabel="Send request"
        successMode="simple"
        successTitle="Request sent"
        successBody="Thanks. We’ll reach out within 24 business hours to schedule your diagnostic."
        whatsapp="https://wa.me/573212712773"
        lang="en"
        steps={steps}
      />
    </div>
  </section>

  <SiteFooter lang="en" />
</LayoutEn>
