---
import LayoutEn from '../../layouts/LayoutEn.astro'
import SiteFooter from '../../components/SiteFooter.astro'
---

<LayoutEn title="Contact — Ekosolv" activePath="/en/contact">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Contact</div>
      <div class="l">We respond within &lt; 24 business hours</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      A <em>diagnostic</em><br>to get started.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Briefly tell us what obligation you need to resolve. We'll reach out within 24 business hours for a free 45-minute session.
    </p>
  </section>

  <section class="section wrap">
    <div class="band reveal" style="margin-bottom: clamp(32px, 4vw, 56px)">
      <div class="band-grid" style="grid-template-columns: 1fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Collection</div>
          <h2 style="margin-top:14px; max-width:20ch">Need to remove <em>obsolete</em> equipment?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:16px; max-width:44ch; font-size:15px; line-height:1.55">
            Schedule an electronic waste (WEEE) collection for your company. Includes certified transport and final disposal certificate.
          </p>
        </div>
        <div style="display:flex; flex-direction:column; justify-content:center; gap:20px">
          <a href="https://wa.me/573212712773" target="_blank" rel="noopener" class="foot-cta" style="background: color-mix(in oklab, #fff 15%, transparent); border: 1px solid color-mix(in oklab, #fff 25%, transparent);">
            Schedule via WhatsApp
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <div style="font-family: var(--font-mono); font-size:11.5px; color: color-mix(in oklab, #fff 55%, transparent); letter-spacing:0.06em; text-transform:uppercase;">
            +57 321 271 2773 · info@ekosolv.com
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="contact-grid reveal">
      <div class="contact-info">
        <div class="row"><div class="k">Email</div><div class="v ulink">info@ekosolv.com</div></div>
        <div class="row"><div class="k">Phone</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">WhatsApp</div><div class="v">+57 321 271 2773</div></div>
        <div class="row"><div class="k">Office</div><div class="v">Edificio RPTV<br>Carrera 15 #31B-33, Bogotá D.C.</div></div>
        <div class="row"><div class="k">Hours</div><div class="v">Mon – Fri · 8:00 – 17:30 COT</div></div>
        <div class="row">
          <div class="k">Emergencies</div>
          <div class="v">
            Unscheduled visits by the environmental authority:<br>
            <span style="color:var(--deep); font-weight:500">+57 322 226 6729</span> · 24/7
          </div>
        </div>
      </div>

      <form class="form" id="contact-form">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <input type="text" placeholder="Your name" />
          </div>
          <div class="field">
            <label>Company</label>
            <input type="text" placeholder="Company name" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Corporate email</label>
            <input type="email" placeholder="you@company.com" />
          </div>
          <div class="field">
            <label>Phone</label>
            <input type="tel" placeholder="+1" />
          </div>
        </div>
        <div class="field">
          <label>Sector</label>
          <select>
            <option>Technology importer</option>
            <option>Assembler / producer</option>
            <option>Telecommunications</option>
            <option>Data center / infrastructure</option>
            <option>Electronics retail</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label>Service line (select all that apply)</label>
          <div class="chips">
            <button type="button" class="chip">EKONSULTING · ANLA Advisory</button>
            <button type="button" class="chip on">EKORAEE · Electronic waste</button>
            <button type="button" class="chip">EKOPARTNER · Waste operations</button>
            <button type="button" class="chip">EKOTRADING · IT assets</button>
            <button type="button" class="chip">ESG Strategy</button>
          </div>
        </div>
        <div class="field">
          <label>Tell us more</label>
          <textarea placeholder="Context of the obligation, type of waste, estimated volumes, upcoming deadlines…"></textarea>
        </div>
        <button type="submit" class="submit">
          <span class="submit-text">Send request</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </button>
      </form>
    </div>
  </section>

  <SiteFooter lang="en" />

  <script>
    const form = document.getElementById("contact-form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const btn = form.querySelector(".submit") as HTMLButtonElement;
      const text = form.querySelector(".submit-text") as HTMLElement;
      if (text) text.textContent = "Sent ✓";
      if (btn) btn.style.background = "var(--forest)";
    });
  </script>
</LayoutEn>
