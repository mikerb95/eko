---
import LayoutEn from '../../layouts/LayoutEn.astro'

const systems = [
  {
    n: "01", title: "Packaging and containers",
    desc: "Our Collective Packaging Collection System, endorsed by Resolution 1407 of 2018 (amended by 1342 of 2020), has operated since 2021. In its first year it managed 52 tonnes of packaging waste.",
    when: "Since 2021",
  },
  {
    n: "02", title: "WEEE collection system",
    desc: "Collective and individual post-consumer collection and management system for waste electrical and electronic equipment, authorized by ANLA. Applies only in Colombia.",
    when: "Collective / individual",
  },
]

const includes = [
  "Management system authorized by ANLA",
  "Collective or individual reverse logistics",
  "Final disposal certificates for all clients",
  "Internal and external awareness campaigns",
  "Environmental training programs",
  "Specialized brand promotion team with ecological focus",
]
---

<LayoutEn title="EKOPARTNER — Post-consumer System Management · Ekosolv" description="We operate collective and individual collection and post-consumer management systems for packaging and WEEE, authorized by ANLA. Colombia only." activePath="/en/services">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKOPARTNER · 03</div>
      <div class="l">WEEE Management · Ekosolv</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      We operate your complete<br><em>post-consumer</em> system.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">
      We integrate and operate collective and individual collection and post-consumer management systems for priority waste, through differentiated systems. We don't just advise — we do it. Colombia only.
    </p>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Post-consumer programs</div>
        <h2>Two <em>differentiated</em><br>collection systems.</h2>
      </div>
      <div class="meta">An initiative of the Ministry of Environment and Sustainable Development to promote the environmentally responsible management of priority waste.</div>
    </div>
    <div class="process reveal">
      {systems.map(s => (
        <div class="process-row">
          <div class="n">{s.n}</div>
          <h3>{s.title}</h3>
          <div class="desc">{s.desc}</div>
          <div class="when">{s.when}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">2021 results</div>
          <h2 style="margin-top:14px; max-width:16ch">Operations with <em>regulatory</em> backing.</h2>
        </div>
        <div class="stat">
          <div class="n">52<small>ton</small></div>
          <div class="lbl">Packaging waste managed in 2021</div>
        </div>
        <div class="stat">
          <div class="n">1407<small>/18</small></div>
          <div class="lbl">Resolution endorsing the collective system</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">What's included</div>
        <h2>A partner that <em>operates</em>,<br>not just advises.</h2>
      </div>
      <div class="meta">We take over the operation of your organization's waste management system, from start to finish.</div>
    </div>
    <div class="reveal" style="display:flex; flex-wrap:wrap; gap:8px;">
      {includes.map(d => (
        <span style="font-family: var(--font-mono); font-size:12px; color:var(--ink-2); padding:8px 14px; background:var(--paper); border:1px solid var(--line); border-radius:999px;">{d}</span>
      ))}
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">A new <em>case</em><br>on the radar?</div>
        <a href="/en/contact" class="foot-cta">Write to us <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Sustainability Consultants" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Environmental consulting specialized in ANLA compliance, ESG, and circular economy.</p>
        </div>
        <div><h5>Services</h5><ul><li><a href="/en/ekonsulting">EKONSULTING</a></li><li><a href="/en/ekoraee">EKORAEE</a></li><li><a href="/en/ekopartner">EKOPARTNER</a></li><li><a href="/en/ekotrading">EKOTRADING</a></li></ul></div>
        <div><h5>Site</h5><ul><li><a href="/en">Home</a></li><li><a href="/en/about">About</a></li><li><a href="/en/schedule-a-collection">Schedule</a></li><li><a href="/en/blog">Journal</a></li></ul></div>
        <div><h5>Contact</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>
</LayoutEn>
