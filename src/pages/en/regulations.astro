---
import LayoutEn from '../../layouts/LayoutEn.astro'

const col1 = [
  { code: "DEC 1076 · 2015", title: "Single Environmental Sector Regulatory Decree", body: "Consolidates most environmental regulations in Colombia. Defines licenses, permits, plans, and competent authorities.", tags: ["MinAmbiente", "Licenses", "ANLA", "CAR"] },
  { code: "RES 2184 · 2019", title: "Color codes for recyclable waste", body: "National standard for source separation: white (recyclable), black (non-recyclable), green (organic).", tags: ["Separation", "MSW", "Households", "Companies"] },
  { code: "RES 1297 · 2010", title: "Post-consumer plan for Waste Electrical and Electronic Equipment", body: "Requires producers and importers to submit management, operation, coverage, and target plans.", tags: ["WEEE", "Post-consumer", "Producer", "Importer"] },
  { code: "LEY 1672 · 2013", title: "WEEE Law", body: "Extended producer responsibility framework. Defines principles, stakeholders, selective collection, and recovery.", tags: ["EPR", "Legal framework"] },
  { code: "RES 0472 · 2017", title: "Integral management of construction and demolition waste (CDW)", body: "Applies to companies that fit out offices, data centers, or warehouses: management plan, registration, and reporting.", tags: ["CDW", "Construction"] },
]

const col2 = [
  { code: "RES 1407 · 2018", title: "Environmental management plan for packaging waste", body: "Obligation for producers and marketers of packaging placed on the Colombian market.", tags: ["Packaging", "EPR", "Marketer"] },
  { code: "DEC 1076 · Title 5", title: "Use and exploitation of water resources", body: "Water concessions, discharge permits, retributive rates, and water use rates.", tags: ["Water", "Discharges", "Concession"] },
  { code: "RES 909 · 2008", title: "Allowable emission standards", body: "Applies to stationary sources. Relevant for assemblers, data centers with generators, processes with furnaces.", tags: ["Air", "Emissions", "Stationary sources"] },
  { code: "RES 0631 · 2015", title: "Maximum limit parameters for point discharges", body: "Defines what can be discharged to a water body or sewage system. Treatment plants, labs, data centers.", tags: ["Discharges", "BOD", "COD"] },
  { code: "RES 1407 · 2022", title: "Environmental penalty regime (Law 1333)", body: "Establishes the penalty procedure and criteria for determining fines.", tags: ["Penalties", "Procedure"] },
]
---

<LayoutEn title="Regulations — Ekosolv" activePath="/en/regulations">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Regulations</div>
      <div class="l">Updated · April 2026</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      The <em>framework</em> that<br>applies to your company.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      A living map of the most common environmental obligations for companies that import, produce, or distribute technology in Colombia. Click to expand.
    </p>
  </section>

  <section class="section wrap">
    <div class="norms reveal">
      <div class="norms-col">
        {col1.map((n, idx) => (
          <div class="norm" data-open={idx === 0 ? 'true' : 'false'}>
            <div>
              <div class="code">{n.code}</div>
              <h4>{n.title}</h4>
            </div>
            <button class="plus" aria-label="expand">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 1v10M1 6h10"/>
              </svg>
            </button>
            <div class="body">
              <p>{n.body}</p>
              <ul>{n.tags.map(t => <li>{t}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
      <div class="norms-col">
        {col2.map((n) => (
          <div class="norm" data-open="false">
            <div>
              <div class="code">{n.code}</div>
              <h4>{n.title}</h4>
            </div>
            <button class="plus" aria-label="expand">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 1v10M1 6h10"/>
              </svg>
            </button>
            <div class="body">
              <p>{n.body}</p>
              <ul>{n.tags.map(t => <li>{t}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Regulatory monitoring</div>
          <h2 style="margin-top:14px; max-width:16ch">New regulations, <em>reviewed</em> every week.</h2>
        </div>
        <div class="stat">
          <div class="n">47</div>
          <div class="lbl">Active resolutions monitored</div>
        </div>
        <div class="stat">
          <div class="n">12</div>
          <div class="lbl">Regulatory changes in 2025</div>
        </div>
        <div class="stat">
          <div class="n">24<small>h</small></div>
          <div class="lbl">Client alert after publication</div>
        </div>
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">A new <em>case</em><br>on the radar?</div>
        <a href="/en/contact" class="foot-cta">
          Write to us
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Sustainability Consultants" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Environmental consulting specialized in ANLA compliance for the tech sector.</p>
        </div>
        <div><h5>Site</h5><ul><li><a href="/en">Home</a></li><li><a href="/en/services">Services</a></li><li><a href="/en/regulations">Regulations</a></li><li><a href="/en/cases">Cases</a></li><li><a href="/en/blog">Journal</a></li></ul></div>
        <div><h5>Contact</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
        <div><h5>Legal</h5><ul><li>Data policy</li><li>Terms of service</li><li>Code of ethics</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <div>Built with care in Bogotá</div>
      </div>
    </div>
  </footer>
</LayoutEn>
