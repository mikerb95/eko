---
import LayoutEn from '../../layouts/LayoutEn.astro'
import normativas from '../../data/normativas.json'

// English copy of the same three entries surfaced on /en/regulations
const radar = [
  { code: 'RES 1297 · 2010', title: 'Post-consumer plan for Waste Electrical and Electronic Equipment', tags: ['WEEE', 'Post-consumer', 'Producer'] },
  { code: 'LEY 1672 · 2013', title: 'WEEE Law', tags: ['EPR', 'Legal framework'] },
  { code: 'RES 1407 · 2018', title: 'Environmental management plan for packaging waste', tags: ['Packaging', 'EPR', 'Marketer'] },
]
---

<LayoutEn title="Ekosolv — Environmental Consulting · ANLA · ESG · Circular Economy" activePath="/en">
  <section class="hero wrap">
    <div class="hero-top reveal">
      <div>
        <div class="eyebrow">ANLA Compliance · ESG · Circular Economy · Bogotá · Colombia</div>
      </div>
      <div class="hero-meta">
        <div>Est.<strong>2013</strong></div>
        <div>Active<strong>clients</strong></div>
        <div>HQ<strong>Bogotá D.C.</strong></div>
        <div>Coverage<strong>Nationwide</strong></div>
      </div>
    </div>

    <h1 class="display hero-title reveal">
      Comply with <em>ANLA</em>,<br>
      grow with <span class="thin">purpose</span>.
    </h1>

    <div class="hero-foot reveal">
      <p class="lede">
        We support importers, producers, and tech operators in Colombia
        to comply with ANLA regulations, build their ESG strategy, and make the leap
        toward the circular economy — with the rigor the authority demands and the speed
        that business requires.
      </p>
      <a href="/en/contact" class="hero-card">
        <div>
          <div class="big">Schedule a <em>diagnostic</em></div>
          <div class="sub">45 min · no cost · confidential</div>
        </div>
        <div class="arrow">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </div>
      </a>
    </div>

    <div class="hero-visual reveal">
      <div class="hv-head">
        <div class="label"><span class="pulse"></span>Regulatory radar · framework in force in Colombia</div>
        <div class="coords">
          04°42′N · 74°03′W<br>
          <strong>Bogotá — Operations</strong>
        </div>
      </div>
      <div class="hv-grid">
        {radar.map((n) => (
          <a class="hv-item" href="/en/regulations">
            <div class="hv-code">{n.code}</div>
            <div class="hv-title">{n.title}</div>
            <div class="hv-tags">{n.tags.slice(0, 3).join(' · ')}</div>
          </a>
        ))}
      </div>
      <a class="hv-foot" href="/en/regulations">
        See the {normativas.length} regulations we audit
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <div class="sectors reveal" style="margin-top:48px">
      <div class="sector"><span class="d deep"></span>Technology importers</div>
      <div class="sector"><span class="d"></span>Assemblers and producers</div>
      <div class="sector"><span class="d aqua"></span>Telecommunications operators</div>
      <div class="sector"><span class="d clay"></span>Data centers &amp; infrastructure</div>
      <div class="sector"><span class="d"></span>Electronics retail</div>
    </div>
  </section>

  <div class="marquee">
    <div class="marquee-track">
      <span>
        Resolution 1297 of 2010 <em class="dot"></em>
        Decree 1076 of 2015 <em class="dot"></em>
        Resolution 2184 of 2019 <em class="dot"></em>
        WEEE — Waste Electrical and Electronic Equipment <em class="dot"></em>
        Post-consumer plan <em class="dot"></em>
        ESG criteria <em class="dot"></em>
        SDGs — Sustainable Development Goals <em class="dot"></em>
        Circular economy <em class="dot"></em>
        ANLA licenses <em class="dot"></em>
      </span>
      <span aria-hidden="true">
        Resolution 1297 of 2010 <em class="dot"></em>
        Decree 1076 of 2015 <em class="dot"></em>
        Resolution 2184 of 2019 <em class="dot"></em>
        WEEE — Waste Electrical and Electronic Equipment <em class="dot"></em>
        Post-consumer plan <em class="dot"></em>
        ESG criteria <em class="dot"></em>
        SDGs — Sustainable Development Goals <em class="dot"></em>
        Circular economy <em class="dot"></em>
        ANLA licenses <em class="dot"></em>
      </span>
    </div>
  </div>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Service lines · 01</div>
        <h2>Four lines. One<br><em>sustainable path.</em></h2>
      </div>
      <div class="meta">
        From regulatory strategy to waste operations and circular economy. Each line addresses a different moment in the environmental lifecycle of a tech company.
      </div>
    </div>

    <div class="services reveal">
      <div class="svc big accent-deep">
        <div>
          <div class="num">EKONSULTING</div>
          <h3>Advisory and compliance before <em>ANLA</em>.</h3>
          <p>Licensing, audits, reports, post-consumer plans, and support in penalty proceedings. We speak both the evaluator's language and the executive's.</p>
        </div>
        <div class="tag"><span class="bar"></span>ANLA · CAR · VITAL · ESG</div>
      </div>
      <div class="svc small accent-forest">
        <div>
          <div class="num">EKORAEE</div>
          <h3>Certified management of <em>electronic</em> waste.</h3>
          <p>Collection, transport, storage, and certification of WEEE under Res. 1297 and Law 1672.</p>
        </div>
        <div class="tag"><span class="bar"></span>Collection · Certification</div>
      </div>
      <div class="svc thin">
        <div>
          <div class="num">EKOPARTNER</div>
          <h3>Operation of waste <em>management</em> systems.</h3>
          <p>We integrate and operate the complete collection and disposal system. Colombia only.</p>
        </div>
        <div class="tag"><span class="bar"></span>Operations · Colombia</div>
      </div>
      <div class="svc wide accent-clay">
        <div>
          <div class="num">EKOTRADING</div>
          <h3>Buying and selling <em>used or obsolete</em> technology at scale.</h3>
          <p>We close the lifecycle of equipment within a circular economy framework. IT asset retrieval, refurbishment, and wholesale remarketing — with the traceability that SDGs demand.</p>
        </div>
        <div class="tag"><span class="bar"></span>Circular economy · SDGs · IT assets</div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Methodology · 02</div>
        <h2>The <em>EKORUTA</em>: sustainability step by step.</h2>
      </div>
      <div class="meta">
        Our proprietary framework guides each organization from the regulatory diagnostic to a complete ESG strategy, aligned with UN SDGs.
      </div>
    </div>

    <div class="process reveal">
      <div class="process-row">
        <div class="n">01</div>
        <h3>Diag<em>nostic</em></h3>
        <div class="desc">A complete scan of active ANLA obligations, ESG gaps, and circular economy opportunities. We map penalty risk and value potential.</div>
        <div class="when">Week 1–2</div>
      </div>
      <div class="process-row">
        <div class="n">02</div>
        <h3>Road<em>map</em></h3>
        <div class="desc">We design the integrated regulatory and ESG plan, prioritizing by penalty exposure, deadlines, and applicable SDG targets.</div>
        <div class="when">Week 2–3</div>
      </div>
      <div class="process-row">
        <div class="n">03</div>
        <h3>Execution and <em>filing</em></h3>
        <div class="desc">Study preparation, VITAL uploads, WEEE collection operations, or EKOTRADING activation as mandated. Direct liaison with the authority.</div>
        <div class="when">Week 3–8</div>
      </div>
      <div class="process-row">
        <div class="n">04</div>
        <h3>Moni<em>toring</em></h3>
        <div class="desc">Responses to requirements, internal audits, quarterly ESG reporting, and post-consumer target tracking. The cycle doesn't end with the filing.</div>
        <div class="when">Ongoing</div>
      </div>
      <div class="process-row">
        <div class="n">05</div>
        <h3>Closure and <em>improvement</em></h3>
        <div class="desc">Consolidation of the file, annual ESG report delivery, and plan redesign for the next regulatory cycle with more ambitious targets.</div>
        <div class="when">Annual</div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">By the numbers</div>
          <h2 style="margin-top:14px">Seven years supporting<br>Colombia's <em>tech industry.</em></h2>
        </div>
        <div class="stat">
          <div class="n">98<small>%</small></div>
          <div class="lbl">Approved filings</div>
        </div>
        <div class="stat">
          <div class="n">0</div>
          <div class="lbl">Final penalties · active clients</div>
        </div>
        <div class="stat">
          <div class="n">4</div>
          <div class="lbl">Integrated service lines</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Clients · 03</div>
        <h2>Companies that have <em>trusted</em><br>us.</h2>
      </div>
      <div class="meta">We work with importers, producers, distributors, and tech infrastructure operators in Colombia.</div>
    </div>

    <div class="logos reveal">
      <div>Nodex</div>
      <div>Andina<span style="color:var(--clay)">.</span>tech</div>
      <div>Kairos</div>
      <div>Ferra</div>
      <div>Origen</div>
      <div>Meridian</div>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">
          A new <em>case</em><br>on the radar?
        </div>
        <a href="/en/contact" class="foot-cta">
          Write to us
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Sustainability Consultants" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">
            Environmental consulting specialized in ANLA compliance, ESG, and circular economy for the tech sector.
          </p>
        </div>
        <div>
          <h5>Site</h5>
          <ul>
            <li><a href="/en">Home</a></li>
            <li><a href="/en/services">Services</a></li>
            <li><a href="/en/regulations">Regulations</a></li>
            <li><a href="/en/cases">Cases</a></li>
            <li><a href="/en/blog">Journal</a></li>
          </ul>
        </div>
        <div>
          <h5>Contact</h5>
          <ul>
            <li>info@ekosolv.com</li>
            <li>+57 321 271 2773</li>
            <li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li>
          </ul>
        </div>
        <div>
          <h5>Legal</h5>
          <ul>
            <li>Data policy</li>
            <li>Terms of service</li>
            <li>Code of ethics</li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>
</LayoutEn>
