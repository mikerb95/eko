---
import LayoutEn from '../../layouts/LayoutEn.astro'
import { FOUNDED_YEAR, tonnesManaged } from '../../lib/brand'

const services = [
  {
    n: "01", title: "Collection campaigns",
    desc: "Selective collection campaigns for waste electrical and electronic equipment for companies, institutions, and communities. Caring for the planet, step by step.",
    when: "Per campaign",
  },
  {
    n: "02", title: "Certified transport and disposal",
    desc: "On-site or door-to-door collection, certified transport to an authorized processor, and final disposal certificates for every client, in accordance with current environmental regulations.",
    when: "Ongoing",
  },
  {
    n: "03", title: "Licensing and compliance reports (ICA)",
    desc: "Environmental licensing projects and compliance reports (ICA), with integration into the EKONSULTING post-consumer plan and target reporting to the authority.",
    when: "Per project",
  },
  {
    n: "04", title: "Reverse logistics and recovery",
    desc: "Reverse logistics solutions for companies and individuals, material recovery and valorization to close the cycle within the circular economy.",
    when: "Ongoing",
  },
]
---

<LayoutEn title="EKORAEE — Electronic Waste Management · Ekosolv" description={`Collection, transport, storage, and WEEE certification under environmental regulations. Over ${tonnesManaged('en')} tonnes managed since ${FOUNDED_YEAR}.`} activePath="/en/services">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · 02</div>
      <div class="l">Recycling the future</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Collection of electrical<br>and electronic <em>waste</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">
      Collection, transport, storage, and certification of WEEE under environmental regulations. Our system has operated since {FOUNDED_YEAR}, managing over {tonnesManaged('en')} tonnes of electronic waste in support of the circular economy.
    </p>
    {/* PENDING-DATA 2.c: confirm the real collection footprint before publishing. */}
    <p class="lede reveal" style="margin-top:20px; max-width:58ch; font-size:17px; color:var(--mute)">
      Regulatory advisory is delivered remotely nationwide. Collection is arranged case by case based on volume and location — get in touch and we will confirm coverage before scheduling.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">WEEE management experience</div>
          <h2 style="margin-top:14px; max-width:16ch">Caring for the planet, <em>step by step</em>.</h2>
        </div>
        <div class="stat">
          <div class="n">2013</div>
          <div class="lbl">System in operation since</div>
        </div>
        <div class="stat">
          <div class="n">1,000<small>+ ton</small></div>
          <div class="lbl">Of WEEE responsibly managed</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="process reveal">
      {services.map(s => (
        <div class="process-row">
          <div class="n">{s.n}</div>
          <h3>{s.title}</h3>
          <div class="desc">{s.desc}</div>
          <div class="when">{s.when}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.4fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Collection</div>
          <h2 style="margin-top:14px; max-width:20ch">Have <em>obsolete</em> equipment to remove?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            Schedule an electronic waste collection for your company. Includes certified transport and final disposal certificate.
          </p>
        </div>
        <div style="display:flex; align-items:center; justify-content:flex-end;">
          <a href="/en/schedule-a-collection" class="foot-cta">
            Schedule a collection
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">A new <em>case</em><br>on the radar?</div>
        <a href="/en/contact" class="foot-cta">Write to us <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Sustainability Consultants" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Environmental consulting specialized in ANLA compliance, ESG, and circular economy.</p>
        </div>
        <div><h5>Services</h5><ul><li><a href="/en/ekonsulting">EKONSULTING</a></li><li><a href="/en/ekoraee">EKORAEE</a></li><li><a href="/en/ekopartner">EKOPARTNER</a></li><li><a href="/en/ekotrading">EKOTRADING</a></li></ul></div>
        <div><h5>Site</h5><ul><li><a href="/en">Home</a></li><li><a href="/en/about">About</a></li><li><a href="/en/schedule-a-collection">Schedule</a></li><li><a href="/en/blog">Journal</a></li></ul></div>
        <div><h5>Contact</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>
</LayoutEn>
