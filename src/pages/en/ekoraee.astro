---
import LayoutEn from '../../layouts/LayoutEn.astro'
import { FOUNDED_YEAR, stats, tonnesManaged } from '../../lib/brand'
import SiteFooter from '../../components/SiteFooter.astro'

const services = [
  {
    n: "01", title: "Collection campaigns",
    desc: "Selective collection campaigns for waste electrical and electronic equipment for companies, institutions, and communities. Caring for the planet, step by step.",
    when: "Per campaign",
  },
  {
    n: "02", title: "Certified transport and disposal",
    desc: "On-site or door-to-door collection, certified transport to an authorized processor, and final disposal certificates for every client, in accordance with current environmental regulations.",
    when: "Ongoing",
  },
  {
    n: "03", title: "Licensing and compliance reports (ICA)",
    desc: "Environmental licensing projects and compliance reports (ICA), with integration into the EKONSULTING post-consumer plan and target reporting to the authority.",
    when: "Per project",
  },
  {
    n: "04", title: "Reverse logistics and recovery",
    desc: "Reverse logistics solutions for companies and individuals, material recovery and valorization to close the cycle within the circular economy.",
    when: "Ongoing",
  },
]
---

<LayoutEn title="EKORAEE — Electronic Waste Management · Ekosolv" description={`Collection, transport, storage, and WEEE certification under environmental regulations. ${tonnesManaged('en')} tonnes managed since ${FOUNDED_YEAR}.`} activePath="/en/ekoraee">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · 02</div>
      <div class="l">Recycling the future</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Collection of electrical<br>and electronic <em>waste</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">
      Collection, transport, storage, and certification of WEEE under environmental regulations. Our system has operated since {FOUNDED_YEAR}, managing {tonnesManaged('en')} tonnes of electronic waste in support of the circular economy.
    </p>
    {/* PENDING-DATA 2.c: confirm the real collection footprint before publishing. */}
    <p class="lede reveal" style="margin-top:20px; max-width:58ch; font-size:17px; color:var(--mute)">
      Regulatory advisory is delivered remotely nationwide. Collection is arranged case by case based on volume and location — get in touch and we will confirm coverage before scheduling.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">WEEE management experience</div>
          <h2 style="margin-top:14px; max-width:16ch">Caring for the planet, <em>step by step</em>.</h2>
        </div>
        <div class="stat">
          <div class="n">{FOUNDED_YEAR}</div>
          <div class="lbl">System in operation since</div>
        </div>
        <div class="stat">
          <div class="n">{stats.tonnesManaged.toLocaleString('en-US')}<small>+ ton</small></div>
          <div class="lbl">Of WEEE responsibly managed</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="process reveal">
      {services.map(s => (
        <div class="process-row">
          <div class="n">{s.n}</div>
          <h3>{s.title}</h3>
          <div class="desc">{s.desc}</div>
          <div class="when">{s.when}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.4fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Collection</div>
          <h2 style="margin-top:14px; max-width:20ch">Have <em>obsolete</em> equipment to remove?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            Schedule an electronic waste collection for your company. Includes certified transport and final disposal certificate.
          </p>
        </div>
        <div style="display:flex; align-items:center; justify-content:flex-end;">
          <a href="/en/schedule-a-collection" class="foot-cta">
            Schedule a collection
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter lang="en" />
</LayoutEn>
