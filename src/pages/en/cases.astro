---
import LayoutEn from '../../layouts/LayoutEn.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import { agregadoCasos, casosVisibles, hayAgregado, mostrarPlaceholders } from '../../lib/credenciales'

const cases = casosVisibles()

---

<LayoutEn title="Cases — Ekosolv" activePath="/en/cases">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Cases</div>
      <div class="l">Selection · 2024 – 2026</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      How we <em>work</em>,<br>case by case.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Mandates executed with real clients. Names are kept confidential under NDA; the figures are the ones we can substantiate.
    </p>
  </section>

  <section class="section wrap">
    {mostrarPlaceholders && (
      <div class="dev-warning">
        ⚠ PLACEHOLDERS — development only. The previous 6 cases were fabricated.
        Fill in `casos` and `agregadoCasos` in src/lib/credenciales.ts with real
        mandates and set `verificado: true`.
      </div>
    )}

    {cases.length === 0 && (
      <div class="reveal" style="border-top:1px solid var(--line); padding-top:40px">
        <h2 style="max-width:22ch">This section is in <em>preparation</em>.</h2>
        <p class="lede" style="margin-top:20px; max-width:56ch">
          We are documenting our mandates in a format we can substantiate without
          compromising client confidentiality. If you need references for a
          procurement process, we will provide them directly.
        </p>
        <a href="/en/contact" class="doc-link" style="margin-top:28px">
          Request references
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    )}

    <div class="cases reveal">
      {cases.map(c => (
        <article class={`case ${c.cls}`}>
          <div class="cover" data-label={c.label}></div>
          <div class="kicker">
            <span>{c.kicker[0]}</span>
            <span>{c.kicker[1]}</span>
          </div>
          <h3 set:html={c.title.replace(c.titleEm, `<em>${c.titleEm}</em>`)}></h3>
          <div class="metric">
            {c.metrics.map(m => (
              <div>
                <div class="v">{m[0]}</div>
                <div class="l">{m[1]}</div>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  {hayAgregado() && (
    <section class="section wrap">
      <div class="band reveal">
        <div class="band-grid" style="grid-template-columns: 1.3fr 1fr 1fr">
          <div>
            <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Aggregate results</div>
            <h2 style="margin-top:14px; max-width:18ch">The impact, <em>summing</em> all mandates.</h2>
          </div>
          <div class="stat">
            <div class="n">{agregadoCasos.riesgoMitigado}</div>
            <div class="lbl">Penalty risk mitigated</div>
          </div>
          <div class="stat">
            <div class="n">{agregadoCasos.sanciones}</div>
            <div class="lbl">Final penalties</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <SiteFooter lang="en" />
</LayoutEn>
