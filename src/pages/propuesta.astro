              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ sesion, mensajes: historial.slice(-16) }),
            })
            const j = await res.json().catch(() => ({}))
            pensando.remove()
            if (!res.ok) throw new Error(j.error || 'No se pudo responder.')
            historial.push({ rol: 'ia', texto: j.respuesta })
            burbuja('ia', j.respuesta, { seccion: j.seccion, aMike: j.pasarAMike })
          } catch (e) {
            pensando.remove()
            historial.pop()
            burbuja('ia', e instanceof Error ? e.message : 'No se pudo responder.', { error: true })
          } finally {
            b.disabled = ta.disabled = false
            ta.focus()
          }
        }
        chatForm.addEventListener('submit', (e) => {
          e.preventDefault()
          const t = ta.value
          ta.value = ''
          ta.style.height = ''
          preguntar(t)
        })
        ta.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault()
            chatForm.requestSubmit()
          }
        })
        ta.addEventListener('input', () => {
          ta.style.height = ''
          ta.style.height = `${Math.min(ta.scrollHeight, 120)}px`
