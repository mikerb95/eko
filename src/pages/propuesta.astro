      .pp-form-sel span { font-size: 12.5px; color: var(--mute); }
      .pp-form-sel b { font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--deep); }
      .pp-form-sel small { font-size: 13.5px; color: var(--ink-2); }
      .pp-form-sel a { font-size: 13px; margin-top: 4px; }
      .pp-form-fila { display: grid; gap: 14px; }
      @media (min-width: 600px) { .pp-form-fila { grid-template-columns: 1fr 1fr; } }
      .pp-form label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 500; }
      .pp-form input, .pp-form textarea { font: 15px var(--font-sans); padding: 11px 12px; border-radius: 10px; border: 1px solid var(--line-2); background: #fff; color: var(--ink); resize: vertical; }
      .pp-form input:focus, .pp-form textarea:focus { outline: 2px solid color-mix(in oklab, var(--deep) 40%, transparent); border-color: var(--deep); }
      .pp-hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
      .pp-form-msg { margin: 0 !important; font-size: 14px; min-height: 1.4em; }
      .pp-form.is-ok .pp-form-msg { color: #2a6d3a !important; font-weight: 600; }
      .pp-form.is-ok button[type='submit'] { display: none; }

      .pp-pie { padding: 28px 0 96px; font-size: 13.5px; color: var(--mute); border-top: 1px solid var(--line); }

      /* Chat */
      .pp-fab { position: fixed; right: 16px; bottom: 16px; z-index: 40; display: flex; align-items: center; gap: 8px; padding: 12px 18px 12px 14px; border: 0; border-radius: 999px; background: var(--deep); color: #fff; font: 600 14.5px var(--font-sans); cursor: pointer; box-shadow: 0 12px 28px -10px rgba(18, 78, 125, 0.6); transition: transform 0.2s, background 0.2s; }
      .pp-fab:hover { background: var(--deep-2); transform: translateY(-2px); }
      .pp-fab svg { width: 22px; height: 22px; }
      .pp-fab[hidden], .pp-chat[hidden] { display: none; }
      .pp-chat { position: fixed; z-index: 50; inset: auto 0 0 0; height: min(86vh, 640px); background: var(--card); border-radius: 18px 18px 0 0; box-shadow: 0 -12px 40px -12px rgba(14, 28, 38, 0.35); display: flex; flex-direction: column; transform: translateY(16px); opacity: 0; transition: transform 0.25s, opacity 0.25s; }
      .pp-chat.is-abierto { transform: none; opacity: 1; }
      @media (min-width: 720px) { .pp-chat { inset: auto 20px 20px auto; width: 400px; border-radius: 18px; height: min(78vh, 640px); } }
      .pp-chat header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
      .pp-chat header b { display: block; font-family: var(--font-display); font-size: 16px; }
      .pp-chat header span { font-size: 12.5px; color: var(--mute); }
      .pp-chat header button { border: 0; background: var(--alt); width: 32px; height: 32px; border-radius: 50%; font-size: 20px; line-height: 1; cursor: pointer; color: var(--ink); }
      .pp-chat-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
      .pp-msg { max-width: 88%; display: flex; flex-direction: column; gap: 6px; }
      .pp-msg p { margin: 0; padding: 10px 14px; border-radius: 16px; font-size: 14.5px; line-height: 1.5; white-space: pre-wrap; }
      .pp-msg.is-ia p { background: var(--alt); border-bottom-left-radius: 4px; }
      .pp-msg.is-yo { align-self: flex-end; }
      .pp-msg.is-yo p { background: var(--deep); color: #fff; border-bottom-right-radius: 4px; }
      .pp-msg.is-error p { background: #fdeceb; color: #9b2c22; }
      .pp-msg.is-pensando p { color: var(--mute); animation: pp-pulso 1.2s ease-in-out infinite; }
      @keyframes pp-pulso { 50% { opacity: 0.5; } }
      .pp-msg-tag { align-self: flex-start; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: #fdf0dc; color: #9a5b00; }
      .pp-msg-link { font-size: 13px; font-weight: 600; text-decoration: none; padding-left: 4px; }
      .pp-msg-link::after { content: ' →'; }
      .pp-sugeridas { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin-top: 4px; }
      .pp-sugeridas button { border: 1px solid var(--line-2); background: #fff; border-radius: 999px; padding: 7px 12px; font: 13.5px var(--font-sans); color: var(--deep); cursor: pointer; text-align: left; transition: background 0.2s; }
      .pp-sugeridas button:hover { background: color-mix(in oklab, var(--deep) 7%, #fff); }
      .pp-chat-form { display: flex; gap: 8px; align-items: flex-end; padding: 10px 12px; border-top: 1px solid var(--line); }
      .pp-chat-form textarea { flex: 1; resize: none; font: 15px var(--font-sans); padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line-2); max-height: 120px; color: var(--ink); }
      .pp-chat-form textarea:focus { outline: 2px solid color-mix(in oklab, var(--deep) 40%, transparent); border-color: var(--deep); }
      .pp-chat-form button { width: 42px; height: 42px; border-radius: 50%; border: 0; background: var(--deep); color: #fff; display: grid; place-items: center; cursor: pointer; flex: none; }
      .pp-chat-form button:disabled { opacity: 0.5; }
      .pp-chat-form button svg { width: 20px; height: 20px; }
      .pp-chat-aviso { margin: 0; padding: 0 14px 12px; font-size: 11.5px; color: var(--mute); line-height: 1.4; }
    </style>
  </body>
</html>
