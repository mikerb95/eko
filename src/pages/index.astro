---
import Layout from '../layouts/Layout.astro'
import normativas from '../data/normativas.json'
import { FOUNDED_YEAR, stats, tonnesManaged, yearsActive } from '../lib/brand'
import { clientesVisibles, mostrarPlaceholders, testimoniosVisibles } from '../lib/credenciales'

const RADAR_CODES = ['RES 1297 · 2010', 'LEY 1672 · 2013', 'RES 1407 · 2018']
const radar = RADAR_CODES
  .map((code) => normativas.find((n) => n.code === code))
  .filter(Boolean)
---

<Layout title="Ekosolv — Consultoría ambiental · ANLA · ESG · Economía circular" activePath="/">
  <section class="hero wrap">
    <div class="eyebrow reveal">Cumplimiento ANLA · ESG · Economía circular — consultoría en toda Colombia</div>

    <h1 class="display hero-title reveal">
      Cumplir con la <em>ANLA</em>,<br>
      crecer con <span class="thin">propósito</span>.
    </h1>

    <div class="hero-foot reveal">
      <p class="lede">
        Acompañamos a importadores, productores y operadores de tecnología en Colombia
        a cumplir con la normativa ANLA, construir su estrategia ESG y dar el salto
        hacia la economía circular — con el rigor que exige la autoridad y la velocidad
        que exige el negocio.
      </p>
      <a href="/contacto" class="hero-card">
        <div>
          <div class="big">Agenda un <em>diagnóstico</em></div>
          <div class="sub">45 min · sin costo · confidencial</div>
        </div>
        <div class="arrow">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </div>
      </a>
    </div>

    {/*
      Fase 2 de docs/plan-competitivo-lito.md. Cifras de escala y trayectoria.
      PENDIENTE-DATO 2.b: cuando exista el número de empresas atendidas, es mejor
      tercera cifra que "normativas auditadas" — es la que usa la competencia.
      PENDIENTE-DATO 2.a: confirmar si las toneladas siguen siendo 1.000+ en 2026.
    */}
    <div class="hero-stats reveal">
      <div>
        <div class="n">{yearsActive}</div>
        <div class="lbl">Años en operación · desde {FOUNDED_YEAR}</div>
      </div>
      <div>
        <div class="n">{tonnesManaged('es')}</div>
        <div class="lbl">Toneladas de RAEE gestionadas</div>
      </div>
      <div>
        <div class="n">{normativas.length}</div>
        <div class="lbl">Normativas bajo seguimiento activo</div>
      </div>
    </div>

    <div class="hero-visual reveal">
      <div class="hv-head">
        <div class="label"><span class="pulse"></span>Radar normativo · marco vigente en Colombia</div>
        <div class="coords">
          04°42′N · 74°03′W<br>
          <strong>Bogotá — Operaciones</strong>
        </div>
      </div>
      <div class="hv-grid">
        {radar.map((n) => (
          <a class="hv-item" href="/normativas">
            <div class="hv-code">{n.code}</div>
            <div class="hv-title">{n.title}</div>
            <div class="hv-tags">{n.tags.slice(0, 3).join(' · ')}</div>
          </a>
        ))}
      </div>
      <a class="hv-foot" href="/normativas">
        Ver las {normativas.length} normativas que auditamos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <div class="sectors reveal" style="margin-top:48px">
      <div class="sector"><span class="d deep"></span>Importadoras de tecnología</div>
      <div class="sector"><span class="d"></span>Ensambladoras y productoras</div>
      <div class="sector"><span class="d aqua"></span>Operadores de telecomunicaciones</div>
      <div class="sector"><span class="d clay"></span>Data centers &amp; infraestructura</div>
      <div class="sector"><span class="d"></span>Retail electrónico</div>
    </div>
  </section>

  <div class="marquee">
    <div class="marquee-track">
      <span>
        Resolución 1297 de 2010 <em class="dot"></em>
        Decreto 1076 de 2015 <em class="dot"></em>
        Resolución 2184 de 2019 <em class="dot"></em>
        RAEE — Residuos de aparatos eléctricos y electrónicos <em class="dot"></em>
        Plan posconsumo <em class="dot"></em>
        Criterios ESG <em class="dot"></em>
        ODS — Objetivos de Desarrollo Sostenible <em class="dot"></em>
        Economía circular <em class="dot"></em>
        Licencias ANLA <em class="dot"></em>
      </span>
      <span aria-hidden="true">
        Resolución 1297 de 2010 <em class="dot"></em>
        Decreto 1076 de 2015 <em class="dot"></em>
        Resolución 2184 de 2019 <em class="dot"></em>
        RAEE — Residuos de aparatos eléctricos y electrónicos <em class="dot"></em>
        Plan posconsumo <em class="dot"></em>
        Criterios ESG <em class="dot"></em>
        ODS — Objetivos de Desarrollo Sostenible <em class="dot"></em>
        Economía circular <em class="dot"></em>
        Licencias ANLA <em class="dot"></em>
      </span>
    </div>
  </div>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Líneas de servicio · 01</div>
        <h2>Cuatro líneas. Un solo<br><em>camino sostenible.</em></h2>
      </div>
      <div class="meta">
        Desde la estrategia regulatoria hasta la operación de residuos y la economía circular. Cada línea resuelve un momento distinto del ciclo ambiental de una compañía tech.
      </div>
    </div>

    <div class="services reveal">
      <div class="svc big accent-deep">
        <div>
          <div class="num">EKONSULTING</div>
          <h3>Asesoría y cumplimiento ante la <em>ANLA</em>.</h3>
          <p>Licenciamiento, auditorías, reportes, planes posconsumo y acompañamiento en procesos sancionatorios. Hablamos el idioma del evaluador y del directivo.</p>
        </div>
        <div class="tag"><span class="bar"></span>ANLA · CAR · VITAL · ESG</div>
      </div>
      <div class="svc small accent-forest">
        <div>
          <div class="num">EKORAEE</div>
          <h3>Gestión certificada de <em>residuos</em> electrónicos.</h3>
          <p>Recolección, transporte, almacenamiento y certificación de RAEE bajo la Res. 1297 y la Ley 1672.</p>
        </div>
        <div class="tag"><span class="bar"></span>Recolección · Certificación</div>
      </div>
      <div class="svc thin">
        <div>
          <div class="num">EKOPARTNER</div>
          <h3>Operación de sistemas de <em>gestión</em> de residuos.</h3>
          <p>Integramos y operamos el sistema completo de recolección y disposición. Solo Colombia.</p>
        </div>
        <div class="tag"><span class="bar"></span>Operación · Colombia</div>
      </div>
      <div class="svc wide accent-clay">
        <div>
          <div class="num">EKOTRADING</div>
          <h3>Compra y venta de tecnología <em>usada u obsoleta</em> en escala.</h3>
          <p>Cerramos el ciclo de vida de los equipos dentro de un marco de economía circular. Retiro de activos tecnológicos, reacondicionamiento y recolocación al por mayor — con la trazabilidad que exigen los ODS.</p>
        </div>
        <div class="tag"><span class="bar"></span>Economía circular · ODS · Activos IT</div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Metodología · 02</div>
        <h2>La <em>EKORUTA</em>: sostenibilidad paso a paso.</h2>
      </div>
      <div class="meta">
        Nuestro framework propio guía a cada organización desde el diagnóstico regulatorio hasta la estrategia ESG completa, alineada con los ODS de la ONU.
      </div>
    </div>

    <div class="process reveal">
      <div class="process-row">
        <div class="n">01</div>
        <h3>Diagnós<em>tico</em></h3>
        <div class="desc">Radiografía completa de obligaciones ANLA activas, brechas ESG y oportunidades de economía circular. Mapeamos riesgo sancionatorio y potencial de valor.</div>
        <div class="when">Semana 1–2</div>
      </div>
      <div class="process-row">
        <div class="n">02</div>
        <h3>Hoja de <em>ruta</em></h3>
        <div class="desc">Diseñamos el plan regulatorio y ESG integrado, priorizando por exposición sancionatoria, vencimientos y metas ODS aplicables al sector.</div>
        <div class="when">Semana 2–3</div>
      </div>
      <div class="process-row">
        <div class="n">03</div>
        <h3>Ejecución y <em>radicación</em></h3>
        <div class="desc">Preparación de estudios, cargue en VITAL, operación de recolección RAEE o activación de EKOTRADING según el mandato. Interlocución directa con la autoridad.</div>
        <div class="when">Semana 3–8</div>
      </div>
      <div class="process-row">
        <div class="n">04</div>
        <h3>Segui<em>miento</em></h3>
        <div class="desc">Respuesta a requerimientos, auditorías internas, reporte ESG trimestral y seguimiento de metas posconsumo. El ciclo no termina con la radicación.</div>
        <div class="when">Continuo</div>
      </div>
      <div class="process-row">
        <div class="n">05</div>
        <h3>Cierre y <em>mejora</em></h3>
        <div class="desc">Consolidación del expediente, entrega de informe ESG anual y rediseño del plan para el siguiente ciclo regulatorio con metas más ambiciosas.</div>
        <div class="when">Anual</div>
      </div>
    </div>
  </section>

  {/*
    BORRADORES SIN VALIDAR — Fase 1 de docs/plan-competitivo-lito.md.
    Los cinco beneficios deben confirmarse con el equipo antes de considerarse definitivos.
    Ver preguntas abiertas 1.a (tiempo de respuesta real) y 1.b (vigencia de "cero sanciones").
  */}
  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Por qué Ekosolv · 03</div>
        <h2>Menos carga para su equipo,<br>más <em>respaldo</em> ante la autoridad.</h2>
      </div>
      <div class="meta">
        Lo que cambia en el día a día de una compañía cuando el cumplimiento ambiental deja de gestionarse a pedazos.
      </div>
    </div>

    <div class="services reveal">
      <div class="svc third static accent-deep">
        <div>
          <div class="num">01</div>
          <h3>Un solo <em>interlocutor</em> para todo el ciclo.</h3>
          <p>Licenciamiento, recolección, disposición y certificado salen del mismo proveedor. Sin coordinar tres empresas ni conciliar tres formatos.</p>
        </div>
        <div class="tag"><span class="bar"></span>4 líneas integradas</div>
      </div>
      <div class="svc third static">
        <div>
          <div class="num">02</div>
          <h3>Su equipo no <em>redacta</em>.</h3>
          <p>Radicaciones, respuestas a requerimientos y soportes ANLA gestionados de punta a punta. Usted aprueba; nosotros sustentamos ante la autoridad.</p>
        </div>
        <div class="tag"><span class="bar"></span>ANLA · VITAL</div>
      </div>
      <div class="svc third static accent-forest">
        <div>
          <div class="num">03</div>
          <h3>Trazabilidad <em>auditable</em>, lote por lote.</h3>
          <p>Cada recolección con su certificado de disposición final, listo para auditoría interna o para el informe de sostenibilidad.</p>
        </div>
        <div class="tag"><span class="bar"></span>Certificación · ESG</div>
      </div>
      <div class="svc half static">
        <div>
          <div class="num">04</div>
          <h3>Cero <em>sanciones</em> en firme entre clientes activos.</h3>
          <p>Trabajamos sobre vencimientos y requerimientos antes de que se conviertan en un proceso sancionatorio. La mejor gestión es la que nunca llega a expediente.</p>
        </div>
        <div class="tag"><span class="bar"></span>Riesgo regulatorio</div>
      </div>
      {/* PENDIENTE-DATO 1.a: sustituir por el compromiso de tiempo real antes de publicar. */}
      <div class="svc half static accent-clay">
        <div>
          <div class="num">05</div>
          <h3>Respuesta en <em>días</em>, no en semanas.</h3>
          <p>Estructura liviana y decisiones sin comité. Cuando la autoridad pone un plazo de diez días hábiles, el cronograma no puede depender de la agenda del proveedor.</p>
        </div>
        <div class="tag"><span class="bar"></span>Tiempo de respuesta</div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Por los números</div>
          <h2 style="margin-top:14px">Resultados que resisten<br>una <em>auditoría.</em></h2>
        </div>
        <div class="stat">
          <div class="n">{stats.approvalRate}<small>%</small></div>
          <div class="lbl">Radicaciones aprobadas</div>
        </div>
        <div class="stat">
          <div class="n">{stats.sanctions}</div>
          <div class="lbl">Sanciones en firme · clientes activos</div>
        </div>
        <div class="stat">
          <div class="n">{stats.serviceLines}</div>
          <div class="lbl">Líneas integradas de servicio</div>
        </div>
      </div>
    </div>
  </section>

  {/*
    Fase 3. Testimonios y clientes salen de src/lib/credenciales.ts, que solo
    entrega contenido marcado como autorizado. En producción, sin datos reales
    estas secciones NO se renderizan — no vuelven los placeholders a la web.
  */}
  {testimoniosVisibles().length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">Testimonios · 04</div>
          <h2>Lo que dicen quienes<br>ya <em>cumplieron</em>.</h2>
        </div>
        <div class="meta">Citas publicadas con autorización escrita de cada cliente.</div>
      </div>

      {mostrarPlaceholders && (
        <div class="dev-warning">
          ⚠ PLACEHOLDERS — visibles solo en desarrollo. Rellena `testimonios` en
          src/lib/credenciales.ts y pon `autorizado: true` (requiere autorización escrita).
        </div>
      )}

      <div class="quotes reveal">
        {testimoniosVisibles().map((t) => (
          <figure class="quote">
            <blockquote>{t.quote}</blockquote>
            <figcaption class="who">
              <strong>{t.autor}</strong>
              <span>{t.cargo} · {t.empresa}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {clientesVisibles().length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">Clientes · 05</div>
          <h2>Compañías que han <em>confiado</em><br>en nosotros.</h2>
        </div>
        <div class="meta">Trabajamos con importadoras, productoras, distribuidoras y operadores de infraestructura tecnológica en Colombia.</div>
      </div>

      {mostrarPlaceholders && (
        <div class="dev-warning">
          ⚠ PLACEHOLDERS — visibles solo en desarrollo. Rellena `clientes` en
          src/lib/credenciales.ts y pon `autorizado: true` (requiere autorización de uso de marca).
        </div>
      )}

      <div class="logos reveal">
        {clientesVisibles().map((c) => (
          <div>{c.logo ? <img src={c.logo} alt={c.nombre} /> : c.nombre}</div>
        ))}
      </div>
    </section>
  )}

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">
          ¿Un nuevo <em>expediente</em><br>en el radar?
        </div>
        <a href="/contacto" class="foot-cta">
          Escríbenos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Consultores en Sostenibilidad" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">
            Consultoría ambiental especializada en cumplimiento ANLA, ESG y economía circular para el sector tecnológico.
          </p>
        </div>
        <div>
          <h5>Sitio</h5>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="/normativas">Normativas</a></li>
            <li><a href="/casos">Casos</a></li>
            <li><a href="/blog">Diario</a></li>
          </ul>
        </div>
        <div>
          <h5>Contacto</h5>
          <ul>
            <li>info@ekosolv.com</li>
            <li>+57 321 271 2773</li>
            <li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li>
          </ul>
        </div>
        <div>
          <h5>Legal</h5>
          <ul>
            <li>Política de tratamiento</li>
            <li>Términos de servicio</li>
            <li>Código de ética</li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>
</Layout>
