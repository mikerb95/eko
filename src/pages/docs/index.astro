  }
  .kpi-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; }
  .kpi-dot--deep { background: var(--deep); }
  .kpi-dot--aqua { background: var(--aqua); }
  .kpi-dot--forest { background: var(--forest); }
  .kpi-dot--clay { background: var(--clay-2); }
  .kpi-value {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .kpi-sub { margin-top: 4px; font-size: 12.5px; color: var(--mute); }

  /* ===== Mapa, stack y alcance ===== */
  .mapa {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 10px;
  }
  .mapa-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 16px;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--paper-warm) 60%, transparent);
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .mapa-card:hover {
    border-color: var(--forest);
    background: var(--paper-warm);
    transform: translateY(-1px);
  }
  .mapa-t { font-size: 14.5px; font-weight: 600; }
  .mapa-d { font-size: 13px; line-height: 1.5; color: var(--mute); }

  .stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }
  .stack-a {
    margin-bottom: 8px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .stack-g ul { list-style: none; display: grid; gap: 4px; }
  .stack-g li { font-size: 14px; line-height: 1.5; }

  .alcance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .alcance-h {
    margin-bottom: 12px;
    padding-bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
  }
  .alcance-h--in { color: var(--forest); }
  .alcance-h--out { color: var(--clay-ink); }
  .alcance-col ul { list-style: none; display: grid; gap: 10px; }
  .alcance-col li { font-size: 14.5px; line-height: 1.6; color: var(--ink-2); }
  .alcance-col b { font-weight: 600; color: var(--ink); }

  /* ===== Barra de avance ===== */
  .barra {
    display: flex;
    gap: 2px;
    height: 8px;
    margin: 20px 0 10px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line);
  }
  .seg--ok { background: var(--forest); }
  .seg--parcial { background: var(--clay-2); }
  .seg--pend { background: var(--line-2); }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12.5px;
    color: var(--mute);
  }
  .leyenda span { display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 9px; height: 9px; border-radius: 2px; }
  .dot--ok { background: var(--forest); }
  .dot--parcial { background: var(--clay-2); }
  .dot--pend { background: var(--line-2); }

  /* ===== Grupos y requerimientos ===== */
  .grupo { margin-top: 34px; }
  .grupo-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .grupo-t { font-family: var(--font-display); font-size: 22px; font-weight: 400; }
  .grupo-n {
    margin-left: auto;
    padding: 2px 9px;
    font-size: 12px;
    font-weight: 600;
    color: var(--mute);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .grupo-d { margin: 10px 0 14px; font-size: 14px; line-height: 1.55; color: var(--mute); }

  .req-list { list-style: none; display: grid; gap: 10px; }
  .req {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--paper-warm) 55%, transparent);
  }
  .req-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 9px; }
  .req-id {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--mute);
  }
  .req-name { flex: 1; font-size: 15px; font-weight: 600; line-height: 1.35; }
  .req-desc { margin-top: 7px; font-size: 14px; line-height: 1.6; color: var(--ink-2); }
  .req-desc b { font-weight: 600; }
  .req-nota {
    margin-top: 8px;
    padding: 9px 11px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--clay-ink);
    background: color-mix(in oklab, var(--clay) 18%, transparent);
    border-radius: var(--r-sm);
  }
  .req-nota b { font-weight: 600; }
  .req-files {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }
  .req-files code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 2px 7px;
    color: var(--mute);
    background: color-mix(in oklab, var(--ink) 5%, transparent);
    border-radius: 4px;
  }

  .pill {
    flex: none;
    padding: 2px 9px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 999px;
  }
  .pill--ok,
  .pill--t-activo {
    color: #0f5c4f;
    background: color-mix(in oklab, var(--forest) 20%, transparent);
  }
  .pill--parcial,
  .pill--t-manual {
    color: var(--clay-ink);
    background: color-mix(in oklab, var(--clay-2) 28%, transparent);
  }
  .pill--pend,
  .pill--t-pend {
    color: var(--mute);
    background: color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .prio {
    padding: 2px 8px;
    font-size: 10.5px;
    font-weight: 600;
    border-radius: 4px;
    background: color-mix(in oklab, var(--ink) 5%, transparent);
    color: var(--mute);
  }
  .prio--alta { color: var(--deep-2); background: color-mix(in oklab, var(--deep) 12%, transparent); }

  /* ===== Actores y casos de uso ===== */
  .actores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
  }
  .actor {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--paper-warm) 60%, transparent);
  }
  .actor--sec { background: color-mix(in oklab, var(--paper-cool) 55%, transparent); }
  .actor-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .actor-n { font-size: 15px; font-weight: 600; }
  .actor-rol,
  .actor-tag {
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--deep-2);
    background: color-mix(in oklab, var(--deep) 12%, transparent);
    border-radius: 4px;
  }
  .actor-tag {
    font-family: var(--font-sans);
    color: var(--mute);
    background: color-mix(in oklab, var(--ink) 7%, transparent);
  }
  .actor-d { margin: 8px 0 10px; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }
  .actor-cu { display: flex; flex-wrap: wrap; gap: 4px; }
  .cu-ref {
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--mute);
    background: color-mix(in oklab, var(--ink) 5%, transparent);
    border-radius: 4px;
  }
  .cu-actores { font-size: 12.5px; color: var(--mute); }

  /* ===== CU extendidos ===== */
  .cux {
    padding: clamp(16px, 2.5vw, 26px);
    margin-top: 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--paper-warm) 68%, transparent);
  }
  .cux-head { display: flex; align-items: baseline; gap: 10px; }
  .cux-t { font-family: var(--font-display); font-size: 24px; font-weight: 400; }
  .cux-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
    margin: 16px 0 20px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cux-meta .k {
    display: block;
    margin-bottom: 3px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .cux-meta .v { font-size: 13.5px; line-height: 1.5; }
  .cux-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 8px;
  }
  .cux-h {
    margin: 18px 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .lista { list-style: none; display: grid; gap: 7px; }
  .lista li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--line-2);
  }
  .lista--grande li { font-size: 15px; }

  .flujo { list-style: none; display: grid; gap: 7px; }
  .flujo li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.55; }
  .flujo-n {
    display: grid;
    place-items: center;
    flex: none;
    width: 21px;
    height: 21px;
    margin-top: 1px;
    font-size: 11px;
    font-weight: 700;
    color: var(--deep-2);
    background: color-mix(in oklab, var(--deep) 12%, transparent);
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .flujo b { font-weight: 600; }

  .ramas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
  }
  .rama {
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--paper-warm);
  }
  .rama--err { background: color-mix(in oklab, var(--clay) 12%, var(--paper-warm)); }
  .rama-t {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .rama-id {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--clay-ink);
  }
  .rama-pasos { padding-left: 18px; display: grid; gap: 4px; }
  .rama-pasos li { font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }
  .cux-src { margin-top: 18px; font-size: 12px; color: var(--mute); }
  .cux-src code { font-family: var(--font-mono); }

  /* ===== Historias ===== */
  .hist-list { list-style: none; display: grid; gap: 6px; }
  .hist {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 9px;
    padding: 10px 13px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: color-mix(in oklab, var(--paper-warm) 55%, transparent);
  }
  .hist-t { flex: 1; min-width: 220px; font-size: 14px; line-height: 1.45; }
  .tipo {
    padding: 2px 7px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-radius: 999px;
    color: var(--mute);
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }
  .tipo--historia { color: var(--deep-2); background: color-mix(in oklab, var(--deep) 13%, transparent); }
  .tipo--bug { color: var(--clay-ink); background: color-mix(in oklab, var(--clay-2) 26%, transparent); }
  .tipo--spike { color: var(--forest); background: color-mix(in oklab, var(--forest) 14%, transparent); }
  .hist-dod {
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--forest);
    background: color-mix(in oklab, var(--forest) 12%, transparent);
    border-radius: var(--r-sm);
    font-variant-numeric: tabular-nums;
  }

  /* ===== Componentes ===== */
  .zonas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 22px;
  }
  .zona {
    padding: 14px;
    border: 1px dashed var(--line-2);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--paper-cool) 45%, transparent);
  }
  .zona-h {
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .zona-n { margin-bottom: 12px; font-size: 12.5px; line-height: 1.5; color: var(--mute); }
  .zona-body { display: grid; gap: 8px; }
  .comp {
    padding: 12px 13px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--paper-warm);
  }
  .comp--datos { border-color: var(--forest); }
  .comp--externo { border-style: dashed; }
  .comp--funcion { border-color: var(--deep); }
  .comp-t { font-size: 14px; font-weight: 600; }
  .comp-d { margin-top: 5px; font-size: 13px; line-height: 1.5; color: var(--ink-2); }
  .comp-tech {
    margin-top: 7px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
  }

  .enlaces { list-style: none; display: grid; gap: 7px; }
  .enlaces li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    padding: 9px 12px;
    font-size: 13.5px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: color-mix(in oklab, var(--paper-warm) 50%, transparent);
  }
  .enlaces b { font-weight: 600; }
  .enlaces li.opt { border-style: dashed; }
  .flecha { color: var(--forest); font-weight: 700; }
  .enlace-e { color: var(--mute); font-size: 13px; }
  .card {
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--deep-2);
    background: color-mix(in oklab, var(--deep) 10%, transparent);
    border-radius: 4px;
  }
  .opt-tag {
    padding: 1px 7px;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--clay-ink);
    background: color-mix(in oklab, var(--clay) 20%, transparent);
    border-radius: 4px;
  }
  .enlaces--compact li { padding: 7px 10px; font-size: 12.5px; }
  .mec { font-size: 12.5px; color: var(--mute); }

  /* ===== Paquetes ===== */
  .paquetes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
    margin-top: 22px;
  }
  .paq {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--paper-warm) 58%, transparent);
  }
  .paq-r {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--deep-2);
  }
  .paq-rol { margin: 8px 0 10px; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }
  .paq-dep { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; }
  .paq-dep .k {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .paq-dep code { font-size: 11.5px; }
  .paq-nota { margin-top: 10px; font-size: 12.5px; line-height: 1.5; color: var(--mute); }

  /* ===== Clases ===== */
  .clases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 12px;
    margin-top: 22px;
  }
  .clase {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    background: var(--paper-warm);
    overflow: hidden;
  }
  .clase-h {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 14px;
    background: color-mix(in oklab, var(--deep) 9%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .clase--enum .clase-h { background: color-mix(in oklab, var(--clay) 18%, transparent); }
  .clase--valor .clase-h { background: color-mix(in oklab, var(--forest) 10%, transparent); }
  .clase-n { font-size: 15px; font-weight: 700; }
  .clase-e { font-family: var(--font-mono); font-size: 11px; color: var(--mute); }
  .clase-mod {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 12px;
    color: var(--mute);
    border-bottom: 1px solid var(--line);
  }
  .attrs, .ops { list-style: none; padding: 10px 14px; display: grid; gap: 5px; }
  .attrs li { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12.5px; line-height: 1.45; }
  .attr-n { font-family: var(--font-mono); font-weight: 600; }
  .attr-t { font-family: var(--font-mono); color: var(--deep-2); }
  .attr-x { width: 100%; font-size: 11.5px; color: var(--mute); }
  .ops { border-top: 1px solid var(--line); }
  .ops code { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-2); }
  .clase-src {
    margin-top: auto;
    padding: 9px 14px;
    border-top: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink) 3%, transparent);
  }
  .clase-src code { font-family: var(--font-mono); font-size: 11px; color: var(--mute); }

  /* ===== Objetos ===== */
  .instant {
    padding: clamp(16px, 2.5vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--paper-warm) 68%, transparent);
  }
  .instant-t { font-family: var(--font-display); font-size: 21px; font-weight: 400; }
  .instant-d {
    margin: 6px 0 16px;
    max-width: 82ch;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .objetos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    margin-bottom: 14px;
  }
  .objeto {
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--paper-warm);
    overflow: hidden;
  }
  .objeto-h {
    padding: 9px 12px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: color-mix(in oklab, var(--forest) 10%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .objeto-id { font-weight: 700; text-decoration: underline; }
  .objeto-c { color: var(--mute); }
  .objeto-v { list-style: none; padding: 10px 12px; display: grid; gap: 5px; }
  .objeto-v li { display: flex; flex-wrap: wrap; gap: 7px; font-size: 12.5px; line-height: 1.45; }
  .ov-k { font-family: var(--font-mono); color: var(--mute); }
  .ov-v { font-weight: 500; }
  .objeto-n {
    padding: 9px 12px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--mute);
    border-top: 1px solid var(--line);
  }

  /* ===== Enlaces grandes ===== */
  .gran-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 12px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--paper-warm) 70%, transparent);
    transition: border-color 0.15s, transform 0.15s, background 0.15s;
  }
  .gran-cta:hover {
    border-color: var(--forest);
    background: var(--paper-warm);
    transform: translateY(-1px);
  }
  .gran-cta-t { display: block; font-size: 17px; font-weight: 600; }
  .gran-cta-d {
    display: block;
    margin-top: 5px;
    max-width: 70ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--mute);
  }
  .gran-cta-f { flex: none; font-size: 22px; color: var(--forest); }

  /* ===== Avisos ===== */
  .aviso {
    padding: 16px 18px;
    margin-bottom: 22px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--clay-ink);
    background: color-mix(in oklab, var(--clay) 22%, transparent);
    border-radius: var(--r-md);
  }
  .aviso b { font-weight: 700; }
