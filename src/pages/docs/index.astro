<script>
  /**
   * Conmutador de secciones. El markup entrega todas las secciones visibles, y
   * este script oculta las que no están activas: sin JavaScript la página sigue
   * siendo legible de arriba abajo, que es lo que queremos de una documentación.
   */
  function initDocs() {
    const nav = document.getElementById('secNav')
    if (!nav || nav.dataset.ready === '1') return
    nav.dataset.ready = '1'

    const chips = Array.from(nav.querySelectorAll<HTMLButtonElement>('.sec-chip'))
    const secciones = Array.from(document.querySelectorAll<HTMLElement>('.doc-section'))

    function mostrar(id: string, scroll = false) {
      const existe = secciones.some((s) => s.dataset.sec === id)
      const activo = existe ? id : secciones[0]?.dataset.sec
      for (const s of secciones) s.hidden = s.dataset.sec !== activo
      for (const c of chips) {
        const on = c.dataset.sec === activo
        c.classList.toggle('sec-chip--on', on)
        c.setAttribute('aria-current', on ? 'true' : 'false')
      }
      if (scroll) nav.scrollIntoView({ block: 'start', behavior: 'smooth' })
      const on = chips.find((c) => c.dataset.sec === activo)
      on?.scrollIntoView({ block: 'nearest', inline: 'center' })
    }

    nav.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('.sec-chip')
      if (!chip?.dataset.sec) return
      history.replaceState(null, '', `#${chip.dataset.sec}`)
      mostrar(chip.dataset.sec)
    })

    // Las tarjetas del mapa llevan a su sección.
    document.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('[data-goto]')
      if (!card?.dataset.goto) return
      history.replaceState(null, '', `#${card.dataset.goto}`)
      mostrar(card.dataset.goto, true)
    })

    window.addEventListener('hashchange', () => mostrar(location.hash.slice(1)))

    mostrar(location.hash.slice(1))
  }

  document.addEventListener('astro:page-load', initDocs)
  initDocs()
</script>

