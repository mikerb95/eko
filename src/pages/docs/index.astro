---
export const prerender = false // página interna: el middleware exige sesión (src/middleware.ts)
/**
 * Documentación de ingeniería del proyecto.
 *
 * Una sola página con navegación por secciones: requerimientos, casos de uso,
 * diagramas y plan de calidad. Todo sale de datos tipados —`documentacion.ts`,
 * `diagramas.ts` y `calidad.ts`— así que un cambio de requerimiento es un commit
 * revisable y no un documento que se desincroniza del código.
 *
 * A diferencia del tablero y del radar, esta página SÍ es pública: entra en
 * rutas.ts y por tanto en el sitemap y en llms.txt. El tablero kanban y el radar
 * siguen siendo páginas propias, enlazadas desde aquí.
 *
 * Sin JavaScript se muestran todas las secciones seguidas; el script solo
 * conmuta cuál se ve.
 */
import Layout from '../../layouts/Layout.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import Bpmn from '../../components/docs/Bpmn.astro'
import Secuencia from '../../components/docs/Secuencia.astro'
import {
  REPO,
  MODULOS,
  RF,
  RNF,
  CATEGORIAS_ISO,
  ACTORES,
  CASOS_USO,
  CU_EXTENDIDOS,
  STACK,
  DENTRO_ALCANCE,
  FUERA_ALCANCE,
  ESTADO_LABELS,
  contarPorEstado,
  rfDeModulo,
  rnfDeCategoria,
} from '../../data/documentacion'
import {
  PROCESOS,
  SECUENCIAS,
  ZONAS,
  COMPONENTES,
  ENLACES_COMPONENTES,
  PAQUETES,
  REGLAS_DEPENDENCIA,
  CLASES,
  RELACIONES_CLASES,
  INSTANTANEAS,
} from '../../data/diagramas'
import {
  NIVELES,
  RESUMEN_PRUEBAS,
  ESTADO_PRUEBA_LABELS,
  VYV,
  VYV_LABELS,
  USABILIDAD_FLUJO,
  USABILIDAD_HIPOTESIS,
  USABILIDAD_PASOS,
  USABILIDAD_NOTA,
  contarNiveles,
  vyvDe,
} from '../../data/calidad'
import { ITERACIONES, COMMITS_TOTAL } from '../../data/iteraciones'

/** Secciones en el orden en que se navegan. */
const SECCIONES = [
  { id: 'vision', label: 'Visión general' },
  { id: 'rf', label: 'Req. funcionales' },
  { id: 'rnf', label: 'Req. no funcionales' },
  { id: 'cu', label: 'Casos de uso' },
  { id: 'cux', label: 'CU extendidos' },
  { id: 'historias', label: 'Historias US' },
  { id: 'bpmn', label: 'BPMN' },
  { id: 'secuencia', label: 'Secuencia' },
  { id: 'componentes', label: 'Componentes' },
  { id: 'paquetes', label: 'Paquetes' },
  { id: 'clases', label: 'Clases' },
  { id: 'objetos', label: 'Objetos' },
  { id: 'kanban', label: 'Kanban' },
  { id: 'testing', label: 'Testing' },
  { id: 'vyv', label: 'V&V' },
  { id: 'usabilidad', label: 'Usability testing' },
]

const otrosDocs = [
  {
    nombre: 'Tablero Kanban',
    href: '/docs/kanban',
    desc: 'Iteraciones, historias y Definition of Done.',
  },
  {
    nombre: 'Radar regulatorio',
    href: '/docs/radar',
    desc: 'Novedades del entorno, borradores propuestos y verificaciones.',
  },
  {
    nombre: 'Auditoría',
    href: `${REPO}/blob/main/AUDITORIA.md`,
    desc: 'Hallazgos de seguridad e integridad, con recomendaciones.',
  },
  {
    nombre: 'Pendientes',
    href: `${REPO}/blob/main/pendientes.md`,
    desc: 'Activos por entregar, decisiones abiertas y deuda técnica.',
  },
]

// Conteos: se calculan de los datos, nunca se escriben a mano.
const rf = contarPorEstado(RF)
const rnf = contarPorEstado(RNF)
const niveles = contarNiveles()
const actoresPrimarios = ACTORES.filter((a) => a.tipo === 'primario')
const historias = ITERACIONES.flatMap((i) => i.historias)
const iteracionesCerradas = ITERACIONES.filter((i) => i.commits != null).length
const criterios = historias.flatMap((h) => h.dod || [])
const criteriosOk = criterios.filter((c) => c.estado === 'pass').length

const kpis = [
  { label: 'Req. funcionales', value: String(rf.total), sub: `${rf.ok} implementados`, tone: 'deep' },
  { label: 'Req. no funcionales', value: String(rnf.total), sub: 'ISO/IEC 25010', tone: 'aqua' },
  {
    label: 'Casos de uso',
    value: String(CASOS_USO.length),
    sub: `${actoresPrimarios.length} actores`,
    tone: 'forest',
  },
  {
    label: 'Historias (kanban)',
    value: String(historias.length),
    sub: `${iteracionesCerradas} iteraciones`,
    tone: 'clay',
  },
  {
    label: 'Pruebas automáticas',
    value: String(RESUMEN_PRUEBAS.automatizadas),
    sub: `${niveles.total} niveles definidos`,
    tone: 'clay',
  },
]

const mapa = [
  { sec: 'rf', titulo: 'Requerimientos funcionales', desc: `${rf.total} requerimientos en ${MODULOS.length} módulos (${rf.ok} implementados).` },
  { sec: 'rnf', titulo: 'Requerimientos no funcionales', desc: `${rnf.total} requerimientos por categoría ISO/IEC 25010.` },
  { sec: 'cu', titulo: 'Casos de uso', desc: `${actoresPrimarios.length} actores primarios y ${CASOS_USO.length} casos de uso.` },
  { sec: 'cux', titulo: 'Casos de uso extendidos', desc: 'Flujo principal, alternos, excepciones y postcondiciones de los CU críticos.' },
  { sec: 'historias', titulo: 'Historias de usuario', desc: `${historias.length} historias en formato XP, con su Definition of Done.` },
  { sec: 'bpmn', titulo: 'Diagramas BPMN', desc: `Los ${PROCESOS.length} procesos de negocio con carriles por participante.` },
  { sec: 'secuencia', titulo: 'Diagramas de secuencia', desc: 'Recolección, acceso, autorización de escrituras y degradación de lectura.' },
  { sec: 'componentes', titulo: 'Diagrama de componentes', desc: 'Navegador → Vercel (estático + funciones + middleware) → Turso, Resend y GitHub.' },
  { sec: 'paquetes', titulo: 'Diagrama de paquetes', desc: 'Las capas del código y la regla de dependencia entre ellas.' },
  { sec: 'clases', titulo: 'Diagrama de clases', desc: 'Entidades derivadas de los CREATE TABLE reales, agrupadas por módulo.' },
  { sec: 'objetos', titulo: 'Diagrama de objetos', desc: 'Instantáneas concretas: una orden con bitácora, una sesión con rol, una licencia retenida.' },
  { sec: 'kanban', titulo: 'Tablero kanban', desc: `${historias.length} historias en ${ITERACIONES.length} iteraciones del propio proyecto.` },
  { sec: 'testing', titulo: 'Testing', desc: `${niveles.total} niveles de prueba con su estado real: ${niveles.activo} automatizados, ${niveles.manual} manuales, ${niveles.pend} pendientes.` },
  { sec: 'vyv', titulo: 'Verificación y validación', desc: 'Las mismas comprobaciones bajo el marco IEEE 1012: ¿lo construimos bien o construimos lo correcto?' },
  { sec: 'usabilidad', titulo: 'Usability testing', desc: 'Metodología en 6 pasos aplicada al flujo de recolección, con lo ejecutado y lo pendiente.' },
]
---

<Layout
  title="Documentación de ingeniería | Ekosolv"
  description="Requerimientos funcionales y no funcionales, casos de uso, diagramas UML, tablero kanban y plan de calidad del sitio de Ekosolv, generados desde datos tipados del repositorio."
  activePath="/docs"
>
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Documentación del proyecto</div>
      <div class="l">{rf.total} requerimientos · {CASOS_USO.length} casos de uso</div>
    </div>

    <h1 class="display reveal" style="margin-top:40px">
      Cómo funciona<br />este sistema, <em>por dentro</em>.
    </h1>

    <p class="lede reveal" style="margin-top:32px; max-width:62ch">
      No es un anexo: es el sistema descrito por sí mismo.<span class="lede-rest">
        Requerimientos, casos de uso, diagramas y plan de calidad viven como datos tipados en
        <code>src/data/</code>, y cada uno apunta al archivo donde se puede abrir y comprobar. Lo que
        no está implementado aparece como pendiente, con el motivo. Incluidas las pruebas: hoy no hay
        ninguna automatizada, y esta documentación lo dice en su propia sección.</span
      >
    </p>

    <nav class="docs-nav reveal" aria-label="Documentos del proyecto">
      <a href="/docs" class="doc-chip doc-chip--on" aria-current="page">
        <span class="doc-chip-name">Documentación</span>
        <span class="doc-chip-desc">Requerimientos, casos de uso y diagramas.</span>
      </a>
      {
        otrosDocs.map((d) => (
          <a
            href={d.href}
            class="doc-chip"
            target={d.href.startsWith('/') ? undefined : '_blank'}
            rel={d.href.startsWith('/') ? undefined : 'noopener noreferrer'}
          >
            <span class="doc-chip-name">{d.nombre}</span>
            <span class="doc-chip-desc">{d.desc}</span>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="section wrap">
    <!-- Navegación entre secciones -->
    <nav class="sec-nav" id="secNav" aria-label="Secciones de la documentación">
      {
        SECCIONES.map((s, i) => (
          <button
            type="button"
            class:list={['sec-chip', { 'sec-chip--on': i === 0 }]}
            data-sec={s.id}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            {s.label}
          </button>
        ))
      }
    </nav>

    <!-- ═══════════════ Visión general ═══════════════ -->
    <section class="doc-section" id="vision" data-sec="vision" aria-label="Visión general">
      <h2 class="sec-title">Introducción</h2>
      <p class="sec-body">
        Esta sección reúne la documentación de ingeniería del sitio de <b>Ekosolv</b>: los
        requerimientos que el sistema cumple hoy, los casos de uso que atiende, los diagramas que
        explican cómo está armado y el estado real de su verificación. El contenido no se escribe
        aquí: vive en <code>src/data/documentacion.ts</code>, <code>src/data/diagramas.ts</code> y
        <code>src/data/calidad.ts</code>, y esta página solo lo dibuja.
      </p>
      <p class="sec-body">
        La razón de hacerlo así es la misma que sostiene el tablero de iteraciones: un documento
        aparte se desactualiza en la primera semana y nadie lo vuelve a abrir. Un requerimiento que
        vive en el repositorio se cambia con un commit que alguien puede revisar, y los conteos de
        esta página se calculan de los datos, así que no pueden mentir por descuido.
      </p>

      <div class="kpis">
        {
          kpis.map((k) => (
            <div class="kpi">
              <div class="kpi-label">
                <i class={`kpi-dot kpi-dot--${k.tone}`} />
                {k.label}
              </div>
              <div class="kpi-value">{k.value}</div>
              <div class="kpi-sub">{k.sub}</div>
            </div>
          ))
        }
      </div>

      <h3 class="sub-title">Propósito</h3>
      <p class="sec-body">
        Dejar trazabilidad del ciclo de vida —del requerimiento a la historia de usuario y de ahí a
        su estado en el tablero— en un formato reconocible de ingeniería de software: requerimientos
        funcionales y no funcionales, casos de uso con flujo extendido, y diagramas BPMN, de
        secuencia, componentes, paquetes, clases y objetos. Sirve como referencia técnica para
        mantener el sistema y como evidencia de cómo se construyó.
      </p>

      <h3 class="sub-title">Mapa de la documentación</h3>
      <div class="mapa">
        {
          mapa.map((m) => (
            <button type="button" class="mapa-card" data-goto={m.sec}>
              <span class="mapa-t">{m.titulo}</span>
              <span class="mapa-d">{m.desc}</span>
            </button>
          ))
        }
      </div>

      <h3 class="sub-title">Stack técnico</h3>
      <div class="stack">
        {
          STACK.map((g) => (
            <div class="stack-g">
              <div class="stack-a">{g.area}</div>
              <ul>
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <h3 class="sub-title">Alcance del proyecto</h3>
      <div class="alcance">
        <div class="alcance-col">
          <div class="alcance-h alcance-h--in">Dentro de alcance</div>
          <ul>
            {
              DENTRO_ALCANCE.map((a) => (
                <li>
                  <b>{a.texto}.</b> {a.detalle}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="alcance-col">
          <div class="alcance-h alcance-h--out">Fuera de alcance, por ahora</div>
          <ul>
            {
              FUERA_ALCANCE.map((a) => (
                <li>
                  <b>{a.texto}.</b> {a.detalle}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══════════════ Requerimientos funcionales ═══════════════ -->
    <section class="doc-section" id="rf" data-sec="rf" aria-label="Requerimientos funcionales">
      <h2 class="sec-title">Requerimientos funcionales</h2>
      <p class="sec-body">
        {rf.total} requerimientos en {MODULOS.length} módulos: {rf.ok} implementados, {rf.parcial} parciales
        y {rf.pend} pendientes. Cada uno apunta a los archivos donde se verifica; los parciales y los
        pendientes dicen qué falta.
      </p>

      <div class="barra" role="img" aria-label={`${rf.ok} implementados, ${rf.parcial} parciales, ${rf.pend} pendientes`}>
        <span class="seg seg--ok" style={`width:${(rf.ok / rf.total) * 100}%`}></span>
        <span class="seg seg--parcial" style={`width:${(rf.parcial / rf.total) * 100}%`}></span>
        <span class="seg seg--pend" style={`width:${(rf.pend / rf.total) * 100}%`}></span>
      </div>
      <div class="leyenda">
        <span><i class="dot dot--ok"></i>Implementado {rf.ok}</span>
        <span><i class="dot dot--parcial"></i>Parcial {rf.parcial}</span>
        <span><i class="dot dot--pend"></i>Pendiente {rf.pend}</span>
      </div>

      {
        MODULOS.map((m) => {
          const items = rfDeModulo(m.id)
          const c = contarPorEstado(items)
          return (
            <div class="grupo">
              <div class="grupo-head">
                <h3 class="grupo-t">{m.nombre}</h3>
                <span class="grupo-n">
                  {c.ok}/{c.total}
                </span>
              </div>
              <p class="grupo-d">{m.descripcion}</p>
              <ul class="req-list">
                {items.map((r) => (
                  <li class="req">
                    <div class="req-top">
                      <span class="req-id">{r.id}</span>
                      <span class="req-name">{r.nombre}</span>
                      <span class={`pill pill--${r.estado}`}>{ESTADO_LABELS[r.estado]}</span>
                    </div>
                    <p class="req-desc">{r.descripcion}</p>
                    {r.nota && <p class="req-nota">{r.nota}</p>}
                    <div class="req-files">
                      <span class={`prio prio--${r.prioridad}`}>Prioridad {r.prioridad}</span>
                      {r.archivos.map((f) => (
                        <code>{f}</code>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        })
      }
    </section>

    <!-- ═══════════════ Requerimientos no funcionales ═══════════════ -->
    <section class="doc-section" id="rnf" data-sec="rnf" aria-label="Requerimientos no funcionales">
      <h2 class="sec-title">Requerimientos no funcionales</h2>
      <p class="sec-body">
        {rnf.total} requerimientos de calidad clasificados por las categorías de ISO/IEC 25010. Cada
        uno declara su criterio de comprobación, porque un requerimiento no funcional sin forma de
        medirlo es una intención.
      </p>

      {
        CATEGORIAS_ISO.map((cat) => {
          const items = rnfDeCategoria(cat)
          if (!items.length) return null
          const c = contarPorEstado(items)
          return (
            <div class="grupo">
              <div class="grupo-head">
                <h3 class="grupo-t">{cat}</h3>
                <span class="grupo-n">
                  {c.ok}/{c.total}
                </span>
              </div>
              <ul class="req-list">
                {items.map((r) => (
                  <li class="req">
                    <div class="req-top">
                      <span class="req-id">{r.id}</span>
                      <span class="req-name">{r.nombre}</span>
                      <span class={`pill pill--${r.estado}`}>{ESTADO_LABELS[r.estado]}</span>
                    </div>
                    <p class="req-desc">
                      <b>Criterio:</b> {r.criterio}
                    </p>
                    {r.nota && <p class="req-nota">{r.nota}</p>}
                    <div class="req-files">
                      {r.archivos.map((f) => (
                        <code>{f}</code>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        })
      }
    </section>

    <!-- ═══════════════ Casos de uso ═══════════════ -->
    <section class="doc-section" id="cu" data-sec="cu" aria-label="Casos de uso">
      <h2 class="sec-title">Casos de uso</h2>
      <p class="sec-body">
        {CASOS_USO.length} casos de uso y {ACTORES.length} actores, de los cuales {actoresPrimarios.length}
        son primarios. Los actores secundarios son sistemas: participan en el caso pero no lo inician.
      </p>

      <h3 class="sub-title">Actores</h3>
      <div class="actores">
        {
          ACTORES.map((a) => (
            <div class:list={['actor', { 'actor--sec': a.tipo === 'secundario' }]}>
              <div class="actor-top">
                <span class="actor-n">{a.nombre}</span>
                {a.rol && <span class="actor-rol">rol {a.rol}</span>}
                {a.tipo === 'secundario' && <span class="actor-tag">sistema</span>}
              </div>
              <p class="actor-d">{a.descripcion}</p>
              <div class="actor-cu">
                {CASOS_USO.filter((c) => c.actores.includes(a.id)).map((c) => (
                  <span class="cu-ref">{c.id}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="sub-title">Catálogo</h3>
      <ul class="req-list">
        {
          CASOS_USO.map((c) => (
            <li class="req">
              <div class="req-top">
                <span class="req-id">{c.id}</span>
                <span class="req-name">{c.nombre}</span>
                <span class={`pill pill--${c.estado}`}>{ESTADO_LABELS[c.estado]}</span>
              </div>
              <p class="req-desc">{c.objetivo}</p>
              <div class="req-files">
                <span class="cu-actores">
                  {c.actores
                    .map((id) => ACTORES.find((a) => a.id === id)?.nombre ?? id)
                    .join(' · ')}
                </span>
                {c.requerimientos.map((r) => (
                  <span class="cu-ref">{r}</span>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ═══════════════ CU extendidos ═══════════════ -->
    <section class="doc-section" id="cux" data-sec="cux" aria-label="Casos de uso extendidos">
      <h2 class="sec-title">Casos de uso extendidos</h2>
      <p class="sec-body">
        Los {CU_EXTENDIDOS.length} casos críticos con su flujo completo. Los flujos alternos son
        caminos válidos que terminan bien; las excepciones son los que no, y en este sistema casi
        todas tienen una salida definida en lugar de un error genérico.
      </p>

      {
        CU_EXTENDIDOS.map((c) => (
          <article class="cux">
            <header class="cux-head">
              <span class="req-id">{c.id}</span>
              <h3 class="cux-t">{c.nombre}</h3>
            </header>

            <div class="cux-meta">
              <div>
                <span class="k">Actor principal</span>
                <span class="v">{c.actorPrincipal}</span>
              </div>
              <div>
                <span class="k">Actores secundarios</span>
                <span class="v">{c.actoresSecundarios.join(', ')}</span>
              </div>
              <div>
                <span class="k">Disparador</span>
                <span class="v">{c.disparador}</span>
              </div>
            </div>

            <div class="cux-cols">
              <div>
                <h4 class="cux-h">Precondiciones</h4>
                <ul class="lista">
                  {c.precondiciones.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="cux-h">Postcondiciones</h4>
                <ul class="lista">
                  {c.postcondiciones.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </div>

            <h4 class="cux-h">Flujo principal</h4>
            <ol class="flujo">
              {c.flujoPrincipal.map((p) => (
                <li>
                  <span class="flujo-n">{p.n}</span>
                  <span>
                    <b>{p.actor}</b> · {p.accion}
                  </span>
                </li>
              ))}
            </ol>

            {c.alternos.length > 0 && (
              <>
                <h4 class="cux-h">Flujos alternos</h4>
                <div class="ramas">
                  {c.alternos.map((a) => (
                    <div class="rama">
                      <div class="rama-t">
                        <span class="rama-id">{a.id}</span>
                        {a.nombre}
                      </div>
                      <ol class="rama-pasos">
                        {a.pasos.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </div>
              </>
            )}

            {c.excepciones.length > 0 && (
              <>
                <h4 class="cux-h">Excepciones</h4>
                <div class="ramas">
                  {c.excepciones.map((e) => (
                    <div class="rama rama--err">
                      <div class="rama-t">
                        <span class="rama-id">{e.id}</span>
                        {e.nombre}
                      </div>
                      <ol class="rama-pasos">
                        {e.pasos.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </div>
              </>
            )}

            <p class="cux-src">
              {c.archivos.map((f, i) => (
                <>
                  <code>{f}</code>
                  {i < c.archivos.length - 1 ? ' · ' : ''}
                </>
              ))}
            </p>
          </article>
        ))
      }
    </section>

    <!-- ═══════════════ Historias ═══════════════ -->
