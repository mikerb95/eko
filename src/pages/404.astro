---
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'

// Astro genera 404.html y Vercel lo sirve con estado 404 para cualquier ruta
// que no exista, también las de /en. Por eso lleva un enlace al sitio en inglés.
const destinos = [
  { href: '/servicios', titulo: 'Servicios', texto: 'Cumplimiento ANLA, RAEE, posconsumo y activos IT.' },
  { href: '/normativas', titulo: 'Normativas', texto: 'Las resoluciones que aplican a su empresa.' },
  { href: '/blog', titulo: 'Blog', texto: 'Guías y novedades regulatorias.' },
  { href: '/contacto', titulo: 'Contacto', texto: 'Hable con un consultor.' },
]
---

<Layout
  path="/404"
  title="Página no encontrada · Ekosolv"
  description="La página que busca no existe o cambió de dirección."
  noindex
>
  <section class="page-head wrap nf">
    <div class="page-strip">
      <div class="l">Error 404</div>
      <a class="l nf-en" href="/en" hreflang="en" lang="en">Page not found · English site</a>
    </div>

    <h1 class="display reveal" style="margin-top:40px">
      Esta página no <em>existe</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:56ch">
      Puede que la dirección esté mal escrita o que la página haya cambiado de lugar.
      Desde aquí puede volver al inicio o ir directo a lo que buscaba.
    </p>

    <div class="nf-accion reveal">
      <a href="/" class="hero-cta">
        Volver al inicio
        <span class="arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </span>
      </a>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <ul class="nf-destinos reveal">
      {destinos.map((d) => (
        <li>
          <a href={d.href}>
            <span class="nf-titulo">{d.titulo}</span>
            <span class="nf-texto">{d.texto}</span>
            <svg class="nf-flecha" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <SiteFooter />
</Layout>

<style>
  .nf .page-strip { flex-wrap: wrap; gap: 8px 24px; }
  .nf-en { text-decoration: none; transition: color .2s ease; }
  .nf-en:hover { color: var(--ink); }

  .nf-accion { margin-top: 40px; }

  .nf-destinos {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .nf-destinos li + li { border-left: 1px solid var(--line); }
  .nf-destinos a {
    display: grid; gap: 10px; align-content: start; height: 100%;
    padding: 28px 24px 32px; color: var(--ink); text-decoration: none;
    position: relative; transition: background .2s ease;
  }
  .nf-destinos a:hover { background: color-mix(in oklab, var(--forest) 7%, transparent); }
  .nf-destinos a:focus-visible { outline: 2px solid var(--forest); outline-offset: -2px; }
  .nf-titulo { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 22px; letter-spacing: -0.01em; }
  .nf-texto { font-size: 15px; color: var(--mute); line-height: 1.45; max-width: 26ch; }
  .nf-flecha { position: absolute; top: 30px; right: 22px; color: var(--mute); transition: transform .2s ease, color .2s ease; }
  .nf-destinos a:hover .nf-flecha { color: var(--forest); transform: rotate(-45deg); }

  @media (max-width: 860px) {
    .nf-destinos { grid-template-columns: 1fr 1fr; }
    .nf-destinos li:nth-child(odd) { border-left: 0; }
    .nf-destinos li:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 520px) {
    .nf-destinos { grid-template-columns: 1fr; }
    .nf-destinos li + li { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
