---
// Página del equipo de Ekosolv para la capacitación en IA: /ia.
//
// Una dirección corta para comunicarla de viva voz. Arriba va la encuesta del
// diagnóstico (mientras esté abierta desde /admin/diagnostico); debajo, el
// programa por área y el material de apoyo, que se publica aquí después de
// cada taller (src/lib/capacitacion.ts).
//
// No es una página comercial: no está en src/lib/rutas.ts (ni en el sitemap ni
// en llms.txt), va con noindex y no usa el Layout del sitio, para que no haya
// menú ni asesor que distraigan.
export const prerender = false
import '../styles/global.css'
import TypeformFlow from '../components/TypeformFlow.astro'
import type { TFStep, TFOption } from '../components/TypeformFlow.astro'
import {
  AREAS,
  AREAS_PROPUESTAS,
  CERTIFICADO_MIN,
  CERTIFICADOS_MES,
  DOCUMENTO_REAL,
  DOCUMENTOS,
  HERRAMIENTAS,
  HORAS,
  IAS,
  MODALIDAD,
  PREOCUPACIONES,
  PROPUESTA_HORAS,
  PROPUESTA_ROL,
  PROPUESTAS_MES,
  TAREAS,
  USO_IA,
  type Opcion,
} from '../lib/diagnostico/preguntas'
import { leerEstado, type EstadoEncuesta } from '../lib/diagnostico/datos'
import { GENERAL, MODULOS, type ModuloCapacitacion } from '../lib/capacitacion'

let estado: EstadoEncuesta = { abierta: false, usada: false }
try {
  estado = await leerEstado()
} catch (e: any) {
  console.error('[ia] carga', e?.message || e)
}

const COLOR: Record<string, string> = {
  general: 'var(--deep)',
  operaciones: '#1f8a8a',
  logistica: '#46a85b',
  ventas: '#2f80c9',
  mercadeo: '#c2557a',
  gerencia: '#8b5cf6',
  finanzas: '#e8920c',
}
const modulos: ModuloCapacitacion[] = [GENERAL, ...MODULOS]

const ops = (lista: readonly Opcion[]): TFOption[] => lista.map((o) => ({ value: o.id, label: o.etiqueta, hint: o.hint }))

const steps: TFStep[] = [
  {
    title: 'Empecemos por usted',
    subtitle: 'Así sabemos para quién es cada ejercicio del taller.',
    row: true,
    fields: [
      { type: 'text', name: 'nombre', label: 'Nombre', placeholder: 'Su nombre', required: true, autocomplete: 'name' },
      { type: 'text', name: 'cargo', label: 'Cargo', placeholder: 'Por ejemplo, consultora ambiental' },
    ],
  },
  {
    title: '¿En qué área trabaja?',
    subtitle: 'Si trabaja en varias, elija la que le ocupa más tiempo.',
    fields: [{ type: 'choice', name: 'area', label: 'Área', required: true, options: ops(AREAS) }],
  },
  ...AREAS.map(
    (a): TFStep => ({
      title: '¿Cuáles de estas tareas hace cada semana?',
      subtitle: `Marque todas las que haga al menos una vez por semana en ${a.etiqueta}.`,
      when: { field: 'area', equals: a.id },
      fields: [
        { type: 'choice', name: `tareas_${a.id}`, label: 'Tareas', multiple: true, options: ops(TAREAS[a.id]) },
        {
          type: 'textarea',
          name: `otra_${a.id}`,
          label: '¿Otra tarea que repita y no esté en la lista?',
          placeholder: 'Opcional',
          ia: true,
        },
      ],
    }),
  ),
  {
    title: '¿Cuánto tiempo se le va en eso?',
    subtitle: 'Un cálculo aproximado basta.',
    fields: [
      {
        type: 'choice',
        name: 'horas',
        label: 'Horas por semana en tareas que se repiten',
        required: true,
        options: HORAS.map((h) => ({ value: h.id, label: h.etiqueta })),
      },
      {
        type: 'textarea',
        name: 'tarea_principal',
        label: 'La tarea que más tiempo le quita',
        placeholder: 'Qué hace, con qué documentos y cuánto le toma cada vez',
        required: true,
        ia: true,
      },
    ],
  },
  {
    title: '¿Participa en las propuestas comerciales?',
    subtitle: 'Desde que llega el Brief hasta que la propuesta se envía al cliente. Un cálculo aproximado basta.',
    when: { field: 'area', equals: AREAS_PROPUESTAS },
    fields: [
      { type: 'choice', name: 'propuesta_rol', label: 'Su papel', required: true, options: ops(PROPUESTA_ROL) },
      {
        type: 'choice',
        name: 'propuesta_horas',
        label: 'Si participa: horas de su parte en una propuesta',
        options: PROPUESTA_HORAS.map((h) => ({ value: h.id, label: h.etiqueta })),
      },
      {
        type: 'choice',
        name: 'propuestas_mes',
        label: 'Si participa: propuestas que pasan por usted al mes',
        options: PROPUESTAS_MES.map((h) => ({ value: h.id, label: h.etiqueta })),
      },
      { type: 'textarea', name: 'propuesta_demora', label: '¿Qué parte de la propuesta le toma más tiempo?', placeholder: 'Opcional', ia: true },
    ],
  },
  {
    title: 'Sobre los certificados',
    subtitle: 'Los de recolección y los de disposición final que Ekosolv emite a sus clientes. Un cálculo aproximado basta.',
    when: { field: 'area', equals: 'logistica' },
    fields: [
      {
        type: 'choice',
        name: 'certificados_mes',
        label: '¿Cuántos certificados emite al mes, contando los dos tipos?',
        required: true,
        options: CERTIFICADOS_MES.map((h) => ({ value: h.id, label: h.etiqueta })),
      },
      {
        type: 'choice',
        name: 'certificado_min',
        label: '¿Cuánto le toma cada uno, desde que tiene los datos o el certificado del gestor?',
        required: true,
        options: CERTIFICADO_MIN.map((h) => ({ value: h.id, label: h.etiqueta })),
      },
      {
        type: 'choice',
        name: 'seguimiento_gestores',
        label: '¿Cuántas horas a la semana le dedica a pedir certificados y hacer seguimiento a los gestores?',
        options: HORAS.map((h) => ({ value: h.id, label: h.etiqueta })),
      },
      { type: 'textarea', name: 'certificado_demora', label: '¿Qué parte le toma más tiempo?', placeholder: 'Opcional', ia: true },
    ],
  },
  {
    title: '¿Con qué trabaja?',
    subtitle: 'Marque lo que usa con frecuencia.',
    fields: [
      { type: 'choice', name: 'documentos', label: 'Documentos', multiple: true, options: ops(DOCUMENTOS) },
      { type: 'choice', name: 'herramientas', label: 'Herramientas', multiple: true, options: ops(HERRAMIENTAS) },
      { type: 'text', name: 'otras_herramientas', label: '¿Otro documento o herramienta?', placeholder: 'Opcional' },
    ],
  },
  {
    title: '¿Ha usado inteligencia artificial?',
    subtitle: 'No hay respuestas buenas ni malas: sirve para arrancar desde donde está el equipo.',
    fields: [
      { type: 'choice', name: 'uso_ia', label: 'Con qué frecuencia', required: true, options: ops(USO_IA) },
      { type: 'choice', name: 'ias', label: 'Cuáles ha usado', multiple: true, options: ops(IAS) },
      { type: 'textarea', name: 'para_que', label: 'Si la usa, ¿para qué?', placeholder: 'Opcional' },
    ],
  },
  {
    title: '¿Qué le preocupa de usarla en su trabajo?',
    subtitle: 'Marque todas las que apliquen. Cada una se trabaja en la capacitación general.',
    fields: [
      { type: 'choice', name: 'preocupaciones', label: 'Preocupaciones', multiple: true, options: ops(PREOCUPACIONES) },
      { type: 'textarea', name: 'otra_preocupacion', label: '¿Otra preocupación?', placeholder: 'Opcional' },
    ],
  },
  {
    title: 'Si la IA le resolviera una sola tarea, ¿cuál sería?',
    subtitle: 'Cada taller termina con un ejercicio sobre un documento real del área.',
    fields: [
      {
        type: 'textarea',
        name: 'deseo',
        label: 'La tarea que le gustaría resolver',
        placeholder: 'Por ejemplo, sacar las obligaciones y plazos de un auto sin leerlo completo',
        required: true,
        ia: true,
      },
      {
        type: 'choice',
        name: 'documento_real',
        label: '¿Podría traer un documento real para el ejercicio?',
        required: true,
        options: ops(DOCUMENTO_REAL),
      },
      { type: 'text', name: 'documento_cual', label: '¿Cuál documento?', placeholder: 'Por ejemplo, un auto de seguimiento de la CAR' },
    ],
  },
  {
    title: 'Por último, la logística',
    subtitle: 'Las fechas de los sábados se fijan con este diagnóstico.',
    fields: [
      { type: 'choice', name: 'modalidad', label: 'Prefiere la capacitación', options: ops(MODALIDAD) },
      {
        type: 'text',
        name: 'restricciones',
        label: '¿Hay algún sábado de las próximas semanas en que no pueda?',
        placeholder: 'Opcional',
      },
      {
        type: 'textarea',
        name: 'comentarios',
        label: '¿Algo más que quiera contarnos?',
        placeholder: 'Lo que no le preguntamos y le parece importante para su taller. Opcional',
      },
      {
        type: 'consent',
        name: 'consent',
        html: 'Autorizo el uso de estas respuestas para diagnosticar y planear la capacitación en IA de Ekosolv. Solo las ven Gerencia y el capacitador.',
        notice: 'No escriba datos de clientes ni información confidencial en las respuestas.',
      },
    ],
  },
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <title>Capacitación en IA · Ekosolv</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Geist:wght@300..700&family=Geist+Mono:wght@300..500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="ia">
    <header class="ia-top">
      <img src="/brand/ekosolv-horizontal.png" alt="EKOSOLV" width="249" height="72" />
      <span class="ia-tag">Capacitación en IA</span>
    </header>

    <main>
      <section class="ia-hero ia-wrap">
        <p class="ia-kicker">Equipo Ekosolv</p>
        <h1>La inteligencia artificial, <em>aplicada a su trabajo</em></h1>
        <p class="ia-lede">
          Todo lo de la capacitación queda en esta página. Primero, la encuesta de diagnóstico. Después de cada taller,
          aquí encontrará el material de su área: guías, plantillas e instrucciones listas para usar.
        </p>
        <nav class="ia-pasos" aria-label="Secciones">
          <a href="#encuesta"><b>1</b>Encuesta{estado.abierta && <i>Ahora</i>}</a>
          <a href="#programa"><b>2</b>Programa por área</a>
          <a href="#material"><b>3</b>Material de apoyo</a>
        </nav>
      </section>

      <!-- 1. ENCUESTA -->
      <section id="encuesta" class="ia-sec ia-wrap">
        <div class="ia-sec-head">
          <p class="ia-kicker">Paso 1 · {estado.abierta ? 'Ahora' : 'Diagnóstico'}</p>
          <h2>Encuesta de diagnóstico</h2>
          <p>Unos 15 minutos. Con sus respuestas se arma el taller de su área, con casos de su trabajo real, y se fijan las fechas.</p>
        </div>
        {estado.abierta && (
          <div class="ia-aviso" id="ia-aviso" hidden>
            <span class="ia-chispa" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.9 6.1L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.9z" /><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" /></svg>
            </span>
            <p>
              <b>Pruebe la IA mientras responde.</b> En las preguntas abiertas escriba como le salga y pulse
              <span class="ia-aviso-btn">Mejorar con IA</span>: le hará una o dos preguntas y le propondrá una versión más
              clara. Usted decide si la usa. Es un primer ejemplo de lo que verá en el taller.
            </p>
          </div>
        )}
        <div class="ia-card ia-encuesta">
          {
            estado.abierta ? (
              <TypeformFlow
                formId="diagnostico-ia"
                endpoint="/api/diagnostico"
                submitLabel="Enviar respuestas"
                successTitle="Gracias, quedó registrado"
                successBody="Con las respuestas de todo el equipo se arma el cronograma y el taller de cada área. Si se le olvidó algo, puede volver a llenar la encuesta: se tiene en cuenta la última."
                steps={steps}
              />
            ) : (
              <div class="ia-cerrada">
                <h3>{estado.usada ? 'La encuesta ya cerró' : 'La encuesta se abre pronto'}</h3>
                <p>
                  {estado.usada
                    ? 'Gracias a quienes respondieron. Abajo está el programa y, después de cada taller, el material de su área.'
                    : 'Vuelva a esta página cuando Gerencia le avise. Mientras tanto, abajo puede ver lo que aprenderá su área.'}
                </p>
              </div>
            )
          }
        </div>
      </section>

      <!-- 2. PROGRAMA -->
      <section id="programa" class="ia-sec ia-wrap">
        <div class="ia-sec-head">
          <p class="ia-kicker">Paso 2 · Los sábados</p>
          <h2>Lo que aprende cada área</h2>
          <p>
            Sábados de 4 horas. Primero, la capacitación general con todo el equipo; después, el taller de cada área.
            Cada taller termina con un ejercicio sobre un documento real. Las fechas se fijan con el diagnóstico.
          </p>
        </div>
        <div class="ia-modulos">
          {modulos.map((m) => (
            <article class={`ia-card ia-modulo${m.id === 'general' ? ' is-general' : ''}`} id={`area-${m.id}`} style={`--c:${COLOR[m.id]}`}>
              <h3><span class="ia-punto" aria-hidden="true"></span>{m.titulo}</h3>
              <p class="ia-quien">{m.quien}</p>
              <p class="ia-mini">Al terminar, podrá</p>
              <ul class="ia-podra">{m.podra.map((x) => <li>{x}</li>)}</ul>
              <details class="ia-aprende">
                <summary>Qué aprende</summary>
                <ul>{m.aprende.map((x) => <li>{x}</li>)}</ul>
              </details>
              <p class="ia-demuestra"><b>Lo demuestra con</b> {m.demuestra}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- 3. MATERIAL -->
      <section id="material" class="ia-sec ia-wrap">
        <div class="ia-sec-head">
          <p class="ia-kicker">Paso 3 · Después de cada taller</p>
          <h2>Material de apoyo</h2>
          <p>Aquí se publica el material de cada taller para que lo tenga a mano cuando lo necesite en el día a día.</p>
        </div>
        <div class="ia-material">
          {modulos.map((m) => (
            <div class="ia-mat" style={`--c:${COLOR[m.id]}`}>
              <h3><span class="ia-punto" aria-hidden="true"></span>{m.titulo}</h3>
              {!m.material.some((x) => x.href) && <small class="ia-pronto">Después del taller</small>}
              <ul>
                {m.material.map((x) => (
                  <li>{x.href ? <a href={x.href} target="_blank" rel="noopener">{x.titulo}</a> : <span>{x.titulo}</span>}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </main>

    <script>
      // Asistente con IA de la encuesta (src/lib/diagnostico/ia.ts). Se monta
      // debajo de cada textarea con data-ia, solo si /api/diagnostico-ia dice
      // que está disponible. Nada de esto se envía con la encuesta salvo la
      // lista de campos en que la persona aceptó la versión de la IA.
      const MAX_VUELTAS = 3

      type Salida = { propuesta: string; preguntas: string[]; nota: string }

      const flow = document.getElementById('diagnostico-ia')
      const form = flow?.querySelector<HTMLFormElement>('.tf-form')

      function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
        const e = document.createElement(tag)
        if (cls) e.className = cls
        if (text) e.textContent = text
        return e
      }

      const valor = (name: string) => form?.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value.trim() ?? ''
      const etiquetasElegidas = (name: string) =>
        Array.from(form?.querySelectorAll<HTMLElement>(`.tf-choices[data-name="${name}"] .tf-choice[aria-pressed="true"] .tf-choice-label`) ?? [])
          .map((b) => b.textContent?.trim() ?? '')
          .filter(Boolean)

      function contexto() {
        const area = valor('area')
        return {
          area: etiquetasElegidas('area')[0] || undefined,
          cargo: valor('cargo') || undefined,
          tareas: area ? etiquetasElegidas(`tareas_${area}`).slice(0, 12) : undefined,
          horas: etiquetasElegidas('horas')[0] || undefined,
        }
      }

      // Campos en que la persona usó la versión de la IA; viaja con la encuesta.
      const usados = new Set<string>()
      let oculto: HTMLInputElement | null = null
      function marcarUsado(campo: string) {
        usados.add(/^otra_/.test(campo) ? 'tarea_otra' : campo)
        if (!oculto && form) {
          oculto = el('input')
          oculto.type = 'hidden'
          oculto.name = 'ia_campos'
          form.appendChild(oculto)
        }
        if (oculto) oculto.value = [...usados].join(', ')
      }

      function montar(ta: HTMLTextAreaElement) {
        const caja = el('div', 'iax')
        const disparar = el('button', 'iax-btn')
        disparar.type = 'button'
        disparar.innerHTML =
          '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.9 6.1L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.9z"/></svg><span>Mejorar con IA</span>'
        const panel = el('div', 'iax-panel')
        panel.hidden = true
        panel.setAttribute('aria-live', 'polite')
        caja.append(disparar, panel)
        ta.closest('.tf-field')?.after(caja)

        let aclaraciones: { pregunta: string; respuesta: string }[] = []
        let vuelta = 0
        let ocupado = false

        // Enter dentro del panel no debe avanzar la encuesta.
        caja.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter') return
          e.stopPropagation()
          const t = e.target as HTMLElement
          if (t.tagName === 'INPUT') {
            e.preventDefault()
            panel.querySelector<HTMLButtonElement>('.iax-responder')?.click()
          }
        })

        function cargando() {
          panel.hidden = false
          panel.replaceChildren(el('p', 'iax-cargando', vuelta ? 'Actualizando la propuesta con lo que respondió…' : 'La IA está leyendo su respuesta…'))
        }

        function error(msg: string) {
          panel.hidden = false
          panel.replaceChildren(el('p', 'iax-error', msg))
        }

        function mostrar(s: Salida) {
          vuelta += 1
          const nodos: HTMLElement[] = []
          if (s.nota) nodos.push(el('p', 'iax-nota', s.nota))

          const prop = el('div', 'iax-prop')
          prop.append(el('span', 'iax-mini', 'Propuesta de la IA'), el('p', 'iax-texto', s.propuesta))
          const acciones = el('div', 'iax-acciones')
          const usar = el('button', 'iax-usar', 'Usar esta versión')
          usar.type = 'button'
          const dejar = el('button', 'iax-dejar', 'Quedarme con la mía')
          dejar.type = 'button'
          acciones.append(usar, dejar)
          prop.append(acciones)
          nodos.push(prop)

          usar.addEventListener('click', () => {
            ta.value = s.propuesta
            ta.dispatchEvent(new Event('input', { bubbles: true }))
            marcarUsado(ta.name)
            panel.replaceChildren(el('p', 'iax-listo', 'Listo, quedó en su respuesta. Puede editarla si quiere.'))
            disparar.querySelector('span')!.textContent = 'Volver a pedir ayuda'
            aclaraciones = []
            vuelta = 0
          })
          dejar.addEventListener('click', () => {
            panel.hidden = true
            panel.replaceChildren()
          })

          if (s.preguntas.length && vuelta < MAX_VUELTAS) {
            const preg = el('div', 'iax-preg')
            preg.append(el('span', 'iax-mini', 'Para completarla, cuéntele a la IA'))
            const campos = s.preguntas.map((p) => {
              const l = el('label', 'iax-q')
              const inp = el('input', 'iax-input')
              inp.type = 'text'
              inp.maxLength = 500
              inp.placeholder = 'Su respuesta, en una línea'
              l.append(el('span', '', p), inp)
              preg.append(l)
              return { pregunta: p, inp }
            })
            const responder = el('button', 'iax-responder', 'Responder y actualizar')
            responder.type = 'button'
            responder.addEventListener('click', () => {
              const nuevas = campos.map((c) => ({ pregunta: c.pregunta, respuesta: c.inp.value.trim() })).filter((c) => c.respuesta)
              if (!nuevas.length) {
                campos[0]?.inp.focus()
                return
              }
              aclaraciones = [...aclaraciones, ...nuevas]
              pedir(s.propuesta)
            })
            preg.append(responder)
            nodos.push(preg)
          }
          panel.replaceChildren(...nodos)
        }

        async function pedir(base?: string) {
          if (ocupado) return
          const borrador = (base ?? ta.value).trim()
          if (borrador.length < 3) {
            error('Escriba primero su respuesta, aunque sea en pocas palabras. La IA parte de lo que usted escriba.')
            ta.focus()
            return
          }
          ocupado = true
          disparar.disabled = true
          cargando()
          try {
            const res = await fetch('/api/diagnostico-ia', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ campo: ta.name, borrador: borrador.slice(0, 1500), contexto: contexto(), aclaraciones }),
            })
            const j = await res.json().catch(() => ({}))
            if (!res.ok) throw new Error(j.error || 'La IA no respondió. Intente de nuevo o siga sin ella.')
            mostrar(j as Salida)
          } catch (e) {
            error(e instanceof Error ? e.message : 'Error de red. Puede seguir sin la IA.')
          } finally {
            ocupado = false
            disparar.disabled = false
          }
        }

        disparar.addEventListener('click', () => {
          aclaraciones = []
          vuelta = 0
          pedir()
        })
      }

      async function iniciar() {
        if (!form) return
        try {
          const r = await fetch('/api/diagnostico-ia')
          const j = await r.json()
          if (!j.disponible) return
        } catch {
          return
        }
        const aviso = document.getElementById('ia-aviso')
        if (aviso) aviso.hidden = false
        form.querySelectorAll<HTMLTextAreaElement>('textarea[data-ia="true"]').forEach(montar)
      }
      iniciar()
    </script>

