---
// Banco de recursos de las capacitaciones (docs/plan-recursos.md, fase 1).
// /academia/recursos muestra las áreas; /academia/recursos/<área>, el banco
// del área. Pública (excepción en src/middleware.ts): se llega por el QR de la
// guía rápida impresa y ningún QR lleva a un login. Un área que no existe no da
// 404 sino el índice, porque un QR impreso ya no se puede corregir.
export const prerender = false
import '../../../styles/global.css'
import '../../../styles/maquetas.css'
import Maqueta from '../../../components/taller/Maqueta.astro'
import { AREAS_RECURSOS, areaRecursos, bancoDe, fuentesDe, rutaRecursos } from '../../../lib/talleres/recursos'

const area = areaRecursos(Astro.params.area)
const banco = area ? bancoDe(area.id) : []
const fuentes = area ? fuentesDe(area.id) : []
const colorNivel = { si: '#179C91', cuidado: '#D9A43B', no: '#C2513F' }
const partes = [
  { id: 'contexto', nombre: 'Contexto', ayuda: 'Quién es usted y qué hay que saber', color: '#124E7D' },
  { id: 'tarea', nombre: 'Tarea', ayuda: 'Qué quiere, con un verbo claro', color: '#179C91' },
  { id: 'formato', nombre: 'Formato', ayuda: 'Cómo lo quiere recibir', color: '#B8926F' },
  { id: 'ejemplo', nombre: 'Ejemplo', ayuda: 'Cómo debe quedar, si lo tiene', color: '#6B7580' },
] as const
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{area ? `Banco de recursos · ${area.nombre} · Ekosolv` : 'Banco de recursos · Ekosolv'}</title>
    <link rel="icon" href="/brand/ekosolv-isotype.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet" />
    <style>
      :root { --tinta: #0E1C26; --azul: #124E7D; --verde: #179C91; --gris: #6B7580; --linea: #E3DFD9; --papel: #F5F2EE; }
      body { margin: 0; background: var(--papel); color: var(--tinta); font-family: var(--font-sans); -webkit-text-size-adjust: 100%; }
      .envoltura { max-width: 760px; margin: 0 auto; padding: 20px 18px 48px; }

      .tope { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 26px; }
      .tope img { height: 34px; width: auto; }
      .tope a { font: 500 12px/1 var(--font-mono); color: var(--gris); text-decoration: none; }

      .kicker { font: 500 12px/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--verde); margin: 0 0 8px; }
      h1 { font: 650 clamp(30px, 8vw, 44px)/1.02 var(--font-display); letter-spacing: -0.02em; margin: 0 0 10px; }
      h1 span { color: var(--azul); }
      .bajada { font-size: 16px; line-height: 1.5; color: #3B4752; margin: 0 0 22px; max-width: 56ch; }

      .areas { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin: 0 -18px 30px; padding-inline: 18px; scrollbar-width: none; }
      .areas a { flex: none; font: 600 14px/1 var(--font-sans); padding: 10px 14px; border-radius: 999px; background: #fff; color: var(--tinta); text-decoration: none; box-shadow: inset 0 0 0 1px var(--linea); }
      .areas a[aria-current='page'] { background: var(--tinta); color: #fff; box-shadow: none; }

      .indice { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
      .indice a { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #fff; border-radius: 14px; padding: 18px; color: var(--tinta); text-decoration: none; font: 600 18px/1.2 var(--font-display); transition: background .15s; }
      .indice a:hover { background: #E6F3F1; }
      .indice a::after { content: '→'; color: var(--verde); font-family: var(--font-sans); }

      .capacitacion { display: grid; gap: 30px; }
      .capacitacion > header { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--linea); }
      .capacitacion > header .num { flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--tinta); color: #fff; display: grid; place-items: center; font: 600 16px/1 var(--font-display); }
      .capacitacion > header h2 { font: 650 22px/1.15 var(--font-display); margin: 0; }
      .capacitacion > header small { display: block; font: 500 11px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--gris); margin-bottom: 3px; }

      h3 { font: 500 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--gris); margin: 0 0 12px; }
      .caja { background: #fff; border-radius: 14px; padding: 16px 18px; }

      .plantilla { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .parte { background: #fff; border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 4px; }
      .parte b { font: 600 15px/1.1 var(--font-display); display: flex; align-items: center; gap: 7px; }
      .parte b::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
      .parte small { font-size: 12px; color: var(--gris); line-height: 1.3; }
      .parte p { margin: 2px 0 0; font-size: 14px; line-height: 1.4; }

      .instr { display: grid; gap: 10px; }
      .instr article { background: #fff; border-radius: 14px; padding: 14px 16px 12px; display: grid; gap: 8px; }
      .instr .cab { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
      .instr b { font: 600 16px/1.2 var(--font-display); }
      .instr pre { margin: 0; white-space: pre-wrap; font: 400 13.5px/1.55 var(--font-mono); color: var(--azul); }
      .copiar { flex: none; border: 0; cursor: pointer; font: 600 13px/1 var(--font-sans); padding: 8px 12px; border-radius: 999px; background: #E6F3F1; color: #0F6B63; }
      .copiar.ok { background: var(--verde); color: #fff; }

      .doble { display: grid; gap: 30px; }
      .frases { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
      .frases li { font: 400 13.5px/1.45 var(--font-mono); color: var(--azul); background: #fff; border-radius: 10px; padding: 10px 12px; }
      .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
      .lista li { font-size: 15px; line-height: 1.45; }
      .lista b { font-weight: 600; }
      .pegar { display: grid; gap: 10px; }
      .pegar div { display: grid; grid-template-columns: 14px 1fr; gap: 10px; font-size: 15px; line-height: 1.45; }
      .pegar div::before { content: ''; width: 12px; height: 12px; border-radius: 50%; margin-top: 5px; background: var(--c); }
      .pegar b { font-weight: 600; }

      .guia .intro { font-size: 15px; line-height: 1.5; margin: 0 0 12px; color: #3B4752; }
      .pasos { display: grid; gap: 8px; counter-reset: paso; }
      .pasos details { background: #fff; border-radius: 14px; }
      .pasos summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 30px 1fr 16px; gap: 12px; align-items: center; padding: 14px 16px; }
      .pasos summary::-webkit-details-marker { display: none; }
      .pasos summary::before { counter-increment: paso; content: counter(paso); width: 30px; height: 30px; border-radius: 50%; background: #E6F3F1; color: #0F6B63; display: grid; place-items: center; font: 600 14px/1 var(--font-display); }
      .pasos summary::after { content: '+'; color: var(--gris); font-size: 18px; }
      .pasos details[open] summary::after { content: '−'; }
      .pasos summary span { display: grid; gap: 2px; }
      .pasos summary small { font: 500 11px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--verde); }
      .pasos summary b { font: 600 15px/1.25 var(--font-display); }
      .paso { padding: 0 16px 16px 58px; display: grid; gap: 12px; }
      .paso p { margin: 0; font-size: 15px; line-height: 1.5; }
      .paso p.que { font-size: 14px; color: #3B4752; background: var(--papel); border-radius: 10px; padding: 10px 12px; }
      .paso .ilustracion { font-size: 13px; background: var(--papel); border-radius: 12px; padding: 14px; overflow: hidden; }

      .enlaces { display: grid; gap: 8px; }
      .enlaces a { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: center; background: #fff; border-radius: 14px; padding: 14px 16px; color: var(--tinta); text-decoration: none; transition: background .15s; }
      .enlaces a:hover { background: #E6F3F1; }
      .enlaces b { font: 600 16px/1.2 var(--font-display); }
      .enlaces span { grid-column: 1; font-size: 13.5px; line-height: 1.4; color: var(--gris); }
      .enlaces i { grid-column: 2; grid-row: 1 / span 2; font-style: normal; font: 500 12px/1 var(--font-mono); color: var(--verde); }

      footer { margin-top: 44px; padding-top: 16px; border-top: 1px solid var(--linea); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font: 500 11px/1.4 var(--font-mono); color: var(--gris); }

      @media (min-width: 680px) {
        .envoltura { padding-top: 32px; }
        .plantilla { grid-template-columns: repeat(4, 1fr); }
        .doble { grid-template-columns: 1fr 1fr; gap: 24px; }
      }
    </style>
  </head>
  <body>
    <div class="envoltura">
      <div class="tope">
        <img src="/brand/ekosolv-horizontal.png" alt="EKOSOLV" width="249" height="72" />
        {area && <a href="/academia/recursos">Todas las áreas</a>}
      </div>

      {!area ? (
        <main>
          <p class="kicker">Capacitación en IA</p>
          <h1>Banco de recursos</h1>
          <p class="bajada">Plantillas, instrucciones para copiar y guías paso a paso de cada capacitación. Elija su área.</p>
          <nav class="indice" aria-label="Áreas">
            {AREAS_RECURSOS.map((a) => <a href={rutaRecursos(a.id)}>{a.nombre}</a>)}
          </nav>
        </main>
      ) : (
        <main>
          <p class="kicker">Banco de recursos</p>
          <h1>Lo que necesita para usar la IA en <span>{area.nombre}</span></h1>
          <p class="bajada">Copie las instrucciones, siga las guías y descargue las hojas de cada capacitación. Se va llenando sábado a sábado.</p>
          <nav class="areas" aria-label="Otras áreas">
            {AREAS_RECURSOS.map((a) => <a href={rutaRecursos(a.id)} aria-current={a.id === area.id ? 'page' : undefined}>{a.nombre}</a>)}
          </nav>

          {banco.map((b) => (
            <section class="capacitacion">
              <header>
                <span class="num">{b.n}</span>
                <div><small>Capacitación {b.n} de 4</small><h2>{b.titulo}</h2></div>
              </header>

              <section>
                <h3>Una buena instrucción tiene cuatro partes</h3>
                <div class="plantilla">
                  {partes.map((p) => (
                    <div class="parte" style={`--c: ${p.color}`}><b>{p.nombre}</b><small>{p.ayuda}</small><p>{b.plantilla[p.id]}</p></div>
                  ))}
                </div>
              </section>

              <section>
                <h3>Instrucciones para copiar</h3>
                <div class="instr">
                  {b.instrucciones.map((x) => (
                    <article>
                      <div class="cab"><b>{x.titulo}</b><button type="button" class="copiar">Copiar</button></div>
                      <pre>{x.texto}</pre>
                    </article>
                  ))}
                </div>
              </section>

              <div class="doble">
                <section>
                  <h3>Si no sirve, dígale qué cambiar</h3>
                  <ul class="frases">{b.siNoSirve.map((x) => <li>{x}</li>)}</ul>
                </section>
                <section>
                  <h3>Antes de usar la respuesta</h3>
                  <ul class="lista">{b.habitos.map((x) => <li><b>{x.titulo}.</b> {x.texto}</li>)}</ul>
                </section>
              </div>

              <section>
                <h3>Dónde pegar</h3>
                <div class="caja pegar">
                  {b.dondePegar.map((x) => <div style={`--c: ${colorNivel[x.nivel]}`}><span><b>{x.titulo}.</b> {x.texto}</span></div>)}
                </div>
              </section>

              {b.guias.map((g) => (
                <section class="guia">
                  <h3>Guía paso a paso</h3>
                  <p class="intro"><b>{g.titulo}.</b> {g.intro}</p>
                  <div class="pasos">
                    {g.pasos.map((p) => (
                      <details>
                        <summary><span><small>{p.concepto}</small><b>{p.titulo}</b></span></summary>
                        <div class="paso">
                          <p>{p.hacer}</p>
                          <p class="que">{p.queEs}</p>
                          <div class="ilustracion"><Maqueta id={p.maqueta} /></div>
                        </div>
                      </details>
                    ))}
                  </div>
                </section>
              ))}

              <section>
                <h3>Descargas</h3>
                <div class="enlaces">
                  {b.descargas.map((d) => <a href={d.href} download><b>{d.titulo}</b><span>{d.texto}</span><i>PDF</i></a>)}
                  <a href={b.resumen}><b>Tarjeta resumen</b><span>Las ideas para llevarse de la capacitación {b.n}.</span><i>Ver</i></a>
                </div>
              </section>
            </section>
          ))}

          <section style="margin-top: 34px">
            <h3>Fuentes oficiales para verificar</h3>
            <div class="enlaces">
              {fuentes.map((f) => <a href={f.href} target="_blank" rel="noopener"><b>{f.titulo}</b><span>{f.texto}</span><i>Abrir</i></a>)}
            </div>
          </section>
        </main>
      )}

      <footer><span>Capacitación en IA para el equipo de Ekosolv</span><span>Dictada por Michael Rodriguez</span></footer>
    </div>

    <script>
      document.querySelectorAll<HTMLButtonElement>('.copiar').forEach((b) =>
        b.addEventListener('click', async () => {
          const texto = b.closest('article')?.querySelector('pre')?.textContent ?? ''
          try {
            await navigator.clipboard.writeText(texto)
          } catch {
            const t = document.createElement('textarea')
            t.value = texto
            document.body.append(t)
            t.select()
            document.execCommand('copy')
            t.remove()
          }
          b.textContent = 'Copiada'
          b.classList.add('ok')
          setTimeout(() => { b.textContent = 'Copiar'; b.classList.remove('ok') }, 1800)
        }),
      )
    </script>
  </body>
</html>
