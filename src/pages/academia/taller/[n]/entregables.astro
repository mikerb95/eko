---
// Vista previa de los entregables impresos de una capacitación (solo admin):
// por cada área, una hoja carta con el checklist de temas y otra con la guía
// rápida, que lleva un QR al banco de recursos. Se elige el área arriba y se
// imprime desde el navegador (una área o todas).
export const prerender = false
import '../../../../styles/global.css'
import QRCode from 'qrcode'
import { tallerDe } from '../../../../lib/talleres'
import { SITE_URL } from '../../../../lib/site'
import { BLOQUES_CHECKLIST, DONDE_PEGAR, ENTREGABLES_TALLER1, HABITOS, SI_NO_SIRVE } from '../../../../lib/talleres/entregables1'

const t = tallerDe(Astro.params.n)
if (!t) return new Response('Esta capacitación no existe.', { status: 404 })
if (String(Astro.locals.role || '') !== 'admin') return Astro.redirect(`/academia/taller/${t.n}`)
if (t.n !== 1) return new Response('Esta capacitación todavía no tiene entregables.', { status: 404 })

// El QR apunta siempre al dominio público, como los del proyector.
// El banco de recursos todavía no existe: debe ser público (ningún QR lleva a un login).
const urlRecursos = (area: string) => `${SITE_URL}/academia/recursos/${area}`
const areas = await Promise.all(
  ENTREGABLES_TALLER1.map(async (a) => ({
    ...a,
    url: urlRecursos(a.id),
    qr: await QRCode.toString(urlRecursos(a.id), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0E1C26', light: '#ffffff00' } }),
  })),
)
const sinEsquema = (u: string) => u.replace(/^https?:\/\//, '')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{`Entregables · Capacitación ${t.n} · Ekosolv`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet" />
    <style>
      @page { size: letter; margin: 0; }
      :root { --tinta: #0E1C26; --azul: #124E7D; --verde: #179C91; --arena: #B8926F; --gris: #6B7580; --linea: #D9D5CF; }
      body { margin: 0; background: #E9E6E1; color: var(--tinta); font-family: var(--font-sans); }

      .barra { position: sticky; top: 0; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; padding: 14px 16px; background: rgba(233, 230, 225, .92); backdrop-filter: blur(8px); }
      .barra button { border: 0; cursor: pointer; font: 600 14px/1.2 var(--font-sans); padding: 10px 16px; border-radius: 999px; background: #fff; color: var(--tinta); box-shadow: inset 0 0 0 1px var(--linea); }
      .barra button[aria-pressed='true'] { background: var(--tinta); color: #fff; box-shadow: none; }
      .barra .sep { width: 1px; height: 24px; background: var(--linea); margin: 0 6px; }
      .barra .imprimir { background: var(--azul); color: #fff; box-shadow: none; }

      .area { display: none; }
      .area.activa { display: block; }
      body.todas .area { display: block; }

      .hoja { width: 8.5in; height: 11in; margin: 0 auto 28px; background: #fff; box-sizing: border-box; padding: 0.55in 0.6in 0.45in; display: flex; flex-direction: column; gap: 0.17in; overflow: hidden; box-shadow: 0 1px 2px rgba(14, 28, 38, .08), 0 8px 24px rgba(14, 28, 38, .08); }

      header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.3in; }
      header img { height: 0.36in; width: auto; }
      .kicker { font: 500 8pt/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--verde); margin: 0 0 0.06in; }
      h1 { font: 650 22pt/1.02 var(--font-display); letter-spacing: -0.02em; margin: 0; }
      h1 .area-nombre { color: var(--azul); }
      h2 { font: 500 7.5pt/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--gris); margin: 0 0 0.08in; }

      .datos { display: grid; grid-template-columns: 1.6fr 1fr; gap: 0.25in; font-size: 8.5pt; color: var(--gris); }
      .datos span { display: flex; gap: 0.08in; align-items: flex-end; }
      .datos i { font-style: normal; flex: 1; border-bottom: 1px solid var(--linea); height: 1.1em; }

      /* Checklist */
      .bloques { display: grid; grid-template-columns: 1fr 1fr; gap: 0.14in 0.22in; }
      .bloque { background: #F5F2EE; border-radius: 0.1in; padding: 0.13in 0.16in 0.12in; }
      .bloque.ancho { grid-column: 1 / -1; }
      .bloque h3 { font: 600 11pt/1.15 var(--font-display); margin: 0 0 0.07in; display: flex; gap: 0.08in; align-items: baseline; }
      .bloque h3 span { font: 500 8pt/1 var(--font-mono); color: var(--verde); }
      .bloque ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.055in; }
      .bloque.ancho ul { grid-template-columns: 1fr 1fr; column-gap: 0.22in; }
      .check { display: grid; grid-template-columns: 0.15in 1fr; gap: 0.07in; font-size: 8.4pt; line-height: 1.32; }
      .check::before { content: ''; width: 0.13in; height: 0.13in; border: 1.2px solid var(--tinta); border-radius: 0.03in; margin-top: 0.015in; box-sizing: border-box; background: #fff; }
      .check.propio b { color: var(--azul); font-weight: 600; }

      .semana { background: var(--tinta); color: #fff; border-radius: 0.1in; padding: 0.15in 0.18in; display: grid; gap: 0.08in; }
      .semana h2 { color: #8FD3CC; }
      .semana .check::before { border-color: #fff; background: transparent; }
      .semana ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.06in; }
      .semana .linea { display: flex; gap: 0.08in; align-items: flex-end; font-size: 8.4pt; color: #C9D3DA; margin-top: 0.04in; }
      .semana .linea i { font-style: normal; flex: 1; border-bottom: 1px solid rgba(255, 255, 255, .4); height: 1.1em; }

      /* Guía rápida */
      .plantilla { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.1in; }
      .parte { background: #F5F2EE; border-radius: 0.1in; padding: 0.11in 0.12in; display: flex; flex-direction: column; gap: 0.04in; }
      .parte b { font: 600 10pt/1.1 var(--font-display); display: flex; align-items: center; gap: 0.06in; }
      .parte b::before { content: ''; width: 0.08in; height: 0.08in; border-radius: 50%; background: var(--c); }
      .parte small { font-size: 7.4pt; color: var(--gris); line-height: 1.25; }
      .parte p { margin: 0; font-size: 8pt; line-height: 1.3; }
      .parte p.mono { font: 400 7.3pt/1.35 var(--font-mono); color: var(--azul); }

      .instr { display: grid; gap: 0.08in; }
      .instr div { background: #F5F2EE; border-radius: 0.1in; padding: 0.1in 0.14in; }
      .instr b { display: block; font: 600 9.5pt/1.2 var(--font-display); margin-bottom: 0.03in; }
      .instr p { margin: 0; font: 400 7.9pt/1.42 var(--font-mono); color: var(--azul); }

      .doble { display: grid; grid-template-columns: 1fr 1fr; gap: 0.2in; }
      .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.06in; }
      .lista li { font-size: 8.2pt; line-height: 1.3; }
      .lista li b { font-weight: 600; }
      .frases li { font: 400 7.9pt/1.35 var(--font-mono); color: var(--azul); background: #F5F2EE; border-radius: 0.07in; padding: 0.05in 0.09in; }

      .pegar { display: grid; gap: 0.06in; }
      .pegar div { display: grid; grid-template-columns: 0.14in 1fr; gap: 0.08in; font-size: 8.1pt; line-height: 1.3; }
      .pegar div::before { content: ''; width: 0.11in; height: 0.11in; border-radius: 50%; margin-top: 0.02in; background: var(--c); }
      .pegar b { font-weight: 600; }

      .recursos { margin-top: auto; display: grid; grid-template-columns: 1.15in 1fr; gap: 0.2in; align-items: center; background: var(--tinta); color: #fff; border-radius: 0.12in; padding: 0.16in 0.2in; }
      .recursos .qr { background: #fff; border-radius: 0.08in; padding: 0.08in; }
      .recursos .qr :global(svg) { display: block; width: 100%; height: auto; }
      .recursos h3 { font: 650 14pt/1.1 var(--font-display); margin: 0 0 0.05in; }
      .recursos p { margin: 0; font-size: 8.5pt; line-height: 1.4; color: #C9D3DA; }
      .recursos code { display: inline-block; margin-top: 0.07in; font: 500 8pt/1 var(--font-mono); color: #8FD3CC; }

      footer { display: flex; justify-content: space-between; font: 500 7pt/1.3 var(--font-mono); color: var(--gris); }

      @media print {
        body { background: none; }
        .barra { display: none; }
        .hoja { margin: 0; box-shadow: none; break-after: page; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        body.solo-checklist .hoja.guia, body.solo-guia .hoja.checklist { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="barra">
      {areas.map((a, k) => <button type="button" data-area={a.id} aria-pressed={k === 0 ? 'true' : 'false'}>{a.nombre}</button>)}
      <button type="button" data-area="todas" aria-pressed="false">Todas</button>
      <span class="sep"></span>
      <button type="button" class="imprimir" data-imprimir="ambas">Imprimir</button>
      <button type="button" data-imprimir="checklist">Solo checklist</button>
      <button type="button" data-imprimir="guia">Solo guía</button>
    </div>

    {areas.map((a, k) => (
      <section class:list={['area', { activa: k === 0 }]} data-area={a.id}>
        <article class="hoja checklist">
          <header>
            <div>
              <p class="kicker">Checklist · Capacitación {t.n} de 4</p>
              <h1>Lo que vimos hoy<br /><span class="area-nombre">{a.nombre}</span></h1>
            </div>
            <img src="/brand/ekosolv-horizontal.png" alt="EKOSOLV" width="249" height="72" />
          </header>
          <div class="datos">
            <span>Nombre <i></i></span>
            <span>Fecha <i></i></span>
          </div>
          <section>
            <h2>Marque lo que ya domina</h2>
            <div class="bloques">
              {BLOQUES_CHECKLIST.map((b, i) => (
                <div class:list={['bloque', { ancho: i === BLOQUES_CHECKLIST.length - 1 }]}>
                  <h3><span>0{i + 1}</span>{b.titulo}</h3>
                  <ul>
                    {b.items.map((x) => <li class="check">{x}</li>)}
                    <li class="check propio"><span><b>{a.nombre}:</b> {a.checklist[b.id]}</span></li>
                  </ul>
                </div>
              ))}
            </div>
          </section>
          <section class="semana">
            <h2>Para practicar esta semana</h2>
            <ol>
              {a.practicar.map((x) => <li class="check">{x}</li>)}
            </ol>
            <div class="linea">La instrucción que voy a guardar: <i></i></div>
          </section>
          <footer><span>Capacitación en IA para el equipo de Ekosolv</span><span>Hoja 1 de 2</span></footer>
        </article>

        <article class="hoja guia">
          <header>
            <div>
              <p class="kicker">Guía rápida · Capacitación {t.n} de 4</p>
              <h1>Cómo pedirle a la IA<br /><span class="area-nombre">{a.nombre}</span></h1>
            </div>
            <img src="/brand/ekosolv-horizontal.png" alt="EKOSOLV" width="249" height="72" />
          </header>
          <section>
            <h2>Una buena instrucción tiene cuatro partes</h2>
            <div class="plantilla">
              <div class="parte" style="--c: #124E7D"><b>Contexto</b><small>Quién es usted y qué hay que saber</small><p>{a.plantilla.contexto}</p></div>
              <div class="parte" style="--c: #179C91"><b>Tarea</b><small>Qué quiere, con un verbo claro</small><p>{a.plantilla.tarea}</p></div>
              <div class="parte" style="--c: #B8926F"><b>Formato</b><small>Cómo lo quiere recibir</small><p>{a.plantilla.formato}</p></div>
              <div class="parte" style="--c: #6B7580"><b>Ejemplo</b><small>Cómo debe quedar, si lo tiene</small><p class:list={{ mono: a.plantilla.ejemplo.startsWith('|') }}>{a.plantilla.ejemplo}</p></div>
            </div>
          </section>
          <section>
            <h2>Instrucciones listas para copiar</h2>
            <div class="instr">
              {a.instrucciones.map((x) => <div><b>{x.titulo}</b><p>{x.texto}</p></div>)}
            </div>
          </section>
          <div class="doble">
            <section>
              <h2>Si no sirve, dígale qué cambiar</h2>
              <ul class="lista frases">{SI_NO_SIRVE.map((x) => <li>{x}</li>)}</ul>
            </section>
            <section>
              <h2>Antes de usar la respuesta</h2>
              <ul class="lista">{HABITOS.map((x) => <li><b>{x.titulo}.</b> {x.texto}</li>)}</ul>
            </section>
          </div>
          <section>
            <h2>Dónde pegar</h2>
            <div class="pegar">
              {DONDE_PEGAR.map((x) => (
                <div style={`--c: ${x.nivel === 'si' ? '#179C91' : x.nivel === 'cuidado' ? '#D9A43B' : '#C2513F'}`}><span><b>{x.titulo}.</b> {x.texto}</span></div>
              ))}
            </div>
          </section>
          <section class="recursos">
            <div class="qr" set:html={a.qr} role="img" aria-label={`Código QR de ${a.url}`} />
            <div>
              <h3>Banco de recursos</h3>
              <p>Plantillas, guías e instrucciones de cada capacitación, con ejemplos de {a.nombre}. Escanee el código con la cámara del celular.</p>
              <code>{sinEsquema(a.url)}</code>
            </div>
          </section>
          <footer><span>Capacitación en IA para el equipo de Ekosolv</span><span>Hoja 2 de 2</span></footer>
        </article>
      </section>
    ))}

    <script>
      const botones = document.querySelectorAll<HTMLButtonElement>('[data-area]')
      const elegir = (id: string) => {
        document.body.classList.toggle('todas', id === 'todas')
        document.querySelectorAll<HTMLElement>('section.area').forEach((s) => s.classList.toggle('activa', s.dataset.area === id))
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === id)))
        history.replaceState(null, '', `#${id}`)
      }
      botones.forEach((b) => b.addEventListener('click', () => elegir(b.dataset.area!)))
      const inicial = location.hash.slice(1)
      if (inicial && document.querySelector(`[data-area="${inicial}"]`)) elegir(inicial)

      document.querySelectorAll<HTMLButtonElement>('[data-imprimir]').forEach((b) =>
        b.addEventListener('click', () => {
          const modo = b.dataset.imprimir
          document.body.classList.toggle('solo-checklist', modo === 'checklist')
          document.body.classList.toggle('solo-guia', modo === 'guia')
          window.print()
        }),
      )
    </script>
  </body>
</html>
