---
// Tarjeta resumen de una capacitación: una hoja con las ideas clave y las
// instrucciones vistas, para guardar en PDF o imprimir desde el navegador.
// Pública (excepción en src/middleware.ts): se llega por el QR del cierre y
// ningún QR debe llevar a un login. Solo tiene contenido de la capacitación.
export const prerender = false
import '../../../../styles/global.css'
import { tallerDe } from '../../../../lib/talleres'

const t = tallerDe(Astro.params.n)
if (!t) return new Response('Esta capacitación no existe.', { status: 404 })
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{`Tarjeta resumen · Capacitación ${t.n} · Ekosolv`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet" />
    <style>
      @page { size: A4; margin: 0; }
      body { margin: 0; background: #E9E6E1; color: #0E1C26; font-family: var(--font-sans); }
      .barra { display: flex; justify-content: center; gap: 12px; padding: 16px; }
      .barra button, .barra a { border: 0; cursor: pointer; font: 600 15px/1.2 var(--font-sans); padding: 11px 20px; border-radius: 999px; background: #124E7D; color: #fff; text-decoration: none; }
      .barra a { background: #fff; color: #0E1C26; box-shadow: inset 0 0 0 1px #D9D5CF; }
      .hoja { width: 210mm; min-height: 297mm; margin: 0 auto 32px; background: #F5F2EE; box-sizing: border-box; padding: 16mm 16mm 12mm; display: flex; flex-direction: column; gap: 9mm; background-image: radial-gradient(circle at 1px 1px, rgba(14, 28, 38, .06) 1px, transparent 1.4px); background-size: 6mm 6mm; }
      header { display: flex; justify-content: space-between; align-items: flex-start; gap: 10mm; }
      header img { height: 11mm; width: auto; }
      .kicker { font: 500 9pt/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: #179C91; margin: 0 0 3mm; }
      h1 { font: 600 27pt/1.02 var(--font-display); letter-spacing: -0.02em; margin: 0; max-width: 15ch; }
      h2 { font: 500 9pt/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: #6B7580; margin: 0 0 4mm; }
      .ideas { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; }
      .idea { background: #fff; border-radius: 4mm; padding: 5mm 6mm; display: flex; flex-direction: column; gap: 2mm; }
      .idea h3 { font: 600 13pt/1.15 var(--font-display); margin: 0; display: flex; gap: 3mm; align-items: baseline; }
      .idea h3 span { font: 500 9pt/1 var(--font-mono); color: #179C91; }
      .idea p { font-size: 10pt; line-height: 1.4; margin: 0; }
      .instr { display: grid; gap: 4mm; }
      .instr div { background: #fff; border-radius: 4mm; padding: 5mm 6mm; }
      .instr b { display: block; font: 600 11pt/1.2 var(--font-display); margin-bottom: 2mm; }
      .instr pre { margin: 0; font: 400 9pt/1.5 var(--font-mono); white-space: pre-wrap; color: #124E7D; }
      footer { margin-top: auto; display: flex; justify-content: space-between; font: 500 8pt/1.3 var(--font-mono); color: #6B7580; }
      @media print {
        body { background: none; }
        .barra { display: none; }
        .hoja { margin: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      }
      @media (max-width: 820px) {
        .hoja { width: auto; min-height: 0; margin: 0 16px 24px; padding: 24px 20px; }
        .ideas { grid-template-columns: minmax(0, 1fr); }
      }
    </style>
  </head>
  <body>
    <div class="barra">
      <button type="button" onclick="window.print()">Guardar en PDF o imprimir</button>
    </div>
    <article class="hoja">
      <header>
        <div>
          <p class="kicker">Tarjeta resumen · Capacitación {t.n} de 4</p>
          <h1>{t.titulo}</h1>
        </div>
        <img src="/brand/ekosolv-horizontal.png" alt="EKOSOLV" width="249" height="72" />
      </header>
      <section>
        <h2>Las ideas para llevarse</h2>
        <div class="ideas">
          {t.resumen.ideas.map((x, k) => (
            <div class="idea"><h3><span>0{k + 1}</span>{x.titulo}</h3><p>{x.texto}</p></div>
          ))}
        </div>
      </section>
      <section>
        <h2>Instrucciones para copiar</h2>
        <div class="instr">
          {t.resumen.instrucciones.map((x) => (
            <div><b>{x.titulo}</b><pre>{x.texto}</pre></div>
          ))}
        </div>
      </section>
      <footer><span>Capacitación en IA para el equipo de Ekosolv</span><span>Dictada por Michael Rodriguez</span></footer>
    </article>
  </body>
</html>
