---
// La sala: lo que cada participante abre en el celular durante una
// capacitación presencial (se llega por el código QR del proyector). Es
// pública: la primera vez pide nombres, apellidos, correo y área (sin usuario
// ni contraseña) y le envía al correo el enlace de entrada. Al abrirlo
// (?e=<pase>) queda registrada su asistencia y entra. Después muestra la pregunta
// abierta en cada momento y guarda sus respuestas. Cuando no hay nada que
// votar, muestra la idea de la escena en palabras sencillas y un ejemplo de su
// área. Abajo, una caja para enviarle preguntas a quien dicta.
// Motor: src/scripts/taller/sala.ts. API: /api/academia/sala.
export const prerender = false
import AcademiaLayout from '../../layouts/AcademiaLayout.astro'
import { SALA_COOKIE, SALA_TTL_SECONDS, verificarPaseSala } from '../../lib/auth'
import { anotar } from '../../lib/bitacora'
import { clientIp } from '../../lib/rateLimit'
import { AREAS_ACADEMIA } from '../../lib/academia/reglas'
import { salaActual } from '../../lib/talleres/sala'
import { TALLERES } from '../../lib/talleres'
import type { PasoGuiado } from '../../lib/talleres/tipos'
import { SITE_URL } from '../../lib/site'
import Maqueta from '../../components/taller/Maqueta.astro'
import '../../styles/maquetas.css'

Astro.response.headers.set('cache-control', 'no-store')

// Enlace del correo: guarda el pase como cookie y recarga sin él en la URL,
// para que no quede en el historial ni se comparta por error al copiar la
// dirección. salaActual decide si el pase sirve (capacitación en curso, hoy).
const enlace = Astro.url.searchParams.get('e')
let enlaceVencido = false
if (enlace) {
  const pase = await verificarPaseSala(enlace)
  if (pase) {
    await anotar('sala_entrada', { quien: `asistente:${pase.a}`, taller: pase.t, detalle: { agente: Astro.request.headers.get('user-agent') ?? '' }, ip: clientIp(Astro.request, Astro.clientAddress ?? '') })
    Astro.cookies.set(SALA_COOKIE, enlace, { path: '/', httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD, maxAge: SALA_TTL_SECONDS })
    return Astro.redirect('/academia/sala')
  }
  enlaceVencido = true
}

const { estado, t, asistente } = await salaActual(Astro.cookies.get(SALA_COOKIE)?.value)
// Un pase válido pero de otro día u otra capacitación no deja entrar.
if (!asistente && Astro.cookies.get(SALA_COOKIE)?.value) enlaceVencido = true

// Dirección corta que se escribe en el PC para ver la presentación (/pc).
const dirPC = `${(import.meta.env.DEV ? Astro.url.origin : SITE_URL).replace(/^https?:\/\//, '')}/pc`
// Maquetas de las prácticas guiadas: quedan en <template> y la sala las clona en cada paso.
const maquetas = [
  ...new Set(
    Object.values(TALLERES).flatMap((t) => t.escenas.filter((e) => e.tipo === 'conectar').flatMap((e) => ((e.datos?.pasos ?? []) as PasoGuiado[]).map((p) => p.maqueta))),
  ),
]
---

<AcademiaLayout titulo="Sala · Academia de IA · Ekosolv" sinNav>
  {asistente ? (
    <section class="sl" data-sala aria-live="polite">
      <p class="sl-quien" data-sl-kicker>Asistencia registrada · {asistente.nombre} {asistente.apellido}</p>
      <p class="ac-kicker" data-sl-escena></p>
      <h1 data-sl-titulo>Conectando…</h1>
      <p class="sl-sub" data-sl-sub></p>
      <div class="sl-preguntas" data-sl-preguntas></div>
      <p class="sl-estado" data-sl-estado></p>
      <aside class="sl-ejemplo" data-sl-ejemplo hidden>
        <p class="n" data-sl-ej-area></p>
        <h2 data-sl-ej-titulo></h2>
        <p data-sl-ej-texto></p>
        <p class="sl-nota">Ejemplo ilustrativo</p>
      </aside>
      <div class="sl-pc-zona">
        <button type="button" class="ac-btn ac-btn-sec" data-sl-pc-abrir>Abrir en mi PC</button>
        <div class="sl-pc" data-sl-pc hidden>
          <p>En el navegador de su PC escriba esta dirección:</p>
          <p class="sl-pc-url">{dirPC}</p>
          <p>Y cuando se la pida, este código:</p>
          <p class="sl-pc-codigo" data-sl-pc-codigo>··</p>
          <div class="sl-pc-fila">
            <p data-sl-pc-vence role="status"></p>
            <button type="button" class="ac-btn ac-btn-sec" data-sl-pc-cerrar>Listo</button>
          </div>
        </div>
      </div>
      {maquetas.map((id) => (
        <template data-mq-plantilla={id}>
          <Maqueta id={id} />
        </template>
      ))}
      <form class="sl-form sl-duda" data-sl-duda novalidate>
        <label>
          <span>¿Tiene una pregunta?</span>
          <textarea name="texto" rows="2" maxlength="400" placeholder="Escríbala aquí: le llega a quien dicta."></textarea>
        </label>
        <button type="submit" class="ac-btn ac-btn-sec">Enviar pregunta</button>
        <p class="sl-estado" data-sl-duda-estado role="status"></p>
      </form>
    </section>
  ) : (
    <section class="sl">
      <p class="ac-kicker">{t ? `Capacitación ${t.n} · ${t.titulo}` : 'Sala de la capacitación'}</p>
      <h1>Antes de empezar, ¿quién es usted?</h1>
      <p class="sl-sub">
        {estado
          ? 'Escriba sus datos y le enviamos a su correo el enlace para entrar. No necesita usuario ni contraseña.'
          : 'La sesión todavía no ha empezado. Puede llenar sus datos cuando quien dicta abra la presentación.'}
      </p>
      {enlaceVencido && <p class="sl-estado error" role="alert">Ese enlace ya no sirve: es de otro día o de otra capacitación. Llene sus datos y le enviamos uno nuevo.</p>}
      <form class="sl-form" data-sl-registro novalidate>
        <div class="sl-par">
          <label>
            <span>Nombres</span>
            <input name="nombre" required maxlength="60" autocomplete="given-name" autocapitalize="words" spellcheck="false" data-capitalizar />
          </label>
          <label>
            <span>Apellidos</span>
            <input name="apellido" required maxlength="60" autocomplete="family-name" autocapitalize="words" spellcheck="false" data-capitalizar />
          </label>
        </div>
        <label>
          <span>Correo</span>
          <input name="correo" type="email" required maxlength="120" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" />
        </label>
        <label>
          <span>Área</span>
          <select name="area" required>
            <option value="" selected disabled>Elija su área</option>
            {AREAS_ACADEMIA.map((a) => <option value={a.id}>{a.etiqueta}</option>)}
          </select>
        </label>
        <button type="submit" class="ac-btn">Enviarme el enlace</button>
        <p class="sl-estado" data-sl-estado role="status"></p>
        <p class="sl-nota">A este correo le llegará también el material de la capacitación: guías, plantillas y recursos visuales.</p>
      </form>
      <div class="sl-enviado" data-sl-enviado hidden>
        <h2>Revise su correo</h2>
        <p>Le enviamos el enlace a <b data-sl-correo></b>. Ábralo desde este celular para entrar. Si no aparece en un minuto, mire en la carpeta de spam.</p>
        <button type="button" class="ac-btn ac-btn-sec" data-sl-otra>Corregir el correo</button>
      </div>
    </section>
  )}
  <script>
    import '../../scripts/taller/sala'
  </script>
</AcademiaLayout>
