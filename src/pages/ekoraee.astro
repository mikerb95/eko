---
import Layout from '../layouts/Layout.astro'
import { FOUNDED_YEAR, tonnesManaged } from '../lib/brand'

const servicios = [
  {
    n: "01", title: "Campañas de recolección",
    desc: "Campañas de recolección selectiva de residuos de aparatos eléctricos y electrónicos para empresas, instituciones y comunidades. Cuidando el planeta, paso a paso.",
    when: "Por campaña",
  },
  {
    n: "02", title: "Transporte y disposición certificada",
    desc: "Recolección en punto o a domicilio, transporte certificado a gestor autorizado y certificados de disposición final para cada cliente, conforme a la normativa ambiental vigente.",
    when: "Continuo",
  },
  {
    n: "03", title: "Licenciamiento e informes (ICA)",
    desc: "Proyectos de licenciamiento ambiental e informes de cumplimiento ambiental (ICA), con integración al plan posconsumo de EKONSULTING y reporte de metas a la autoridad.",
    when: "Por proyecto",
  },
  {
    n: "04", title: "Logística inversa y valorización",
    desc: "Soluciones de logística inversa para empresas y personas, recuperación y valorización de materiales para cerrar el ciclo dentro de la economía circular.",
    when: "Continuo",
  },
]
---

<Layout title="EKORAEE — Gestión de residuos electrónicos · Ekosolv" description="Recolección, transporte, almacenamiento y certificación de RAEE conforme a la normativa ambiental. Más de 1.000 toneladas gestionadas desde 2013." activePath="/servicios">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · 02</div>
      <div class="l">Reciclando el futuro</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Recolección de <em>residuos</em><br>eléctricos y electrónicos.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">
      Recolección, transporte, almacenamiento y certificación de RAEE conforme a la normativa ambiental. Nuestro sistema opera desde {FOUNDED_YEAR}, gestionando más de {tonnesManaged('es')} toneladas de residuos electrónicos en apoyo a la economía circular.
    </p>
    {/* PENDIENTE-DATO 2.c: confirmar el alcance real de recolección antes de publicar. */}
    <p class="lede reveal" style="margin-top:20px; max-width:58ch; font-size:17px; color:var(--mute)">
      La asesoría normativa se presta de forma remota en todo el país. La recolección se coordina caso a caso según volumen y ubicación — escríbenos y confirmamos cobertura antes de agendar.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Experiencia en gestión de RAEE</div>
          <h2 style="margin-top:14px; max-width:16ch">Cuidando el planeta, <em>paso a paso</em>.</h2>
        </div>
        <div class="stat">
          <div class="n">2013</div>
          <div class="lbl">Sistema en operación desde</div>
        </div>
        <div class="stat">
          <div class="n">1.000<small>+ ton</small></div>
          <div class="lbl">De RAEE gestionadas responsablemente</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="process reveal">
      {servicios.map(s => (
        <div class="process-row">
          <div class="n">{s.n}</div>
          <h3>{s.title}</h3>
          <div class="desc">{s.desc}</div>
          <div class="when">{s.when}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.4fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Recolección</div>
          <h2 style="margin-top:14px; max-width:20ch">¿Tienes equipos <em>obsoletos</em> por retirar?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            Agenda una recolección de residuos electrónicos para tu empresa. Incluye transporte certificado y certificado de disposición final.
          </p>
        </div>
        <div style="display:flex; align-items:center; justify-content:flex-end;">
          <a href="/agenda-una-recoleccion" class="foot-cta">
            Agenda una recolección
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-head reveal">
        <div class="display">¿Un nuevo <em>expediente</em><br>en el radar?</div>
        <a href="/contacto" class="foot-cta">Escríbenos <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="foot-cols">
        <div>
          <img class="foot-logo" src="/brand/ekosolv-horizontal-white.svg" alt="EKOSOLV — Consultores en Sostenibilidad" />
          <p style="opacity:.6; font-size:14px; margin-top:12px; max-width:36ch">Consultoría ambiental especializada en cumplimiento ANLA, ESG y economía circular.</p>
        </div>
        <div><h5>Servicios</h5><ul><li><a href="/ekonsulting">EKONSULTING</a></li><li><a href="/ekoraee">EKORAEE</a></li><li><a href="/ekopartner">EKOPARTNER</a></li><li><a href="/ekotrading">EKOTRADING</a></li></ul></div>
        <div><h5>Sitio</h5><ul><li><a href="/">Inicio</a></li><li><a href="/quienes-somos">Nosotros</a></li><li><a href="/agenda-una-recoleccion">Agenda</a></li><li><a href="/blog">Diario</a></li></ul></div>
        <div><h5>Contacto</h5><ul><li>info@ekosolv.com</li><li>+57 321 271 2773</li><li>Edif. RPTV · Carrera 15 #31B-33<br>Bogotá D.C.</li></ul></div>
      </div>
      <div class="foot-bottom">
        <div>© 2026 Ekosolv S.A.S. · NIT 900.659.506-9</div>
        <a href="https://github.com/mikerb95" target="_blank" rel="noopener noreferrer" class="gh-badge">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span>@mikerb95</span>
        </a>
      </div>
    </div>
  </footer>
</Layout>
