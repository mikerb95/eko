---
import Layout from '../layouts/Layout.astro'
import { FOUNDED_YEAR, stats, tonnesManaged } from '../lib/brand'
import SiteFooter from '../components/SiteFooter.astro'

const servicios = [
  {
    n: "01", title: "Campañas de recolección",
    desc: "Campañas de recolección selectiva de residuos de aparatos eléctricos y electrónicos para empresas, instituciones y comunidades. Cuidando el planeta, paso a paso.",
    when: "Por campaña",
  },
  {
    n: "02", title: "Transporte y disposición certificada",
    desc: "Recolección en punto o a domicilio, transporte certificado a gestor autorizado y certificados de disposición final para cada cliente, conforme a la normativa ambiental vigente.",
    when: "Continuo",
  },
  {
    n: "03", title: "Licenciamiento e informes (ICA)",
    desc: "Proyectos de licenciamiento ambiental e informes de cumplimiento ambiental (ICA), con integración al plan posconsumo de EKONSULTING y reporte de metas a la autoridad.",
    when: "Por proyecto",
  },
  {
    n: "04", title: "Logística inversa y valorización",
    desc: "Soluciones de logística inversa para empresas y personas, recuperación y valorización de materiales para cerrar el ciclo dentro de la economía circular.",
    when: "Continuo",
  },
]
---

<Layout activePath="/ekoraee">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">EKORAEE · 02</div>
      <div class="l">Reciclando el futuro</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Recolección de <em>residuos</em><br>eléctricos y electrónicos.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:58ch">
      Recolección, transporte, almacenamiento y certificación de RAEE conforme a la normativa ambiental. Nuestro sistema opera desde {FOUNDED_YEAR}, gestionando {tonnesManaged('es')} toneladas de residuos electrónicos en apoyo a la economía circular.
    </p>
    {/* PENDIENTE-DATO 2.c: confirmar el alcance real de recolección antes de publicar. */}
    <p class="lede reveal" style="margin-top:20px; max-width:58ch; font-size:17px; color:var(--mute)">
      La asesoría normativa se presta de forma remota en todo el país. La recolección se coordina caso a caso según volumen y ubicación — escríbenos y confirmamos cobertura antes de agendar.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="band reveal">
      <div class="band-grid">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Experiencia en gestión de RAEE</div>
          <h2 style="margin-top:14px; max-width:16ch">Cuidando el planeta, <em>paso a paso</em>.</h2>
        </div>
        <div class="stat">
          <div class="n">{FOUNDED_YEAR}</div>
          <div class="lbl">Sistema en operación desde</div>
        </div>
        <div class="stat">
          <div class="n">{stats.tonnesManaged.toLocaleString('es-CO')}<small>+ ton</small></div>
          <div class="lbl">De RAEE gestionadas responsablemente</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="process reveal">
      {servicios.map(s => (
        <div class="process-row">
          <div class="n">{s.n}</div>
          <h3>{s.title}</h3>
          <div class="desc">{s.desc}</div>
          <div class="when">{s.when}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.4fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">EKORAEE · Recolección</div>
          <h2 style="margin-top:14px; max-width:20ch">¿Tienes equipos <em>obsoletos</em> por retirar?</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            Agenda una recolección de residuos electrónicos para tu empresa. Incluye transporte certificado y certificado de disposición final.
          </p>
        </div>
        <div style="display:flex; align-items:center; justify-content:flex-end;">
          <a href="/agenda-una-recoleccion" class="foot-cta">
            Agenda una recolección
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</Layout>
