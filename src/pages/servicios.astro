---
import Layout from '../layouts/Layout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import VideoFacade from '../components/VideoFacade.astro'
import { videoServiciosVisible } from '../lib/credenciales'

const videoServicios = videoServiciosVisible('es')

const lines = [
  {
    n: "01", code: "EKONSULTING", slug: "/ekonsulting",
    title: "Asesoría y cumplimiento ANLA",
    lede: "El núcleo de nuestra práctica. Estructuramos y ejecutamos todos los trámites regulatorios ante la ANLA y las CAR — desde el licenciamiento hasta la defensa en procesos sancionatorios.",
    deliverables: [
      "Licenciamiento ambiental (EIA, DAA, PMA)",
      "Planes posconsumo RAEE y pilas",
      "Auditoría de cumplimiento 360°",
      "Reportes ante autoridad (RUA, ICA, ANLA)",
      "Acompañamiento en procesos sancionatorios",
      "Capacitación in-house del equipo HSE",
      "Estrategia ESG y alineación ODS",
    ],
    plazo: "Continuo",
    accent: "accent-deep",
    thumb: "sg-deep",
    icon: "shield",
  },
  {
    n: "02", code: "EKORAEE", slug: "/ekoraee",
    title: "Gestión certificada de residuos electrónicos",
    lede: "Recolección, transporte, almacenamiento y certificación de aparatos eléctricos y electrónicos bajo la Resolución 1297 de 2010 y la Ley 1672 de 2013.",
    deliverables: [
      "Recolección en punto o a domicilio",
      "Transporte certificado a gestor autorizado",
      "Certificados de disposición final",
      "Integración con plan posconsumo EKONSULTING",
      "Reporte de metas para la autoridad",
    ],
    plazo: "Por campaña o continuo",
    accent: "accent-forest",
    thumb: "sg-forest",
    icon: "chip",
  },
  {
    n: "03", code: "EKOPARTNER", slug: "/ekopartner",
    title: "Operación de sistemas de gestión de residuos",
    lede: "Integramos y operamos el sistema completo de recolección y disposición de residuos de la organización. No solo asesoramos — lo hacemos. Aplica únicamente en Colombia.",
    deliverables: [
      "Diseño del sistema de gestión integral",
      "Operación de puntos de recolección",
      "Gestión de gestores y transportistas",
      "Trazabilidad end-to-end de residuos",
      "Reportes operativos y regulatorios",
    ],
    plazo: "Retainer mensual",
    accent: "",
    thumb: "sg-neutral",
    icon: "loop",
  },
  {
    n: "04", code: "EKOTRADING", slug: "/ekotrading",
    title: "Economía circular · compra y venta de activos IT",
    lede: "Cerramos el ciclo de vida de los equipos tecnológicos dentro de un marco de economía circular. Compramos y vendemos tecnología usada u obsoleta al por mayor, con la trazabilidad que exigen los ODS.",
    deliverables: [
      "Valoración y retiro de activos IT obsoletos",
      "Reacondicionamiento y certificación",
      "Recolocación en mercados secundarios",
      "Documentación para reporte ESG",
      "Integración con EKORAEE para lo no reacondicionable",
    ],
    plazo: "Por lote o continuo",
    accent: "accent-clay",
    thumb: "sg-clay",
    icon: "swap",
  },
]

const icons: Record<string, string> = {
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/>',
  chip: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M7 3.5V7M17 3.5V7M7 17v3.5M17 17v3.5"/>',
  loop: '<path d="M4 12a8 8 0 0 1 14-5.3M20 5v5h-5"/><path d="M20 12a8 8 0 0 1-14 5.3M4 19v-5h5"/>',
  swap: '<path d="M7 4l-4 4 4 4"/><path d="M3 8h13a4 4 0 0 1 4 4v1"/><path d="M17 20l4-4-4-4"/><path d="M21 16H8a4 4 0 0 1-4-4v-1"/>',
}
---

<Layout activePath="/servicios">
  <section class="page-head wrap">
    <div class="page-strip">
      <div class="l">Líneas de servicio</div>
      <div class="l">04 líneas · un solo ecosistema</div>
    </div>
    <h1 class="display reveal" style="margin-top:40px">
      Del cumplimiento<br>a la <em>ventaja competitiva</em>.
    </h1>
    <p class="lede reveal" style="margin-top:32px; max-width:54ch">
      Cuatro líneas integradas que cubren todo el ciclo ambiental de una compañía tech: la obligación regulatoria, la operación de residuos, la economía circular y la estrategia ESG.
    </p>
  </section>

  <section class="section wrap">
    <div class="process reveal">
      {lines.map(s => (
        <div class={`process-row process-row-thumb ${s.accent ? s.accent + '-row' : ''}`}>
          <div class={`svc-thumb ${s.thumb}`} aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
          </div>
          <div>
            <div class="n">{s.n} · {s.code}</div>
            <h3 style="font-size:clamp(20px,2vw,30px); margin-top:6px">{s.title}</h3>
          </div>
          <div class="desc">
            {s.lede}
            <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:18px">
              {s.deliverables.map(d => (
                <span style="font-size:13px; line-height:1.4; color:var(--ink-2); padding:8px 14px; background:var(--paper); border:1px solid var(--line); border-radius:999px;">{d}</span>
              ))}
            </div>
            <a href={s.slug} style="display:inline-flex; align-items:center; gap:6px; margin-top:16px; font-family:var(--font-mono); font-size:11.5px; letter-spacing:0.04em; text-transform:uppercase; color:var(--deep);">
              Ver línea {s.code}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <div class="when">{s.plazo}</div>
        </div>
      ))}
    </div>
  </section>

  {videoServicios && (
    <section class="section wrap">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">Video · Servicios</div>
          <h2>Nuestras líneas de servicio<br>en <em>acción</em>.</h2>
        </div>
      </div>
      <div class="reveal" style="max-width:820px">
        <VideoFacade video={videoServicios} lang="es" />
      </div>
    </section>
  )}

  <section class="section wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Metodología · EKORUTA</div>
        <h2>Un framework propio para ir<br>más allá del <em>mínimo regulatorio</em>.</h2>
      </div>
      <div class="meta">
        La EKORUTA es nuestra hoja de ruta de sostenibilidad empresarial. Guía a cada organización paso a paso — desde el primer diagnóstico ANLA hasta la estrategia ESG alineada con los ODS de la ONU.
      </div>
    </div>

    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr">
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Diagnóstico</div>
          <div class="lbl">Obligaciones ANLA + brechas ESG</div>
        </div>
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Hoja de ruta</div>
          <div class="lbl">Plan regulatorio + ODS aplicables</div>
        </div>
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Ejecución</div>
          <div class="lbl">Trámites + operación + trading</div>
        </div>
        <div class="stat">
          <div class="n" style="font-size:clamp(20px,2.5vw,32px)">Mejora</div>
          <div class="lbl">Reporte ESG + nuevo ciclo</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="band reveal">
      <div class="band-grid" style="grid-template-columns: 1.4fr 1fr 1fr">
        <div>
          <div class="eyebrow" style="color: color-mix(in oklab, #fff 55%, transparent)">Forma de trabajo</div>
          <h2 style="margin-top:14px; max-width:18ch">Tres modalidades, un <em>solo estándar</em>.</h2>
          <p style="color: color-mix(in oklab, #fff 75%, transparent); margin-top:20px; max-width:44ch; font-size:15px; line-height:1.55">
            Trabajamos por proyecto cerrado, como retainer mensual o en esquema híbrido. Sin letra pequeña.
          </p>
        </div>
        <div class="stat">
          <div class="n">45<small>min</small></div>
          <div class="lbl">Diagnóstico inicial sin costo</div>
        </div>
        <div class="stat">
          <div class="n">4</div>
          <div class="lbl">Líneas integradas disponibles</div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</Layout>
