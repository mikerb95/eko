---
import { getStory } from '../utils/api'
import DynamicComponent from '../storyblok/DynamicComponent.astro'
import Layout from '../layouts/Layout.astro'
import generateStaticPaths from '../utils/generateStaticPaths'
import * as locales from '../locales'

export async function getStaticPaths() {
  return await generateStaticPaths()
}

const { slug } = Astro.props
const story = await getStory(slug)
const translate = locales.es
const title = story?.content?.title ? `${story.content.title} — Eko` : "Eko"
---

<Layout title={title}>
  <DynamicComponent blok={story.content} language="es" translate={translate} />
</Layout>
